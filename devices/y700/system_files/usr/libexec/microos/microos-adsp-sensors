#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob inherit_errexit
export LC_ALL=C

me=microos-adsp-sensors
root=${MICROOS_ADSP_ROOT:-}
state=$root/run/microos/adsp
unit=microos-hexagonrpcd-adsp.service
tries=${MICROOS_ADSP_TRIES:-100}
lpextent=${MICROOS_LP_EXTENT:-/usr/libexec/microos/microos-lp-extent}
layout=3
nosource=75

log() { echo "$me: $*"; }

ufs_part() {
  local link=$root/dev/disk/by-partlabel/$1 dev name parent id
  why="no $1 partition"
  [[ -e $link ]] || return 1
  dev=$(readlink -f "$link")
  name=${dev##*/}
  why="$1 is $name, not a partition"
  [[ -e $root/sys/class/block/$name/partition ]] || return 1
  parent=$(realpath -e "$root/sys/class/block/$name/..") || return 1
  why="$1 is on ${parent##*/}, which has no ID_PATH"
  id=$(udevadm info --query=property --property=ID_PATH --value --name="/dev/${parent##*/}") || return 1
  why="$1 is on ${parent##*/} ($id), not UFS"
  [[ $id == platform-1d84000.ufshc-scsi-* ]] || return 1
  part=$dev
}

active_slot() {
  local f re='androidboot\.slot_suffix[ ="]*(_[ab])'
  for f in "$root/proc/cmdline" "$root/proc/bootconfig"; do
    [[ -r $f && $(< "$f") =~ $re ]] || continue
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  done
}

pick() {
  local s
  ufs_part persist || return 1
  persist=$part
  for s in $active _a _b; do
    ufs_part "dsp$s" || continue
    dsp=$part
    slot=$s
    return 0
  done
  return 1
}

copy_tree() {
  local src=$1 dst=$2
  mkdir -p "$dst" || return
  (cd -- "$src" && find . -mindepth 1 -type d -print0) | (cd -- "$dst" && xargs -0 -r mkdir -p) || return
  (cd -- "$src" && find . -type f -print0 | xargs -0 -r cp --no-preserve=all --parents -t "$dst")
}

vendor_conf() {
  local ext first count loop dir=$work/vendor conf cfg links
  ufs_part super || return 1
  if ! ext=$("$lpextent" "$part" "vendor$slot" 2>&1); then
    why=${ext##*$'\n'}
    why=${why#microos-lp-extent: }
    why=${why:-microos-lp-extent failed on vendor$slot}
    return 1
  fi
  why="vendor$slot extent is '$ext'"
  read -r first count <<< "$ext"
  [[ $first =~ ^[0-9]+$ && $count =~ ^[0-9]+$ && $ext == "$first $count" ]] || return 1
  why="losetup on vendor$slot failed"
  loop=$(losetup -r -f --show -o "$(( first * 512 ))" --sizelimit "$(( count * 512 ))" "$part") || return 1
  [[ -n $loop ]] || return 1
  loops+=("$loop")
  why="blockdev --setro on $loop failed"
  blockdev --setro "$loop" || return 1
  why="mounting vendor$slot failed"
  mkdir "$dir" || return 1
  mount -t erofs -o ro,nosuid,nodev,noexec "$loop" "$dir" || return 1
  mounted+=("$dir")
  conf=$dir/etc/sensors/sns_reg_config
  cfg=$dir/etc/sensors/config
  why="no etc/sensors/sns_reg_config on vendor$slot"
  [[ -f $conf && $(realpath -e -- "$conf") == "$conf" ]] || return 1
  why="no etc/sensors/config on vendor$slot"
  [[ -d $cfg && $(realpath -e -- "$cfg") == "$cfg" ]] || return 1
  why="copying the vendor$slot sensor config failed"
  cp --no-preserve=all -- "$conf" "$gen/sensors/sns_reg.conf" || return 1
  copy_tree "$cfg" "$gen/sensors/config" || return 1
  links=$(find "$cfg" -type l -printf . | wc -c)
  (( links == 0 )) || log "skipped $links symlinks in etc/sensors/config on vendor$slot"
}

sum_tree() {
  (
    cd -- "$2"
    printf '%s\n' "$1"
    find . \( -type d -o -type f \) -printf '%y %p\n' | sort
    find . -type f -print0 | sort -z | xargs -0 -r sha256sum
  )
}

provision() {
  found=0 mounted=() loops=() tmp=
  for f in "$root"/run/microos/adsp-sensors.*; do
    rm -rf --one-file-system -- "${f:?}"
  done
  active=$(active_slot)

  for (( i = 1; i <= tries; i++ )); do
    if pick; then
      found=1
      break
    fi
    sleep 0.1
  done
  if (( ! found )); then
    log "$why, no sensor tree"
    exit "$nosource"
  fi
  log "using slot $slot${active:+ (booted $active)}"

  mkdir -p "$state"
  work=$(mktemp -d "$root/run/microos/adsp-sensors.XXXXXX")
  work=$(realpath -e "$work")
  cleanup() {
    local m
    for m in "${mounted[@]}"; do umount "$m" || true; done
    for m in "${loops[@]}"; do losetup -d "$m" || true; done
    rm -rf --one-file-system -- "${work:?}"
    [[ -z $tmp ]] || rm -rf --one-file-system -- "${tmp:?}"
  }
  trap cleanup EXIT

  mount_ro() {
    local dev=$1 type=$2 dir=$work/$3 opts=ro,nosuid,nodev,noexec
    [[ $type == ext4 ]] && opts=$opts,noload
    blockdev --setro "$dev"
    mkdir "$dir"
    mount -t "$type" -o "$opts" "$dev" "$dir"
    mounted+=("$dir")
  }
  mount_ro "$dsp" ext4 dsp
  mount_ro "$persist" ext4 persist

  adsp=$work/dsp/adsp
  registry=$work/persist/sensors/registry
  missing=
  [[ -d $adsp && $(realpath -e -- "$adsp") == "$adsp" ]] || missing="adsp on dsp$slot"
  [[ -d $registry/registry && $(realpath -e -- "$registry/registry") == "$registry/registry" ]] ||
    missing="sensors registry on persist"
  if [[ -n $missing ]]; then
    log "no $missing, no sensor tree"
    exit "$nosource"
  fi

  gen=$work/gen
  mkdir -p "$gen/socinfo" "$gen/sensors"
  for f in family machine revision soc_id serial_number; do
    cat "$root/sys/devices/soc0/$f" > "$gen/socinfo/$f"
  done
  dbg=$root/sys/kernel/debug/qcom_socinfo
  read -r subtype 2> /dev/null < "$dbg/hardware_platform_subtype" || subtype=0
  read -r version 2> /dev/null < "$dbg/platform_version" || version=65536
  printf 'QRD\n' > "$gen/socinfo/hw_platform"
  printf 'QRD\n' > "$gen/socinfo/platform_subtype"
  printf '%s\n' "$subtype" > "$gen/socinfo/platform_subtype_id"
  printf '%s\n' "$version" > "$gen/socinfo/platform_version"
  if ! vendor_conf; then
    log "no vendor sensor config ($why), the generated sns_reg.conf is used"
    rm -rf --one-file-system -- "${gen:?}/sensors/config"
    cat > "$gen/sensors/sns_reg.conf" << 'EOF'
version=1
file=hw_platform=/sys/devices/soc0/hw_platform
file=platform_subtype=/sys/devices/soc0/platform_subtype
file=platform_subtype_id=/sys/devices/soc0/platform_subtype_id
file=platform_version=/sys/devices/soc0/platform_version
file=soc_id=/sys/devices/soc0/soc_id
file=revision=/sys/devices/soc0/revision
file=output=/mnt/vendor/persist/sensors/registry/registry
property=persist.vendor.sensors.enable.property=/mnt/vendor/persist/sensors/registry/file1
property=persist.vendor.sensors.enable.property1=/mnt/vendor/persist/sensors/registry/file2
EOF
  fi

  hash=$(
    {
      printf 'layout %s\n' "$layout"
      sum_tree adsp "$adsp"
      sum_tree registry "$registry"
      sum_tree gen "$gen"
    } | sha256sum | cut -d' ' -f1
  )

  if [[ $(readlink "$state/current" 2> /dev/null) == "$hash" && -d $state/$hash ]]; then
    log "tree $hash in place"
  else
    tmp=$state/.$hash.tmp
    rm -rf --one-file-system -- "${tmp:?}" "${state:?}/${hash:?}"
    copy_tree "$adsp" "$tmp/hexagonfs/dsp/adsp"
    copy_tree "$registry" "$tmp/hexagonfs/sensors/persist"
    copy_tree "$gen" "$tmp/hexagonfs"
    chown -R 0:0 "$tmp"
    find "$tmp" -type d -exec chmod 0755 {} +
    find "$tmp" -type f -exec chmod 0644 {} +
    mv -T "$tmp" "$state/$hash"
    tmp=

    running=0
    if systemctl -q is-active "$unit"; then
      systemctl stop "$unit"
      running=1
    fi
    rc=0
    ln -sfn "$hash" "$state/.current.tmp"
    mv -T "$state/.current.tmp" "$state/current" || rc=$?
    if (( running )); then
      systemctl --no-block start "$unit" || log "starting $unit failed"
    fi
    (( rc == 0 )) || exit "$rc"
    log "tree $hash installed"
  fi

  for f in "$state"/* "$state"/.*.tmp; do
    [[ ${f##*/} == current || ${f##*/} == "$hash" ]] && continue
    rm -rf --one-file-system -- "${f:?}"
  done
}

set +e
(set -e; provision)
rc=$?
set -e
if (( rc == nosource )); then
  exit 0
elif (( rc != 0 )); then
  if [[ -d $state/current/hexagonfs ]]; then
    log "provisioning failed ($rc), $unit serves the tree in place ($(readlink "$state/current"))"
  else
    log "provisioning failed ($rc) and no tree in place"
    exit "$rc"
  fi
fi
