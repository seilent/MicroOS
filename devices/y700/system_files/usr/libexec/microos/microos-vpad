GADGET = f"{CONFIGFS}/usb_gadget/microos-vpad"
DEFAULT_BRIGHTNESS = 512

BASE = 0xA000
MIN_MS = 8
TICK_MS = 12
CLICK_MS = 25
MAX_MS = 200
INTENSITY = {0: 1.0, 1: 0.5, 2: 1.0, 3: 1.5, 4: 2.0}
REPORT_MS = REPORT_US / 1000
TAP_MS = 300
HOLD_MS = 1000
QAM_MS = 100
GRAB_POLL_MS = 50
GRAB_WAIT_MS = 2000
RECHECK_MS = 1000
SCAN_MS = 5000
RESUME_MS = 100
WAKE_BEFORE_MS = 5000
WAKE_GRACE_MS = 1500
