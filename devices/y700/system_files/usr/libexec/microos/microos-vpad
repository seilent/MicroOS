                         "9501 7503 9101 9506 7508 1500 2565 0507 1900 2965 8100 c0")
FUNCTIONS = (("hid.kbd", KEYBOARD, 8), ("hid.kbd2", KEYBOARD, 8), ("hid.ctl", DESC, 64))
UNIT_SERIAL = b"MICROOSY700"
SERIALS = {0: b"MICROOSY700B", 1: UNIT_SERIAL}
REPORT_US = 4000
ATTRIBUTES = ((1, 0x1205), (2, 0), (4, 0x65E4F1AD), (9, 0x2E), (10, 0x62A9122B), (11, REPORT_US), (12, 0), (13, 0), (14, 0))


def ioc(direction, nr, size, kind=0x45):
    return (direction << 30) | (size << 16) | (kind << 8) | nr


EVIOCSFF = ioc(1, 0x80, 48)
EVIOCGRAB = ioc(1, 0x90, 4)
EVIOCGKEY = ioc(2, 0x18, 96)
EVIOCSCLOCKID = ioc(1, 0xA0, 4)
GADGET_HID_READ_GET_REPORT_ID = ioc(2, 0x41, 1, 0x67)
GADGET_HID_WRITE_GET_REPORT = ioc(1, 0x42, 72, 0x67)
EV_KEY = 0x01
EV_FF = 0x15
FF_RUMBLE = 0x50
KEY_POWER = 116
EBUSY = 16
ENODEV = 19
EROFS = 30
ESHUTDOWN = 108

MOTORS = {"left": "vibrator@5b", "right": "vibrator@5a"}
BOTH = ("left", "right")
PULSE_SIDES = {0: ("right",), 1: ("left",), 2: BOTH}
CMD_SIDES = {0: ("left",), 1: ("right",), 2: BOTH}
POWER = "pmic_pwrkey"
SCREEN_INPUTS = ("Novatek NT36523 Touchscreen", "Novatek NT36523 Pen")
BACKLIGHT = "/sys/class/backlight/ktz8866-backlight/brightness"
BL_POWER = "/sys/class/backlight/ktz8866-backlight/bl_power"
POWERDOWN = 4
SAVED = "/run/microos-vpad/brightness"
SOCKET = os.environ.get("MICROOS_VPAD_SOCKET", "/run/microos-vpad/power")
HELPER = os.environ.get("MICROOS_VPAD_HELPER", "micro")
HELPER_UNIT = os.environ.get("MICROOS_VPAD_HELPER_UNIT", "microos-powerkey.service")
