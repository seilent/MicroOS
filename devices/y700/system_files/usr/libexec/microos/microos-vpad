def log(text):
    print(f"microos-vpad: {text}", file=sys.stderr)


def ms():
    return time.clock_gettime(time.CLOCK_BOOTTIME) * 1000


def slept_ms():
    return (time.clock_gettime(time.CLOCK_BOOTTIME) - time.clock_gettime(time.CLOCK_MONOTONIC)) * 1000


def message(data):
    return bytes(data).ljust(64, b"\0")[:64]


def feature(msg):
    if msg[0] == 0xAE:
        text = SERIALS.get(msg[2], b"") + b"\0"
        out = bytes((0xAE, len(text), msg[2])) + text
    elif msg[0] == 0x83:
        body = b"".join(struct.pack("<BI", tag, value) for tag, value in ATTRIBUTES)
        out = bytes((0x83, len(body))) + body
    elif msg[0] == 0xBA:
        out = bytes((0xBA, 0x11, 0)) + UNIT_SERIAL.ljust(16, b"\0")
    else:
        out = msg
    return message(out)


class Pad:
    def __init__(self):
        self.last = message(b"")

    def set(self, data):
        self.last = message(data)
        if TRACE:
            log("set " + self.last[:12].hex(" "))
        return self.last

    def get(self, rid):
        return struct.pack("<BBH64s4x", rid, 1, 64, feature(self.last))


def clamp(length):
    return max(MIN_MS, min(MAX_MS, length))


def magnitude(msg, at):
    gain = struct.unpack_from("<b", msg, at)[0]
    return min(0xFFFF, round(BASE * 10 ** (gain / 20)))


def pulses(msg):
    if msg[0] == 0x8F:
        on, off, count = struct.unpack_from("<HHH", msg, 3)
        us = on if count <= 1 else count * (on + off)
        length = clamp(math.ceil(us / 1000))
        return [(motor, length, magnitude(msg, 9)) for motor in PULSE_SIDES.get(msg[2], BOTH)]
    if msg[0] == 0xEA:
        motors = CMD_SIDES.get(msg[2], BOTH)
        if msg[3] == 0:
            return [(motor, 0, 0) for motor in motors]
        base = TICK_MS if msg[3] == 1 else CLICK_MS
        length = clamp(math.ceil(base * INTENSITY.get(msg[4], 1.0)))
        return [(motor, length, magnitude(msg, 5)) for motor in motors]
    return []


def effect(eid, length, strong):
    return struct.pack("<HhHHHHH2xHH28x", FF_RUMBLE, eid, 0, 0, 0, length, 0, strong, 0)


def input_event(kind, code, value):
    return struct.pack("<qqHHi", 0, 0, kind, code, value)


def scan():
    found = {}
    for entry in sorted(os.listdir("/sys/class/input")):
        if entry.startswith("event"):
            dev = f"/dev/input/{entry}"
            try:
                with open(f"/sys/class/input/{entry}/device/name") as f:
                    found.setdefault(f.read().strip(), dev)
            except OSError:
                pass
            try:
                node = os.readlink(f"/sys/class/input/{entry}/device/device/of_node")
            except OSError:
                continue
            found.setdefault(os.path.basename(node), dev)
    return found


class Taps:
    def __init__(self, emit):
        self.emit = emit
        self.down = None
        self.released = None
        self.first = None
        self.hold_at = None
        self.second = False

    def deadline(self):
        tap = math.inf if self.released is None else self.released + TAP_MS
        return min(tap, math.inf if self.hold_at is None else self.hold_at)

    def expire(self, now):
        if self.released is not None and now - self.released >= TAP_MS:
            at = self.released + TAP_MS
            self.released = None
            self.emit("single", at, self.first)
        if self.hold_at is not None and now >= self.hold_at:
            at = self.hold_at
            self.hold_at = None
            self.emit("hold", at, self.down)

    def key(self, value, now):
        self.expire(now)
        if value == 1 and self.down is None:
            self.down = now
            self.second = self.released is not None
            self.hold_at = None if self.second else now + HOLD_MS
            self.emit("down", now, now)
            if self.second:
                self.released = None
                self.emit("double", now, now)
        elif value == 0 and self.down is not None:
            held = now - self.down
            if not self.second and held <= TAP_MS:
                self.released = now
                self.first = self.down
            self.down = None
            self.hold_at = None


def restore_value(level, saved):
    return None if level else (saved or DEFAULT_BRIGHTNESS)


class Screen:
    def __init__(self, qam):
        self.qam = qam
        self.off = False
        self.pending = []
        self.grabbed = []

    def tap(self, kind, now):
        if self.off:
            self.wake()
        elif kind == "double":
            if not MICROSET:
                self.qam(now)
        else:
            self.sleep(now)

    def sleep(self, now):
        if MICROSET:
            self.write(POWERDOWN, BL_POWER)
        else:
            try:
                level = self.read()
            except OSError as err:
                self.say("", f"backlight: {err.strerror}")
                return
            self.save(level)
            self.write(0)
        self.off = True
        self.pending = [(name, handle, now + GRAB_WAIT_MS) for name, handle in self.inputs()]
        self.poll(now)

    def poll(self, now):
        waiting = []
        for name, handle, deadline in self.pending:
            try:
                if self.touched(handle):
                    if now < deadline:
                        waiting.append((name, handle, deadline))
                    else:
                        self.release(handle)
                        self.say("nograb", f"{name}: still in contact after {GRAB_WAIT_MS} ms, not grabbed")
                    continue
                self.grab(handle)
            except OSError as err:
                self.release(handle)
                self.say("nograb", f"{name}: grab: {err.strerror}")
                continue
            self.grabbed.append(handle)
            self.say("grab")
        self.pending = waiting

    def wake(self):
        if MICROSET:
            try:
                dark = self.read(BL_POWER) != 0
            except (OSError, ValueError):
                dark = True
            if dark:
                self.write(0, BL_POWER)
        else:
            self.write(self.load() or DEFAULT_BRIGHTNESS)
        for _, handle, _ in self.pending:
            self.release(handle)
        for handle in self.grabbed:
            self.release(handle)
        self.pending = []
        self.grabbed = []
        self.off = False
        self.unsave()
        self.say("ungrab")

    def recheck(self):
        node, dark = (BL_POWER, POWERDOWN) if MICROSET else (BACKLIGHT, 0)
        try:
            level = self.read(node)
        except OSError:
            return
        if level != dark:
            self.write(dark, node)

    def read(self, node=BACKLIGHT):
        with open(node) as f:
            return int(f.read())

    def write(self, level, node=BACKLIGHT):
        try:
            fd = os.open(node, os.O_WRONLY | os.O_TRUNC)
            try:
                os.write(fd, b"%d\n" % level)
            finally:
                os.close(fd)
        except OSError as err:
            if err.errno == EROFS:
                log("backlight is read only in this namespace, exiting for a restart")
                raise SystemExit(1)
            log(f"backlight: {err.strerror}")

    def save(self, level):
        try:
            with open(SAVED, "w") as f:
                f.write(f"{level}\n")
        except OSError as err:
            log(f"{SAVED}: {err.strerror}")

    def load(self):
        try:
            with open(SAVED) as f:
                return int(f.read())
        except (OSError, ValueError):
            return None

    def unsave(self):
        try:
            os.unlink(SAVED)
        except FileNotFoundError:
            pass

    def inputs(self):
        found = scan()
        handles = []
        for name in SCREEN_INPUTS:
            if name in found:
                try:
                    handles.append((name, os.open(found[name], os.O_RDONLY | os.O_NONBLOCK)))
                except OSError as err:
                    log(f"{name}: {err.strerror}")
        return handles

    def touched(self, fd):
        keys = bytearray(96)
        fcntl.ioctl(fd, EVIOCGKEY, keys)
        return any(keys)

    def grab(self, fd):
        fcntl.ioctl(fd, EVIOCGRAB, 1)

    def release(self, fd):
        os.close(fd)

    def say(self, word, detail=""):
        if detail:
            log(detail)


class DryScreen(Screen):
    def __init__(self, level):
        super().__init__(lambda now: print("qam"))
        self.level = level
        self.power = 0
        self.saved = None
        self.contact = False
        self.busy = False

    def read(self, node=BACKLIGHT):
        return self.power if node == BL_POWER else self.level

    def write(self, level, node=BACKLIGHT):
        if node == BL_POWER:
            self.power = level
            print(f"bl_power {level}")
        else:
            self.level = level
            print(f"bl {level}")

    def save(self, level):
        self.saved = level
        print(f"save {level}")

    def load(self):
        return self.saved

    def unsave(self):
        self.saved = None

    def inputs(self):
        return [("touch", None)]

    def touched(self, handle):
        return self.contact

    def grab(self, handle):
        if self.busy:
            raise OSError(EBUSY, os.strerror(EBUSY))

    def release(self, handle):
        pass

    def say(self, word, detail=""):
        if word:
            print(word)


class Power:
    def __init__(self, screen, qam, send):
        self.screen = screen
        self.qam = qam
        self.send = send
        self.woke = None
        self.held = False

    def state(self):
        return "state off" if self.screen.off else "state on"

    def resumed(self, now):
        self.woke = now
        self.held = self.screen.off

    def holding(self, now, linked):
        if self.held and not linked and now >= self.woke + WAKE_GRACE_MS:
            self.held = False
        return self.held

    def gesture(self, kind, at, down):
        if self.send(f"{kind} {down / 1000:.6f} {'off' if self.screen.off else 'on'}"):
            if kind == "double" and not self.screen.off and not MICROSET:
                self.qam(at)
            return
        if self.woke is not None and self.woke - WAKE_BEFORE_MS <= down <= self.woke + WAKE_GRACE_MS:
            if kind == "down" and self.screen.off:
                self.held = False
                self.screen.wake()
            return
        if kind in ("single", "double"):
            self.screen.tap(kind, at)

    def command(self, word, now):
        self.held = False
        if word == "blank":
            if self.screen.off:
                self.screen.recheck()
            else:
                self.screen.sleep(now)
        elif word == "restore":
            if self.screen.off:
                self.screen.wake()
        elif word == "qam":
            self.qam(now)
        else:
            log(f"power key helper: unknown word {word!r}")
            return
        self.send(self.state())


def cgroup(pid):
    try:
        with open(f"/proc/{pid}/cgroup") as f:
            for line in f:
                if line.startswith("0::"):
                    return line[3:].strip()
    except OSError:
        pass
    return ""


class Link:
    def __init__(self, poller):
        self.poller = poller
        self.server = None
        self.client = None
        self.refused = set()

    def listen(self):
        try:
            os.unlink(SOCKET)
        except FileNotFoundError:
            pass
        except OSError as err:
            log(f"{SOCKET}: {err.strerror}, no power key helper")
            return
        server = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET | socket.SOCK_NONBLOCK | socket.SOCK_CLOEXEC)
        try:
            server.bind(SOCKET)
            os.chmod(SOCKET, 0o666)
            server.listen(1)
        except OSError as err:
            server.close()
            log(f"{SOCKET}: {err.strerror}, no power key helper")
            return
        self.server = server
        self.poller.register(server, select.POLLIN)

    def ready(self, fd, power, now):
        if self.server is not None and fd == self.server.fileno():
            self.accept(power)
        elif self.client is not None and fd == self.client.fileno():
            self.receive(power, now)

    def accept(self, power):
        try:
            conn, _ = self.server.accept()
        except OSError:
            return
        pid, uid, _ = struct.unpack("3i", conn.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        try:
            want = pwd.getpwnam(HELPER).pw_uid
        except KeyError:
            want = None
        group = cgroup(pid)
        if uid != want or not group.endswith("/" + HELPER_UNIT):
            if (uid, group) not in self.refused:
                self.refused.add((uid, group))
                log(f"power key helper: uid {uid} in {group or 'no cgroup'} refused")
            conn.close()
            return
        self.drop()
        conn.setblocking(False)
        self.client = conn
        self.poller.register(conn, select.POLLIN)
        log("power key helper connected")
        self.send(power.state())

    def receive(self, power, now):
        try:
            data = self.client.recv(64)
        except BlockingIOError:
            return
        except OSError:
            data = b""
        if not data:
            log("power key helper gone")
            self.drop()
            return
        power.command(data.decode(errors="replace").strip(), now)

    def send(self, text):
        if self.client is None:
            return False
        try:
            self.client.send(text.encode())
        except OSError:
            log("power key helper gone")
            self.drop()
            return False
        return True

    def drop(self):
        if self.client is not None:
            self.poller.unregister(self.client)
            self.client.close()
            self.client = None


class Daemon:
    def __init__(self, hid, path):
        self.hid = hid
        self.path = path
        self.poller = select.poll()
        self.poller.register(hid, select.POLLIN | select.POLLPRI)
        self.reading = True
        self.power = None
        self.clock = False
        self.motors = {}
        self.noted = set()
        self.pad = Pad()
        self.screen = Screen(self.qam)
        self.link = Link(self.poller)
        self.keys = Power(self.screen, self.qam, self.link.send)
        self.taps = Taps(self.keys.gesture)
        self.slept = slept_ms()
        self.qam_until = 0
        self.scan_at = 0
        self.stop = False
        self.seq = 0
        self.report = bytearray(message(bytes((0x01, 0x00, 0x09, 0x40))))

    def note(self, text):
        if text not in self.noted:
            self.noted.add(text)
            log(text)

    def qam(self, now):
        self.qam_until = now + QAM_MS

    def resumed(self, now):
        slept = slept_ms()
        if slept - self.slept >= RESUME_MS:
            self.slept = slept
            self.keys.resumed(now)

    def scan(self, now):
        found = scan()
        if self.power is None and POWER in found:
            try:
                fd = os.open(found[POWER], os.O_RDONLY | os.O_NONBLOCK)
            except OSError as err:
                self.note(f"{POWER}: {err.strerror}")
            else:
                try:
                    fcntl.ioctl(fd, EVIOCGRAB, 1)
                except OSError as err:
                    os.close(fd)
                    self.note(f"{POWER}: grab: {err.strerror}")
                else:
                    try:
                        fcntl.ioctl(fd, EVIOCSCLOCKID, struct.pack("i", time.CLOCK_BOOTTIME))
                        self.clock = True
                    except OSError as err:
                        self.clock = False
                        self.note(f"{POWER}: clock: {err.strerror}, key times taken on read")
                    self.power = fd
                    self.poller.register(fd, select.POLLIN)
        for side, name in MOTORS.items():
            if side in self.motors or name not in found:
                continue
            try:
                fd = os.open(found[name], os.O_RDWR | os.O_NONBLOCK)
            except OSError as err:
                self.note(f"{name}: {err.strerror}")
                continue
            buf = bytearray(effect(-1, MIN_MS, 0))
            try:
                fcntl.ioctl(fd, EVIOCSFF, buf)
            except OSError as err:
                os.close(fd)
                self.note(f"{name}: upload: {err.strerror}")
                continue
            self.motors[side] = (fd, struct.unpack_from("<h", buf, 2)[0])
        missing = self.power is None or len(self.motors) < len(MOTORS)
        self.scan_at = now + SCAN_MS if missing else math.inf

    def play(self, side, length, strong):
        if side not in self.motors:
            return
        fd, eid = self.motors[side]
        try:
            if length:
                fcntl.ioctl(fd, EVIOCSFF, effect(eid, length, strong))
            os.write(fd, input_event(EV_FF, eid, 1 if length else 0))
        except OSError as err:
            if err.errno != ENODEV:
                self.note(f"{MOTORS[side]}: {err.strerror}")
                return
            self.drop(fd)
            del self.motors[side]
            self.scan_at = ms()

    def drop(self, fd):
        try:
            self.poller.unregister(fd)
        except KeyError:
            pass
        os.close(fd)

    def resume_reading(self):
        if not self.reading:
            self.reading = True
            self.poller.modify(self.hid, select.POLLIN | select.POLLPRI)

    def hid_events(self, mask):
        if mask & select.POLLPRI:
            self.resume_reading()
        while self.reading:
            try:
                data = os.read(self.hid, 64)
            except BlockingIOError:
                break
            except OSError:
                self.reading = False
                self.poller.modify(self.hid, select.POLLPRI)
                break
            for side, length, strong in pulses(self.pad.set(data)):
                self.play(side, length, strong)
        if mask & select.POLLPRI:
            rid = bytearray(1)
            try:
                fcntl.ioctl(self.hid, GADGET_HID_READ_GET_REPORT_ID, rid)
                fcntl.ioctl(self.hid, GADGET_HID_WRITE_GET_REPORT, self.pad.get(rid[0]))
            except OSError as err:
                self.note(f"{self.path}: get report: {err.strerror}")

    def power_events(self):
        try:
            data = os.read(self.power, 24 * 32)
        except BlockingIOError:
            return
        except OSError as err:
            self.note(f"{POWER}: {err.strerror}")
            self.drop(self.power)
            self.power = None
            self.scan_at = ms()
            return
        now = ms()
        for at in range(0, len(data) - 23, 24):
            sec, usec, kind, code, value = struct.unpack_from("<qqHHi", data, at)
            if kind == EV_KEY and code == KEY_POWER and value in (0, 1):
                self.taps.key(value, sec * 1000 + usec / 1000 if self.clock else now)

    def send(self, now):
        self.seq = (self.seq + 1) & 0xFFFFFFFF
        struct.pack_into("<I", self.report, 4, self.seq)
        self.report[14] = 0x04 if now < self.qam_until else 0
        try:
            os.write(self.hid, self.report)
        except BlockingIOError:
            pass
        except OSError as err:
            if err.errno == ESHUTDOWN:
                return
            self.note(f"{self.path}: {err.strerror}")
        self.resume_reading()

    def run(self):
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, "stop", True))
        self.link.listen()
        report_at = grab_at = check_at = ms()
        while not self.stop:
            now = ms()
            self.resumed(now)
            if now >= self.scan_at:
                self.scan(now)
            self.taps.expire(now)
            if self.screen.pending and now >= grab_at:
                self.screen.poll(now)
                grab_at = now + GRAB_POLL_MS
            if self.screen.off and now >= check_at:
                if not self.keys.holding(now, self.link.client is not None):
                    self.screen.recheck()
                check_at = now + RECHECK_MS
            if now >= report_at:
                self.send(now)
                report_at = report_at + REPORT_MS if report_at + REPORT_MS > now else now + REPORT_MS
            deadlines = [report_at, self.scan_at, self.taps.deadline()]
            if self.screen.pending:
                deadlines.append(grab_at)
            if self.screen.off:
                deadlines.append(check_at)
            timeout = max(0, math.ceil(min(deadlines) - ms()))
            ready = self.poller.poll(timeout)
            self.resumed(ms())
            for fd, mask in ready:
                if fd == self.hid:
                    self.hid_events(mask)
                elif fd == self.power:
                    self.power_events()
                else:
                    self.link.ready(fd, self.keys, ms())
        if self.screen.off:
            self.screen.wake()
        os.close(self.hid)
        return 0


def restore(screen):
    try:
        if screen.read(BL_POWER):
            screen.write(0, BL_POWER)
    except (OSError, ValueError):
        pass
    try:
        level = screen.read()
    except (OSError, ValueError):
        return 0
    value = restore_value(level, screen.load())
    if value is not None:
        screen.write(value)
        screen.unsave()
    return 0


def put(path, value):
    try:
        with open(path, "wb") as f:
            f.write(value if isinstance(value, bytes) else f"{value}\n".encode())
    except OSError as err:
        raise OSError(err.errno, err.strerror, path)


def children(path):
    try:
        return [f"{path}/{name}" for name in sorted(os.listdir(path))]
    except FileNotFoundError:
        return []


def modprobe(*args):
    if os.spawnvp(os.P_WAIT, MODPROBE, [MODPROBE, *args]):
        log(f"modprobe {' '.join(args)} failed")
        return False
    return True


def dummy_udc():
    for path in children(f"{SYSCLASS}/udc"):
        name = os.path.basename(path)
        if name.startswith("dummy_udc"):
            return name
    return None


def teardown():
    if not os.path.isdir(GADGET):
        return
    try:
        with open(f"{GADGET}/UDC") as f:
            bound = f.read().strip()
    except FileNotFoundError:
        bound = ""
    if bound:
        put(f"{GADGET}/UDC", "")
    for config in children(f"{GADGET}/configs"):
        for path in children(config):
            if os.path.islink(path):
                os.unlink(path)
        for path in children(f"{config}/strings"):
            os.rmdir(path)
        os.rmdir(config)
    for path in children(f"{GADGET}/functions") + children(f"{GADGET}/strings"):
        os.rmdir(path)
    os.rmdir(GADGET)


def gadget_start():
    try:
        teardown()
    except OSError as err:
        log(f"{err.filename}: {err.strerror}")
        return 1
    if not modprobe("dummy_hcd", "tick_us=1000"):
        return 1
    try:
        with open(f"{SYSMODULE}/dummy_hcd/parameters/tick_us") as f:
            tick = f.read().strip()
    except OSError as err:
        log(f"{err.filename}: {err.strerror}")
        return 1
    if tick != "1000":
        log(f"dummy_hcd runs with tick_us {tick}, not 1000")
        return 1
    udc = dummy_udc()
    if udc is None:
        log(f"no dummy_udc in {SYSCLASS}/udc after modprobe")
        return 1
    config = f"{GADGET}/configs/c.1"
    try:
        os.mkdir(GADGET)
        os.mkdir(f"{GADGET}/strings/0x409")
        os.mkdir(config)
        for name, value in (("idVendor", "0x28de"), ("idProduct", "0x1205"), ("bcdDevice", "0x0300"), ("bcdUSB", "0x0200")):
            put(f"{GADGET}/{name}", value)
        for name, value in (("manufacturer", "Valve Software"), ("product", "Steam Deck Controller"),
                            ("serialnumber", UNIT_SERIAL.decode())):
            put(f"{GADGET}/strings/0x409/{name}", value)
        for name, desc, length in FUNCTIONS:
            function = f"{GADGET}/functions/{name}"
            os.mkdir(function)
            put(f"{function}/report_length", length)
            put(f"{function}/report_desc", desc)
            put(f"{function}/no_out_endpoint", 1)
            os.symlink(function, f"{config}/{name}")
        put(f"{GADGET}/UDC", udc)
    except OSError as err:
        log(f"{err.filename}: {err.strerror}")
        try:
            teardown()
        except OSError as err:
            log(f"{err.filename}: {err.strerror}")
        return 1
    log(f"bound to {udc}")
    return 0


def gadget_stop():
    try:
        teardown()
    except OSError as err:
        log(f"{err.filename}: {err.strerror}")
        return 1
    if not os.path.isdir(f"{SYSMODULE}/dummy_hcd"):
        return 0
    return 0 if modprobe("-r", "dummy_hcd") else 1


def hid_node():
    with open(f"{GADGET}/functions/hid.ctl/dev") as f:
        want = f.read().strip()
    for path in children(f"{SYSCLASS}/hidg"):
        with open(f"{path}/dev") as f:
            if f.read().strip() == want:
                return f"/dev/{os.path.basename(path)}"
    return None


def dryrun(mode, args):
    if mode == "1":
        print(GADGET_HID_READ_GET_REPORT_ID, GADGET_HID_WRITE_GET_REPORT, EVIOCSFF, EVIOCGRAB, EVIOCGKEY, EVIOCSCLOCKID,
              len(effect(-1, 0, 0)), len(input_event(0, 0, 0)), DESC.hex(), KEYBOARD.hex())
    elif mode == "hid":
        pad = Pad()
        for arg in args:
            name, _, value = arg.partition("=")
            if name == "set":
                print(pad.set(bytes.fromhex(value)).hex())
            elif name == "get":
                print(pad.get(int(value)).hex())
    elif mode == "feature":
        pad = Pad()
        for arg in args:
            pad.set(bytes.fromhex(arg))
            print(pad.get(0)[4:68].hex())
    elif mode == "node":
        print(hid_node())
    elif mode == "haptic":
        for arg in args:
            for side, length, strong in pulses(message(bytes.fromhex(arg))):
                print(side, length, strong)
    elif mode == "keys":
        taps = Taps(lambda kind, at, down: print(kind, at, down))
        for item in " ".join(args).split():
            at, value = item.split(":")
            taps.key(int(value), int(at))
        taps.expire(math.inf)
    elif mode == "power":
        screen = DryScreen(int(args[0]))
        helper = []

        def send(text):
            if helper:
                print(f"send {text}")
            return bool(helper)

        power = Power(screen, screen.qam, send)
        taps = Taps(power.gesture)
        for item in " ".join(args[1:]).split():
            name, _, value = item.partition("=")
            if name == "helper":
                helper[:] = [True] if value == "1" else []
            elif name == "key":
                at, down = value.split(":")
                taps.key(int(down), int(at))
            elif name == "at":
                taps.expire(int(value))
            elif name == "word":
                power.command(value, 0)
            elif name == "bl":
                screen.level = int(value)
            elif name == "blp":
                screen.power = int(value)
            elif name == "resume":
                power.resumed(int(value))
            elif name == "check":
                if screen.off and not power.holding(int(value), bool(helper)):
                    screen.recheck()
        taps.expire(math.inf)
    elif mode == "link":
        sys.stdout.reconfigure(line_buffering=True)
        poller = select.poll()
        link = Link(poller)
        link.listen()
        if link.server is None:
            return 1
        screen = DryScreen(int(args[0]))
        power = Power(screen, screen.qam, link.send)
        taps = Taps(power.gesture)
        poller.register(0, select.POLLIN)
        print("ready")
        pending = b""
        while True:
            for fd, _ in poller.poll():
                if fd != 0:
                    link.ready(fd, power, 0)
                    continue
                data = os.read(0, 4096)
                if not data:
                    return 0
                *lines, pending = (pending + data).split(b"\n")
                for words in (line.split() for line in lines):
                    if words[0] == b"key":
                        taps.key(int(words[2]), int(words[1]))
                    elif words[0] == b"at":
                        taps.expire(int(words[1]))
    elif mode == "screen":
        screen = DryScreen(int(args[0]))
        now = 0
        for item in " ".join(args[1:]).split():
            name, _, value = item.partition("=")
            if name in ("single", "double"):
                screen.tap(name, now)
            elif name == "bl":
                screen.level = int(value)
                if screen.off:
                    screen.recheck()
            elif name == "touch":
                screen.contact = value == "1"
            elif name == "ebusy":
                screen.busy = True
            elif name == "wait":
                now += int(value)
            if screen.pending:
                screen.poll(now)
    elif mode == "restore":
        value = restore_value(int(args[0]), None if args[1] == "none" else int(args[1]))
        if value is not None:
            print(value)
    elif mode == "stop":
        screen = DryScreen(int(args[0]))
        screen.saved = None if args[1] == "none" else int(args[1])
        screen.power = int(args[2])
        restore(screen)
    elif mode == "resume":
        daemon = Daemon(os.open(os.devnull, os.O_WRONLY), os.devnull)
        daemon.slept -= int(args[0])
        daemon.resumed(5)
        print(daemon.keys.woke)
    elif mode == "qam":
        daemon = Daemon(os.open(os.devnull, os.O_WRONLY), os.devnull)
        daemon.keys.command("qam", int(args[0]))
        for at in args[1:]:
            daemon.send(int(at))
            print(at, daemon.report[14])
    else:
        log(f"unknown MICROOS_VPAD_DRYRUN {mode}")
        return 2
    return 0


def main():
    mode = os.environ.get("MICROOS_VPAD_DRYRUN")
    if mode:
        return dryrun(mode, sys.argv[1:])
    if sys.argv[1:] == ["restore"]:
        return restore(Screen(None))
    if sys.argv[1:] == ["gadget", "start"]:
        return gadget_start()
    if sys.argv[1:] == ["gadget", "stop"]:
        return gadget_stop()
    if sys.argv[1:2] == ["gadget"]:
        log("usage: microos-vpad gadget start|stop")
        return 2
    try:
        path = hid_node()
    except OSError as err:
        log(f"{err.filename}: {err.strerror}")
        return 1
    if path is None:
        log(f"no {SYSCLASS}/hidg entry for {GADGET}/functions/hid.ctl")
        return 1
    try:
        hid = os.open(path, os.O_RDWR | os.O_NONBLOCK)
    except OSError as err:
        log(f"{path}: {err.strerror}")
        return 1
    return Daemon(hid, path).run()


sys.exit(main())
