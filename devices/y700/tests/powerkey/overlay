#!/usr/bin/env python3
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

NAME = "net.seilent.MicroSet.Overlay"
PATH = "/net/seilent/MicroSet/Overlay"
XML = '<node><interface name="net.seilent.MicroSet.Overlay1"><method name="Toggle"/></interface></node>'
LOG = sys.argv[1]
hang = sys.argv[2:] == ["hang"]
held = []


def record(line):
    with open(LOG, "a") as f:
        f.write(line + "\n")


def method(_conn, _sender, _path, _iface, name, _params, invocation):
    record(name)
    if hang:
        held.append(invocation)
        return
    invocation.return_value(None)


bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
bus.register_object_with_closures2(PATH, Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0], method, None, None)
Gio.bus_own_name_on_connection(bus, NAME, Gio.BusNameOwnerFlags.NONE, lambda *_: record("ready"), None)
GLib.MainLoop().run()
