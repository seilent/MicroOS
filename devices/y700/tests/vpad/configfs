#!/usr/bin/env python3
import builtins
import errno
import os
import runpy
import sys

open = builtins.open
mkdir = os.mkdir
rmdir = os.rmdir
symlink = os.symlink
GROUPS = {"usb_gadget": ("configs", "functions", "strings"), "configs": ("strings",)}


class FailedWrite:
    def __enter__(self):
        return self

    def __exit__(self, *_):
        raise OSError(errno.ENODEV, os.strerror(errno.ENODEV))

    def write(self, data):
        return len(data)


def configfs_open(path, mode="r", *args, **kwargs):
    if "w" in mode and os.path.basename(path) == os.environ.get("FAKE_WRITE_FAIL"):
        return FailedWrite()
    return open(path, mode, *args, **kwargs)


def configfs_mkdir(path, mode=0o777):
    mkdir(path, mode)
    for name in GROUPS.get(os.path.basename(os.path.dirname(path)), ()):
        mkdir(os.path.join(path, name))


def configfs_rmdir(path):
    for entry in os.scandir(path):
        if entry.is_file(follow_symlinks=False):
            os.unlink(entry.path)
        elif entry.is_dir(follow_symlinks=False) and not os.listdir(entry.path):
            rmdir(entry.path)
    rmdir(path)


def logged_symlink(target, link):
    name = os.path.basename(link)
    if name == os.environ.get("FAKE_LINK_FAIL"):
        raise OSError(errno.EIO, os.strerror(errno.EIO), link)
    with open(os.path.join(os.environ["FAKE_STATE"], "links.log"), "a") as f:
        f.write(f"{name}\n")
    symlink(target, link)


builtins.open = configfs_open
os.mkdir = configfs_mkdir
os.rmdir = configfs_rmdir
os.symlink = logged_symlink
sys.argv = sys.argv[1:]
runpy.run_path(sys.argv[0], run_name="__main__")
