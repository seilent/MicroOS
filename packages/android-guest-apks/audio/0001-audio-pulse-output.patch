+static void context_failed(struct alsa_audio_device *adev, int error)
+{
+    if (adev->context) {
+        pa_context_set_state_callback(adev->context, NULL, NULL);
+        pa_context_unref(adev->context);
+        adev->context = NULL;
+    }
+    if (!adev->failing) {
+        adev->failing = true;
+        adev->failed_attempts = 0;
+        adev->last_report = pa_rtclock_now();
+        ALOGE("pulse: %s, reconnecting", pa_strerror(error));
+    }
+}
+
+static void context_state_cb(pa_context *c, void *userdata)
+{
+    struct alsa_audio_device *adev = userdata;
+
+    if (!adev->loop_rt) {
+        adev->loop_rt = true;
+        set_fifo("pulse loop");
+    }
+    switch (pa_context_get_state(c)) {
+    case PA_CONTEXT_READY:
+        if (adev->failing)
+            ALOGI("pulse: connected after %u attempts", adev->failed_attempts);
+        adev->failing = false;
+        break;
+    case PA_CONTEXT_FAILED:
+    case PA_CONTEXT_TERMINATED:
+        if (c == adev->context)
+            context_failed(adev, pa_context_errno(c));
+        break;
+    default:
+        break;
+    }
+    pa_threaded_mainloop_signal(adev->loop, 0);
+}
+
+static void connect_cb(pa_mainloop_api *api, pa_defer_event *e, void *userdata)
+{
+    struct alsa_audio_device *adev = userdata;
+    pa_usec_t now = pa_rtclock_now();
+    pa_proplist *props;
+    pa_context *c;
+    char value[32];
+
+    api->defer_enable(e, 0);
+    adev->connecting = false;
+    pa_threaded_mainloop_signal(adev->loop, 0);
+    if (adev->context)
+        return;
+    adev->attempts++;
+    adev->last_attempt = now;
+    if (adev->failing) {
+        adev->failed_attempts++;
+        if (now - adev->last_report >= PLAYBACK_REPORT_INTERVAL_USEC) {
+            adev->last_report = now;
+            ALOGW("pulse: still down after %u attempts", adev->failed_attempts);
         }
     }
+    props = pa_proplist_new();
+    snprintf(value, sizeof(value), "%u/%u", adev->period, PLAYBACK_CODEC_SAMPLING_RATE);
+    pa_proplist_sets(props, "pulse.min.req", value);
+    pa_proplist_sets(props, "pulse.min.quantum", value);
+    c = pa_context_new_with_proplist(api, "Waydroid", props);
+    pa_proplist_free(props);
+    if (!c) {
+        context_failed(adev, PA_ERR_INTERNAL);
+        return;
+    }
+    adev->context = c;
+    pa_context_set_state_callback(c, context_state_cb, adev);
+    if (pa_context_connect(c, NULL, PA_CONTEXT_NOAUTOSPAWN, NULL) < 0 && adev->context == c)
+        context_failed(adev, pa_context_errno(c));
+}
 
