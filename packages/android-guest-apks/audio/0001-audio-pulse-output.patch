+static bool stream_wait(struct alsa_stream_out *out, pa_usec_t deadline)
+{
+    struct alsa_audio_device *adev = out->dev;
+    pa_context_state_t state;
+
+    if (pa_rtclock_now() >= deadline)
+        return false;
+    if (out->s) {
+        if (pa_stream_get_state(out->s) != PA_STREAM_CREATING)
+            return false;
+    } else if (adev->context) {
+        state = pa_context_get_state(adev->context);
+        if (state == PA_CONTEXT_READY || !PA_CONTEXT_IS_GOOD(state))
+            return false;
+    } else if (!adev->connecting) {
+        return false;
     }
+    if (adev->context) {
+        if (out->bound)
+            pa_context_rttime_restart(adev->context, out->bound, deadline);
+        else
+            out->bound = pa_context_rttime_new(adev->context, deadline, bound_cb, out);
+        if (!out->bound)
+            return false;
+    }
+    pa_threaded_mainloop_wait(adev->loop);
+    if (out->bound)
+        adev->api->time_restart(out->bound, NULL);
+    return true;
+}
 
