+        if (n == (size_t)-1)
+            break;
+        if (n > left)
+            n = left;
+        n -= n % frame_size;
+        if (n) {
+            if (pa_stream_write(out->s, data, n, NULL, 0, PA_SEEK_RELATIVE) < 0)
