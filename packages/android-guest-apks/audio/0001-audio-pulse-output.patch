+static void update_stats(struct alsa_stream_out *out, size_t frames, size_t dropped, bool stalled)
+{
+    struct out_stats *st = &out->stats;
+    pa_usec_t latency = 0;
+    int negative = 0;
+    bool have = false;
+
+    if (out->s && pa_stream_get_state(out->s) == PA_STREAM_READY)
+        have = pa_stream_get_latency(out->s, &latency, &negative) == 0;
+    pthread_mutex_lock(&out->stats_lock);
+    if (out->restarted) {
+        st->render_base = st->presented;
+        out->restarted = false;
     }
+    st->written += frames;
+    st->dropped += dropped;
+    st->stalls += stalled;
+    st->reconnects = out->dev->attempts ? out->dev->attempts - 1 : 0;
+    if (have) {
+        st->latency = negative ? 0 : latency;
+        st->valid = true;
+    }
+    if (st->valid) {
+        uint64_t pending = st->latency * out->config.rate / PA_USEC_PER_SEC;
+        uint64_t presented = st->written > pending ? st->written - pending : 0;
 
-    if (snd_pcm_state(out->pcm) != SND_PCM_STATE_PREPARED) {
-        ALOGE("cannot open pcm_out driver");
-        snd_pcm_close(out->pcm);
-        adev->active_output = NULL;
-        return -ENODEV;
+        if (presented > st->presented)
+            st->presented = presented;
+        clock_gettime(CLOCK_MONOTONIC, &st->time);
     }
+    pthread_mutex_unlock(&out->stats_lock);
+}
 
