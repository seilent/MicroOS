+    size_t left = bytes;
+    pa_operation *o;
+
+    if (out->corked) {
+        o = pa_stream_cork(out->s, 0, NULL, NULL);
+        if (o)
+            pa_operation_unref(o);
+        out->corked = false;
+        out->started = false;
