+static bool stream_ready(struct alsa_stream_out *out)
+{
+    struct alsa_audio_device *adev = out->dev;
+
+    if (out->s) {
+        switch (pa_stream_get_state(out->s)) {
+        case PA_STREAM_READY:
+            if (out->stream_failing)
+                ALOGI("pulse stream: open again");
+            out->stream_failing = false;
+            return true;
+        case PA_STREAM_UNCONNECTED:
+        case PA_STREAM_CREATING:
+            return false;
+        default:
+            if (!out->stream_failing && pa_stream_get_state(out->s) == PA_STREAM_FAILED && adev->context &&
+                    pa_context_get_state(adev->context) == PA_CONTEXT_READY) {
+                out->stream_failing = true;
+                ALOGE("pulse stream: %s, reopening", pa_strerror(pa_context_errno(adev->context)));
+            }
+            stream_close(out);
+            break;
+        }
+    }
+    if (!adev->context || pa_context_get_state(adev->context) != PA_CONTEXT_READY) {
+        want_context(adev);
+        return false;
     }
+    stream_open(out);
+    return false;
+}
 
