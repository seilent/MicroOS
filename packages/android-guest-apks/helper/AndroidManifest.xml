<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.seilent.microos.helper"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name="net.seilent.microos.helper.HelperApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:persistent="true"
        android:theme="@android:style/Theme.DeviceDefault.Settings">

        <service
            android:name="net.seilent.microos.helper.InternetTile"
            android:exported="true"
            android:icon="@drawable/ic_wifi_signal_4"
            android:label="@string/internet"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name="net.seilent.microos.helper.BluetoothTile"
            android:exported="true"
            android:icon="@drawable/ic_qs_bluetooth"
            android:label="@string/bluetooth"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <activity
            android:name="net.seilent.microos.helper.TilePrefsActivity"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <activity
            android:name="net.seilent.microos.helper.WifiActivity"
            android:exported="false"
            android:label="@string/internet" />

        <activity
            android:name="net.seilent.microos.helper.BluetoothActivity"
            android:exported="false"
            android:label="@string/bluetooth" />
    </application>
</manifest>
