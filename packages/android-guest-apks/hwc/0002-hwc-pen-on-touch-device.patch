From 1bda6f34f4a194e6f31dc694faa2f4741708b6a5 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Wed, 25 Nov 2026 13:35:13 +0900
Subject: [PATCH] hwcomposer: report tablet tools as pens on the touch device

---
 hwcomposer/wayland-hwc.cpp | 264 ++++++++++---------------------------
 hwcomposer/wayland-hwc.h   |  10 +-
 2 files changed, 75 insertions(+), 199 deletions(-)

diff --git a/hwcomposer/wayland-hwc.cpp b/hwcomposer/wayland-hwc.cpp
index d1e46ab..f4045b7 100644
--- a/hwcomposer/wayland-hwc.cpp
+++ b/hwcomposer/wayland-hwc.cpp
@@ -1142,16 +1142,18 @@ touch_handle_down(void *data, struct wl_touch *,
           int32_t id, wl_fixed_t x_w, wl_fixed_t y_w)
 {
     if (!surface) {
-        // The surface this down event corresponds to was already destroyed
         return;
     }
 
     struct display* display = (struct display*)data;
-    struct input_event event[6];
+    struct input_event event[7];
     struct timespec rt;
     int x, y;
     unsigned int res, n = 0;
 
+    if (display->tablet_down)
+        return;
+
     if (ensure_pipe(display, INPUT_TOUCH))
         return;
 
@@ -1173,6 +1175,7 @@ touch_handle_down(void *data, struct wl_touch *,
 
     ADD_EVENT(EV_ABS, ABS_MT_SLOT, touch_id);
     ADD_EVENT(EV_ABS, ABS_MT_TRACKING_ID, touch_id);
+    ADD_EVENT(EV_ABS, ABS_MT_TOOL_TYPE, MT_TOOL_FINGER);
     ADD_EVENT(EV_ABS, ABS_MT_POSITION_X, x);
     ADD_EVENT(EV_ABS, ABS_MT_POSITION_Y, y);
     ADD_EVENT(EV_ABS, ABS_MT_PRESSURE, 50);
@@ -1278,19 +1281,16 @@ touch_handle_cancel(void *data, struct wl_touch *)
             __FILE__, __LINE__, strerror(errno));
     }
 
-    // Cancel all touch points.
     for (i = 0; i < MAX_TOUCHPOINTS; i++) {
-        if (display->touch_id[i] != -1) {
+        if (display->touch_id[i] != -1 && display->touch_id[i] != TABLET_TOUCH_ID) {
             id = display->touch_id[i];
             display->touch_id[i] = -1;
             display->touch_surfaces[id] = NULL;
 
             n = 0;
-            // Turn finger into palm.
             ADD_EVENT(EV_ABS, ABS_MT_SLOT, i);
             ADD_EVENT(EV_ABS, ABS_MT_TOOL_TYPE, MT_TOOL_PALM);
             ADD_EVENT(EV_SYN, SYN_REPORT, 0);
-            // Lift off.
             ADD_EVENT(EV_ABS, ABS_MT_TOOL_TYPE, MT_TOOL_FINGER);
             ADD_EVENT(EV_ABS, ABS_MT_TRACKING_ID, -1);
             ADD_EVENT(EV_SYN, SYN_REPORT, 0);
@@ -1519,40 +1519,8 @@ static void tablet_seat_handle_add_pad(void*, struct zwp_tablet_seat_v2 *,
 }
 
 static void
-tablet_tool_receive_type(void *data, struct zwp_tablet_tool_v2 *tool,
-                         uint32_t type)
+tablet_tool_receive_type(void *, struct zwp_tablet_tool_v2 *, uint32_t)
 {
-    struct display* display = (struct display*)data;
-    uint16_t evt_code;
-    switch(type) {
-        case ZWP_TABLET_TOOL_V2_TYPE_PEN:
-            evt_code = BTN_TOOL_PEN;
-            break;
-        case ZWP_TABLET_TOOL_V2_TYPE_ERASER:
-            evt_code = BTN_TOOL_RUBBER;
-            break;
-        case ZWP_TABLET_TOOL_V2_TYPE_BRUSH:
-            evt_code = BTN_TOOL_BRUSH;
-            break;
-        case ZWP_TABLET_TOOL_V2_TYPE_PENCIL:
-            evt_code = BTN_TOOL_PENCIL;
-            break;
-        case ZWP_TABLET_TOOL_V2_TYPE_AIRBRUSH:
-            evt_code = BTN_TOOL_AIRBRUSH;
-            break;
-        case ZWP_TABLET_TOOL_V2_TYPE_FINGER:
-            evt_code = BTN_TOOL_FINGER;
-            break;
-        case ZWP_TABLET_TOOL_V2_TYPE_MOUSE:
-            evt_code = BTN_TOOL_MOUSE;
-            break;
-        case ZWP_TABLET_TOOL_V2_TYPE_LENS:
-            evt_code = BTN_TOOL_LENS;
-            break;
-        default:
-            evt_code = BTN_DIGI;
-    }
-    display->tablet_tools_evt[tool] = evt_code;
 }
 
 static void
@@ -1578,110 +1546,68 @@ tablet_tool_receive_done(void *, struct zwp_tablet_tool_v2 *)
 }
 
 static void
-tablet_tool_receive_removed(void *, struct zwp_tablet_tool_v2 *)
-{
-}
-
-static void
-tablet_tool_proximity_in(void *data, struct zwp_tablet_tool_v2 *tool,
+tablet_tool_proximity_in(void *data, struct zwp_tablet_tool_v2 *,
                          uint32_t, struct zwp_tablet_v2 *,
                          struct wl_surface *surface)
 {
     struct display* display = (struct display*)data;
-    struct input_event event[2];
-    struct timespec rt;
-    unsigned int res, n = 0;
-
-    if (ensure_pipe(display, INPUT_TABLET))
-        return;
 
     display->tablet_surface = surface;
-
-    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
-        ALOGE("%s:%d error in touch clock_gettime: %s",
-              __FILE__, __LINE__, strerror(errno));
-    }
-
-    ADD_EVENT(EV_KEY, display->tablet_tools_evt[tool], 1);
-    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
-
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
-    if (res < sizeof(event))
-        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
 }
 
 static void
-tablet_tool_proximity_out(void *data, struct zwp_tablet_tool_v2 *tool)
+tablet_tool_proximity_out(void *data, struct zwp_tablet_tool_v2 *)
 {
     struct display* display = (struct display*)data;
-    struct input_event event[2];
+    struct input_event event[3];
     struct timespec rt;
     unsigned int res, n = 0;
 
-    if (ensure_pipe(display, INPUT_TABLET))
+    display->tablet_surface = NULL;
+    display->tablet_down = false;
+
+    int touch_id = flush_touch_id(display, TABLET_TOUCH_ID);
+    if (touch_id == -1)
         return;
 
-    display->tablet_surface = NULL;
+    if (ensure_pipe(display, INPUT_TOUCH))
+        return;
 
     if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
         ALOGE("%s:%d error in touch clock_gettime: %s",
               __FILE__, __LINE__, strerror(errno));
     }
 
-    ADD_EVENT(EV_KEY, display->tablet_tools_evt[tool], 0);
+    ADD_EVENT(EV_ABS, ABS_MT_SLOT, touch_id);
+    ADD_EVENT(EV_ABS, ABS_MT_TRACKING_ID, -1);
     ADD_EVENT(EV_SYN, SYN_REPORT, 0);
 
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
+    res = write(display->input_fd[INPUT_TOUCH], &event, sizeof(event));
     if (res < sizeof(event))
         ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
 }
 
+static void
+tablet_tool_receive_removed(void *data, struct zwp_tablet_tool_v2 *tool)
+{
+    tablet_tool_proximity_out(data, tool);
+}
+
 static void
 tablet_tool_down(void *data, struct zwp_tablet_tool_v2 *, uint32_t)
 {
     struct display* display = (struct display*)data;
-    struct input_event event[2];
-    struct timespec rt;
-    unsigned int res, n = 0;
-
-    if (ensure_pipe(display, INPUT_TABLET))
-        return;
-
-    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
-        ALOGE("%s:%d error in touch clock_gettime: %s",
-              __FILE__, __LINE__, strerror(errno));
-    }
-
-    ADD_EVENT(EV_KEY, BTN_TOUCH, 1);
-    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
 
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
-    if (res < sizeof(event))
-        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
+    display->tablet_down = true;
+    touch_handle_cancel(data, NULL);
 }
 
 static void
 tablet_tool_up(void *data, struct zwp_tablet_tool_v2 *)
 {
     struct display* display = (struct display*)data;
-    struct input_event event[2];
-    struct timespec rt;
-    unsigned int res, n = 0;
-
-    if (ensure_pipe(display, INPUT_TABLET))
-        return;
 
-    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
-        ALOGE("%s:%d error in touch clock_gettime: %s",
-              __FILE__, __LINE__, strerror(errno));
-    }
-
-    ADD_EVENT(EV_KEY, BTN_TOUCH, 0);
-    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
-
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
-    if (res < sizeof(event))
-        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
+    display->tablet_down = false;
 }
 
 static void
@@ -1689,35 +1615,17 @@ tablet_tool_motion(void *data, struct zwp_tablet_tool_v2 *,
                    wl_fixed_t x_w, wl_fixed_t y_w)
 {
     struct display* display = (struct display*)data;
-    struct input_event event[3];
-    struct timespec rt;
     int x, y;
-    unsigned int res, n = 0;
 
     if (display->tablet_surface) {
-        if (ensure_pipe(display, INPUT_TABLET))
-            return;
-
-        if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
-            ALOGE("%s:%d error in touch clock_gettime: %s",
-                  __FILE__, __LINE__, strerror(errno));
-        }
         x = wl_fixed_to_int(x_w);
         y = wl_fixed_to_int(y_w);
         if (display->scale != 1) {
             x = int(x * display->scale);
             y = int(y * display->scale);
         }
-        x += display->layers[display->tablet_surface].x;
-        y += display->layers[display->tablet_surface].y;
-
-        ADD_EVENT(EV_ABS, ABS_X, x);
-        ADD_EVENT(EV_ABS, ABS_Y, y);
-        ADD_EVENT(EV_SYN, SYN_REPORT, 0);
-
-        res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
-        if (res < sizeof(event))
-            ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
+        display->tablet_x = x + display->layers[display->tablet_surface].x;
+        display->tablet_y = y + display->layers[display->tablet_surface].y;
     }
 }
 
@@ -1726,78 +1634,18 @@ tablet_tool_pressure(void *data, struct zwp_tablet_tool_v2 *,
                      uint32_t pressure)
 {
     struct display* display = (struct display*)data;
-    struct input_event event[2];
-    struct timespec rt;
-    unsigned int res, n = 0;
-
-    if (ensure_pipe(display, INPUT_TABLET))
-        return;
-
-    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
-        ALOGE("%s:%d error in touch clock_gettime: %s",
-              __FILE__, __LINE__, strerror(errno));
-    }
-
-    // wayland value is 16 bits. android expects 8 bits max.
-    pressure >>= 8;
-
-    ADD_EVENT(EV_ABS, ABS_PRESSURE, pressure);
-    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
 
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
-    if (res < sizeof(event))
-        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
+    display->tablet_pressure = pressure >> 8;
 }
 
 static void
-tablet_tool_distance(void *data, struct zwp_tablet_tool_v2 *,
-                     uint32_t distance_raw)
+tablet_tool_distance(void *, struct zwp_tablet_tool_v2 *, uint32_t)
 {
-    struct display* display = (struct display*)data;
-    struct input_event event[2];
-    struct timespec rt;
-    unsigned int res, n = 0;
-
-    if (ensure_pipe(display, INPUT_TABLET))
-        return;
-
-    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
-        ALOGE("%s:%d error in touch clock_gettime: %s",
-              __FILE__, __LINE__, strerror(errno));
-    }
-
-    ADD_EVENT(EV_ABS, ABS_DISTANCE, distance_raw);
-    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
-
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
-    if (res < sizeof(event))
-        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
 }
 
 static void
-tablet_tool_tilt(void *data, struct zwp_tablet_tool_v2 *,
-                 wl_fixed_t tilt_x, wl_fixed_t tilt_y)
+tablet_tool_tilt(void *, struct zwp_tablet_tool_v2 *, wl_fixed_t, wl_fixed_t)
 {
-    struct display* display = (struct display*)data;
-    struct input_event event[3];
-    struct timespec rt;
-    unsigned int res, n = 0;
-
-    if (ensure_pipe(display, INPUT_TABLET))
-        return;
-
-    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
-       ALOGE("%s:%d error in touch clock_gettime: %s",
-            __FILE__, __LINE__, strerror(errno));
-    }
-
-    ADD_EVENT(EV_ABS, ABS_TILT_X, wl_fixed_to_int(tilt_x));
-    ADD_EVENT(EV_ABS, ABS_TILT_Y, wl_fixed_to_int(tilt_y));
-    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
-
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
-    if (res < sizeof(event))
-        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
 }
 
 static void
@@ -1820,11 +1668,11 @@ tablet_tool_button_state(void *data, struct zwp_tablet_tool_v2 *,
                          uint32_t, uint32_t button, uint32_t state)
 {
     struct display* display = (struct display*)data;
-    struct input_event event[2];
+    struct input_event event[1];
     struct timespec rt;
     unsigned int res, n = 0;
 
-    if (ensure_pipe(display, INPUT_TABLET))
+    if (ensure_pipe(display, INPUT_TOUCH))
         return;
 
     if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
@@ -1833,16 +1681,46 @@ tablet_tool_button_state(void *data, struct zwp_tablet_tool_v2 *,
     }
 
     ADD_EVENT(EV_KEY, button, state);
-    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
 
-    res = write(display->input_fd[INPUT_TABLET], &event, sizeof(event));
+    res = write(display->input_fd[INPUT_TOUCH], &event, sizeof(event));
     if (res < sizeof(event))
         ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
 }
 
 static void
-tablet_tool_frame(void *, struct zwp_tablet_tool_v2 *, uint32_t)
+tablet_tool_frame(void *data, struct zwp_tablet_tool_v2 *, uint32_t)
 {
+    struct display* display = (struct display*)data;
+    struct input_event event[7];
+    struct timespec rt;
+    unsigned int res, n = 0;
+
+    if (!display->tablet_surface)
+        return;
+
+    if (ensure_pipe(display, INPUT_TOUCH))
+        return;
+
+    int touch_id = create_touch_id(display, TABLET_TOUCH_ID);
+    if (touch_id == -1)
+        return;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &rt) == -1) {
+        ALOGE("%s:%d error in touch clock_gettime: %s",
+              __FILE__, __LINE__, strerror(errno));
+    }
+
+    ADD_EVENT(EV_ABS, ABS_MT_SLOT, touch_id);
+    ADD_EVENT(EV_ABS, ABS_MT_TRACKING_ID, touch_id);
+    ADD_EVENT(EV_ABS, ABS_MT_TOOL_TYPE, MT_TOOL_PEN);
+    ADD_EVENT(EV_ABS, ABS_MT_POSITION_X, display->tablet_x);
+    ADD_EVENT(EV_ABS, ABS_MT_POSITION_Y, display->tablet_y);
+    ADD_EVENT(EV_ABS, ABS_MT_PRESSURE, display->tablet_down ? std::max(display->tablet_pressure, 1U) : 0);
+    ADD_EVENT(EV_SYN, SYN_REPORT, 0);
+
+    res = write(display->input_fd[INPUT_TOUCH], &event, sizeof(event));
+    if (res < sizeof(event))
+        ALOGE("Failed to write event for InputFlinger: %s", strerror(errno));
 }
 
 static const struct zwp_tablet_tool_v2_listener tablet_tool_listener = {
@@ -1887,10 +1765,6 @@ static const struct zwp_tablet_seat_v2_listener tablet_seat_listener = {
 };
 
 static void add_tablet_seat(struct display *d) {
-    d->input_fd[INPUT_TABLET] = -1;
-    mkfifo(INPUT_PIPE_NAME[INPUT_TABLET], S_IRUSR | S_IWUSR | S_IRGRP | S_IWGRP);
-    chown(INPUT_PIPE_NAME[INPUT_TABLET], 1000, 1000);
-
     d->tablet_seat = zwp_tablet_manager_v2_get_tablet_seat(d->tablet_manager, d->seat);
     zwp_tablet_seat_v2_add_listener(d->tablet_seat, &tablet_seat_listener, d);
 }
diff --git a/hwcomposer/wayland-hwc.h b/hwcomposer/wayland-hwc.h
index cb7739c..c4d4346 100644
--- a/hwcomposer/wayland-hwc.h
+++ b/hwcomposer/wayland-hwc.h
@@ -68,15 +68,13 @@ enum {
     INPUT_TOUCH,
     INPUT_KEYBOARD,
     INPUT_POINTER,
-    INPUT_TABLET,
     INPUT_TOTAL
 };
 
 static const char *INPUT_PIPE_NAME[INPUT_TOTAL] = {
     "/dev/input/wl_touch_events",
     "/dev/input/wl_keyboard_events",
-    "/dev/input/wl_pointer_events",
-    "/dev/input/wl_tablet_events"
+    "/dev/input/wl_pointer_events"
 };
 
 enum class GrallocType {
@@ -87,6 +85,7 @@ enum class GrallocType {
 };
 
 #define MAX_TOUCHPOINTS 10
+#define TABLET_TOUCH_ID INT32_MIN
 
 struct layerFrame {
     int x;
@@ -350,7 +349,10 @@ struct display {
     struct wl_surface *pointer_surface;
     struct wl_surface *tablet_surface;
     std::list<struct zwp_tablet_tool_v2 *> tablet_tools;
-    std::map<struct zwp_tablet_tool_v2 *, uint16_t> tablet_tools_evt;
+    int tablet_x;
+    int tablet_y;
+    uint32_t tablet_pressure;
+    bool tablet_down;
     uint32_t keyboard_enter_serial;
     std::string clipboard;
     std::list<std::string> clipboard_offer_mime_types;
-- 
