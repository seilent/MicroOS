FROM localhost/microos-pkg-builder

COPY SOURCE.env /tmp/android-guest-systemui/
RUN --mount=type=cache,id=microos-android-guest-systemui,target=/var/cache/android-guest-systemui \
    dnf -y --setopt=install_weak_deps=False install unzip zip e2fsprogs java-25-openjdk-devel \
 && dnf clean all \
 && . /tmp/android-guest-systemui/SOURCE.env \
 && cache=/var/cache/android-guest-systemui \
 && get() { \
      if ! echo "$2  $3" | sha256sum -c --status - 2>/dev/null; then \
        curl -fsSL --retry 3 -o "$3" "$1" \
        && echo "$2  $3" | sha256sum -c -; \
      fi; \
    } \
 && tools=$cache/${BUILD_TOOLS_URL##*/} \
 && get "$BUILD_TOOLS_URL" "$BUILD_TOOLS_SHA256" "$tools" \
 && mkdir "/opt/smali-$SMALI_VERSION" \
 && keep=" ${tools##*/} " \
 && while read -r sum url; do \
      get "$url" "$sum" "$cache/${url##*/}" && cp "$cache/${url##*/}" "/opt/smali-$SMALI_VERSION/" || exit 1; \
      keep="$keep${url##*/} "; \
    done <<< "$SMALI_JARS" \
 && for f in "$cache"/*; do \
      case $keep in *" ${f##*/} "*) ;; *) rm -f -- "$f" ;; esac; \
    done \
 && unzip -q "$tools" -d /tmp/android-guest-systemui/build-tools \
 && mv /tmp/android-guest-systemui/build-tools/android-15 "/opt/android-build-tools-$BUILD_TOOLS_VERSION" \
 && grep -qx "Pkg.Revision=$BUILD_TOOLS_VERSION" "/opt/android-build-tools-$BUILD_TOOLS_VERSION/source.properties" \
 && mkdir /opt/android-platform-key \
 && for f in "$PLATFORM_PK8_SHA256 platform.pk8" "$PLATFORM_X509_SHA256 platform.x509.pem"; do \
      curl -fsSL --retry 3 \
        "https://android.googlesource.com/platform/build/+/$SIGNER_REF/target/product/security/${f#* }?format=TEXT" \
        | base64 -d > "/opt/android-platform-key/${f#* }" \
      && echo "${f%% *}  /opt/android-platform-key/${f#* }" | sha256sum -c - || exit 1; \
    done \
 && rm -rf /tmp/android-guest-systemui
