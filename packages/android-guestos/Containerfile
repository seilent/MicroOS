FROM localhost/microos-pkg-builder

COPY SOURCE.env /tmp/android-guestos/
RUN --mount=type=cache,id=microos-android-ndk,target=/var/cache/android-ndk \
    dnf -y --setopt=install_weak_deps=False install unzip \
 && dnf clean all \
 && . /tmp/android-guestos/SOURCE.env \
 && zip=/var/cache/android-ndk/${NDK_URL##*/} \
 && if ! echo "$NDK_SHA256  $zip" | sha256sum -c --status - 2>/dev/null; then \
      curl -fsSL --retry 3 -o "$zip" "$NDK_URL" \
      && echo "$NDK_SHA256  $zip" | sha256sum -c -; \
    fi \
 && find /var/cache/android-ndk -maxdepth 1 -type f -name '*.zip' ! -name "${zip##*/}" -delete \
 && unzip -q "$zip" -d /opt \
 && grep -qxF "Pkg.Revision = $NDK_REVISION" "/opt/android-ndk-$NDK_VERSION/source.properties" \
 && rm -rf /tmp/android-guestos

COPY microos-android-guestos.spec SOURCE.env /tmp/android-guestos/
RUN . /tmp/android-guestos/SOURCE.env \
 && dnf -y --setopt=install_weak_deps=False builddep \
      --define "ndk /opt/android-ndk-$NDK_VERSION" \
      --define "android_api $ANDROID_API" \
      --define "libdrm_version $LIBDRM_VERSION" \
      --define "fossilize_ref $FOSSILIZE_REF" \
      --define "rapidjson_ref $RAPIDJSON_REF" \
      --define "angle_ref $ANGLE_REF" \
      /tmp/android-guestos/microos-android-guestos.spec \
 && dnf clean all \
 && rm -rf /tmp/android-guestos
