diff --git a/es-app/src/RocknixGamelist.cpp b/es-app/src/RocknixGamelist.cpp
new file mode 100644
index 0000000..31cb382
--- /dev/null
+++ b/es-app/src/RocknixGamelist.cpp
@@ -0,0 +1,52 @@
+#include "RocknixGamelist.h"
+
+#include "utils/FileSystemUtil.h"
+
+#include <cstdio>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace RocknixGamelist
+{
+    GamelistPaths gamelistPaths(const std::string& root,
+                                const std::string& romDirectory,
+                                const std::string& appdataGamelist,
+                                const bool legacy)
+    {
+        if (legacy) {
+            const std::string canonicalRoot {Utils::FileSystem::getCanonicalPath(root)};
+            const std::string canonicalRoms {Utils::FileSystem::getCanonicalPath(romDirectory)};
+            if (!canonicalRoms.empty() &&
+                (canonicalRoot == canonicalRoms ||
+                 canonicalRoot.compare(0, canonicalRoms.size() + 1, canonicalRoms + "/") == 0)) {
+                const std::string systemGamelist {root + "/gamelist.xml"};
+                return {Utils::FileSystem::exists(systemGamelist) ? systemGamelist : "",
+                        systemGamelist};
+            }
+        }
+        return {Utils::FileSystem::exists(appdataGamelist) ? appdataGamelist : "", appdataGamelist};
+    }
+
+    bool saveGamelist(const pugi::xml_document& doc, const std::string& path)
+    {
+        const std::string tempPath {path + ".tmp"};
+        const int fd {
+            open(tempPath.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_NOFOLLOW | O_CLOEXEC, 0644)};
+        if (fd < 0)
+            return false;
+        FILE* file {fdopen(fd, "wb")};
+        if (file == nullptr) {
+            close(fd);
+            Utils::FileSystem::removeFile(tempPath);
+            return false;
+        }
+        pugi::xml_writer_file writer {file};
+        doc.save(writer);
+        const bool written {std::fflush(file) == 0 && !std::ferror(file) &&
+                            fsync(fileno(file)) == 0};
+        if (std::fclose(file) == 0 && written && std::rename(tempPath.c_str(), path.c_str()) == 0)
+            return true;
+        Utils::FileSystem::removeFile(tempPath);
+        return false;
+    }
+}
