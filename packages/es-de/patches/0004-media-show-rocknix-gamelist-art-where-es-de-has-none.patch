+const std::string FileData::getDisplayMediaPath(const std::string& type)
+{
+    static const std::map<std::string, const std::string (FileData::*)() const> getters {
+        {"image", &FileData::getImagePath},
+        {"miximage", &FileData::getMiximagePath},
+        {"marquee", &FileData::getMarqueePath},
+        {"screenshot", &FileData::getScreenshotPath},
+        {"titlescreen", &FileData::getTitleScreenPath},
+        {"cover", &FileData::getCoverPath},
+        {"backcover", &FileData::getBackCoverPath},
+        {"3dbox", &FileData::get3DBoxPath},
+        {"physicalmedia", &FileData::getPhysicalMediaPath},
+        {"fanart", &FileData::getFanArtPath},
+        {"video", &FileData::getVideoPath},
+        {"manual", &FileData::getManualPath}};
+    const auto getter {getters.find(type)};
+    if (getter == getters.cend())
+        return "";
+    const std::string path {(this->*getter->second)()};
+    if (!path.empty())
+        return path;
+    FileData* source {getSourceFileData()};
+    return RocknixGamelist::displayMedia(source->getSystemEnvData()->mStartPath,
+                                         source->mRocknixMedia, type);
+}
