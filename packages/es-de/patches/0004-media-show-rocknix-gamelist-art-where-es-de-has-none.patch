diff --git a/es-app/src/RocknixGamelist.cpp b/es-app/src/RocknixGamelist.cpp
index b489893..d68655f 100644
--- a/es-app/src/RocknixGamelist.cpp
+++ b/es-app/src/RocknixGamelist.cpp
@@ -81,4 +81,52 @@ namespace RocknixGamelist
             return "./" + value.substr(prefix.size());
         return value;
     }
+
+    std::map<std::string, std::string> rocknixMedia(const pugi::xml_node& node)
+    {
+        std::map<std::string, std::string> media;
+        for (const char* tag : {"image", "thumbnail", "marquee", "wheel", "video", "fanart",
+                                "titleshot", "boxback", "manual"}) {
+            const std::string value {node.child(tag).text().get()};
+            if (!value.empty())
+                media[tag] = value;
+        }
+        return media;
+    }
+
+    std::string resolveTag(const std::string& root, const std::string& value)
+    {
+        const std::string path {Utils::FileSystem::isAbsolute(value) ? value : root + "/" + value};
+        if (!Utils::FileSystem::isRegularFile(path))
+            return "";
+        const std::string canonicalRoot {Utils::FileSystem::getCanonicalPath(root)};
+        const std::string canonicalPath {Utils::FileSystem::getCanonicalPath(path)};
+        if (canonicalRoot.empty() ||
+            canonicalPath.compare(0, canonicalRoot.size() + 1, canonicalRoot + "/") != 0)
+            return "";
+        return canonicalPath;
+    }
+
+    std::string displayMedia(const std::string& root,
+                             const std::map<std::string, std::string>& media,
+                             const std::string& type)
+    {
+        static const std::map<std::string, std::vector<std::string>> tags {
+            {"image", {"image"}},     {"miximage", {"image"}},           {"screenshot", {"image"}},
+            {"cover", {"thumbnail"}}, {"marquee", {"marquee", "wheel"}}, {"video", {"video"}},
+            {"fanart", {"fanart"}},   {"titlescreen", {"titleshot"}},    {"backcover", {"boxback"}},
+            {"manual", {"manual"}}};
+        const auto typeTags {tags.find(type)};
+        if (typeTags == tags.cend())
+            return "";
+        for (const std::string& tag : typeTags->second) {
+            const auto value {media.find(tag)};
+            if (value == media.cend())
+                continue;
+            const std::string path {resolveTag(root, normalizeRomPath(value->second, root))};
+            if (!path.empty())
+                return path;
+        }
+        return "";
+    }
 }
