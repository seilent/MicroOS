+static uint64_t steamcompmgr_vblank_paced_fps_interval( bool bShouldLimitFPS, bool *pbOnGrid = nullptr )
+{
+	if ( GetBackend()->GetCurrentConnector() && GetBackend()->GetCurrentConnector()->IsVRRActive() )
+		return 0;
+
+	int nRefreshHz = gamescope::ConvertmHzToHz( g_nNestedRefresh ? g_nNestedRefresh : g_nOutputRefresh );
+	int nTargetFPS = g_nSteamCompMgrTargetFPS;
+	if ( !nTargetFPS || !bShouldLimitFPS || nRefreshHz <= nTargetFPS )
+		return 0;
+
+	if ( pbOnGrid )
+		*pbOnGrid = nRefreshHz % nTargetFPS == 0;
+
+	return 1'000'000'000ul / nTargetFPS;
+}
