diff --git a/tests/test_utils_frame_limit.cpp b/tests/test_utils_frame_limit.cpp
new file mode 100644
index 0000000..603f71e
--- /dev/null
+++ b/tests/test_utils_frame_limit.cpp
@@ -0,0 +1,84 @@
+#include <catch2/catch_test_macros.hpp>
+#include "Utils/FrameLimit.h"
+
+#include <vector>
+
+using namespace gamescope;
+
+namespace
+{
+
+constexpr uint64_t k_ulCycle60 = 16'666'667;
+constexpr uint64_t k_ulInterval30 = 33'333'333;
+constexpr uint64_t k_ulInterval45 = 22'222'222;
+
+std::vector<int> Releases( uint64_t ulInterval, bool bOnGrid, int nVBlanks, int nLateVBlank = -1, int64_t nJitter = 0 )
+{
+	uint64_t ulTarget = 0;
+	std::vector<int> releases;
+	for ( int i = 1; i <= nVBlanks; i++ )
+	{
+		int64_t nOffset = ( i % 3 - 1 ) * nJitter;
+		uint64_t ulVBlank = 1'000'000'000 + i * k_ulCycle60 + nOffset;
+		ulTarget = ClampFrameLimitTarget( ulTarget, ulVBlank, ulInterval );
+		if ( !IsFrameLimitDue( ulTarget, ulVBlank, k_ulCycle60 ) || i == nLateVBlank )
+			continue;
+
+		ulTarget = GetNextFrameLimitTarget( ulTarget, ulVBlank, ulInterval, k_ulCycle60, bOnGrid );
+		releases.push_back( i );
+	}
+	return releases;
+}
+
+}
+
+TEST_CASE("A frame is due at the vblank nearest its target", "[frame_limit]") {
+	REQUIRE_FALSE(IsFrameLimitDue( 1'033'333'433, 1'016'666'767, k_ulCycle60 ));
+	REQUIRE(IsFrameLimitDue( 1'033'333'433, 1'033'000'000, k_ulCycle60 ));
+	REQUIRE(IsFrameLimitDue( 1'033'333'433, 1'033'333'434, k_ulCycle60 ));
+}
+
+TEST_CASE("An on time release on the refresh grid anchors to its vblank", "[frame_limit]") {
+	REQUIRE(GetNextFrameLimitTarget( 1'000'000'000, 1'000'000'100, k_ulInterval30, k_ulCycle60, true ) == 1'033'333'433);
+	REQUIRE(GetNextFrameLimitTarget( 1'000'000'000, 999'999'900, k_ulInterval30, k_ulCycle60, true ) == 1'033'333'233);
+}
+
+TEST_CASE("A late release keeps the anchor so the next frame is not delayed", "[frame_limit]") {
+	uint64_t ulTarget = GetNextFrameLimitTarget( 1'000'000'000, 1'016'666'667, k_ulInterval30, k_ulCycle60, true );
+	REQUIRE(ulTarget == 1'033'333'333);
+	REQUIRE(IsFrameLimitDue( ulTarget, 1'033'333'334, k_ulCycle60 ));
+}
+
+TEST_CASE("A target behind by more than one interval resyncs", "[frame_limit]") {
+	REQUIRE(GetNextFrameLimitTarget( 1'000'000'000, 1'050'000'000, k_ulInterval30, k_ulCycle60, true ) == 1'083'333'333);
+	REQUIRE(GetNextFrameLimitTarget( 0, 5'000'000'000, k_ulInterval30, k_ulCycle60, true ) == 5'033'333'333);
+}
+
+TEST_CASE("Off the refresh grid the target advances by the interval", "[frame_limit]") {
+	REQUIRE(GetNextFrameLimitTarget( 1'000'000'000, 994'444'445, k_ulInterval45, k_ulCycle60, false ) == 1'022'222'222);
+}
+
+TEST_CASE("One second at 60 Hz releases the limit", "[frame_limit]") {
+	REQUIRE(Releases( k_ulInterval30, true, 60 ).size() == 30);
+	REQUIRE(Releases( k_ulInterval45, false, 60 ).size() == 45);
+}
+
+TEST_CASE("A frame missing its vblank costs one vblank", "[frame_limit]") {
+	REQUIRE(Releases( k_ulInterval30, true, 60, 11 ).size() == 30);
+}
+
+TEST_CASE("30 on 60 with vblank jitter releases every second vblank", "[frame_limit]") {
+	std::vector<int> releases = Releases( k_ulInterval30, true, 600, -1, 500'000 );
+	REQUIRE(releases.size() == 300);
+	for ( size_t i = 1; i < releases.size(); i++ )
+		REQUIRE(releases[i] - releases[i - 1] == 2);
+}
+
+TEST_CASE("A lower limit does not delay the next frame after the limit rises", "[frame_limit]") {
+	constexpr uint64_t ulInterval10 = 100'000'000;
+	uint64_t ulTarget = GetNextFrameLimitTarget( 0, 1'000'000'000, ulInterval10, k_ulCycle60, true );
+	REQUIRE(ulTarget == 1'100'000'000);
+	ulTarget = ClampFrameLimitTarget( ulTarget, 1'016'666'667, k_ulInterval30 );
+	REQUIRE(ulTarget == 1'050'000'000);
+	REQUIRE(IsFrameLimitDue( ulTarget, 1'050'000'001, k_ulCycle60 ));
+}
