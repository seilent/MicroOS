diff --git a/src/Utils/FrameLimit.h b/src/Utils/FrameLimit.h
new file mode 100644
index 0000000..5bb6d84
--- /dev/null
+++ b/src/Utils/FrameLimit.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace gamescope
+{
+    inline uint64_t ClampFrameLimitTarget( uint64_t ulTarget, uint64_t ulVBlank, uint64_t ulInterval )
+    {
+        return std::min( ulTarget, ulVBlank + ulInterval );
+    }
+
+    inline bool IsFrameLimitDue( uint64_t ulTarget, uint64_t ulVBlank, uint64_t ulCycle )
+    {
+        return ulVBlank + ulCycle / 2 >= ulTarget;
+    }
+
+    inline uint64_t GetNextFrameLimitTarget( uint64_t ulTarget, uint64_t ulVBlank, uint64_t ulInterval, uint64_t ulCycle, bool bOnGrid )
+    {
+        if ( ulTarget + ulInterval < ulVBlank )
+            return ulVBlank + ulInterval;
+
+        if ( bOnGrid && ulVBlank <= ulTarget + ulCycle / 2 )
+            return ulVBlank + ulInterval;
+
+        return ulTarget + ulInterval;
+    }
+}
