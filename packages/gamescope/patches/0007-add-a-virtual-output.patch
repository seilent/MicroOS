+TEST_CASE("The virtual stream follows the newest request", "[virtual_output]") {
+	VirtualStreamReconcile none = ReconcileVirtualStream( 0, 0, 0 );
+	REQUIRE_FALSE(none.bDestroy);
+	REQUIRE_FALSE(none.bCreate);
+
+	VirtualStreamReconcile open = ReconcileVirtualStream( 1, 0, 0 );
+	REQUIRE_FALSE(open.bDestroy);
+	REQUIRE(open.bCreate);
+
+	VirtualStreamReconcile keep = ReconcileVirtualStream( 1, 1, 0 );
+	REQUIRE_FALSE(keep.bDestroy);
+	REQUIRE_FALSE(keep.bCreate);
+
+	VirtualStreamReconcile close = ReconcileVirtualStream( 0, 1, 0 );
+	REQUIRE(close.bDestroy);
+	REQUIRE_FALSE(close.bCreate);
+
+	VirtualStreamReconcile reopen = ReconcileVirtualStream( 3, 1, 0 );
+	REQUIRE(reopen.bDestroy);
+	REQUIRE(reopen.bCreate);
+
+	VirtualStreamReconcile closedThenOpen = ReconcileVirtualStream( 3, 0, 0 );
+	REQUIRE_FALSE(closedThenOpen.bDestroy);
+	REQUIRE(closedThenOpen.bCreate);
+}
