+TEST_CASE("A repeated log line is let through every 5 s with the suppressed count", "[virtual_output]") {
+	LogRateLimit limit;
+	uint64_t ulSuppressed = 99;
+
+	REQUIRE(limit.Allow( 1'000, &ulSuppressed ));
+	REQUIRE(ulSuppressed == 0);
+
+	ulSuppressed = 99;
+	REQUIRE_FALSE(limit.Allow( 2'000, &ulSuppressed ));
+	REQUIRE_FALSE(limit.Allow( 4'999'999'999ul, &ulSuppressed ));
+	REQUIRE_FALSE(limit.Allow( 5'000'000'999ul, &ulSuppressed ));
+	REQUIRE(ulSuppressed == 99);
+
+	REQUIRE(limit.Allow( 5'000'001'000ul, &ulSuppressed ));
+	REQUIRE(ulSuppressed == 3);
+
+	REQUIRE(limit.Allow( 20'000'000'000ul, &ulSuppressed ));
+	REQUIRE(ulSuppressed == 0);
+}
