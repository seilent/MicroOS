+  <description summary="gamescope virtual output">
+    This is a private Gamescope protocol. Regular Wayland clients must not use
+    it.
+
+    A virtual output is a display that gamescope composites into a PipeWire
+    node. It lasts as long as its object.
+  </description>
+
+  <interface name="gamescope_virtual_output_manager" version="1">
+    <request name="destroy" type="destructor"></request>
+
+    <request name="create_virtual_output">
+      <arg name="id" type="new_id" interface="gamescope_virtual_output"/>
+      <arg name="width" type="uint"/>
+      <arg name="height" type="uint"/>
+      <arg name="refresh_mhz" type="uint"/>
+      <arg name="width_mm" type="uint"/>
+      <arg name="height_mm" type="uint"/>
+    </request>
+  </interface>
+
+  <interface name="gamescope_virtual_output" version="1">
+    <enum name="failure">
+      <entry name="busy" value="1"/>
+      <entry name="invalid_mode" value="2"/>
+      <entry name="output_disable_failed" value="3"/>
+      <entry name="stream_failed" value="4"/>
+      <entry name="revoked" value="5"/>
+      <entry name="forced_internal" value="6"/>
+    </enum>
+
+    <request name="destroy" type="destructor"></request>
+
+    <event name="stream_node">
+      <arg name="node_id" type="uint"/>
+    </event>
+
+    <event name="failed">
+      <arg name="reason" type="uint" enum="failure"/>
+    </event>
+  </interface>
+</protocol>
