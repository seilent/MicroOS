+		virtual bool SupportsVRR() const override
+		{
+			return false;
+		}
+
+		virtual std::span<const uint8_t> GetRawEDID() const override
+		{
+			return m_Edid;
+		}
+		virtual std::span<const uint32_t> GetValidDynamicRefreshRates() const override
+		{
+			return std::span<const uint32_t>{};
+		}
+
+		virtual void GetNativeColorimetry(
+			bool bHDR10,
+			displaycolorimetry_t *displayColorimetry, EOTF *displayEOTF,
+			displaycolorimetry_t *outputEncodingColorimetry, EOTF *outputEncodingEOTF ) const override
+		{
+			*displayColorimetry = displaycolorimetry_709;
+			*displayEOTF = EOTF_Gamma22;
+			*outputEncodingColorimetry = displaycolorimetry_709;
+			*outputEncodingEOTF = EOTF_Gamma22;
+		}
+
+		virtual const char *GetName() const override
+		{
+			return "VIRTUAL-1";
+		}
+		virtual const char *GetMake() const override
+		{
+			return "Gamescope";
+		}
+		virtual const char *GetModel() const override
+		{
+			return "Virtual Output";
+		}
+
+		virtual int Present( const FrameInfo_t *pFrameInfo, bool bAsync ) override
+		{
+			m_PresentFeedback.m_uQueuedPresents++;
+			GetVBlankTimer().UpdateWasCompositing( true );
+
+#if HAVE_PIPEWIRE
+			if ( !cv_drm_sleep_screens[ GAMESCOPE_SCREEN_TYPE_EXTERNAL ] )
+			{
+				if ( struct pipewire_buffer *pBuffer = pipewire_virtual_dequeue() )
+				{
+					FrameInfo_t frameInfo = *pFrameInfo;
+					std::optional<uint64_t> oSequence = pBuffer->texture
+						? vulkan_composite( &frameInfo, Rc<CVulkanTexture>{ pBuffer->texture }, false )
+						: std::nullopt;
+					if ( oSequence )
+						vulkan_wait( *oSequence, true );
+					pipewire_virtual_push( pBuffer, !oSequence );
+				}
+			}
+#endif
+
+			const uint64_t ulTargetVBlank = g_SteamCompMgrVBlankTime.schedule.ulTargetVBlank;
+			GetVBlankTimer().UpdateLastDrawTime( get_time_in_nanos() - g_SteamCompMgrVBlankTime.ulWakeupTime );
+			GetVBlankTimer().MarkVBlank( ulTargetVBlank, true );
+			m_PresentFeedback.m_uCompletedPresents = m_PresentFeedback.m_uQueuedPresents.load();
+			mangoapp_output_update( ulTargetVBlank );
+			return 0;
+		}
+
+		bool IsStreamed() const
+		{
+			return m_oMode && m_bStreamed && !m_bFailed;
+		}
+
+		void Poll()
+		{
+			const bool bWasStreamed = IsStreamed();
+
+			std::optional<VirtualOutputMode> oMode;
+			if ( wlserver_virtual_output_poll( &m_ulSerial, &oMode ) )
+			{
+				m_oMode = oMode;
+				m_bStreamed = false;
+				m_bFailed = false;
+				m_bNodeReported = false;
+				m_bOutrankedNoted = false;
+				m_uDisableRetries = 0;
+#if HAVE_PIPEWIRE
+				if ( m_oMode )
+					pipewire_virtual_open( m_ulSerial, m_oMode->uWidth, m_oMode->uHeight, m_oMode->uRefreshmHz );
+				else
+					pipewire_virtual_close();
+#endif
+			}
+
+#if HAVE_PIPEWIRE
+			if ( m_oMode && !m_bFailed )
+			{
+				const pipewire_virtual_status status = pipewire_virtual_get_status();
+				if ( status.serial == m_ulSerial && status.failed )
+				{
+					drm_log.errorf( "virtual output stream failed" );
+					Fail( GAMESCOPE_VIRTUAL_OUTPUT_FAILURE_STREAM_FAILED );
+				}
+				else if ( status.serial == m_ulSerial )
+				{
+					if ( status.node_id != SPA_ID_INVALID && !m_bNodeReported )
+					{
+						m_oNodeReport = status.node_id;
+						m_bNodeReported = true;
+					}
+					m_bStreamed |= status.streamed_once;
+				}
+			}
+#endif
+
+			if ( IsStreamed() != bWasStreamed )
+				GetBackend()->DirtyState();
+		}
+
+		bool Select( struct drm_t *drm )
+		{
+			int nRet = drm_disable_outputs( drm );
+			if ( nRet == -EACCES )
+				return true;
+
+			if ( nRet == -EBUSY && m_uDisableRetries++ < 3 )
+			{
+				GetBackend()->DirtyState();
+				return true;
+			}
+
+			if ( nRet != 0 )
+			{
+				drm_log.errorf( "virtual output: disabling the outputs failed: %s", strerror( -nRet ) );
+				Fail( GAMESCOPE_VIRTUAL_OUTPUT_FAILURE_OUTPUT_DISABLE_FAILED );
+				return false;
+			}
+			m_uDisableRetries = 0;
+
+			{
+				std::scoped_lock lock{ drm->m_QueuedFbIdsMutex, drm->m_mutVisibleFbIds };
+				drm->m_QueuedFbIds.clear();
+				drm->m_VisibleFbIds.clear();
+			}
+			g_bVirtualOutputCurrent = true;
+			drm_unset_connector( drm );
+
+			drm_log.infof( "selecting connector %s", GetName() );
+
+			const VirtualOutputMode &mode = *m_oMode;
+			g_nOutputWidth = mode.uWidth;
+			g_nOutputHeight = mode.uHeight;
+			g_nOutputRefresh = mode.uRefreshmHz;
+			g_nDynamicRefreshHz = 0;
+			g_bRotated = false;
+			g_uOutputRotation = 0;
+
+			m_Modes = { BackendMode{ mode.uWidth, mode.uHeight, ConvertmHzToHz( mode.uRefreshmHz ) } };
+			m_Edid = GenerateSimpleEdid( mode.uWidth, mode.uHeight );
+
+			const struct wlserver_output_info wlserver_output_info = {
+				.description = "Gamescope Virtual Output",
+				.phys_width = (int) mode.uWidthMM,
+				.phys_height = (int) mode.uHeightMM,
+			};
+			wlserver_lock();
+			wlserver_set_output_info( &wlserver_output_info );
+			wlserver_unlock();
+
+			WritePatchedEdid( GetRawEDID(), GetHDRInfo(), false );
+			WriteModeListFile( GetModes() );
+			update_connector_display_info_wl( drm );
+
+			return true;
+		}
+
+		void NoteOutranked( const char *pszConnector )
+		{
+			if ( m_bOutrankedNoted )
+				return;
+
+			m_bOutrankedNoted = true;
+			drm_log.infof( "virtual output streams, but --prefer-output ranks %s above %s", pszConnector, GetName() );
+		}
+
+		void Fail( uint32_t uReason )
+		{
+			if ( m_bFailed )
+				return;
+
+			m_bFailed = true;
+			m_oFailureReport = uReason;
+		}
+
+		void Report()
+		{
+			if ( m_oNodeReport || m_oFailureReport )
+				wlserver_virtual_output_report( m_ulSerial, std::exchange( m_oNodeReport, std::nullopt ), std::exchange( m_oFailureReport, std::nullopt ) );
+		}
+
+	private:
+		BackendConnectorHDRInfo m_HDRInfo{};
+		std::vector<BackendMode> m_Modes;
+		std::vector<uint8_t> m_Edid;
+
+		uint64_t m_ulSerial = 0;
+		std::optional<VirtualOutputMode> m_oMode;
+		bool m_bStreamed = false;
+		bool m_bFailed = false;
+		bool m_bNodeReported = false;
+		bool m_bOutrankedNoted = false;
+		uint32_t m_uDisableRetries = 0;
+		std::optional<uint32_t> m_oNodeReport;
+		std::optional<uint32_t> m_oFailureReport;
+	};
+}
