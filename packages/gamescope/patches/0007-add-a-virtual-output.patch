+TEST_CASE("No stream offers NV12 over DMA-BUF", "[virtual_output]") {
+	for ( bool bVirtualOutput : { false, true } )
+	{
+		for ( const StreamOffer &offer : GetStreamOffers( bVirtualOutput ) )
+			REQUIRE_FALSE(( offer.eFormat == StreamFormat::NV12 && offer.bDmaBuf ));
+	}
+
+	std::span<const StreamOffer> virtualOffers = GetStreamOffers( true );
+	REQUIRE(virtualOffers.size() == 3);
+	REQUIRE(virtualOffers[0].eFormat == StreamFormat::NV12);
+	REQUIRE_FALSE(virtualOffers[0].bDmaBuf);
+	REQUIRE(virtualOffers[1].eFormat == StreamFormat::BGRx);
+	REQUIRE(virtualOffers[1].bDmaBuf);
+	REQUIRE(virtualOffers[2].eFormat == StreamFormat::BGRx);
+	REQUIRE_FALSE(virtualOffers[2].bDmaBuf);
+
+	std::span<const StreamOffer> mainOffers = GetStreamOffers( false );
+	REQUIRE(mainOffers.size() == 3);
+	REQUIRE(mainOffers[0].eFormat == StreamFormat::BGRx);
+	REQUIRE(mainOffers[0].bDmaBuf);
+	REQUIRE(mainOffers[1].eFormat == StreamFormat::BGRx);
+	REQUIRE_FALSE(mainOffers[1].bDmaBuf);
+	REQUIRE(mainOffers[2].eFormat == StreamFormat::NV12);
+	REQUIRE_FALSE(mainOffers[2].bDmaBuf);
+}
