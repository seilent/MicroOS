@@ -745,17 +760,40 @@ static bool drm_detach_lease_resources(
 		}
 	}
 
-	if ( !bValid || drmModeAtomicCommit( drm->fd, pRequest, DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr ) != 0 )
+	int nRet = bValid ? drmModeAtomicCommit( drm->fd, pRequest, DRM_MODE_ATOMIC_ALLOW_MODESET, nullptr ) : -EINVAL;
+	if ( nRet != 0 )
 	{
 		for ( gamescope::CDRMAtomicProperty *pProperty : changedProperties )
 			pProperty->Rollback();
-		return false;
+		return nRet;
 	}
 
 	for ( gamescope::CDRMAtomicProperty *pProperty : changedProperties )
 		pProperty->OnCommit();
 
-	return true;
+	return 0;
+}
+
+static int drm_disable_outputs( struct drm_t *drm )
+{
+	std::unordered_set< uint64_t > crtcIds;
+	for ( const std::unique_ptr< gamescope::CDRMCRTC > &pCRTC : drm->crtcs )
+	{
+		if ( pCRTC->GetProperties().ACTIVE->GetCurrentValue() )
+			crtcIds.insert( pCRTC->GetObjectId() );
+	}
+
+	for ( auto &iter : drm->connectors )
+	{
+		gamescope::CDRMConnector *pConnector = &iter.second;
+		if ( !drm->leasedConnectorIds.contains( pConnector->GetObjectId() ) )
+			crtcIds.insert( pConnector->GetProperties().CRTC_ID->GetCurrentValue() );
+	}
+
+	crtcIds.erase( 0 );
+	std::erase_if( crtcIds, [drm]( uint64_t ulCRTCId ) { return drm->leasedCRTCIds.contains( ulCRTCId ); } );
+
+	return drm_disable_crtcs( drm, crtcIds );
 }
 
