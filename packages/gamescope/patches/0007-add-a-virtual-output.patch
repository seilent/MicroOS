diff --git a/src/Utils/LogRateLimit.h b/src/Utils/LogRateLimit.h
new file mode 100644
index 00000000..bbc60796
--- /dev/null
+++ b/src/Utils/LogRateLimit.h
@@ -0,0 +1,32 @@
+#pragma once
+
+#include <cstdint>
+
+namespace gamescope
+{
+    class LogRateLimit
+    {
+    public:
+        static constexpr uint64_t k_ulInterval = 5'000'000'000ul;
+
+        bool Allow( uint64_t ulNow, uint64_t *pulSuppressed )
+        {
+            if ( m_bLogged && ulNow - m_ulLastLog < k_ulInterval )
+            {
+                m_ulSuppressed++;
+                return false;
+            }
+
+            *pulSuppressed = m_ulSuppressed;
+            m_ulSuppressed = 0;
+            m_ulLastLog = ulNow;
+            m_bLogged = true;
+            return true;
+        }
+
+    private:
+        uint64_t m_ulLastLog = 0;
+        uint64_t m_ulSuppressed = 0;
+        bool m_bLogged = false;
+    };
+}
