+namespace gamescope
+{
+    struct VirtualOutputMode
+    {
+        uint32_t uWidth = 0;
+        uint32_t uHeight = 0;
+        uint32_t uRefreshmHz = 0;
+        uint32_t uWidthMM = 0;
+        uint32_t uHeightMM = 0;
+
+        bool operator==( const VirtualOutputMode & ) const = default;
+    };
+
+    inline bool IsValidVirtualOutputMode( const VirtualOutputMode &mode )
+    {
+        return mode.uWidth >= 2 && mode.uWidth <= 3840 && mode.uWidth % 2 == 0 &&
+               mode.uHeight >= 2 && mode.uHeight <= mode.uWidth && mode.uHeight % 2 == 0 &&
+               mode.uRefreshmHz >= 1'000 && mode.uRefreshmHz <= 240'000 &&
+               mode.uWidthMM >= 1 && mode.uWidthMM <= 2000 &&
+               mode.uHeightMM >= 1 && mode.uHeightMM <= 2000;
+    }
+
+    inline std::optional<VirtualOutputMode> ParseVirtualOutputMode( std::string_view svMode )
+    {
+        static constexpr char k_cSeparators[] = { 'x', '@', ':', 'x', '\0' };
+
+        uint32_t uValues[ std::size( k_cSeparators ) ];
+        const char *pCursor = svMode.data();
+        const char *pEnd = svMode.data() + svMode.size();
+        for ( size_t i = 0; i < std::size( k_cSeparators ); i++ )
+        {
+            auto [ pNext, eError ] = std::from_chars( pCursor, pEnd, uValues[ i ] );
+            if ( eError != std::errc{} )
+                return std::nullopt;
+
+            pCursor = pNext;
+            if ( k_cSeparators[ i ] )
+            {
+                if ( pCursor == pEnd || *pCursor != k_cSeparators[ i ] )
+                    return std::nullopt;
+                pCursor++;
+            }
+        }
+
+        if ( pCursor != pEnd || uValues[ 2 ] > UINT32_MAX / 1'000 )
+            return std::nullopt;
+
+        VirtualOutputMode mode =
+        {
+            .uWidth = uValues[ 0 ],
+            .uHeight = uValues[ 1 ],
+            .uRefreshmHz = uValues[ 2 ] * 1'000,
+            .uWidthMM = uValues[ 3 ],
+            .uHeightMM = uValues[ 4 ],
+        };
+        if ( !IsValidVirtualOutputMode( mode ) )
+            return std::nullopt;
+
+        return mode;
+    }
+
+    class VirtualOutputArbiter
+    {
+    public:
+        bool Create( void *pClient, const VirtualOutputMode &mode )
+        {
+            if ( m_oMode )
+                return false;
+
+            Take( pClient, mode );
+            return true;
+        }
+
+        bool Destroy( void *pClient )
+        {
+            if ( !pClient || pClient != m_pClient )
+                return false;
+
+            Clear();
+            return true;
+        }
+
+        bool Set( const VirtualOutputMode &mode )
+        {
+            if ( m_pClient )
+                return false;
+
+            if ( m_oMode != mode )
+                Take( nullptr, mode );
+            return true;
+        }
+
+        void *Off()
+        {
+            void *pRevoked = m_pClient;
+            if ( m_oMode )
+                Clear();
+            return pRevoked;
+        }
+
+        bool Release( uint64_t ulSerial )
+        {
+            if ( !m_oMode || ulSerial != m_ulSerial )
+                return false;
+
+            Clear();
+            return true;
+        }
+
+        uint64_t GetSerial() const { return m_ulSerial; }
+        const std::optional<VirtualOutputMode> &GetMode() const { return m_oMode; }
+        void *GetClient() const { return m_pClient; }
+
+    private:
+        void Take( void *pClient, const VirtualOutputMode &mode )
+        {
+            m_pClient = pClient;
+            m_oMode = mode;
+            m_ulSerial++;
+        }
+
+        void Clear()
+        {
+            m_pClient = nullptr;
+            m_oMode = std::nullopt;
+            m_ulSerial++;
+        }
+
+        void *m_pClient = nullptr;
+        std::optional<VirtualOutputMode> m_oMode;
+        uint64_t m_ulSerial = 0;
+    };
+
+    enum class VirtualOutputChoice
+    {
+        Kms,
+        Virtual,
+        ForcedInternal,
+    };
+
+    inline VirtualOutputChoice ChooseVirtualOutput( bool bStreamed, bool bForceInternal, int nVirtualPriority, int nBestKmsPriority )
+    {
+        if ( !bStreamed || nVirtualPriority > nBestKmsPriority )
+            return VirtualOutputChoice::Kms;
+
+        if ( bForceInternal )
+            return VirtualOutputChoice::ForcedInternal;
+
+        return VirtualOutputChoice::Virtual;
+    }
+
+    struct VirtualStreamReconcile
+    {
+        bool bDestroy = false;
+        bool bCreate = false;
+    };
+
+    inline VirtualStreamReconcile ReconcileVirtualStream( uint64_t ulWantedSerial, uint64_t ulStreamSerial, uint64_t ulFailedSerial )
+    {
+        const bool bKeep = ulStreamSerial && ulStreamSerial == ulWantedSerial && ulStreamSerial != ulFailedSerial;
+        return VirtualStreamReconcile
+        {
+            .bDestroy = ulStreamSerial && !bKeep,
+            .bCreate = ulWantedSerial && ulWantedSerial != ulStreamSerial && ulWantedSerial != ulFailedSerial,
+        };
+    }
+
+    enum class StreamFormat
+    {
+        BGRx,
+        NV12,
+    };
+
+    struct StreamOffer
+    {
+        StreamFormat eFormat;
+        bool bDmaBuf;
+    };
+
+    inline std::span<const StreamOffer> GetStreamOffers( bool bVirtualOutput )
+    {
+        static constexpr StreamOffer k_MainOffers[] =
+        {
+            { StreamFormat::BGRx, true },
+            { StreamFormat::BGRx, false },
+            { StreamFormat::NV12, false },
+        };
+        static constexpr StreamOffer k_VirtualOutputOffers[] =
+        {
+            { StreamFormat::NV12, false },
+            { StreamFormat::BGRx, true },
+            { StreamFormat::BGRx, false },
+        };
+
+        if ( bVirtualOutput )
+            return k_VirtualOutputOffers;
+        return k_MainOffers;
+    }
+}
