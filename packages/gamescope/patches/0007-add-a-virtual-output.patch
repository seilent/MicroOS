+static struct
+{
+	std::mutex mutex;
+	std::atomic<uint64_t> ulSerial = { 0 };
+	gamescope::VirtualOutputArbiter arbiter;
+	bool bSupported = false;
+} s_VirtualOutputSlot;
+
+static void gamescope_virtual_output_handle_destroy( struct wl_client *client, struct wl_resource *resource )
+{
+	wl_resource_destroy( resource );
+}
+
+static const struct gamescope_virtual_output_interface gamescope_virtual_output_impl = {
+	.destroy = gamescope_virtual_output_handle_destroy,
+};
+
+static void gamescope_virtual_output_resource_destroy( struct wl_resource *resource )
+{
+	bool bChanged;
+	{
+		std::scoped_lock lock( s_VirtualOutputSlot.mutex );
+		bChanged = s_VirtualOutputSlot.arbiter.Destroy( resource );
+		s_VirtualOutputSlot.ulSerial = s_VirtualOutputSlot.arbiter.GetSerial();
+	}
+
+	if ( bChanged )
+		nudge_steamcompmgr();
+}
+
+static void gamescope_virtual_output_manager_handle_destroy( struct wl_client *client, struct wl_resource *resource )
+{
+	wl_resource_destroy( resource );
+}
+
+static void gamescope_virtual_output_manager_create_virtual_output( struct wl_client *client, struct wl_resource *resource, uint32_t id,
+	uint32_t width, uint32_t height, uint32_t refresh_mhz, uint32_t width_mm, uint32_t height_mm )
+{
+	struct wl_resource *output = wl_resource_create( client, &gamescope_virtual_output_interface, wl_resource_get_version( resource ), id );
+	if ( !output )
+	{
+		wl_client_post_no_memory( client );
+		return;
+	}
+	wl_resource_set_implementation( output, &gamescope_virtual_output_impl, NULL, gamescope_virtual_output_resource_destroy );
+
+	const gamescope::VirtualOutputMode mode = {
+		.uWidth = width,
+		.uHeight = height,
+		.uRefreshmHz = refresh_mhz,
+		.uWidthMM = width_mm,
+		.uHeightMM = height_mm,
+	};
+	if ( !gamescope::IsValidVirtualOutputMode( mode ) )
+	{
+		wl_log.errorf( "virtual output %ux%u@%u mHz %ux%u mm refused: invalid mode", width, height, refresh_mhz, width_mm, height_mm );
+		gamescope_virtual_output_send_failed( output, GAMESCOPE_VIRTUAL_OUTPUT_FAILURE_INVALID_MODE );
+		return;
+	}
+
+	bool bCreated;
+	{
+		std::scoped_lock lock( s_VirtualOutputSlot.mutex );
+		bCreated = s_VirtualOutputSlot.arbiter.Create( output, mode );
+		s_VirtualOutputSlot.ulSerial = s_VirtualOutputSlot.arbiter.GetSerial();
+	}
+
+	if ( !bCreated )
+	{
+		wl_log.errorf( "virtual output refused: busy" );
+		gamescope_virtual_output_send_failed( output, GAMESCOPE_VIRTUAL_OUTPUT_FAILURE_BUSY );
+		return;
+	}
+
+	wl_log.infof( "virtual output %ux%u@%u mHz %ux%u mm requested", width, height, refresh_mhz, width_mm, height_mm );
+	nudge_steamcompmgr();
+}
+
+static const struct gamescope_virtual_output_manager_interface gamescope_virtual_output_manager_impl = {
+	.destroy = gamescope_virtual_output_manager_handle_destroy,
+	.create_virtual_output = gamescope_virtual_output_manager_create_virtual_output,
+};
+
+static void gamescope_virtual_output_manager_bind( struct wl_client *client, void *data, uint32_t version, uint32_t id )
+{
+	struct wl_resource *resource = wl_resource_create( client, &gamescope_virtual_output_manager_interface, version, id );
+	if ( !resource )
+	{
+		wl_client_post_no_memory( client );
+		return;
+	}
+	wl_resource_set_implementation( resource, &gamescope_virtual_output_manager_impl, NULL, NULL );
+}
+
+static void create_gamescope_virtual_output( void )
+{
+	s_VirtualOutputSlot.bSupported = true;
+
+	uint32_t version = 1;
+	wl_global_create( wlserver.display, &gamescope_virtual_output_manager_interface, version, NULL, gamescope_virtual_output_manager_bind );
+}
+
+static gamescope::ConCommand cc_virtual_output( "virtual_output", "Show the screen on a virtual output PipeWire node. Eg. virtual_output 1280x800@60:172x108 (size, refresh, size in mm), virtual_output off",
+[]( std::span<std::string_view> args )
+{
+	if ( !s_VirtualOutputSlot.bSupported )
+	{
+		console_log.errorf( "virtual_output: this backend has no virtual output" );
+		return;
+	}
+
+	if ( args.size() != 2 )
+	{
+		console_log.errorf( "Usage: virtual_output <WxH@Hz:WxH> or virtual_output off" );
+		return;
+	}
+
+	void *pRevoked = nullptr;
+	if ( args[1] == "off" )
+	{
+		std::scoped_lock lock( s_VirtualOutputSlot.mutex );
+		pRevoked = s_VirtualOutputSlot.arbiter.Off();
+		s_VirtualOutputSlot.ulSerial = s_VirtualOutputSlot.arbiter.GetSerial();
+	}
+	else
+	{
+		std::optional<gamescope::VirtualOutputMode> oMode = gamescope::ParseVirtualOutputMode( args[1] );
+		if ( !oMode )
+		{
+			console_log.errorf( "Invalid virtual output mode '%.*s'", (int)args[1].size(), args[1].data() );
+			return;
+		}
+
+		std::scoped_lock lock( s_VirtualOutputSlot.mutex );
+		if ( !s_VirtualOutputSlot.arbiter.Set( *oMode ) )
+		{
+			console_log.errorf( "The virtual output belongs to a client, use virtual_output off" );
+			return;
+		}
+		s_VirtualOutputSlot.ulSerial = s_VirtualOutputSlot.arbiter.GetSerial();
+	}
+
+	if ( pRevoked )
+		gamescope_virtual_output_send_failed( (struct wl_resource *) pRevoked, GAMESCOPE_VIRTUAL_OUTPUT_FAILURE_REVOKED );
+	nudge_steamcompmgr();
+}, false );
+
+bool wlserver_virtual_output_poll( uint64_t *pulSerial, std::optional<gamescope::VirtualOutputMode> *poMode )
+{
+	if ( s_VirtualOutputSlot.ulSerial == *pulSerial )
+		return false;
+
+	std::scoped_lock lock( s_VirtualOutputSlot.mutex );
+	*pulSerial = s_VirtualOutputSlot.arbiter.GetSerial();
+	*poMode = s_VirtualOutputSlot.arbiter.GetMode();
+	return true;
+}
+
+void wlserver_virtual_output_report( uint64_t ulSerial, std::optional<uint32_t> oNodeId, std::optional<uint32_t> oFailure )
+{
+	bool bReleased = false;
+
+	wlserver_lock();
+	{
+		std::scoped_lock lock( s_VirtualOutputSlot.mutex );
+		if ( s_VirtualOutputSlot.arbiter.GetSerial() == ulSerial )
+		{
+			struct wl_resource *pOwner = (struct wl_resource *) s_VirtualOutputSlot.arbiter.GetClient();
+			if ( oNodeId )
+			{
+				wl_log.infof( "virtual output on PipeWire node %u", *oNodeId );
+				if ( pOwner )
+					gamescope_virtual_output_send_stream_node( pOwner, *oNodeId );
+			}
+
+			if ( oFailure )
+			{
+				if ( pOwner )
+					gamescope_virtual_output_send_failed( pOwner, *oFailure );
+				bReleased = s_VirtualOutputSlot.arbiter.Release( ulSerial );
+				s_VirtualOutputSlot.ulSerial = s_VirtualOutputSlot.arbiter.GetSerial();
+			}
+		}
+	}
+	wlserver_unlock();
+
+	if ( bReleased )
+		nudge_steamcompmgr();
+}
