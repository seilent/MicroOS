+
+#include <climits>
+#include <string_view>
+
+using namespace gamescope;
+
+namespace
+{
+
+constexpr VirtualOutputMode k_Tablet{ 1280, 800, 60'000, 172, 108 };
+constexpr VirtualOutputMode k_Monitor{ 1920, 1080, 60'000, 527, 296 };
+
+int g_nClientA;
+int g_nClientB;
+
+}
+
+TEST_CASE("The virtual output mode parses and validates", "[virtual_output]") {
+	REQUIRE(ParseVirtualOutputMode( "1280x800@60:172x108" ) == k_Tablet);
+	REQUIRE(ParseVirtualOutputMode( "3840x2160@240:2000x2000" ) == VirtualOutputMode{ 3840, 2160, 240'000, 2000, 2000 });
+	REQUIRE(ParseVirtualOutputMode( "2x2@1:1x1" ) == VirtualOutputMode{ 2, 2, 1'000, 1, 1 });
+
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1281x800@60:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x801@60:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "0x0@60:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "3842x800@60:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "800x1280@60:108x172" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@0:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@241:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@4294968:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@60:0x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@60:172x2001" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@60" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@60:172x108x" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x800@60:172x108 " ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "+1280x800@60:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "1280x-800@60:172x108" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "" ));
+	REQUIRE_FALSE(ParseVirtualOutputMode( "off" ));
+
+	REQUIRE(IsValidVirtualOutputMode( VirtualOutputMode{ 1280, 800, 59'940, 172, 108 } ));
+	REQUIRE(IsValidVirtualOutputMode( VirtualOutputMode{ 1280, 1280, 240'000, 172, 172 } ));
+	REQUIRE_FALSE(IsValidVirtualOutputMode( VirtualOutputMode{ 1280, 800, 999, 172, 108 } ));
+	REQUIRE_FALSE(IsValidVirtualOutputMode( VirtualOutputMode{ 1280, 800, 240'001, 172, 108 } ));
+	REQUIRE_FALSE(IsValidVirtualOutputMode( VirtualOutputMode{ 3842, 2160, 60'000, 172, 108 } ));
+	REQUIRE_FALSE(IsValidVirtualOutputMode( VirtualOutputMode{ 1280, 0, 60'000, 172, 108 } ));
+}
+
+TEST_CASE("A client owns the virtual output until it goes", "[virtual_output]") {
+	VirtualOutputArbiter arbiter;
+	REQUIRE(arbiter.GetSerial() == 0);
+	REQUIRE_FALSE(arbiter.GetMode());
+
+	REQUIRE(arbiter.Create( &g_nClientA, k_Tablet ));
+	REQUIRE(arbiter.GetSerial() == 1);
+	REQUIRE(arbiter.GetMode() == k_Tablet);
+	REQUIRE(arbiter.GetClient() == &g_nClientA);
+
+	REQUIRE_FALSE(arbiter.Create( &g_nClientB, k_Monitor ));
+	REQUIRE_FALSE(arbiter.Set( k_Monitor ));
+	REQUIRE_FALSE(arbiter.Destroy( &g_nClientB ));
+	REQUIRE_FALSE(arbiter.Destroy( nullptr ));
+	REQUIRE(arbiter.GetSerial() == 1);
+	REQUIRE(arbiter.GetMode() == k_Tablet);
+
+	REQUIRE(arbiter.Destroy( &g_nClientA ));
+	REQUIRE(arbiter.GetSerial() == 2);
+	REQUIRE_FALSE(arbiter.GetMode());
+	REQUIRE(arbiter.GetClient() == nullptr);
+
+	REQUIRE_FALSE(arbiter.Destroy( &g_nClientA ));
+	REQUIRE(arbiter.GetSerial() == 2);
+}
+
+TEST_CASE("The command sets the virtual output and off always wins", "[virtual_output]") {
+	VirtualOutputArbiter arbiter;
+	REQUIRE(arbiter.Set( k_Tablet ));
+	REQUIRE(arbiter.GetSerial() == 1);
+	REQUIRE(arbiter.GetClient() == nullptr);
+
+	REQUIRE(arbiter.Set( k_Tablet ));
+	REQUIRE(arbiter.GetSerial() == 1);
+	REQUIRE(arbiter.Set( k_Monitor ));
+	REQUIRE(arbiter.GetSerial() == 2);
+	REQUIRE(arbiter.GetMode() == k_Monitor);
+
+	REQUIRE_FALSE(arbiter.Create( &g_nClientA, k_Tablet ));
+	REQUIRE(arbiter.GetSerial() == 2);
+
+	REQUIRE(arbiter.Off() == nullptr);
+	REQUIRE(arbiter.GetSerial() == 3);
+	REQUIRE_FALSE(arbiter.GetMode());
+	REQUIRE(arbiter.Off() == nullptr);
+	REQUIRE(arbiter.GetSerial() == 3);
+
+	REQUIRE(arbiter.Create( &g_nClientA, k_Tablet ));
+	REQUIRE(arbiter.GetSerial() == 4);
+	REQUIRE(arbiter.Off() == &g_nClientA);
+	REQUIRE(arbiter.GetSerial() == 5);
+	REQUIRE_FALSE(arbiter.GetMode());
+
+	REQUIRE_FALSE(arbiter.Destroy( &g_nClientA ));
+	REQUIRE(arbiter.GetSerial() == 5);
+}
+
+TEST_CASE("A backend failure releases only its own request", "[virtual_output]") {
+	VirtualOutputArbiter arbiter;
+	REQUIRE(arbiter.Create( &g_nClientA, k_Tablet ));
+	REQUIRE_FALSE(arbiter.Release( 0 ));
+	REQUIRE_FALSE(arbiter.Release( 2 ));
+	REQUIRE(arbiter.GetSerial() == 1);
+
+	REQUIRE(arbiter.Release( 1 ));
+	REQUIRE(arbiter.GetSerial() == 2);
+	REQUIRE_FALSE(arbiter.GetMode());
+	REQUIRE_FALSE(arbiter.Release( 2 ));
+
+	REQUIRE_FALSE(arbiter.Destroy( &g_nClientA ));
+	REQUIRE(arbiter.Create( &g_nClientB, k_Tablet ));
+	REQUIRE(arbiter.GetSerial() == 3);
+}
