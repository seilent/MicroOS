@@ -0,0 +1,242 @@
+#include <catch2/catch_test_macros.hpp>
+#include "Utils/LogRateLimit.h"
+#include "Utils/VirtualOutput.h"
+#if HAVE_PIPEWIRE
+#include "Utils/VirtualOutputNode.h"
