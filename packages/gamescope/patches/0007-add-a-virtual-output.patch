+TEST_CASE("A failed virtual stream is not recreated for the same request", "[virtual_output]") {
+	VirtualStreamReconcile failed = ReconcileVirtualStream( 1, 1, 1 );
+	REQUIRE(failed.bDestroy);
+	REQUIRE_FALSE(failed.bCreate);
+
+	VirtualStreamReconcile destroyed = ReconcileVirtualStream( 1, 0, 1 );
+	REQUIRE_FALSE(destroyed.bDestroy);
+	REQUIRE_FALSE(destroyed.bCreate);
+
+	VirtualStreamReconcile next = ReconcileVirtualStream( 2, 0, 1 );
+	REQUIRE_FALSE(next.bDestroy);
+	REQUIRE(next.bCreate);
+
+	VirtualStreamReconcile replaced = ReconcileVirtualStream( 2, 1, 1 );
+	REQUIRE(replaced.bDestroy);
+	REQUIRE(replaced.bCreate);
+}
