 std::atomic<bool> g_bPendingTouchMovement = { false };
 
-static void wlserver_touch_associate_connector(struct wlserver_touch *touch)
+static bool wlserver_input_device_screen_type( struct wlr_input_device *device, bool bBusType, gamescope::GamescopeScreenType *peScreenType )
 {
-	if (touch->connector != nullptr) return;
+	struct libinput_device *lidev = wlr_libinput_get_device_handle( device );
+	if ( !lidev )
+		return false;
 
-	// Heuristic to associate a monitor to a touch input device:
-	//  - if a touchscreen's bus is I²C, it can very likely be associated to an internal monitor.
-	//  - if its bus is USB, it can be associated to an external monitor.
-	// This isn't perfect, but we can't rely on the physical sizes reported by both devices,
-	// because it's not uncommon for touchscreens to report wildly incorrect sizes.
-	gamescope::IBackendConnector* connector = nullptr;
-	struct libinput_device *lidev = wlr_libinput_get_device_handle(&touch->wlr->base);
+	bool bFound = false;
+	bool bBusFound = false;
+	gamescope::GamescopeScreenType eBusScreenType = gamescope::GAMESCOPE_SCREEN_TYPE_INTERNAL;
 	struct udev_device *dev = libinput_device_get_udev_device(lidev);
 	auto *parent = dev;
 	while (parent) {
 		const char *subsystem = udev_device_get_subsystem(parent);
 		if (subsystem) {
-			if (strcmp( subsystem, "i2c" ) == 0) {
-				connector = GetBackend()->GetConnector(gamescope::GAMESCOPE_SCREEN_TYPE_INTERNAL);
-				touch->bInternal = true;
+			if (strcmp( subsystem, "i2c" ) == 0 || strcmp( subsystem, "spi" ) == 0) {
+				*peScreenType = gamescope::GAMESCOPE_SCREEN_TYPE_INTERNAL;
+				bFound = true;
 				break;
 			} else if (strcmp( subsystem, "usb" ) == 0) {
-				connector = GetBackend()->GetConnector(gamescope::GAMESCOPE_SCREEN_TYPE_EXTERNAL);
+				*peScreenType = gamescope::GAMESCOPE_SCREEN_TYPE_EXTERNAL;
+				bFound = true;
 				break;
+			} else if ( bBusType && !bBusFound && strcmp( subsystem, "input" ) == 0 ) {
+				const char *pBusType = udev_device_get_sysattr_value( parent, "id/bustype" );
+				unsigned long ulBusType = pBusType ? strtoul( pBusType, nullptr, 16 ) : 0;
+				if ( ulBusType == BUS_I2C || ulBusType == BUS_SPI ) {
+					eBusScreenType = gamescope::GAMESCOPE_SCREEN_TYPE_INTERNAL;
+					bBusFound = true;
+				} else if ( ulBusType == BUS_USB ) {
+					eBusScreenType = gamescope::GAMESCOPE_SCREEN_TYPE_EXTERNAL;
+					bBusFound = true;
+				}
 			}
 		}
 		parent = udev_device_get_parent(parent);
 	}
 	udev_device_unref(dev);
+
+	if ( !bFound && bBusFound ) {
+		*peScreenType = eBusScreenType;
+		bFound = true;
+	}
+
+	return bFound;
+}
+
+static void wlserver_touch_associate_connector(struct wlserver_touch *touch)
+{
+	if (touch->connector != nullptr) return;
+
+	gamescope::GamescopeScreenType eScreenType;
+	if ( !wlserver_input_device_screen_type( &touch->wlr->base, false, &eScreenType ) )
+		return;
+
+	touch->bInternal = eScreenType == gamescope::GAMESCOPE_SCREEN_TYPE_INTERNAL;
+	gamescope::IBackendConnector* connector = GetBackend()->GetConnector( eScreenType );
 	if (connector != nullptr) {
 		touch->connector = connector;
 		wl_log.infof("associating connector %s (%s %s) with touch input device %s",
 			connector->GetName(), connector->GetMake(), connector->GetModel(),
-			libinput_device_get_name(lidev));
+			touch->wlr->base.name);
 	}
 }
 
@@ -612,6 +643,11 @@ static void wlserver_handle_touch_destroy(struct wl_listener *listener, void *da
 	free( touch );
 }
 
+static struct wlr_tablet_manager_v2 *s_pTabletManager = nullptr;
+static uint32_t s_uTabletToolsDown = 0;
+
+static void wlserver_new_tablet( struct wlr_input_device *device );
+
 static void wlserver_new_input(struct wl_listener *listener, void *data)
 {
 	struct wlr_input_device *device = (struct wlr_input_device *) data;
@@ -692,6 +728,9 @@ static void wlserver_new_input(struct wl_listener *listener, void *data)
 			wlserver_touch_associate_connector( touch );
 		}
 		break;
+		case WLR_INPUT_DEVICE_TABLET:
