+static FILE *s_pFifoDebugLog = nullptr;
+static uint64_t s_ulFifoDebugCheck = 0;
+static FILE *fifo_debug_log()
+{
+	if ( ( s_ulFifoDebugCheck++ & 255 ) == 0 )
+	{
+		bool bOn = access( "/tmp/gs-fifo-debug", F_OK ) == 0;
+		if ( bOn && !s_pFifoDebugLog )
+			s_pFifoDebugLog = fopen( "/tmp/gs-fifo-debug.log", "a" );
+		else if ( !bOn && s_pFifoDebugLog )
+		{
+			fclose( s_pFifoDebugLog );
+			s_pFifoDebugLog = nullptr;
+		}
+	}
+	return s_pFifoDebugLog;
+}
