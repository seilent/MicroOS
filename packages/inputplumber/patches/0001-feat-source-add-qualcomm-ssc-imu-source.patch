+
+    #[test]
+    fn pm2_config() {
+        let conf: config::SourceDevice = serde_yaml::from_str(PM2_IMU).unwrap();
+        let conf = Some(&conf);
+        assert_eq!(sample_rate_from_config(conf), Some(400.0));
+        let driver = Driver::new(
+            mount_matrix_from_config(conf),
+            sample_rate_from_config(conf),
+        );
+        let (accel_correction, gyro_correction) = corrections_from_config(conf);
+
+        let rate = enable_request(driver.sample_rate);
+        assert_eq!(
+            request(3, UID_ACCEL, MSG_ENABLE_CONTINUOUS, Some(&rate)),
+            ENABLE_ACCEL
+        );
+
+        let (_, _, _, data) = report(SAMPLE_ACCEL);
+        let (_, bodies) = parse_report(data.unwrap()).unwrap();
+        let event = driver.translate(Sensor::Accel, bodies[0].1).unwrap();
+        let native = translate_events(vec![event], accel_correction, gyro_correction);
+        let InputValue::Vector3 { x, y, z } = native[0].get_value() else {
