+    #[test]
+    fn fixture_samples() {
+        let driver = pm2_driver();
+
+        let (_, _, _, data) = report(SAMPLE_ACCEL_STATUS_0);
+        let (uid, bodies) = parse_report(data.unwrap()).unwrap();
+        assert_eq!(uid, UID_ACCEL);
+        assert_eq!(bodies[0].0, MSG_MEASUREMENT);
+        assert_eq!(sample(bodies[0].1), None);
+        assert!(driver.translate(Sensor::Accel, bodies[0].1).is_none());
+
+        let (_, _, _, data) = report(SAMPLE_ACCEL);
+        let (uid, bodies) = parse_report(data.unwrap()).unwrap();
+        assert_eq!(uid, UID_ACCEL);
+        let (x, y, z) = sample(bodies[0].1).unwrap();
+        assert_eq!(x, 9.71648120880127);
+        assert_eq!(y, 0.029166072607040405);
+        assert_eq!(z, -0.010674640536308289);
+        let event = driver.translate(Sensor::Accel, bodies[0].1).unwrap();
+        let native = translate_events(vec![event], 1.0, 1.0);
+        assert_eq!(
+            native[0].as_capability(),
+            Capability::Accelerometer(Source::Center)
+        );
+        let InputValue::Vector3 {
+            x: rx,
+            y: ry,
+            z: rz,
+        } = native[0].get_value()
+        else {
+            panic!("expected a vector value");
+        };
+        assert_eq!((rx, ry, rz), (Some(-y), Some(x), Some(z)));
+
+        let (_, _, _, data) = report(SAMPLE_GYRO);
+        let (uid, bodies) = parse_report(data.unwrap()).unwrap();
+        assert_eq!(uid, UID_GYRO);
+        let (x, y, z) = sample(bodies[0].1).unwrap();
+        assert_eq!(x, -0.006985682062804699);
+        assert_eq!(y, 0.0048760538920760155);
+        assert_eq!(z, -0.004077108111232519);
+        let event = driver.translate(Sensor::Gyro, bodies[0].1).unwrap();
+        let native = translate_events(vec![event], 1.0, 1.0);
+        assert_eq!(
+            native[0].as_capability(),
+            Capability::Gyroscope(Source::Center)
+        );
+        let InputValue::Vector3 {
+            x: rx,
+            y: ry,
+            z: rz,
+        } = native[0].get_value()
+        else {
+            panic!("expected a vector value");
+        };
+        assert_eq!((rx, ry, rz), (Some(-y), Some(x), Some(z)));
+    }
+
+    #[test]
+    fn filtered_sample() {
+        let mut driver = pm2_driver();
+        driver.update_filtered_events(HashSet::from([Capability::Gyroscope(Source::Center)]));
+        let (_, _, _, data) = report(SAMPLE_GYRO);
+        let (_, bodies) = parse_report(data.unwrap()).unwrap();
+        assert!(driver.translate(Sensor::Gyro, bodies[0].1).is_none());
+        let (_, _, _, data) = report(SAMPLE_ACCEL);
+        let (_, bodies) = parse_report(data.unwrap()).unwrap();
+        assert!(driver.translate(Sensor::Accel, bodies[0].1).is_some());
+    }
+
+    #[test]
+    fn suspend_and_resume() {
+        let mut driver = pm2_driver();
+        driver.resume();
+        assert!(driver.recovering.is_none());
+        driver.suspend();
+        assert!(driver.poll().unwrap().is_empty());
+        assert!(driver.session.is_none());
+        assert!(!driver.streaming());
+        driver.resume();
+        assert!(!driver.suspended);
+        assert!(driver.recovering.is_some());
+        assert!(driver.backoff.ready(Instant::now()));
+    }
+
+    const PM2_IMU: &str = "
+group: imu
+ssc:
+  name: fastrpc-sdsp
+config:
+  imu:
+    sample_rate: 400
+    mount_matrix:
+      x: [0, -1, 0]
+      y: [1, 0, 0]
+      z: [0, 0, 1]
