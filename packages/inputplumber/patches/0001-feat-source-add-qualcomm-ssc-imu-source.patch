new file mode 100644
index 0000000..43c8104
--- /dev/null
+++ b/src/drivers/ssc/qrtr.rs
@@ -0,0 +1,147 @@
+use std::{
+    io,
+    mem::size_of,
+    os::fd::{AsRawFd, FromRawFd, OwnedFd},
+};
+
+use nix::libc;
+
+pub const PORT_CTRL: u32 = 0xfffffffe;
+pub const TYPE_NEW_SERVER: u32 = 4;
+pub const TYPE_DEL_SERVER: u32 = 5;
+pub const TYPE_NEW_LOOKUP: u32 = 10;
+
+const AF_QIPCRTR: libc::c_int = 42;
+
+#[repr(C)]
+struct SockaddrQrtr {
+    family: libc::sa_family_t,
+    node: u32,
+    port: u32,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Server {
+    pub service: u32,
+    pub instance: u32,
+    pub node: u32,
+    pub port: u32,
+}
+
+pub struct Socket {
+    fd: OwnedFd,
+    node: u32,
+}
+
+impl Socket {
+    pub fn new() -> io::Result<Self> {
+        let fd = unsafe {
+            libc::socket(
+                AF_QIPCRTR,
+                libc::SOCK_DGRAM | libc::SOCK_NONBLOCK | libc::SOCK_CLOEXEC,
+                0,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        let fd = unsafe { OwnedFd::from_raw_fd(fd) };
+
+        let mut addr = SockaddrQrtr {
+            family: 0,
+            node: 0,
+            port: 0,
+        };
+        let mut len = size_of::<SockaddrQrtr>() as libc::socklen_t;
+        let ret = unsafe {
+            libc::getsockname(
+                fd.as_raw_fd(),
+                &mut addr as *mut SockaddrQrtr as *mut libc::sockaddr,
+                &mut len,
+            )
+        };
+        if ret < 0 {
+            return Err(io::Error::last_os_error());
+        }
+
+        Ok(Self {
+            fd,
+            node: addr.node,
+        })
+    }
+
+    pub fn send_to(&self, node: u32, port: u32, data: &[u8]) -> io::Result<()> {
+        let addr = SockaddrQrtr {
+            family: AF_QIPCRTR as libc::sa_family_t,
+            node,
+            port,
+        };
+        let ret = unsafe {
+            libc::sendto(
+                self.fd.as_raw_fd(),
+                data.as_ptr() as *const libc::c_void,
+                data.len(),
+                0,
+                &addr as *const SockaddrQrtr as *const libc::sockaddr,
+                size_of::<SockaddrQrtr>() as libc::socklen_t,
+            )
+        };
+        if ret < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(())
+    }
+
+    pub fn recv_from(&self, buf: &mut [u8]) -> io::Result<Option<(usize, u32, u32)>> {
+        let mut addr = SockaddrQrtr {
+            family: 0,
+            node: 0,
+            port: 0,
+        };
+        let mut len = size_of::<SockaddrQrtr>() as libc::socklen_t;
+        let ret = unsafe {
+            libc::recvfrom(
+                self.fd.as_raw_fd(),
+                buf.as_mut_ptr() as *mut libc::c_void,
+                buf.len(),
+                0,
+                &mut addr as *mut SockaddrQrtr as *mut libc::sockaddr,
+                &mut len,
+            )
+        };
+        if ret < 0 {
+            let err = io::Error::last_os_error();
+            if err.kind() == io::ErrorKind::WouldBlock {
+                return Ok(None);
+            }
+            return Err(err);
+        }
+        Ok(Some((ret as usize, addr.node, addr.port)))
+    }
+
+    pub fn lookup(&self, service: u32) -> io::Result<()> {
+        self.send_to(self.node, PORT_CTRL, &lookup_packet(service))
+    }
+}
+
+pub fn lookup_packet(service: u32) -> Vec<u8> {
+    let mut pkt = Vec::with_capacity(20);
+    for value in [TYPE_NEW_LOOKUP, service, 0, 0, 0] {
+        pkt.extend_from_slice(&value.to_le_bytes());
+    }
+    pkt
+}
+
+pub fn parse_ctrl(buf: &[u8]) -> Option<(u32, Server)> {
+    let buf = buf.get(..20)?;
+    let word = |i: usize| u32::from_le_bytes([buf[i], buf[i + 1], buf[i + 2], buf[i + 3]]);
+    Some((
+        word(0),
+        Server {
+            service: word(4),
+            instance: word(8),
+            node: word(12),
+            port: word(16),
+        },
+    ))
+}
