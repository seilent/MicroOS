+            let (kind, msg_id, _, data) = report(buf);
+            assert_eq!(kind, qmi::TYPE_INDICATION);
+            assert_eq!(msg_id, qmi::SSC_REPORT_LARGE);
+            let (from, bodies) = parse_report(data.unwrap()).unwrap();
+            assert_eq!(from, SUID_UID);
+            assert_eq!(bodies.len(), 1);
+            assert_eq!(bodies[0].0, MSG_CONFIG_EVENT);
+            assert_eq!(parse_suid(bodies[0].1), Some((sensor, Some(uid))));
