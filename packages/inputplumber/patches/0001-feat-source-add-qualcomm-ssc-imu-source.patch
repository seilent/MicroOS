+pub mod imu;
+mod sleep;
+
+use std::error::Error;
+
+use glob_match::glob_match;
+
+use crate::{
+    config,
+    constants::BUS_SOURCES_PREFIX,
+    input::{
+        capability::Capability, composite_device::client::CompositeDeviceClient,
+        info::DeviceInfoRef, output_capability::OutputCapability,
+    },
+    udev::device::UdevDevice,
+};
+
+use self::imu::SscImu;
+
+use super::{InputError, OutputError, SourceDeviceCompatible, SourceDriver};
+
+const ANCHOR_DEVICES: &str = "fastrpc-*dsp";
+
+#[derive(Debug)]
+pub enum SscDevice {
+    Imu(SourceDriver<SscImu>),
+}
+
+impl SourceDeviceCompatible for SscDevice {
+    fn get_device_ref(&self) -> DeviceInfoRef<'_> {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.info_ref(),
+        }
+    }
+
+    fn get_id(&self) -> String {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.get_id(),
+        }
+    }
+
+    fn client(&self) -> super::client::SourceDeviceClient {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.client(),
+        }
+    }
+
+    async fn run(self) -> Result<(), Box<dyn Error>> {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.run().await,
+        }
+    }
+
+    fn get_capabilities(&self) -> Result<Vec<Capability>, InputError> {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.get_capabilities(),
+        }
+    }
+
+    fn get_output_capabilities(&self) -> Result<Vec<OutputCapability>, OutputError> {
+        Ok(vec![])
+    }
+
+    fn get_device_path(&self) -> String {
+        match self {
+            SscDevice::Imu(source_driver) => source_driver.get_device_path(),
+        }
+    }
+}
+
+impl SscDevice {
+    pub fn new(
+        device_info: UdevDevice,
+        composite_device: CompositeDeviceClient,
+        conf: Option<config::SourceDevice>,
+    ) -> Result<Self, Box<dyn Error + Send + Sync>> {
+        let device = SscImu::new(conf.as_ref());
+        let source_device = SourceDriver::new(composite_device, device, device_info.into(), conf);
+        Ok(Self::Imu(source_device))
+    }
+}
+
+pub fn is_anchor_device(sysname: &str) -> bool {
+    glob_match(ANCHOR_DEVICES, sysname)
+}
+
+pub fn get_dbus_path(id: String) -> String {
+    let name = id.replace([':', '-', '.'], "_");
+    format!("{}/{}", BUS_SOURCES_PREFIX, name)
+}
diff --git a/src/input/source/ssc/imu.rs b/src/input/source/ssc/imu.rs
new file mode 100644
index 0000000..af0358e
--- /dev/null
+++ b/src/input/source/ssc/imu.rs
@@ -0,0 +1,133 @@
+use std::{
+    collections::HashSet,
+    fmt::Debug,
+    thread,
+    time::{Duration, Instant},
+};
+
+use tokio::{
+    runtime::Handle,
+    sync::mpsc::{self, error::TryRecvError},
+    task::JoinHandle,
+};
+
+use crate::{
+    config,
+    drivers::ssc::driver::{Backoff, Driver},
+    input::{
+        capability::Capability,
+        event::native::NativeEvent,
+        source::{
+            iio::common::{
+                corrections_from_config, mount_matrix_from_config, sample_rate_from_config,
+                translate_events, CAPABILITIES,
+            },
+            InputError, SourceInputDevice, SourceOutputDevice,
+        },
+    },
+};
+
+use super::sleep::{self, SleepEvent};
+
+const IDLE_POLL: Duration = Duration::from_millis(50);
+
+pub struct SscImu {
+    driver: Driver,
+    accel_correction: f64,
+    gyro_correction: f64,
+    runtime: Handle,
+    sleep_rx: mpsc::UnboundedReceiver<SleepEvent>,
+    sleep_task: JoinHandle<()>,
+    sleep_watching: bool,
+    sleep_backoff: Backoff,
+}
+
+impl SscImu {
+    pub fn new(conf: Option<&config::SourceDevice>) -> Self {
+        let mount_matrix = mount_matrix_from_config(conf);
+        let sample_rate = sample_rate_from_config(conf);
+        let (accel_correction, gyro_correction) = corrections_from_config(conf);
+        let driver = Driver::new(mount_matrix, sample_rate);
+        let runtime = Handle::current();
+        let (sleep_rx, sleep_task) = sleep::watch(&runtime);
+        Self {
+            driver,
+            accel_correction,
+            gyro_correction,
+            runtime,
+            sleep_rx,
+            sleep_task,
+            sleep_watching: true,
+            sleep_backoff: Backoff::new(Instant::now()),
+        }
+    }
+
+    fn handle_sleep(&mut self) {
+        loop {
+            match self.sleep_rx.try_recv() {
+                Ok(SleepEvent::Sleep(lock)) => {
+                    self.sleep_backoff.reset();
+                    self.driver.suspend();
+                    drop(lock);
+                }
+                Ok(SleepEvent::Wake) => {
+                    self.sleep_backoff.reset();
+                    self.driver.resume();
+                }
+                Err(TryRecvError::Empty) => return,
+                Err(TryRecvError::Disconnected) => break,
+            }
+        }
+
+        let now = Instant::now();
+        if self.sleep_watching {
+            self.sleep_watching = false;
+            self.driver.resume();
+            let delay = self.sleep_backoff.fail(now);
+            log::warn!("System suspend watch ended, restarting in {delay:?}");
+            return;
+        }
+        if self.sleep_backoff.ready(now) {
+            (self.sleep_rx, self.sleep_task) = sleep::watch(&self.runtime);
+            self.sleep_watching = true;
+        }
+    }
+}
+
+impl Drop for SscImu {
+    fn drop(&mut self) {
+        self.sleep_task.abort();
+    }
+}
+
+impl SourceInputDevice for SscImu {
+    fn poll(&mut self) -> Result<Vec<NativeEvent>, InputError> {
+        self.handle_sleep();
+        let events = self.driver.poll().map_err(|e| e.to_string())?;
+        if !self.driver.streaming() {
+            thread::sleep(IDLE_POLL);
+        }
+        Ok(translate_events(
+            events,
+            self.accel_correction,
+            self.gyro_correction,
+        ))
+    }
+
+    fn get_capabilities(&self) -> Result<Vec<Capability>, InputError> {
+        Ok(CAPABILITIES.into())
+    }
+
+    fn update_event_filter(&mut self, events: HashSet<Capability>) -> Result<(), InputError> {
+        self.driver.update_filtered_events(events);
+        Ok(())
+    }
+}
+
+impl SourceOutputDevice for SscImu {}
+
+impl Debug for SscImu {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SscImu").finish()
+    }
+}
