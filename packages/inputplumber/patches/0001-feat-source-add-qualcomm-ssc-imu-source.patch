new file mode 100644
index 0000000..c9f0553
--- /dev/null
+++ b/src/input/source/ssc/sleep.rs
@@ -0,0 +1,67 @@
+use futures::StreamExt;
+use tokio::{runtime::Handle, sync::mpsc, task::JoinHandle};
+use zbus::{proxy, zvariant::OwnedFd, Connection};
+
+#[proxy(
+    interface = "org.freedesktop.login1.Manager",
+    default_service = "org.freedesktop.login1",
+    default_path = "/org/freedesktop/login1"
+)]
+trait Login1Manager {
+    fn inhibit(&self, what: &str, who: &str, why: &str, mode: &str) -> zbus::Result<OwnedFd>;
+
+    #[zbus(signal)]
+    fn prepare_for_sleep(&self, start: bool) -> zbus::Result<()>;
+}
+
+pub enum SleepEvent {
+    Sleep(Option<OwnedFd>),
+    Wake,
+}
+
+pub fn watch(runtime: &Handle) -> (mpsc::UnboundedReceiver<SleepEvent>, JoinHandle<()>) {
+    let (tx, rx) = mpsc::unbounded_channel();
+    let task = runtime.spawn(async move {
+        if let Err(e) = run(tx).await {
+            log::warn!("Failed to watch for system suspend: {e}");
+        }
+    });
+    (rx, task)
+}
+
+async fn run(tx: mpsc::UnboundedSender<SleepEvent>) -> zbus::Result<()> {
+    let conn = Connection::system().await?;
+    let manager = Login1ManagerProxy::new(&conn).await?;
+    let mut signals = manager.receive_prepare_for_sleep().await?;
+    let mut lock = inhibit(&manager).await;
+    while let Some(signal) = signals.next().await {
+        let event = if signal.args()?.start {
+            SleepEvent::Sleep(lock.take())
+        } else {
+            lock = inhibit(&manager).await;
+            SleepEvent::Wake
+        };
+        if tx.send(event).is_err() {
+            break;
+        }
+    }
+    Ok(())
+}
+
+async fn inhibit(manager: &Login1ManagerProxy<'_>) -> Option<OwnedFd> {
+    let lock = manager
+        .inhibit(
+            "sleep",
+            "InputPlumber",
+            "Disable SSC sensors before suspend",
+            "delay",
+        )
+        .await;
+    match lock {
+        Ok(lock) => Some(lock),
+        Err(e) => {
+            log::warn!("Failed to take a sleep delay lock for SSC sensors: {e}");
+            None
+        }
+    }
+}
