+    }
+
+    #[test]
+    fn fixture_config_events() {
+        let (_, _, _, data) = report(CONFIG_EVENT_ACCEL);
+        let (uid, bodies) = parse_report(data.unwrap()).unwrap();
+        assert_eq!(uid, UID_ACCEL);
+        assert_eq!(bodies[0].0, MSG_CONFIG_EVENT);
+        assert_eq!(protobuf::floats(bodies[0].1, 1).next(), Some(400.0));
+
+        let (_, _, _, data) = report(EVENT_1022_ACCEL);
+        let (uid, bodies) = parse_report(data.unwrap()).unwrap();
+        assert_eq!(uid, UID_ACCEL);
+        assert_eq!(bodies.len(), 1);
+        assert_eq!(bodies[0].0, 1022);
+    }
