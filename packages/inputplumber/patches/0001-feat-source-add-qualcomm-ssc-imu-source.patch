+    #[test]
+    fn fixture_suid_events() {
+        for (buf, sensor, uid) in [
+            (SUID_EVENT_ACCEL, Sensor::Accel, UID_ACCEL),
+            (SUID_EVENT_GYRO, Sensor::Gyro, UID_GYRO),
