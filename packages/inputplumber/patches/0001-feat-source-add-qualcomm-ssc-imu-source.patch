@@ -0,0 +1,178 @@
+#[derive(Debug, Clone, Copy)]
+pub enum Value<'a> {
+    Varint(u64),
+    Fixed64(u64),
+    Bytes(&'a [u8]),
+    Fixed32(u32),
+}
+
+pub fn put_varint(buf: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let byte = (value & 0x7f) as u8;
+        value >>= 7;
+        if value == 0 {
+            buf.push(byte);
+            return;
+        }
+        buf.push(byte | 0x80);
+    }
+}
+
+fn put_key(buf: &mut Vec<u8>, field: u32, wire_type: u8) {
+    put_varint(buf, ((field as u64) << 3) | wire_type as u64);
+}
+
+pub fn put_uint(buf: &mut Vec<u8>, field: u32, value: u64) {
+    put_key(buf, field, 0);
+    put_varint(buf, value);
+}
+
+pub fn put_fixed64(buf: &mut Vec<u8>, field: u32, value: u64) {
+    put_key(buf, field, 1);
+    buf.extend_from_slice(&value.to_le_bytes());
+}
+
+pub fn put_bytes(buf: &mut Vec<u8>, field: u32, value: &[u8]) {
+    put_key(buf, field, 2);
+    put_varint(buf, value.len() as u64);
+    buf.extend_from_slice(value);
+}
+
+pub fn put_fixed32(buf: &mut Vec<u8>, field: u32, value: u32) {
+    put_key(buf, field, 5);
+    buf.extend_from_slice(&value.to_le_bytes());
+}
+
+pub fn put_float(buf: &mut Vec<u8>, field: u32, value: f32) {
+    put_fixed32(buf, field, value.to_bits());
+}
+
+fn read_varint(buf: &[u8], pos: &mut usize) -> Option<u64> {
+    let mut value = 0u64;
+    for shift in (0..64).step_by(7) {
+        let byte = *buf.get(*pos)?;
+        *pos += 1;
+        value |= ((byte & 0x7f) as u64) << shift;
+        if byte & 0x80 == 0 {
+            return Some(value);
+        }
+    }
+    None
+}
+
+fn read_slice<'a>(buf: &'a [u8], pos: &mut usize, len: usize) -> Option<&'a [u8]> {
+    let end = pos.checked_add(len)?;
+    let slice = buf.get(*pos..end)?;
+    *pos = end;
+    Some(slice)
+}
+
+pub struct Fields<'a> {
+    buf: &'a [u8],
+    pos: usize,
+}
+
+impl<'a> Iterator for Fields<'a> {
+    type Item = (u32, Value<'a>);
+
+    fn next(&mut self) -> Option<Self::Item> {
+        if self.pos >= self.buf.len() {
+            return None;
+        }
+        let field = self.read_field();
+        if field.is_none() {
+            self.pos = self.buf.len();
+        }
+        field
+    }
+}
+
+impl<'a> Fields<'a> {
+    fn read_field(&mut self) -> Option<(u32, Value<'a>)> {
+        let buf = self.buf;
+        let pos = &mut self.pos;
+        let key = read_varint(buf, pos)?;
+        let field = (key >> 3) as u32;
+        let value = match key & 0x7 {
+            0 => Value::Varint(read_varint(buf, pos)?),
+            1 => {
+                let bytes = read_slice(buf, pos, 8)?;
+                Value::Fixed64(u64::from_le_bytes(bytes.try_into().ok()?))
+            }
+            2 => {
+                let len = read_varint(buf, pos)? as usize;
+                Value::Bytes(read_slice(buf, pos, len)?)
+            }
+            5 => {
+                let bytes = read_slice(buf, pos, 4)?;
+                Value::Fixed32(u32::from_le_bytes(bytes.try_into().ok()?))
+            }
+            _ => return None,
+        };
+        Some((field, value))
+    }
+}
+
+pub fn fields(buf: &[u8]) -> Fields<'_> {
+    Fields { buf, pos: 0 }
+}
+
+pub fn floats(buf: &[u8], field: u32) -> impl Iterator<Item = f32> + '_ {
+    fields(buf)
+        .filter(move |(id, _)| *id == field)
+        .flat_map(|(_, value)| {
+            let single = match value {
+                Value::Fixed32(bits) => Some(f32::from_bits(bits)),
+                _ => None,
+            };
+            let packed: &[u8] = match value {
+                Value::Bytes(packed) => packed,
+                _ => &[],
+            };
+            single.into_iter().chain(
+                packed
+                    .chunks_exact(4)
+                    .map(|chunk| f32::from_le_bytes([chunk[0], chunk[1], chunk[2], chunk[3]])),
+            )
+        })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn round_trip() {
+        let mut buf = Vec::new();
+        put_fixed64(&mut buf, 1, 0xABABABABABABABAB);
+        put_fixed32(&mut buf, 2, 513);
+        put_uint(&mut buf, 3, 300);
+        put_bytes(&mut buf, 4, b"accel");
+        put_float(&mut buf, 5, 9.81);
+        let fields: Vec<_> = fields(&buf).collect();
+        assert_eq!(fields.len(), 5);
+        assert!(matches!(fields[0], (1, Value::Fixed64(0xABABABABABABABAB))));
+        assert!(matches!(fields[1], (2, Value::Fixed32(513))));
+        assert!(matches!(fields[2], (3, Value::Varint(300))));
+        assert!(matches!(fields[3], (4, Value::Bytes(b"accel"))));
+        assert_eq!(floats(&buf, 5).collect::<Vec<_>>(), vec![9.81]);
+    }
+
+    #[test]
+    fn packed_floats() {
+        let mut packed = Vec::new();
+        for value in [1.0f32, -2.5, 9.81] {
+            packed.extend_from_slice(&value.to_le_bytes());
+        }
+        let mut buf = Vec::new();
+        put_bytes(&mut buf, 1, &packed);
+        assert_eq!(floats(&buf, 1).collect::<Vec<_>>(), vec![1.0, -2.5, 9.81]);
+    }
+
+    #[test]
+    fn truncated() {
+        assert_eq!(fields(&[0x0a, 0x05, 0x01]).count(), 0);
+        assert_eq!(fields(&[0x09, 0x01]).count(), 0);
+        assert_eq!(fields(&[0x08, 0x01, 0x09, 0x01]).count(), 1);
+    }
+}
