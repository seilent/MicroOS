             // Only consider evdev mappings
             for event in mapping.source_events.iter() {
                 let Some(evdev_event) = event.evdev.as_ref() else {
@@ -134,6 +269,10 @@ impl EventTranslator {
             }
         }
 
+        if !stick_pairs.is_empty() {
+            translatable_events.insert(SYN_REPORT);
+        }
+
         Self {
             abs_info,
             chord_mappings,
@@ -144,6 +283,8 @@ impl EventTranslator {
             translatable_active_inputs: HashSet::new(),
             translatable_active_inputs_used: HashSet::new(),
             scheduled_events: Vec::new(),
+            stick_pairs,
+            stick_axes,
         }
     }
 
@@ -185,6 +326,10 @@ impl EventTranslator {
             return vec![];
         }
 
+        if event_signature == SYN_REPORT && !self.stick_pairs.is_empty() {
+            return self.translate_stick_pairs();
+        }
+
         // Check if this event is part of a chord mapping
         if self.delayed_chord_mappings.contains_key(&event_signature)
             && !event.is_pressed()
@@ -203,6 +348,8 @@ impl EventTranslator {
                 .unwrap_or_default();
         }
 
+        self.update_stick_pairs(event_signature, event);
+
         // Check if this event is part of a multi_source mapping
         if self.multi_source_mappings.contains_key(&event_signature) {
             return self.translate_multi_source(event);
@@ -211,6 +358,54 @@ impl EventTranslator {
         vec![]
     }
 
+    fn update_stick_pairs(&mut self, event_signature: EventSignature, event: &InputEvent) {
+        let Some(axes) = self.stick_axes.get(&event_signature) else {
+            return;
+        };
+        let Some(info) = self.abs_info.get(&evdev::AbsoluteAxisCode(event.code())) else {
+            return;
+        };
+        let value = normalize_signed_value(event.value(), info.minimum(), info.maximum());
+        for (index, axis) in axes.iter() {
+            let pair = &mut self.stick_pairs[*index];
+            match axis {
+                StickAxis::X => pair.x = value,
+                StickAxis::Y => pair.y = value,
+            }
+            pair.pending = true;
+        }
+    }
+
+    fn translate_stick_pairs(&mut self) -> Vec<NativeEvent> {
+        let mut events = vec![];
+        for pair in self.stick_pairs.iter_mut().filter(|pair| pair.pending) {
+            pair.pending = false;
+            let distance = pair.x.hypot(pair.y);
+            pair.outside = if pair.outside {
+                distance > pair.zone
+            } else {
+                distance > pair.zone + pair.band
+            };
+            let value = if pair.outside {
+                (pair.x, pair.y)
+            } else {
+                (0.0, 0.0)
+            };
+            if value == pair.emitted {
+                continue;
+            }
+            pair.emitted = value;
+            events.push(NativeEvent::new(
+                pair.capability.clone(),
+                InputValue::Vector2 {
+                    x: Some(value.0),
+                    y: Some(value.1),
+                },
+            ));
+        }
+        events
+    }
+
     /// Translate the given evdev event into a single native inputplumber event
     fn translate_multi_source(&mut self, event: &InputEvent) -> Vec<NativeEvent> {
         let event_signature = (event.event_type().0, event.code());
@@ -529,3 +724,707 @@ impl Pressable for InputEvent {
         self.value() != 0
     }
 }
