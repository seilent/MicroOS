+#[cfg(test)]
+mod tests {
+    use evdev::{
+        AbsInfo, AbsoluteAxisCode, EventType, InputEvent, KeyCode, RelativeAxisCode,
+        SynchronizationCode,
+    };
+
+    use crate::{
+        config::capability_map::CapabilityMapConfigV2,
+        input::{
+            capability::{Capability, Gamepad, GamepadAxis, GamepadButton, GamepadTrigger, Source},
+            event::{native::NativeEvent, value::InputValue},
+        },
+    };
+
+    use super::EventTranslator;
+
+    const HALF: f64 = 32767.0;
+    const LEFT: Capability = Capability::Gamepad(Gamepad::Axis(GamepadAxis::LeftStick));
+    const RIGHT: Capability = Capability::Gamepad(Gamepad::Axis(GamepadAxis::RightStick));
+    const SYN: (u16, u16, i32) = (
+        EventType::SYNCHRONIZATION.0,
+        SynchronizationCode::SYN_REPORT.0,
+        0,
+    );
+
+    const LEFT_STICK: &str = "
+  - name: Left stick
+    source_events:
+      - evdev: {event_type: ABS, event_code: ABS_X, value_type: joystick_x}
+      - evdev: {event_type: ABS, event_code: ABS_Y, value_type: joystick_y}
+    target_event: {gamepad: {axis: {name: LeftStick}}}
+";
+
+    const RIGHT_STICK: &str = "
+  - name: Right stick
+    source_events:
+      - evdev: {event_type: ABS, event_code: ABS_Z, value_type: joystick_x}
+      - evdev: {event_type: ABS, event_code: ABS_RZ, value_type: joystick_y}
+    target_event: {gamepad: {axis: {name: RightStick}}}
+";
+
+    type Stick = (Capability, Option<f64>, Option<f64>);
+
+    const NOTHING: Vec<Stick> = Vec::new();
+
+    fn axis(value: i32) -> AbsInfo {
+        AbsInfo::new(value, -32768, 32767, 255, 4095, 0)
+    }
+
+    fn translator(mapping: &str, abs_info: &[(AbsoluteAxisCode, AbsInfo)]) -> EventTranslator {
+        let map: CapabilityMapConfigV2 = serde_yaml::from_str(&format!(
+            "version: 2\nkind: CapabilityMap\nname: Test\nid: test\nmapping:\n{mapping}"
+        ))
+        .unwrap();
+        EventTranslator::new(&map, abs_info.iter().copied().collect())
+    }
+
+    fn pm2() -> EventTranslator {
+        translator(
+            &[LEFT_STICK, RIGHT_STICK].concat(),
+            &[
+                (AbsoluteAxisCode::ABS_X, axis(0)),
+                (AbsoluteAxisCode::ABS_Y, axis(0)),
+                (AbsoluteAxisCode::ABS_Z, axis(0)),
+                (AbsoluteAxisCode::ABS_RZ, axis(0)),
+            ],
+        )
+    }
+
+    fn abs(code: AbsoluteAxisCode, value: i32) -> (u16, u16, i32) {
+        (EventType::ABSOLUTE.0, code.0, value)
+    }
+
+    fn feed(translator: &mut EventTranslator, events: &[(u16, u16, i32)]) -> Vec<NativeEvent> {
+        let mut out = vec![];
+        for (kind, code, value) in events.iter().copied() {
+            let event = InputEvent::new(kind, code, value);
+            if translator.has_translation(&event) {
+                out.extend(translator.translate(&event));
+            }
+        }
+        out
+    }
+
+    fn sticks(events: &[NativeEvent]) -> Vec<Stick> {
+        events
+            .iter()
+            .map(|event| match event.get_value() {
+                InputValue::Vector2 { x, y } => (event.as_capability(), x, y),
+                value => panic!("not a stick value: {value:?}"),
+            })
+            .collect()
+    }
+
+    fn right(translator: &mut EventTranslator, x: i32, y: i32) -> Vec<Stick> {
+        sticks(&feed(
+            translator,
+            &[
+                abs(AbsoluteAxisCode::ABS_Z, x),
+                abs(AbsoluteAxisCode::ABS_RZ, y),
+                SYN,
+            ],
+        ))
+    }
+
+    fn syn_report_translated(translator: &EventTranslator) -> bool {
+        translator.has_translation(&InputEvent::new(SYN.0, SYN.1, SYN.2))
+    }
+
+    fn single(events: Vec<NativeEvent>) -> (Capability, InputValue) {
+        assert_eq!(events.len(), 1, "{events:?}");
+        (events[0].as_capability(), events[0].get_value())
+    }
+
+    #[test]
+    fn rest_reports_emit_nothing() {
+        let mut t = pm2();
+        for (x, y) in [(754, 2978), (600, 3200), (0, 0)] {
+            assert_eq!(right(&mut t, x, y), NOTHING);
+        }
+    }
+
+    #[test]
+    fn a_pair_starts_inside() {
+        let mut t = pm2();
+        assert_eq!(right(&mut t, 4300, 0), NOTHING);
+    }
+
+    #[test]
+    fn leaves_above_flat_plus_twice_fuzz_and_returns_at_flat() {
+        let mut t = pm2();
+        assert_eq!(right(&mut t, 4094, 0), NOTHING);
+        assert_eq!(right(&mut t, 4604, 0), NOTHING);
+        assert_eq!(
+            right(&mut t, 4606, 0),
+            vec![(RIGHT, Some(4606.0 / HALF), Some(0.0))]
+        );
+        assert_eq!(
+            right(&mut t, 4096, 0),
+            vec![(RIGHT, Some(4096.0 / HALF), Some(0.0))]
+        );
+        assert_eq!(right(&mut t, 4094, 0), vec![(RIGHT, Some(0.0), Some(0.0))]);
+        assert_eq!(right(&mut t, 4093, 0), NOTHING);
+        assert_eq!(right(&mut t, 4600, 0), NOTHING);
+    }
+
