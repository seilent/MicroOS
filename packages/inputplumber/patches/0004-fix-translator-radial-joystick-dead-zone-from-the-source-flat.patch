         for mapping in capability_map.mapping.iter() {
@@ -74,6 +197,18 @@ impl EventTranslator {
                 .and_then(|t| t.evdev)
                 .unwrap_or_default();
 
+            if let Some((pair, axes)) = StickPair::new(mapping, &mapping_type, &abs_info) {
+                for (signature, axis) in axes {
