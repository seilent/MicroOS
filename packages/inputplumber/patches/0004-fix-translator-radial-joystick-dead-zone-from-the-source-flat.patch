From: seilent <github@seilent.net>
Date: Fri, 30 Oct 2026 04:52:03 +0900
Subject: [PATCH] fix(translator): radial joystick dead zone from the source
 axis flat

---
 src/input/event/evdev/translator.rs | 899 ++++++++++++++++++++++++++++
 1 file changed, 899 insertions(+)

diff --git a/src/input/event/evdev/translator.rs b/src/input/event/evdev/translator.rs
index dc70e6b..218b4cc 100644
--- a/src/input/event/evdev/translator.rs
+++ b/src/input/event/evdev/translator.rs
@@ -25,6 +25,125 @@ type EventType = u16;
 type EventCode = u16;
 type EventSignature = (EventType, EventCode);
 
+const SYN_REPORT: EventSignature = (
+    evdev::EventType::SYNCHRONIZATION.0,
+    evdev::SynchronizationCode::SYN_REPORT.0,
+);
+
+#[derive(Debug, Clone, Copy)]
+enum StickAxis {
+    X,
+    Y,
+}
+
+#[derive(Debug)]
+struct StickPair {
+    capability: Capability,
+    zone: f64,
+    band: f64,
+    x: f64,
+    y: f64,
+    pending: bool,
+    outside: bool,
+    emitted: (f64, f64),
+}
+
+impl StickPair {
+    fn new(
+        mapping: &CapabilityMapping,
+        mapping_type: &EvdevMappingType,
+        abs_info: &HashMap<evdev::AbsoluteAxisCode, AbsInfo>,
+    ) -> Option<(Self, [(EventSignature, StickAxis); 2])> {
+        if *mapping_type != EvdevMappingType::MultiSource {
+            return None;
+        }
+        let [first, second] = mapping.source_events.as_slice() else {
+            return None;
+        };
+        let (Some(first), Some(second)) = (first.evdev.as_ref(), second.evdev.as_ref()) else {
+            return None;
+        };
+        let (x, y) = match (&first.value_type, &second.value_type) {
+            (ValueType::JoystickX, ValueType::JoystickY) => (first, second),
+            (ValueType::JoystickY, ValueType::JoystickX) => (second, first),
+            _ => return None,
+        };
+        let abs = evdev::EventType::ABSOLUTE.0;
+        let x_code = x.event_code.as_u16();
+        let y_code = y.event_code.as_u16();
+        if x.event_type.as_u16() != abs
+            || y.event_type.as_u16() != abs
+            || x.axis_direction.is_some()
+            || y.axis_direction.is_some()
+            || x_code == y_code
+        {
+            return None;
+        }
+        let capability: Capability = mapping.target_event.clone().into();
+        if capability == Capability::NotImplemented {
+            return None;
+        }
+
+        let x_info = abs_info.get(&evdev::AbsoluteAxisCode(x_code));
+        let y_info = abs_info.get(&evdev::AbsoluteAxisCode(y_code));
+        let (Some(x_info), Some(y_info)) = (x_info, y_info) else {
+            let level = if abs_info.is_empty() {
+                log::Level::Debug
+            } else {
+                log::Level::Warn
+            };
+            log::log!(
+                level,
+                "No ABS info for stick mapping '{}', no dead zone",
+                mapping.name
+            );
+            return None;
+        };
+        let (Some(x_half), Some(y_half)) = (half_range(x_info), half_range(y_info)) else {
+            log::warn!(
+                "Empty ABS range on stick mapping '{}', no dead zone",
+                mapping.name
+            );
+            return None;
+        };
+        let zone = (x_info.flat() as f64 / x_half).max(y_info.flat() as f64 / y_half);
+        if zone <= 0.0 {
+            return None;
+        }
+        let band = (2.0 * x_info.fuzz() as f64 / x_half)
+            .max(2.0 * y_info.fuzz() as f64 / y_half)
+            .max(0.0);
+        if zone + band >= 0.5 {
+            log::warn!(
+                "ABS flat plus twice the fuzz on stick mapping '{}' is not under half the travel from center, no dead zone",
+                mapping.name
+            );
+            return None;
+        }
+
+        let pair = Self {
+            capability,
+            zone,
+            band,
+            x: normalize_signed_value(x_info.value(), x_info.minimum(), x_info.maximum()),
+            y: normalize_signed_value(y_info.value(), y_info.minimum(), y_info.maximum()),
+            pending: false,
+            outside: false,
+            emitted: (0.0, 0.0),
+        };
+        Some((
+            pair,
+            [((abs, x_code), StickAxis::X), ((abs, y_code), StickAxis::Y)],
+        ))
+    }
+}
+
+fn half_range(info: &AbsInfo) -> Option<f64> {
+    let max = i64::from(info.maximum());
+    let half = max - (max + i64::from(info.minimum())) / 2;
+    (half > 0).then_some(half as f64)
+}
+
 /// Used to translate evdev events into native inputplumber events using a
 /// capability map.
 #[derive(Debug)]
@@ -50,6 +169,8 @@ pub struct EventTranslator {
     emitted_mappings: Vec<CapabilityMapping>,
     /// Events to emit during polling
