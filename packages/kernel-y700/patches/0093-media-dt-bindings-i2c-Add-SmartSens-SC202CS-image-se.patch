From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Thu, 19 Nov 2026 15:19:34 +0900
Subject: [PATCH] media: dt-bindings: i2c: Add SmartSens SC202CS image sensor

Describe the SmartSens SC202CS, a 2MP raw image sensor with a single
lane MIPI CSI-2 output: its MCLK input, the active low reset line and
the 2.8 V analogue and 1.8 V I/O supplies.

Signed-off-by: seilent <github@seilent.net>
---
 .../bindings/media/i2c/smartsens,sc202cs.yaml | 98 +++++++++++++++++++
 MAINTAINERS                                   |  7 ++
 2 files changed, 105 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/smartsens,sc202cs.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/smartsens,sc202cs.yaml b/Documentation/devicetree/bindings/media/i2c/smartsens,sc202cs.yaml
new file mode 100644
index 0000000..17fee18
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/smartsens,sc202cs.yaml
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/smartsens,sc202cs.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SmartSens SC202CS Image Sensor
+
+description:
+  The SmartSens SC202CS is a 2MP raw image sensor controlled over an I2C
+  compatible bus. It outputs 1600x1200 RAW10 frames over a single lane
+  MIPI CSI-2 D-PHY interface.
+
+maintainers:
+  - seilent <github@seilent.net>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: smartsens,sc202cs
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK input clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESETB pad of the sensor.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dovdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "smartsens,sc202cs";
+            reg = <0x36>;
+            clocks = <&camera_mclk 1>;
+            assigned-clocks = <&camera_mclk 1>;
+            assigned-clock-rates = <19200000>;
+            reset-gpios = <&gpio1 15 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&vreg_2p8>;
+            dovdd-supply = <&vreg_1p8>;
+            orientation = <1>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    data-lanes = <1>;
+                    link-frequencies = /bits/ 64 <360000000>;
+                    remote-endpoint = <&csiphy_ep>;
+                };
+            };
+        };
+    };
+...
