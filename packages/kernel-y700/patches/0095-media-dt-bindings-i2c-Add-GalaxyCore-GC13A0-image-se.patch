From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Thu, 19 Nov 2026 23:59:35 +0900
Subject: [PATCH] media: dt-bindings: i2c: Add GalaxyCore GC13A0 image sensor

Describe the GalaxyCore GC13A0, a 13MP raw image sensor with a four lane
MIPI CSI-2 output: its MCLK input, the active low reset line, the 2.8 V
analogue, 1.8 V I/O and 1.2 V core supplies, and the optional 2.8 V
supply of the autofocus actuator in the camera module.

Signed-off-by: seilent <github@seilent.net>
---
 .../bindings/media/i2c/galaxycore,gc13a0.yaml | 110 ++++++++++++++++++
 MAINTAINERS                                   |   7 ++
 2 files changed, 117 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/galaxycore,gc13a0.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/galaxycore,gc13a0.yaml b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc13a0.yaml
new file mode 100644
index 0000000..257da55
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc13a0.yaml
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/galaxycore,gc13a0.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GalaxyCore GC13A0 Image Sensor
+
+description:
+  The GalaxyCore GC13A0 is a 13MP raw image sensor controlled over an I2C
+  compatible bus. It outputs 4208x3120 RAW10 frames over a four lane MIPI
+  CSI-2 D-PHY interface.
+
+maintainers:
+  - seilent <github@seilent.net>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: galaxycore,gc13a0
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK input clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESETB pad of the sensor.
+    maxItems: 1
+
+  afvdd-supply:
+    description: Autofocus actuator voltage supply, 2.8 volts.
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  dvdd-supply:
+    description: Digital core voltage supply, 1.2 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dovdd-supply
+  - dvdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@11 {
+            compatible = "galaxycore,gc13a0";
+            reg = <0x11>;
+            clocks = <&camera_mclk 0>;
+            assigned-clocks = <&camera_mclk 0>;
+            assigned-clock-rates = <19200000>;
+            reset-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
+            afvdd-supply = <&vreg_af_2p8>;
+            avdd-supply = <&vreg_2p8>;
+            dovdd-supply = <&vreg_1p8>;
+            dvdd-supply = <&vreg_1p2>;
+            orientation = <1>;
+            rotation = <270>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <590400000>;
+                    remote-endpoint = <&csiphy_ep>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 9e4796b..13ba492 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
