From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Fri, 20 Nov 2026 04:37:04 +0900
Subject: [PATCH] media: dt-bindings: i2c: Add SmartSens SC820CS image sensor

Describe the SmartSens SC820CS, an 8MP raw image sensor with a four lane
MIPI CSI-2 output: its MCLK input, the active low reset line and the
2.8 V analogue, 1.8 V I/O and 1.2 V core supplies.

Signed-off-by: seilent <github@seilent.net>
---
 .../bindings/media/i2c/smartsens,sc820cs.yaml | 106 ++++++++++++++++++
 MAINTAINERS                                   |   7 ++
 2 files changed, 113 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/smartsens,sc820cs.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/smartsens,sc820cs.yaml b/Documentation/devicetree/bindings/media/i2c/smartsens,sc820cs.yaml
new file mode 100644
index 0000000..419aa01
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/smartsens,sc820cs.yaml
@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/smartsens,sc820cs.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SmartSens SC820CS Image Sensor
+
+description:
+  The SmartSens SC820CS is an 8MP raw image sensor controlled over an I2C
+  compatible bus. It outputs 3264x2448 RAW10 frames over a four lane MIPI
+  CSI-2 D-PHY interface.
+
+maintainers:
+  - seilent <github@seilent.net>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: smartsens,sc820cs
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK input clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to the RESETB pad of the sensor.
+    maxItems: 1
+
+  avdd-supply:
+    description: Analogue voltage supply, 2.8 volts.
+
+  dovdd-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  dvdd-supply:
+    description: Digital core voltage supply, 1.2 volts.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dovdd-supply
+  - dvdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "smartsens,sc820cs";
+            reg = <0x36>;
+            clocks = <&camera_mclk 3>;
+            assigned-clocks = <&camera_mclk 3>;
+            assigned-clock-rates = <19200000>;
+            reset-gpios = <&gpio1 109 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&vreg_2p8>;
+            dovdd-supply = <&vreg_1p8>;
+            dvdd-supply = <&vreg_1p2>;
+            orientation = <0>;
+            rotation = <90>;
+
+            port {
+                endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <364800000>;
+                    remote-endpoint = <&csiphy_ep>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index a022525..4704aeb 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -25964,6 +25964,13 @@ T:	git git://linuxtv.org/media.git
