 drivers/media/i2c/Kconfig   |  10 +
 drivers/media/i2c/Makefile  |   1 +
 drivers/media/i2c/sc820cs.c | 750 ++++++++++++++++++++++++++++++++++++
 4 files changed, 762 insertions(+)
 create mode 100644 drivers/media/i2c/sc820cs.c

