+static const struct cci_reg_sequence sc820cs_stream_on_regs[] = {
+	{ SC820CS_REG_CTRL_MODE, SC820CS_MODE_STREAMING },
+	{ CCI_REG8(0x302d), 0x00 },
+};
+
+struct sc820cs {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(sc820cs_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *exposure;
+};
+
+static inline struct sc820cs *to_sc820cs(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct sc820cs, sd);
+}
+
+static int sc820cs_set_gain(struct sc820cs *sc820cs, u32 gain)
+{
+	unsigned int coarse = ilog2(gain / SC820CS_GAIN_MIN);
+	int ret = 0;
+
+	cci_write(sc820cs->regmap, SC820CS_REG_COARSE_GAIN,
+		  sc820cs_coarse_gain[coarse], &ret);
+	cci_write(sc820cs->regmap, SC820CS_REG_FINE_GAIN, gain >> coarse, &ret);
+
+	return ret;
+}
+
+static int sc820cs_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc820cs *sc820cs = container_of(ctrl->handler, struct sc820cs,
+					       ctrl_handler);
+	u32 val;
+	int ret;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		s64 max = SC820CS_HEIGHT + ctrl->val - SC820CS_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(sc820cs->exposure,
+					       sc820cs->exposure->minimum, max,
+					       sc820cs->exposure->step,
+					       sc820cs->exposure->default_value);
+		if (ret)
+			return ret;
+	}
+
+	if (!pm_runtime_get_if_in_use(sc820cs->dev))
+		return 0;
+
+	ret = 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		val = SC820CS_HEIGHT + ctrl->val;
+		cci_write(sc820cs->regmap, SC820CS_REG_VTS_H, val >> 16, &ret);
+		cci_write(sc820cs->regmap, SC820CS_REG_VTS, val & 0xffff, &ret);
+		break;
+	case V4L2_CID_EXPOSURE:
+		val = ctrl->val * 2;
+		cci_write(sc820cs->regmap, SC820CS_REG_EXPOSURE_H, val >> 20,
+			  &ret);
+		cci_write(sc820cs->regmap, SC820CS_REG_EXPOSURE,
+			  (val << SC820CS_EXPOSURE_SHIFT) & GENMASK(23, 0),
+			  &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = sc820cs_set_gain(sc820cs, ctrl->val);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(sc820cs->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc820cs_ctrl_ops = {
+	.s_ctrl = sc820cs_set_ctrl,
+};
+
+static int sc820cs_init_controls(struct sc820cs *sc820cs)
+{
+	struct v4l2_ctrl_handler *hdl = &sc820cs->ctrl_handler;
+	const struct v4l2_ctrl_ops *ops = &sc820cs_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank = SC820CS_HTS - SC820CS_WIDTH;
+	u32 vblank = SC820CS_VTS - SC820CS_HEIGHT;
+	u32 exposure_max = SC820CS_VTS - SC820CS_EXPOSURE_MARGIN;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(sc820cs->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 8);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_PIXEL_RATE, SC820CS_PIXEL_RATE,
+			  SC820CS_PIXEL_RATE, 1, SC820CS_PIXEL_RATE);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, ops, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(sc820cs_link_freq_menu) - 1, 0,
+				      sc820cs_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	ctrl = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK, vblank,
+			  SC820CS_VTS_MAX - SC820CS_HEIGHT, 1, vblank);
+
+	sc820cs->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					      SC820CS_EXPOSURE_MIN, exposure_max,
+					      1, exposure_max);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, SC820CS_GAIN_MIN,
+			  SC820CS_GAIN_MAX, 1, SC820CS_GAIN_MIN);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return dev_err_probe(sc820cs->dev, ret,
+				     "failed to init controls\n");
+	}
+
+	sc820cs->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static void sc820cs_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = SC820CS_MBUS_CODE;
+	fmt->width = SC820CS_WIDTH;
+	fmt->height = SC820CS_HEIGHT;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int sc820cs_enum_mbus_code(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+
+	code->code = SC820CS_MBUS_CODE;
+
+	return 0;
+}
+
+static int sc820cs_enum_frame_size(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state,
+				   struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index || fse->code != SC820CS_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = SC820CS_WIDTH;
+	fse->max_width = SC820CS_WIDTH;
+	fse->min_height = SC820CS_HEIGHT;
+	fse->max_height = SC820CS_HEIGHT;
+
+	return 0;
+}
+
+static int sc820cs_set_fmt(struct v4l2_subdev *sd,
+			   const struct v4l2_subdev_client_info *ci,
+			   struct v4l2_subdev_state *state,
+			   struct v4l2_subdev_format *fmt)
+{
+	sc820cs_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int sc820cs_get_selection(struct v4l2_subdev *sd,
+				 const struct v4l2_subdev_client_info *ci,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = SC820CS_WIDTH;
+		sel->r.height = SC820CS_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int sc820cs_init_state(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_state *state)
+{
+	sc820cs_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
+
+static int sc820cs_enable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc820cs *sc820cs = to_sc820cs(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sc820cs->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(sc820cs->regmap, sc820cs_mode_regs,
+				  ARRAY_SIZE(sc820cs_mode_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(sd->ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(sc820cs->regmap, sc820cs_stream_on_regs,
+				  ARRAY_SIZE(sc820cs_stream_on_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	return 0;
+
+err_rpm_put:
+	pm_runtime_put(sc820cs->dev);
+
+	return ret;
+}
+
+static int sc820cs_disable_streams(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_state *state, u32 pad,
+				   u64 streams_mask)
+{
+	struct sc820cs *sc820cs = to_sc820cs(sd);
+	int ret;
+
+	ret = cci_write(sc820cs->regmap, SC820CS_REG_CTRL_MODE, 0, NULL);
+	if (ret)
+		dev_err(sc820cs->dev, "failed to stop streaming: %d\n", ret);
+
+	pm_runtime_put(sc820cs->dev);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops sc820cs_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops sc820cs_pad_ops = {
+	.enum_mbus_code = sc820cs_enum_mbus_code,
+	.enum_frame_size = sc820cs_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = sc820cs_set_fmt,
+	.get_selection = sc820cs_get_selection,
+	.enable_streams = sc820cs_enable_streams,
+	.disable_streams = sc820cs_disable_streams,
+};
+
+static const struct v4l2_subdev_ops sc820cs_subdev_ops = {
+	.video = &sc820cs_video_ops,
+	.pad = &sc820cs_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops sc820cs_internal_ops = {
+	.init_state = sc820cs_init_state,
+};
+
+static int sc820cs_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc820cs *sc820cs = to_sc820cs(sd);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(sc820cs->supplies); i++) {
+		ret = regulator_enable(sc820cs->supplies[i].consumer);
+		if (ret)
+			goto err_supplies;
+
+		fsleep(1000);
+	}
+
+	fsleep(1000);
+
+	gpiod_set_value_cansleep(sc820cs->reset_gpio, 0);
+	fsleep(5000);
+
+	ret = clk_prepare_enable(sc820cs->mclk);
+	if (ret)
+		goto err_reset;
+
+	fsleep(5000);
+
+	return 0;
+
+err_reset:
+	gpiod_set_value_cansleep(sc820cs->reset_gpio, 1);
+err_supplies:
+	while (i--)
+		regulator_disable(sc820cs->supplies[i].consumer);
+
+	return ret;
+}
+
+static int sc820cs_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc820cs *sc820cs = to_sc820cs(sd);
+	unsigned int i = ARRAY_SIZE(sc820cs->supplies);
+
+	clk_disable_unprepare(sc820cs->mclk);
+	fsleep(1000);
+
+	gpiod_set_value_cansleep(sc820cs->reset_gpio, 1);
+	fsleep(1000);
+
+	while (i--) {
+		regulator_disable(sc820cs->supplies[i].consumer);
+		fsleep(1000);
+	}
+
+	return 0;
+}
+
+static int sc820cs_identify(struct sc820cs *sc820cs)
+{
+	u64 id;
+	int ret;
+
+	ret = cci_read(sc820cs->regmap, SC820CS_REG_CHIP_ID, &id, NULL);
+	if (ret)
+		return dev_err_probe(sc820cs->dev, ret,
+				     "failed to read chip id\n");
+
+	if (id != SC820CS_CHIP_ID)
+		return dev_err_probe(sc820cs->dev, -ENODEV,
+				     "unexpected chip id 0x%04llx\n", id);
+
+	return 0;
+}
+
+static int sc820cs_parse_endpoint(struct sc820cs *sc820cs)
+{
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	unsigned long link_freq_bitmap;
+	struct fwnode_handle *ep;
+	int ret;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(sc820cs->dev), 0, 0, 0);
+	if (!ep)
+		return dev_err_probe(sc820cs->dev, -ENXIO,
+				     "missing endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(sc820cs->dev, ret,
+				     "failed to parse endpoint\n");
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != SC820CS_DATA_LANES) {
+		ret = dev_err_probe(sc820cs->dev, -EINVAL,
+				    "only %d data lanes are supported\n",
+				    SC820CS_DATA_LANES);
+		goto out;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(sc820cs->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       sc820cs_link_freq_menu,
+				       ARRAY_SIZE(sc820cs_link_freq_menu),
+				       &link_freq_bitmap);
+
+out:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+static int sc820cs_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct sc820cs *sc820cs;
+	unsigned long freq;
+	int ret;
+
+	sc820cs = devm_kzalloc_obj(dev, *sc820cs);
+	if (!sc820cs)
+		return -ENOMEM;
+
+	sc820cs->dev = dev;
+	v4l2_i2c_subdev_init(&sc820cs->sd, client, &sc820cs_subdev_ops);
+
+	sc820cs->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc820cs->regmap))
+		return dev_err_probe(dev, PTR_ERR(sc820cs->regmap),
+				     "failed to init CCI\n");
+
+	sc820cs->mclk = devm_v4l2_sensor_clk_get(dev, NULL);
+	if (IS_ERR(sc820cs->mclk))
+		return dev_err_probe(dev, PTR_ERR(sc820cs->mclk),
+				     "failed to get mclk\n");
+
+	freq = clk_get_rate(sc820cs->mclk);
+	if (freq != SC820CS_MCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "mclk at %lu Hz, %lu Hz needed\n",
+				     freq, SC820CS_MCLK_FREQ);
+
+	for (unsigned int i = 0; i < ARRAY_SIZE(sc820cs_supply_names); i++)
+		sc820cs->supplies[i].supply = sc820cs_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(sc820cs->supplies),
+				      sc820cs->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supplies\n");
+
+	sc820cs->reset_gpio = devm_gpiod_get_optional(dev, "reset",
+						      GPIOD_OUT_HIGH);
+	if (IS_ERR(sc820cs->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(sc820cs->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	ret = sc820cs_parse_endpoint(sc820cs);
+	if (ret)
+		return ret;
+
+	ret = sc820cs_power_on(dev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to power on\n");
+
+	ret = sc820cs_identify(sc820cs);
+	if (ret)
+		goto err_power_off;
+
+	ret = sc820cs_init_controls(sc820cs);
+	if (ret)
+		goto err_power_off;
+
+	sc820cs->sd.internal_ops = &sc820cs_internal_ops;
+	sc820cs->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc820cs->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc820cs->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc820cs->sd.entity, 1, &sc820cs->pad);
+	if (ret)
+		goto err_ctrl_free;
+
+	sc820cs->sd.state_lock = sc820cs->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&sc820cs->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc820cs->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&sc820cs->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_entity_cleanup:
+	media_entity_cleanup(&sc820cs->sd.entity);
+err_ctrl_free:
+	v4l2_ctrl_handler_free(&sc820cs->ctrl_handler);
+err_power_off:
+	sc820cs_power_off(dev);
+
+	return ret;
+}
+
+static void sc820cs_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc820cs *sc820cs = to_sc820cs(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc820cs->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		sc820cs_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(sc820cs_pm_ops, sc820cs_power_off,
+				 sc820cs_power_on, NULL);
+
+static const struct of_device_id sc820cs_of_match[] = {
+	{ .compatible = "smartsens,sc820cs" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, sc820cs_of_match);
+
+static struct i2c_driver sc820cs_driver = {
+	.driver = {
+		.name = "sc820cs",
+		.pm = pm_ptr(&sc820cs_pm_ops),
+		.of_match_table = sc820cs_of_match,
+	},
+	.probe = sc820cs_probe,
+	.remove = sc820cs_remove,
+};
+module_i2c_driver(sc820cs_driver);
+
+MODULE_DESCRIPTION("SmartSens SC820CS image sensor driver");
+MODULE_AUTHOR("seilent <github@seilent.net>");
+MODULE_LICENSE("GPL");
