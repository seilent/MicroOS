From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: flightlessmango <flightlessmangoyt@gmail.com>
Date: Mon, 28 Sep 2026 12:26:48 +0200
Subject: [PATCH] fdinfo: handle denied proc fd iteration

Backport of 16d783b5d29a1d949f3348dbf28a00126d1bca07 to
GPU_fdinfo::find_fd in v0.8.4, catching ghc's fs::filesystem_error.

Backported-by: seilent <github@seilent.net>
---
 src/gpu_fdinfo.cpp | 88 ++++++++++++++++++++++++----------------------
 1 file changed, 46 insertions(+), 42 deletions(-)

diff --git a/src/gpu_fdinfo.cpp b/src/gpu_fdinfo.cpp
index b863473..ef7a62f 100644
--- a/src/gpu_fdinfo.cpp
+++ b/src/gpu_fdinfo.cpp
@@ -26,59 +26,63 @@ void GPU_fdinfo::find_fd()
     std::set<std::string> client_ids;
     int total = 0;
 
-    for (const auto& entry : fs::directory_iterator(path)) {
-        auto fd_path = entry.path().string();
-        auto file = std::ifstream(fd_path);
+    try {
+        for (const auto& entry : fs::directory_iterator(path)) {
+            auto fd_path = entry.path().string();
+            auto file = std::ifstream(fd_path);
 
-        if (!file.is_open())
-            continue;
+            if (!file.is_open())
+                continue;
 
-        std::string driver, pdev, client_id;
+            std::string driver, pdev, client_id;
 
-        for (std::string line; std::getline(file, line);) {
-            size_t colon = line.find(":");
+            for (std::string line; std::getline(file, line);) {
+                size_t colon = line.find(":");
 
-            if (line[0] == ' ' || line[0] == '\t')
-                continue;
+                if (line[0] == ' ' || line[0] == '\t')
+                    continue;
 
-            if (colon == std::string::npos || colon + 2 >= line.length())
-                continue;
+                if (colon == std::string::npos || colon + 2 >= line.length())
+                    continue;
 
-            auto key = line.substr(0, colon);
-            auto val = line.substr(key.length() + 2);
+                auto key = line.substr(0, colon);
+                auto val = line.substr(key.length() + 2);
 
-            if (key == "drm-driver")
-                driver = val;
-            else if (key == "drm-pdev")
-                pdev = val;
-            else if (key == "drm-client-id")
-                client_id = val;
-        }
+                if (key == "drm-driver")
+                    driver = val;
+                else if (key == "drm-pdev")
+                    pdev = val;
+                else if (key == "drm-client-id")
+                    client_id = val;
+            }
 
-        // fixup mismatch between display engine and render engine drivers
-        if (module == "msm_dpu" && driver == "msm") {
-            driver = "msm_dpu";
-        }
+            // fixup mismatch between display engine and render engine drivers
+            if (module == "msm_dpu" && driver == "msm") {
+                driver = "msm_dpu";
+            }
 
-        if (!driver.empty() && driver == module) {
-            total++;
-            SPDLOG_TRACE(
-                "driver = \"{}\", pdev = \"{}\", "
-                "client_id = \"{}\", client_id_exists = \"{}\"",
-                driver, pdev,
-                client_id, client_ids.find(client_id) != client_ids.end()
-            );
-        }
+            if (!driver.empty() && driver == module) {
+                total++;
+                SPDLOG_TRACE(
+                    "driver = \"{}\", pdev = \"{}\", "
+                    "client_id = \"{}\", client_id_exists = \"{}\"",
+                    driver, pdev,
+                    client_id, client_ids.find(client_id) != client_ids.end()
+                );
+            }
 
-        if (
-            driver.empty() || client_id.empty() ||
-            driver != module || pdev != pci_dev ||
-            client_ids.find(client_id) != client_ids.end()
-        )
-            continue;
+            if (
+                driver.empty() || client_id.empty() ||
+                driver != module || pdev != pci_dev ||
+                client_ids.find(client_id) != client_ids.end()
+            )
+                continue;
 
-        client_ids.insert(client_id);
-        open_fdinfo_fd(fd_path);
+            client_ids.insert(client_id);
+            open_fdinfo_fd(fd_path);
+        }
+    } catch (const fs::filesystem_error& ex) {
+        SPDLOG_TRACE("failed to iterate {}: {}", path.string(), ex.what());
     }
 
     SPDLOG_TRACE(
