#!/usr/bin/bash
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
. "${MICROOS_LEPTON_LIB:-${here}/../libexec/microos/microos-lepton-lib.sh}"
microos_me=microos-android
export microos_me

DATA="${MICROOS_ANDROID_DATA:-${HOME}/.local/share/microos-android}"
CONTEXT="${MICROOS_ANDROID_CONTEXT:-${DATA}/home/.local/share/lepton/contexts/android}"
GAPPS="${MICROOS_GAPPS:-${DATA}/gapps}"
CACHE="${MICROOS_GAPPS_CACHE:-${XDG_CACHE_HOME:-${HOME}/.cache}/microos-android/gapps}"
FETCH="${MICROOS_FETCH:-/usr/libexec/microos/microos-fetch}"
SET=mtg11-20230922.vending-36.6.25

MTG11_URL=https://github.com/MindTheGapps/11.0.0-arm64/releases/download/MindTheGapps-11.0.0-arm64-20230922_081122/MindTheGapps-11.0.0-arm64-20230922_081122.zip
MTG11_SIZE=194494611
MTG11_SHA=a34e054b952b8d5117e5c011b807ef25be1f02d71f0d1ce11db42e89da2962ce
MTG14_URL=https://github.com/MindTheGapps/14.0.0-arm64/releases/download/MindTheGapps-14.0.0-arm64-20250203_200051/MindTheGapps-14.0.0-arm64-20250203_200051.zip
MTG14_SIZE=431524182
MTG14_SHA=6e1c3616862ce5b33e2b96074f86ae846eb1351a26a980e1ed140f8a7e7a4fd6
DONOR=system/product/etc/permissions/privapp-permissions-google-product.xml
DONOR_SHA=af730bf23ca2408fd642d64b5ca8a846b1d31c9a348368e6df26e91905b7bc11
MERGED=system/product/etc/permissions/privapp-permissions-google-p.xml
MERGED_SOURCE_SHA=1d06370c2d94d519907b87c13e42789131e9a0a811a8b53fe60439062238d541

FILES="
11 system/system_ext/priv-app/GoogleServicesFramework/GoogleServicesFramework.apk 482798ab45ae314ae8084ee15295d0acb7da4ea9cdc3c2701a75ab2dbc10f252
11 system/product/priv-app/PrebuiltGmsCore/PrebuiltGmsCore.apk 0b4e47b1e53d8d035fda2f5d8369f67de6f9985ed49001c207aac329d563b56f
14 system/product/priv-app/Phonesky/Phonesky.apk a11f673c924a5900672793ec631408d0a8b0f50191cc22208da6bd5202e8bdf1
merged system/product/etc/permissions/privapp-permissions-google-p.xml fb059266e9b1f96688eeb2ea48a9075e01757fd76921d0087226976154015d33
11 system/system_ext/etc/permissions/privapp-permissions-google-se.xml 4e2161961b9750773d4b9239ec1b4c5197c8131f6f51a18496aef72389dbbd8c
11 system/product/etc/sysconfig/google.xml 95616cfe00726b60759be00a6491e2b5186da02bb0e384e6682bef61428d2709
11 system/product/etc/sysconfig/google_build.xml 724875dc95f7fb7eb950714f9a474a9a304e081626d9364647e02409e4bdae9c
11 system/product/etc/sysconfig/google-hiddenapi-package-whitelist.xml 8be877d7f55f1ef7a650290e99f6bbeeab25ae2573c4604280c7f2b6d286d516
"

if [[ "${MICROOS_TEST:-}" == 1 ]]; then
    MTG11_SIZE="${MICROOS_GAPPS_MTG11_SIZE:-${MTG11_SIZE}}"
    MTG11_SHA="${MICROOS_GAPPS_MTG11_SHA:-${MTG11_SHA}}"
    MTG14_SIZE="${MICROOS_GAPPS_MTG14_SIZE:-${MTG14_SIZE}}"
    MTG14_SHA="${MICROOS_GAPPS_MTG14_SHA:-${MTG14_SHA}}"
    DONOR_SHA="${MICROOS_GAPPS_DONOR_SHA:-${DONOR_SHA}}"
    MERGED_SOURCE_SHA="${MICROOS_GAPPS_MERGED_SOURCE_SHA:-${MERGED_SOURCE_SHA}}"
    FILES="${MICROOS_GAPPS_FILES:-${FILES}}"
fi

me="microos-android ${1:-}"
say() { printf '%s: %s\n' "${me}" "$*"; }

fail() {
    printf '%s: %s\n' "${me}" "$*" >&2
    exit 1
}

REVIEWED="${MICROOS_LEPTON_REVIEWED:-/usr/share/microos-lepton/reviewed}"

usage() {
    echo "usage: microos-android status | gapps install | gapps setup | gapps remove --yes | prune | reset --yes | storage state | storage move card | storage move internal [--keep-card] [--seed <dir>] | storage new --yes | storage prune <id> --yes" >&2
    exit 1
}

stamp_set() {
    local file=$1 value=$2 first=1 line found=0
    local -a lines=()
    [[ -f "${file}" && ! -L "${file}" ]] || fail "${file} is not a regular file, refusing"
    while IFS= read -r line || [[ -n "${line}" ]]; do
        if (( first )); then
            first=0
            if [[ "${line}" == *" gapps="* ]]; then
                line=${line/ gapps=*/ gapps=${value}}
                found=1
            fi
        fi
        lines+=("${line}")
    done < "${file}"
    (( found )) || lines[0]+=" gapps=${value}"
    printf '%s\n' "${lines[@]}" > "${file}.new" && mv -T "${file}.new" "${file}" || fail "cannot write ${file}"
}

status() {
    local key value built storage_word storage_folder
    for key in lepton.build lepton.source last.result last.reason gapps.set gapps.gms gapps.play gapps.setup gsf_id keyboard; do
        value=$(state_get "${key}" 2>/dev/null) || value=
        printf '%s\t%s\n' "${key}" "${value}"
    done
    value=
    if [[ -e "${GAPPS}/current" ]]; then
        value=$(readlink "${GAPPS}/current" 2>/dev/null) || value=
        value=${value##*/}
    fi
    printf 'gapps.current\t%s\n' "${value}"
    built=
    if [[ -n "$(state_get lepton.build 2>/dev/null)" ]] && [[ -f "${REVIEWED}/$(state_get lepton.build)" ]] 2>/dev/null; then
        built=reviewed
    elif [[ -n "$(state_get lepton.build 2>/dev/null)" ]]; then
        built=not-reviewed
    fi
    printf 'lepton.reviewed\t%s\n' "${built}"
    storage_read || :
    printf 'storage\t%s\n' "${storage_word}"
    other_folders
}

other_folders() {
    local content owned folder
    content=$(storage_content) || return 0
    owned=$(storage_tie storage) || owned=
    for folder in "${content}"/MicroOS/Android/*; do
        [[ -d "${folder}" && ! -L "${folder}" ]] || continue
        [[ "${folder##*/}" != "${owned}" ]] || continue
        printf 'other %s\n' "${folder##*/}"
    done
}

gapps_setup() {
    local set dir version found running
    set=$(readlink "${GAPPS}/current" 2>/dev/null) || set=
    set=${set##*/}
    [[ -n "${set}" ]] || fail "no Google apps set is installed"
    dir="${GAPPS}/${set}"
    [[ -d "${dir}" && -f "${dir}/STAMP" ]] || fail "${dir} is not a complete set"
    running=$(systemctl --user show -P ActiveState microos-android.service 2>/dev/null) || running=
    [[ "${running}" == active || "${running}" == activating ]] || fail "Android is not running, refusing"
    state_write "gapps.setup=running" || fail "cannot write the state"
    for _ in $(seq 1 120); do
        version=$(podman exec lepton-android /system/bin/dumpsys package com.google.android.gms 2>/dev/null \
            | sed -n 's/.*versionCode=\([0-9]*\).*/\1/p' | head -n 1) || version=
        [[ -n "${version}" ]] || version=$(podman exec lepton-android /system/bin/cmd package list packages \
            --show-versioncode 2>/dev/null | sed -n 's/^package:com\.google\.android\.gms versionCode:\([0-9]*\)$/\1/p') \
            || version=
        if [[ -n "${version}" ]]; then
            found=${version}
            break
        fi
        sleep 10
    done
    state_write "gapps.set=${set}" "gapps.gms=${found:-}" "gapps.play=$( [[ -d "${dir}/system/product/priv-app/Phonesky" ]] && printf on || printf off )" \
        "gapps.setup=done" || fail "cannot write the state"
    say "Google apps ${set} set up"
}

gapps_remove() {
    [[ "${1:-}" == --yes ]] || fail "removing Google apps drops their data, refusing without --yes"
    no_live
    local stamp="${CONTEXT}/microos-android-stamp"
    [[ -f "${stamp}" ]] || fail "${stamp} missing, refusing"
    stamp_set "${stamp}" none
    state_write "gapps.set=" "gapps.gms=" "gapps.play=" || say "cannot write the state"
    say "the next Android start boots without the Google apps layer"
}

remove_tree() {
    [[ -e "$1" || -L "$1" ]] || return 0
    chmod -R u+w "$1" 2>/dev/null
    rm -rf "$1"
}

complete() {
    local stamp="${GAPPS}/${SET}/STAMP" source path sha
    [[ -f "${stamp}" ]] || return 1
    [[ "$(head -n 1 "${stamp}")" == "set=${SET}" ]] || return 1
    while read -r source path sha; do
        [[ -n "${path}" ]] || continue
        grep -qx "${sha} [0-9]* ${path}" "${stamp}" || return 1
        [[ -f "${GAPPS}/${SET}/${path}" ]] || return 1
    done <<< "${FILES}"
}

fetch() {
    local url=$1 size=$2 sha=$3 file=$4 rc=0
    "${FETCH}" "${url}" "${size}" "${sha}" "${file}" || rc=$?
    (( ! rc )) || exit 1
}

member() {
    local zip=$1 path=$2 out=$3 sha=$4
    mkdir -p "$(dirname "${out}")"
    unzip -p "${zip}" "${path}" > "${out}" 2>/dev/null || fail "${path} missing in ${zip##*/}"
    [[ "$(sha256sum "${out}" | cut -d' ' -f1)" == "${sha}" ]] || fail "${path} from ${zip##*/}: sha256 mismatch"
}

merge() {
    python3 - "$1" "$2" "$3" <<'PY'
import re
import sys

base, donor, out = sys.argv[1:4]
block = re.compile(r'[ \t]*<privapp-permissions package="com\.android\.vending">.*?</privapp-permissions>[ \t]*\n', re.S)
base_text = open(base).read()
donor_text = open(donor).read()
base_blocks, donor_blocks = block.findall(base_text), block.findall(donor_text)
if len(base_blocks) != 1 or len(donor_blocks) != 1:
    sys.exit("expected one vending block in each file, found %d and %d" % (len(base_blocks), len(donor_blocks)))
open(out, "w").write(base_text.replace(base_blocks[0], donor_blocks[0]))
PY
}

no_live() {
    local unit rc container leptons
    for unit in microos-android.service microos-lepton-prepare.service; do
        case "$(systemctl --user show -P ActiveState "${unit}" 2>/dev/null)" in
            inactive|failed|"") ;;
            *) fail "${unit} is running, refusing" ;;
        esac
    done
    rc=0
    podman container exists lepton-android 2>/dev/null || rc=$?
    case "${rc}" in
        1) ;;
        0) fail "container lepton-android exists, refusing" ;;
        *) fail "podman container exists failed (rc=${rc}), refusing" ;;
    esac
    leptons=$(podman ps -a --filter label=lepton=true --format '{{.Names}}') || fail "podman ps failed, refusing"
    [[ -z "${leptons}" ]] || fail "Lepton containers exist (${leptons//$'\n'/ }), ${GAPPS} is shared, refusing"
}

gapps_install() {
    no_live
    mkdir -p "${GAPPS}" "${CACHE}"
    if complete; then
        say "${SET} already installed"
    else
        remove_tree "${GAPPS}/${SET}.tmp"
        remove_tree "${GAPPS}/${SET}"
        fetch "${MTG11_URL}" "${MTG11_SIZE}" "${MTG11_SHA}" "${CACHE}/${MTG11_URL##*/}"
        fetch "${MTG14_URL}" "${MTG14_SIZE}" "${MTG14_SHA}" "${CACHE}/${MTG14_URL##*/}"
        tmp="${GAPPS}/${SET}.tmp"
        mkdir -p "${tmp}"
        while read -r source path sha; do
            [[ -n "${path}" ]] || continue
            case "${source}" in
                11) member "${CACHE}/${MTG11_URL##*/}" "${path}" "${tmp}/${path}" "${sha}" ;;
                14) member "${CACHE}/${MTG14_URL##*/}" "${path}" "${tmp}/${path}" "${sha}" ;;
                merged)
                    member "${CACHE}/${MTG11_URL##*/}" "${MERGED}" "${tmp}/.base.xml" "${MERGED_SOURCE_SHA}"
                    member "${CACHE}/${MTG14_URL##*/}" "${DONOR}" "${tmp}/.donor.xml" "${DONOR_SHA}"
                    mkdir -p "$(dirname "${tmp}/${path}")"
                    merge "${tmp}/.base.xml" "${tmp}/.donor.xml" "${tmp}/${path}" || fail "cannot merge ${path}"
                    rm -f "${tmp}/.base.xml" "${tmp}/.donor.xml"
                    [[ "$(sha256sum "${tmp}/${path}" | cut -d' ' -f1)" == "${sha}" ]] || fail "merged ${path}: sha256 mismatch"
                    ;;
                *) fail "unknown source ${source} for ${path}" ;;
            esac
        done <<< "${FILES}"
        {
            echo "set=${SET}"
            while read -r source path sha; do
                [[ -n "${path}" ]] || continue
                echo "${sha} $(stat -c %s "${tmp}/${path}") ${path}"
            done <<< "${FILES}"
        } > "${tmp}/STAMP.new"
        mv "${tmp}/STAMP.new" "${tmp}/STAMP"
        chmod -R a-w "${tmp}"
        mv -T "${tmp}" "${GAPPS}/${SET}"
        rm -f "${CACHE}/${MTG11_URL##*/}" "${CACHE}/${MTG14_URL##*/}"
        say "${SET} installed in ${GAPPS}/${SET}"
    fi
    ln -sfn "${SET}" "${GAPPS}/current.new"
    mv -T "${GAPPS}/current.new" "${GAPPS}/current"
    say "the next Android start binds ${SET}"
}

prune() {
    local data="${DATA}" states="${DATA}/sideload" queue="${DATA}/prune" stale=() state pkg
    for state in "${states}"/*; do
        [[ -f "${state}" ]] || continue
        grep -qx stale "${state}" || continue
        pkg=${state##*/}
        if (( $# )) && ! printf '%s\n' "$@" | grep -qxF "${pkg}"; then
            continue
        fi
        stale+=("${pkg}")
        printf '%s %s\n' "${pkg}" "$(sed -n 's/^path=//p' "${state}")"
    done
    if (( ! ${#stale[@]} )); then
        say "no stale package"
        return 0
    fi
    mkdir -p "${data}"
    touch "${queue}"
    printf '%s\n' "${stale[@]}" | sort -u - "${queue}" > "${queue}.tmp"
    mv "${queue}.tmp" "${queue}"
    say "${#stale[@]} package(s) queued, uninstalled at the next Android start that installs an .apk"
}

storage_remove_tree() {
    [[ -e "$1" || -L "$1" ]] || return 0
    podman unshare chmod -R u+rwX "$1" || return 1
    podman unshare rm -rf "$1"
}

reset() {
    local rc users container path leptons word folder card id storage_word storage_folder
    [[ "${CONTEXT##*/}" == android ]] || fail "${CONTEXT} is not the android context, refusing"
    [[ "${1:-}" == --yes ]] || fail "reset removes every installed app, refusing without --yes"
    no_live
    storage_lock
    storage_read --locked || fail "cannot read the shared storage, refusing"
    word=${storage_word}
    folder=${storage_folder}
    users=$(podman ps -a --format '{{.Names}} {{.Label "STEAM_COMPAT_DATA_PATH"}}') || fail "podman ps failed, refusing"
    while read -r container path; do
        if [[ -n "${path}" && "$(readlink -m "${path}")" == "$(readlink -m "${CONTEXT}")" ]]; then
            fail "container ${container} uses ${CONTEXT}, refusing"
        fi
    done <<< "${users}"
    case "${word}" in
        card)
            [[ -z "${folder}" ]] || storage_remove_tree "${folder}" || fail "cannot remove ${folder}"
            ;;
        on-os-card)
            ;;
        *)
            card=$(storage_tie card) || card=
            id=$(storage_tie storage) || id=
            [[ -z "${id}" ]] || say "the shared storage ${card:+${card}:}MicroOS/Android/${id} was left in place"
            ;;
    esac
    storage_remove_tree "${CONTEXT}" || fail "cannot remove ${CONTEXT}"
    rm -rf "${DATA}/sideload" "${DATA}/prune"
    rm -f "${STORAGE_STEP}" "${STORAGE_MANIFEST}"
    say "the next Android start boots a fresh context and installs every .apk again"
}

storage_lock() {
    local uid status
    uid=$(storage_owner) || fail "no micro user on this system, refusing"
    [[ "$(id -u)" == "${uid}" ]] || fail "storage verbs run as micro only, refusing"
    case "$(systemctl --user show -P ActiveState microos-lepton-prepare.service 2>/dev/null)" in
        inactive|failed|"") ;;
        *) fail "microos-lepton-prepare.service is running, refusing" ;;
    esac
    status=$(podman inspect --type container -f '{{.State.Status}}' lepton-android 2>/dev/null) || status=
    case "${status}" in
        running|paused|stopping) fail "container lepton-android is ${status}, refusing" ;;
    esac
    [[ ! -L "${STATE_DIR}" ]] || fail "${STATE_DIR} is a link, refusing"
    mkdir -p "${STATE_DIR}" || fail "cannot make ${STATE_DIR}"
    exec {storage_fd}>>"${STORAGE_LOCK}" || fail "cannot open ${STORAGE_LOCK}"
    flock -x -n "${storage_fd}" || fail "another storage run holds ${STORAGE_LOCK}, refusing"
}

storage_free() {
    local where=$1 path=$2 avail need
    avail=$(df --output=avail "${where}" 2>/dev/null | sed -n 2p | tr -d ' ') || return 1
    [[ "${avail}" =~ ^[0-9]+$ ]] || return 1
    need=$(storage_du "${path}") || return 1
    (( avail * 1024 >= need + STORAGE_MARGIN ))
}

storage_space() {
    local where=$1 path=$2 size
    size=$(storage_du "${path}") || size=
    storage_free "${where}" "${path}" || fail "${size:-?} bytes plus the margin do not fit in ${where}, refusing"
}

storage_manifest_equal() {
    local want=$1 dir=$2 got
    got=$(storage_manifest "${dir}") || { say "cannot read the manifest of ${dir}"; return 1; }
    diff -u "${want}" <(printf '%s\n' "${got}") > "${STATE_DIR}/storage-manifest.diff" || {
        say "the copy in ${dir} is not the recorded source, see ${STATE_DIR}/storage-manifest.diff"
        return 1
    }
    rm -f "${STATE_DIR}/storage-manifest.diff"
    return 0
}

storage_move_card() {
    local state="" ext card="" content row type uuid options folder tmp step="" id="" naming=0 fresh=1 storage_word storage_folder
    storage_lock
    storage_read --locked || fail "cannot read the shared storage, refusing"
    state=${storage_word}
    ext="${CONTEXT}/external"
    [[ -d "${ext}" && ! -L "${ext}" ]] || fail "${ext} is not a directory, refusing"
    id=$(storage_tie storage) || id=
    [[ -z "${id}" ]] || storage_id_ok "${id}" || fail "the tie's id ${id} is not 16 lowercase hex digits, refusing"
    content=$(storage_content) || fail "no content card, refusing"
    row=$(storage_mount_row "${content}") || fail "cannot read the mount table of ${content}, refusing"
    IFS='|' read -r type uuid options <<< "${row}"
    [[ "${type}" == ext4 ]] || fail "${content} is ${type}, not ext4, refusing"
    ! storage_read_only "${options}" || fail "${content} is read only, refusing"
    if [[ -z "${id}" && "$(storage_step_get verb)" == move-card \
        && "$(storage_step_get card)" == "${uuid}" ]]; then
        id=$(storage_step_get id) || id=
        storage_id_ok "${id}" || id=
    fi
    [[ -n "${id}" ]] || id=$(storage_new_id)
    folder="${content}/MicroOS/Android/${id}"
    tmp="${folder}.tmp"
    step=$(storage_step_get step) || step=
    if [[ -n "${step}" && "$(storage_step_get verb)" == move-card && "$(storage_step_get id)" == "${id}" \
        && "$(storage_step_get card)" == "${uuid}" ]]; then
        fresh=0
    fi
    if (( fresh )); then
        [[ -n "$(ls -A "${ext}" 2>/dev/null)" ]] || fail "${ext} is empty, nothing to move; storage new --yes makes an empty shared storage"
    fi
    [[ "$(storage_tie card)" == "${uuid}" && "$(storage_tie storage)" == "${id}" ]] && naming=1
    if (( fresh )); then
        step=copy
        [[ "${state}" == on-internal ]] || fail "storage reads ${state}, move card needs on-internal, refusing"
        storage_make_folder "${content}" "" || fail "cannot make ${content}/MicroOS/Android, refusing"
        storage_step_write move-card "${id}" "${uuid}" 0 copy || fail "cannot write ${STORAGE_STEP}"
    elif [[ "${step}" == copy || "${step}" == renamed ]]; then
        storage_make_folder "${content}" "" || fail "cannot make ${content}/MicroOS/Android, refusing"
    else
        storage_component_ok "${folder}" || fail "${folder} is missing or fails its check, refusing"
        if ! storage_manifest_equal "${STORAGE_MANIFEST}" "${folder}"; then
            [[ "${step}" == tie ]] && (( ! naming )) \
                || fail "${folder} changed after the tie was written: storage move internal brings it back to internal, then storage move card moves it again, refusing"
            storage_step_write move-card "${id}" "${uuid}" 0 copy || fail "cannot write ${STORAGE_STEP}"
            storage_make_folder "${content}" "" || fail "cannot make ${content}/MicroOS/Android, refusing"
            step=copy
        fi
    fi
    while :; do
        case "${step}" in
            copy)
                [[ ! -e "${tmp}" && ! -L "${tmp}" ]] \
                    || podman unshare rm -rf "${tmp:?}" || fail "cannot remove ${tmp}, refusing"
                if (( ! naming )) && [[ -e "${folder}" || -L "${folder}" ]]; then
                    podman unshare rm -rf "${folder:?}" || fail "cannot remove ${folder}, refusing"
                    say "removed the existing ${folder}"
                fi
                storage_space "${content}" "${ext}"
                mkdir "${tmp}" || fail "cannot make ${tmp}, refusing"
                sync "${content}/MicroOS/Android" 2>/dev/null || :
                storage_manifest "${ext}" > "${STORAGE_MANIFEST}" || fail "cannot record the manifest of ${ext}, refusing"
                sync "${STORAGE_MANIFEST}" || fail "cannot sync ${STORAGE_MANIFEST}, refusing"
                nice -n 10 podman unshare rsync -aHAX --numeric-ids --delete "${ext}/" "${tmp}/" \
                    || fail "cannot copy ${ext} into ${tmp}, refusing"
                storage_manifest_equal "${STORAGE_MANIFEST}" "${tmp}" || fail "the copy into ${tmp} is not ${ext}, refusing"
                storage_step_write move-card "${id}" "${uuid}" 0 renamed || fail "cannot write ${STORAGE_STEP}"
                step=renamed
                ;;
            renamed)
                if (( naming )); then
                    storage_step_write move-card "${id}" "${uuid}" 0 tie || fail "cannot write ${STORAGE_STEP}"
                    step=tie
                    continue
                fi
                if [[ ! -e "${tmp}" && ! -L "${tmp}" ]]; then
                    if [[ -d "${folder}" && ! -L "${folder}" ]] \
                        && storage_manifest_equal "${STORAGE_MANIFEST}" "${folder}"; then
                        sync -f "${content}" || fail "cannot sync ${content}, refusing"
                        storage_step_write move-card "${id}" "${uuid}" 0 tie || fail "cannot write ${STORAGE_STEP}"
                        step=tie
                        continue
                    fi
                    storage_step_write move-card "${id}" "${uuid}" 0 copy || fail "cannot write ${STORAGE_STEP}"
                    step=copy
                    continue
                fi
                mv -T "${tmp}" "${folder}" || fail "cannot move ${tmp} into ${folder}, refusing"
                sync -f "${content}" || fail "cannot sync ${content}, refusing"
                storage_step_write move-card "${id}" "${uuid}" 0 tie || fail "cannot write ${STORAGE_STEP}"
                step=tie
                ;;
            tie)
                storage_tie_write "${uuid}" "${id}" || fail "cannot write the tie, refusing"
                storage_step_write move-card "${id}" "${uuid}" 0 emptying || fail "cannot write ${STORAGE_STEP}"
                step=emptying
                ;;
            emptying)
                podman unshare find "${ext:?}" -mindepth 1 -delete || fail "cannot empty ${ext}, refusing"
                chmod 0555 "${ext}" || fail "cannot set ${ext} to 0555, refusing"
                sync -f "${CONTEXT}" || fail "cannot sync ${CONTEXT}, refusing"
                storage_step_forget
                step="done"
                ;;
            *)
                fail "${STORAGE_STEP} names the step ${step}, which move card does not have, refusing"
                ;;
        esac
        [[ "${step}" != "done" ]] || break
    done
    say "the shared storage moved to ${folder}"
}

storage_move_internal() {
    local state="" folder="" seed="" keep=0 step="" id="" card="" content="" row type uuid options fresh=1 need=0
    local target="$CONTEXT" storage_word storage_folder
    while (( $# )); do
        case "$1" in
            --keep-card) keep=1 ;;
            --seed)
                shift
                seed=${1:-}
                [[ -n "${seed}" && -d "${seed}" && ! -L "${seed}" ]] || fail "--seed needs a directory, refusing"
                ;;
            *) fail "unknown option $1, refusing" ;;
        esac
        shift
    done
    storage_lock
    storage_read --locked || fail "cannot read the shared storage, refusing"
    state=${storage_word}
    id=$(storage_tie storage) || id=
    [[ -z "${id}" ]] || storage_id_ok "${id}" || fail "the tie's id ${id} is not 16 lowercase hex digits, refusing"
    card=$(storage_tie card) || card=
    step=$(storage_step_get step) || step=
    if [[ -n "${step}" && "$(storage_step_get verb)" == move-internal \
        && ( -z "${id}" || "$(storage_step_get id)" == "${id}" ) \
        && ( -z "${card}" || "$(storage_step_get card)" == "${card}" ) ]]; then
        fresh=0
        id=$(storage_step_get id) || id=
        card=$(storage_step_get card) || card=
        keep=$(storage_step_get keep-card) || keep=
        [[ "${keep}" =~ ^[01]$ ]] || keep=0
        storage_id_ok "${id}" || fail "the step file's id ${id} is not 16 lowercase hex digits, refusing"
    else
        fresh=1
        step=
        [[ "${state}" == card ]] || fail "storage reads ${state}, move internal needs card, refusing"
        [[ -n "${storage_folder}" ]] || fail "storage reads card with no folder, refusing"
        [[ -n "${id}" && -n "${card}" ]] || fail "the tie is incomplete, refusing"
    fi
    need=0
    case "${step}" in
        manifest|copy|"") need=2 ;;
        tie|swapped|removing-card) (( keep )) || need=1 ;;
    esac
    if (( need )); then
        content=$(storage_content) || fail "no content card, refusing"
        row=$(storage_mount_row "${content}") || fail "cannot read the mount table of ${content}, refusing"
        IFS='|' read -r type uuid options <<< "${row}"
        [[ "${type}" == ext4 ]] || fail "${content} is ${type}, not ext4, refusing"
        ! storage_read_only "${options}" || fail "${content} is read only, refusing"
        [[ "${uuid}" == "${card}" ]] || fail "${content} is card ${uuid:-none}, not the tie's ${card}, refusing"
        folder="${content}/MicroOS/Android/${id}"
        (( need < 2 )) || [[ -d "${folder}" && ! -L "${folder}" ]] || fail "${folder} is not a directory, refusing"
    fi
    if (( fresh )); then
        storage_step_write move-internal "${id}" "${card}" "${keep}" manifest || fail "cannot write ${STORAGE_STEP}"
        step=manifest
    fi
    while :; do
        case "${step}" in
            manifest)
                storage_space "${target}" "${folder}"
                storage_manifest "${folder}" > "${STORAGE_MANIFEST}.new" || fail "cannot record the manifest of ${folder}, refusing"
                sync "${STORAGE_MANIFEST}.new" || fail "cannot sync ${STORAGE_MANIFEST}.new, refusing"
                mv -T "${STORAGE_MANIFEST}.new" "${STORAGE_MANIFEST}" || fail "cannot write ${STORAGE_MANIFEST}, refusing"
                sync "${STATE_DIR}" || fail "cannot sync ${STATE_DIR}, refusing"
                storage_step_write move-internal "${id}" "${card}" "${keep}" copy || fail "cannot write ${STORAGE_STEP}"
                step=copy
                ;;
            copy)
                podman unshare rm -rf "${target:?}/external.tmp" 2>/dev/null || :
                storage_space "${target}" "${folder}"
                mkdir "${target}/external.tmp" || fail "cannot make ${target}/external.tmp, refusing"
                if [[ -n "${seed}" ]]; then
                    podman unshare cp -a --reflink=always "${seed}/." "${target}/external.tmp/" \
                        || fail "cannot seed ${target}/external.tmp from ${seed}, refusing"
                fi
                nice -n 10 podman unshare rsync -aHAX --numeric-ids --delete "${folder}/" "${target}/external.tmp/" \
                    || fail "cannot copy ${folder} into ${target}/external.tmp, refusing"
                storage_manifest_equal "${STORAGE_MANIFEST}" "${target}/external.tmp" \
                    || fail "the copy of ${folder} is not the card folder, refusing"
                sync -f "${target}" || fail "cannot sync ${target}, refusing"
                storage_step_write move-internal "${id}" "${card}" "${keep}" swapped || fail "cannot write ${STORAGE_STEP}"
                step=swapped
                ;;
            swapped)
                if [[ ! -e "${target}/external.tmp" && ! -L "${target}/external.tmp" ]]; then
                    [[ -d "${target}/external" && ! -L "${target}/external" ]] \
                        || fail "${target}/external.tmp is gone and ${target}/external is not a directory, refusing"
                    storage_step_write move-internal "${id}" "${card}" "${keep}" tie || fail "cannot write ${STORAGE_STEP}"
                    step=tie
                    continue
                fi
                if [[ -d "${target}/external" && ! -L "${target}/external" ]]; then
                    podman unshare rm -rf "${target:?}/external" || fail "cannot remove the stub ${target}/external, refusing"
                fi
                mv -T "${target}/external.tmp" "${target}/external" \
                    || fail "cannot move the copy into ${target}/external, refusing"
                sync "${target}" || fail "cannot sync ${target}, refusing"
                storage_step_write move-internal "${id}" "${card}" "${keep}" tie || fail "cannot write ${STORAGE_STEP}"
                step=tie
                ;;
            tie)
                storage_tie_write "" "${id}" || fail "cannot write the tie, refusing"
                storage_step_write move-internal "${id}" "${card}" "${keep}" removing-card \
                    || fail "cannot write ${STORAGE_STEP}"
                step=removing-card
                ;;
            removing-card)
                if (( ! keep )); then
                    if [[ -e "${folder}" || -L "${folder}" ]]; then
                        storage_component_ok "${folder}" || fail "${folder} fails its check, refusing"
                        podman unshare chmod -R u+rwX "${folder}" || fail "cannot chmod ${folder}, refusing"
                        podman unshare rm -rf "${folder:?}" || fail "cannot remove ${folder}, refusing"
                        sync -f "${content}" || fail "cannot sync the card, refusing"
                    fi
                fi
                storage_step_forget
                step="done"
                ;;
            *)
                fail "${STORAGE_STEP} names the step ${step}, which move internal does not have, refusing"
                ;;
        esac
        [[ "${step}" != "done" ]] || break
    done
    say "the shared storage moved to ${target}/external"
}

storage_new() {
    local state="" content row type uuid options id old="" keep="" folder storage_word storage_folder
    [[ "${1:-}" == --yes ]] || fail "storage new makes a new shared storage, refusing without --yes"
    storage_lock
    storage_read --locked || fail "cannot read the shared storage, refusing"
    state=${storage_word}
    case "${state}" in
        other-card|folder-missing) ;;
        *) fail "storage reads ${state}, storage new needs other-card or folder-missing, refusing" ;;
    esac
    content=$(storage_content) || fail "no content card, refusing"
    row=$(storage_mount_row "${content}") || fail "cannot read the mount table of ${content}, refusing"
    IFS='|' read -r type uuid options <<< "${row}"
    [[ "${type}" == ext4 ]] || fail "${content} is ${type}, not ext4, refusing"
    ! storage_read_only "${options}" || fail "${content} is read only, refusing"
    id=$(storage_new_id)
    storage_make_folder "${content}" "${id}" || fail "cannot make ${content}/MicroOS/Android/${id}, refusing"
    sync -f "${content}" || fail "cannot sync ${content}, refusing"
    old=$(storage_tie card) || old=
    keep=$(storage_tie storage) || keep=
    storage_tie_write "${uuid}" "${id}" || fail "cannot write the tie, refusing"
    say "the shared storage is ${content}/MicroOS/Android/${id}"
    [[ -z "${keep}" ]] || printf '%s:MicroOS/Android/%s\n' "${old}" "${keep}"
}

storage_prune() {
    local id=${1:-} state="" folder storage_word storage_folder
    [[ -n "${id}" && "${id}" =~ ^[0-9a-f]{16}$ ]] || fail "storage prune needs an id of 16 lowercase hex digits, refusing"
    [[ "${2:-}" == --yes ]] || fail "storage prune removes a shared storage, refusing without --yes"
    storage_lock
    storage_read --locked || fail "cannot read the shared storage, refusing"
    state=${storage_word}
    [[ "${state}" == card ]] || fail "storage reads ${state}, storage prune needs card, refusing"
    [[ "${id}" != "$(storage_tie storage)" ]] || fail "${id} is this context's own shared storage, refusing"
    folder=$(storage_content)/MicroOS/Android/${id}
    [[ -d "${folder}" && ! -L "${folder}" ]] || fail "${folder} is not a directory, refusing"
    storage_component_ok "${folder}" || fail "${folder} fails its check, refusing"
    podman unshare chmod -R u+rwX "${folder}" || fail "cannot chmod ${folder}, refusing"
    podman unshare rm -rf "${folder:?}" || fail "cannot remove ${folder}, refusing"
    sync -f "${folder%/*}" || fail "cannot sync the card, refusing"
    say "${folder} removed"
}

case "${1:-}" in
    status)
        [[ $# == 1 ]] || usage
        status
        ;;
    gapps)
        case "${2:-}" in
            install)
                me="microos-android gapps install"
                shift 2
                gapps_install "$@"
                ;;
            setup)
                me="microos-android gapps setup"
                shift 2
                gapps_setup "$@"
                ;;
            remove)
                me="microos-android gapps remove"
                shift 2
                gapps_remove "$@"
                ;;
            *) usage ;;
        esac
        ;;
    prune)
        shift
        prune "$@"
        ;;
    reset)
        shift
        reset "$@"
        ;;
    storage)
        case "${2:-}" in
            state)
                me="microos-android storage state"
                shift 2
                (($# == 0 || $# == 1)) || usage
                storage_state "$@" || exit 1
                ;;
            move)
                case "${3:-}" in
                    card)
                        me="microos-android storage move card"
                        shift 3
                        (( $# == 0 )) || usage
                        storage_move_card
                        ;;
                    internal)
                        me="microos-android storage move internal"
                        shift 3
                        storage_move_internal "$@"
                        ;;
                    *) usage ;;
                esac
                ;;
            new)
                me="microos-android storage new"
                shift 2
                storage_new "$@"
                ;;
            prune)
                me="microos-android storage prune"
                shift 2
                storage_prune "$@"
                ;;
            *) usage ;;
        esac
        ;;
    *) usage ;;
esac
