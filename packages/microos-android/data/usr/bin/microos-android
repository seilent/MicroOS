#!/usr/bin/bash
set -uo pipefail

STATE_DIR="${MICROOS_ANDROID_STATE:-${XDG_STATE_HOME:-${HOME}/.local/state}/microos-android}"
IMAGES="${MICROOS_ANDROID_IMAGES:-/var/lib/microos-android/images}"
IMAGES_STATE="${MICROOS_ANDROID_IMAGES_STATE:-/var/lib/microos-android/images.state}"
VAR="${MICROOS_ANDROID_VAR:-/var/lib/microos-android}"
SYSTEM_CARD="${MICROOS_SYSTEM_CARD:-/run/microos/system-card}"
SYSTEMCTL="${MICROOS_SYSTEMCTL:-systemctl}"

me="microos-android ${1:-}"
say() { printf '%s: %s\n' "${me}" "$*"; }

fail() {
    printf '%s: %s\n' "${me}" "$*" >&2
    exit 1
}

usage() {
    echo "usage: microos-android status | gapps install | gapps remove --yes | reset --yes | storage state" >&2
    exit 1
}

state_get() {
    python3 -I - "${STATE_DIR}/state.json" "$1" <<'PY'
import json
import sys

try:
    with open(sys.argv[1]) as handle:
        data = json.load(handle)
except (OSError, ValueError):
    sys.exit(1)
for part in sys.argv[2].split("."):
    if not isinstance(data, dict):
        sys.exit(1)
    data = data.get(part)
    if data is None:
        sys.exit(1)
if isinstance(data, bool) or not isinstance(data, (str, int)):
    sys.exit(1)
print(data)
PY
}

state_clear() {
    local lock
    [[ -f "${STATE_DIR}/state.json" ]] || return 0
    exec {lock}>>"${STATE_DIR}/state.json.lock" || return 1
    flock -w 10 -x "${lock}" || say "${STATE_DIR}/state.json.lock is held, writing anyway"
    python3 -I - "${STATE_DIR}/state.json" "$@" <<'PY'
import json
import os
import sys
import tempfile

path = sys.argv[1]
try:
    with open(path) as handle:
        data = json.load(handle)
except (OSError, ValueError):
    sys.exit(0)
if not isinstance(data, dict):
    sys.exit(0)
for key in sys.argv[2:]:
    parts = key.split(".")
    node = data
    for part in parts[:-1]:
        node = node.get(part) if isinstance(node, dict) else None
    if isinstance(node, dict):
        node.pop(parts[-1], None)
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".state.")
with os.fdopen(fd, "w") as handle:
    json.dump(data, handle, sort_keys=True)
    handle.write("\n")
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
}

storage_word() {
    local flag
    [[ ! -L "${SYSTEM_CARD}" ]] || return 1
    flag=$(head -n 1 "${SYSTEM_CARD}" 2>/dev/null) || return 1
    case "${flag}" in
        none) printf 'on-internal\n' ;;
        internal) printf 'on-os-card\n' ;;
        *) [[ "${flag}" =~ ^mmcblk[0-9]+$ ]] || return 1; printf 'on-os-card\n' ;;
    esac
}

status() {
    local key value
    for key in last.result last.reason gapps.play gapps.gms; do
        value=$(state_get "${key}" 2>/dev/null) || value=
        printf '%s\t%s\n' "${key}" "${value}"
    done
    value=
    [[ ! -d "${IMAGES}/current/" ]] || value=$(readlink "${IMAGES}/current" 2>/dev/null) || value=
    printf 'image.set\t%s\n' "${value##*/}"
    value=$(sed -n 's/^state=//p' "${IMAGES_STATE}" 2>/dev/null) || value=
    printf 'image.state\t%s\n' "${value}"
    printf 'gapps.installed\t%s\n' "$([[ -f "${VAR}/gapps.manifest" ]] && echo yes || echo no)"
    value=$(head -n 1 "${VAR}/gsf-id" 2>/dev/null) || value=
    [[ "${value}" =~ ^[1-9][0-9]*$ ]] || value=
    printf 'gsf_id\t%s\n' "${value}"
    value=$(storage_word) || value=
    printf 'storage\t%s\n' "${value}"
}

root_unit() {
    "${SYSTEMCTL}" start "$1" || fail "$1 failed, journalctl -u $1 has its reason"
}

case "${1:-}" in
    status)
        (( $# == 1 )) || usage
        status
        ;;
    gapps)
        case "${2:-}" in
            install)
                me="microos-android gapps install"
                (( $# == 2 )) || usage
                root_unit microos-android-gapps@install.service
                say "MindTheGapps 13 is in the overlay, Android boots with it at its next start"
                ;;
            remove)
                me="microos-android gapps remove"
                [[ "${3:-}" == --yes && $# == 3 ]] || fail "removing Google apps drops their data, refusing without --yes"
                root_unit microos-android-gapps@remove.service
                say "Android boots without Google apps at its next start"
                ;;
            *) usage ;;
        esac
        ;;
    reset)
        [[ "${2:-}" == --yes && $# == 2 ]] || fail "reset removes every installed app, refusing without --yes"
        root_unit microos-android-reset.service
        state_clear last.result last.reason gapps.play gapps.gms || say "cannot clear the state"
        say "the next Android start boots a fresh guest"
        ;;
    storage)
        [[ "${2:-}" == state && $# == 2 ]] || usage
        me="microos-android storage state"
        storage_word || fail "the system card flag ${SYSTEM_CARD} is not decided"
        ;;
    *) usage ;;
esac
