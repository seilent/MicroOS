def log(message):
    print(f"{ME}: {message}", file=sys.stderr, flush=True)


def home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def u32(value):
    return value & 0xFFFFFFFF


def guest_index(hundredths, top):
    return (min(hundredths, 100) * top + 50) // 100


def report_state(report):
    index, _top, muted = report
    return 0 if muted else index


def helper_uid(text):
    found = [fields for fields in (line.split() for line in text.splitlines()) if fields and fields[0] == PACKAGE]
    if len(found) != 1:
        return None
    fields = found[0]
    if len(fields) < 5 or not UID.fullmatch(fields[1]) or fields[2] != "0" or ":privapp:" not in fields[4]:
        return None
    return int(fields[1])


def error_name(error):
    return Gio.DBusError.get_remote_error(error) or ""


def logged(what):
    def done(bus, result):
        try:
            bus.call_finish(result)
        except GLib.Error as error:
            log(f"{what} failed: {error_name(error) or error.message}")

    return done


def outcome(error):
    name = error_name(error)
    if error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.TIMED_OUT):
        return TIMEOUT, ""
    if name in AUTH_ERRORS:
        return AUTH, name
    return (CANCELED if name == CANCELED_ERROR else FAILED), name


def prop(proxy, name, default=None):
    value = None if proxy is None else proxy.get_cached_property(name)
    return default if value is None else value.unpack()


def text(data):
    return bytes(data).decode(errors="replace")


def cut(name, units):
    used = 0
    for index, char in enumerate(name):
        used += 2 if ord(char) > 0xFFFF else 1
        if used > units:
            return name[:index]
    return name


def groups(variant):
    found = {}
    for i in range(variant.n_children()):
        group = variant.get_child_value(i)
        values = group.get_child_value(1)
        entries = (values.get_child_value(j) for j in range(values.n_children()))
        found[group.get_child_value(0).get_string()] = {
            entry.get_child_value(0).get_string(): entry.get_child_value(1).get_variant() for entry in entries}
    return found


def wifi_profile(settings):
    kind = settings.get("connection", {}).get("type")
    ssid = settings.get("802-11-wireless", {}).get("ssid")
    if kind is None or ssid is None or kind.get_string() != "802-11-wireless":
        return None
    permissions = settings["connection"].get("permissions")
    return bytes(ssid.unpack()), permissions is not None and f"user:{USER}:" in permissions.unpack()


def security(point):
    flags, wpa, rsn = (prop(point, name, 0) for name in ("Flags", "WpaFlags", "RsnFlags"))
    both = wpa | rsn
    if both & (KEY_8021X | KEY_SUITE_B):
        return OTHER
    if both & (KEY_PSK | KEY_SAE):
        return PERSONAL
    if both & KEY_OWE:
        return OWE
    if both == KEY_OWE_TM or not (both or flags & PRIVACY):
        return OPEN
    return OTHER


def profile(ssid, kind, point, password):
    settings = {
        "connection": {"type": GLib.Variant("s", "802-11-wireless"), "id": GLib.Variant("s", text(ssid)),
                       "autoconnect": GLib.Variant("b", False),
                       "permissions": GLib.Variant("as", [f"user:{USER}:"])},
        "802-11-wireless": {"ssid": GLib.Variant("ay", ssid), "mode": GLib.Variant("s", "infrastructure")},
    }
    if kind == OWE:
        settings["802-11-wireless-security"] = {"key-mgmt": GLib.Variant("s", "owe")}
    elif kind == PERSONAL:
        rsn = prop(point, "RsnFlags", 0)
        settings["802-11-wireless-security"] = {
            "key-mgmt": GLib.Variant("s", "sae" if rsn & KEY_SAE and not rsn & KEY_PSK else "wpa-psk"),
            "psk": GLib.Variant("s", password), "psk-flags": GLib.Variant("u", 0)}
    return settings


def write_atomic(path, data):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    temp = f"{path}.{os.getpid()}.new"
    with open(temp, "w") as handle:
        handle.write(data)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temp, 0o600)
    os.replace(temp, path)


class BadArgument(Exception):
    pass


def read_int(reader):
    ok, value = reader.read_int32()
    if not ok:
        raise BadArgument()
    return value


def read_choice(reader, count):
    value = read_int(reader)
    if not 0 <= value < count:
        raise BadArgument()
    return value


def read_text(reader, longest):
    size = read_int(reader)
    if not 0 <= size <= longest:
        raise BadArgument()
    words = [read_int(reader) for _ in range((size + 2) // 2)]
    try:
        return struct.pack(f"<{len(words)}i", *words)[:2 * size].decode("utf-16-le")
    except UnicodeDecodeError:
        raise BadArgument() from None


def read_binder(reader):
    ok, remote = reader.read_nullable_object()
    if not ok or remote is None or remote.is_dead():
        raise BadArgument()
    return remote


def read_address(reader):
    address = read_text(reader, 17)
    if not ADDRESS.fullmatch(address):
        raise BadArgument()
    return address


class Packages:
    def __init__(self):
        self.directory = os.path.join(home(), ".local/share/microos-waydroid/waydroid/data/system")
        self.path = os.path.join(self.directory, PACKAGES)
        self.uid = None
        self.seen = None
        self.checked = None
        self.monitor = None
        self.unwatchable = None

    def start(self):
        self.read()
        if self.arm(True):
            GLib.timeout_add(ARM_MS, self.arm)

    def arm(self, first=False):
        if not os.path.isdir(self.directory):
            return True
        try:
            monitor = Gio.File.new_for_path(self.directory).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        except GLib.Error as error:
            if error.message != self.unwatchable:
                log(f"cannot watch {self.directory}: {error.message}")
            self.unwatchable = error.message
            return True
        self.unwatchable = None
        self.monitor = monitor
        monitor.connect("changed", self.event)
        if not first:
            self.read()
        return False

    def event(self, monitor, one, other, kind):
        if kind == Gio.FileMonitorEvent.DELETED and one.get_path() == self.directory:
            monitor.cancel()
            self.monitor = None
            self.read()
            GLib.timeout_add(ARM_MS, self.arm)
            return
        if one.get_basename() == PACKAGES or (other is not None and other.get_basename() == PACKAGES):
            self.read()

    def signature(self):
        try:
            info = os.stat(self.path)
        except OSError:
            return None
        return info.st_ino, info.st_size, info.st_mtime_ns

    def read(self):
        self.seen = self.signature()
        uid = None
        if self.seen is not None:
            try:
                with open(self.path, "rb") as handle:
                    uid = helper_uid(handle.read().decode(errors="replace"))
            except OSError:
                uid = None
        if uid != self.uid:
            log(f"helper uid {uid}" if uid is not None else f"no helper uid in {self.path}")
        self.uid = uid

    def check(self):
        now = time.monotonic()
        if self.checked is not None and now - self.checked < STAT_S:
            return
        self.checked = now
        if self.signature() != self.seen:
            self.read()


class Volume:
    def __init__(self, bridge):
        self.bridge = bridge
        self.dump = None
        self.settle = 0
        self.running = None
        self.timer = 0
        self.writes = []
        self.asked = None
        self.own = False
        self.read_due = False
        self.decide_due = False
        self.host = None
        self.report = None
        self.fresh = False
        self.held = None
        self.hold = 0
        self.level = None

    def start(self):
        try:
            self.dump = Gio.Subprocess.new([PW_DUMP, "-m", "-N"], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as error:
            log(f"{PW_DUMP} did not run: {error.message}: host volume changes do not reach the guest")
        else:
            self.dump.wait_async(None, self.dump_exited)
            self.dump.get_stdout_pipe().read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, self.dumped)
        self.read_due = True
        self.step()

    def stop(self):
        if self.dump is not None:
            self.dump.force_exit()
        if self.running is not None:
            self.running.force_exit()

    def dumped(self, stream, result):
        try:
            data = stream.read_bytes_finish(result)
        except GLib.Error as error:
            log(f"reading {PW_DUMP} failed: {error.message}")
            return
        if not data.get_size():
            return
        if not self.settle:
            self.settle = GLib.timeout_add(SETTLE_MS, self.settled)
        stream.read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, self.dumped)

    def dump_exited(self, process, result):
        try:
            process.wait_finish(result)
        except GLib.Error as error:
            log(f"waiting for {PW_DUMP} failed: {error.message}")
            return
        rc = process.get_exit_status() if process.get_if_exited() else -process.get_term_sig()
        log(f"pw-dump exited {rc}: host volume changes no longer reach the guest")

    def settled(self):
        self.settle = 0
        self.read_due = True
        self.step()
        return False

    def step(self):
        if self.running is not None:
            return
        if self.writes:
            verb, value = self.writes.pop(0)
            self.run([WPCTL, verb, SINK, value], self.wrote)
        elif self.read_due:
            self.read_due = False
            self.run([WPCTL, "get-volume", SINK], self.got)
        elif self.decide_due and self.held is None:
            self.decide_due = False
            self.decide()

    def run(self, argv, done):
        command = " ".join(argv[1:])
        try:
            process = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as error:
            log(f"wpctl {command} did not run: {error.message}")
            self.finish(done, None)
            return

        def communicated(proc, result):
            if self.running is not process:
                return
            GLib.source_remove(self.timer)
            self.timer = 0
            try:
                _ok, out, _err = proc.communicate_utf8_finish(result)
            except GLib.Error as error:
                log(f"wpctl {command} failed: {error.message}")
                self.finish(done, None)
                return
            rc = proc.get_exit_status() if proc.get_if_exited() else -proc.get_term_sig()
            out = (out or "").strip()
            if rc:
                log(f"wpctl {command} exited {rc}: {out}")
            self.finish(done, None if rc else out)

        def expire():
            self.timer = 0
            process.force_exit()
            log(f"wpctl {command} killed after {WPCTL_S:g} s")
            self.finish(done, None)
            return False

        self.running = process
        self.timer = GLib.timeout_add(int(WPCTL_S * 1000), expire)
        process.communicate_utf8_async(None, None, communicated)

    def finish(self, done, out):
        self.running = None
        done(out)
        self.step()

    def wrote(self, _out):
        if not self.writes:
            self.own = True
            self.read_due = True

    def got(self, out):
        own, self.own = self.own, False
        if out is None:
            return
        found = VOLUME.fullmatch(out)
        if found is None:
            log(f"wpctl get-volume printed {out!r}")
            return
        self.host = (int(found.group(1)) * 100 + int(found.group(2)), found.group(3) is not None)
        if self.report is None:
            return
        state = self.host_state()
        if own and state == self.asked:
            if self.held is None and state != report_state(self.report):
                self.decide_due = True
            return
        if self.held is None and not self.decide_due and (state != report_state(self.report) or self.muted_moved()):
            self.push()

    def host_state(self):
        hundredths, muted = self.host
        return 0 if muted else guest_index(hundredths, self.report[1])

    def muted_moved(self):
        hundredths, muted = self.host
        return muted and guest_index(hundredths, self.report[1]) != self.level

    def reset(self, fresh):
        if self.hold:
            GLib.source_remove(self.hold)
            self.hold = 0
        self.held = None
        self.report = None
        self.writes = []
        self.decide_due = False
        self.fresh = fresh
        self.level = None

    def reported(self, index, top, muted):
        self.report = (index, top, muted)
        if index and not muted:
            self.level = index
        state = report_state(self.report)
        if self.fresh:
            self.fresh = False
            if self.host is not None and self.host_state() != state:
                self.push()
            return
        self.decide_due = True
        if self.held is None:
            self.step()
        elif state == self.held:
            self.end_hold()

    def decide(self):
        if self.host is None or self.report is None:
            return
        index, top, muted = self.report
        want = report_state(self.report)
        if want == self.host_state():
            return
        hundredths, host_muted = self.host
        level = [] if guest_index(hundredths, top) == want else [("set-volume", f"{want / top:.4f}")]
        if want == 0:
            writes = [("set-mute", "1")]
        elif host_muted:
            writes = level + [("set-mute", "0")]
        else:
            writes = level
        log(f"guest volume {index} of {top}{' muted' if muted else ''}: "
            f"{', '.join(' '.join(write) for write in writes)}")
        self.writes = writes
        self.asked = want
        self.step()

    def push(self):
        hundredths, muted = self.host
        top = self.report[1]
        index = guest_index(hundredths, top)
        self.decide_due = False
        self.held = 0 if muted or index == 0 else index
        self.level = index
        if self.hold:
            GLib.source_remove(self.hold)
        self.hold = GLib.timeout_add(HOLD_MS, self.hold_done)
        log(f"host volume {hundredths / 100:.2f}{' muted' if muted else ''} pushed as {index} of {top}")
        self.bridge.send(SET_VOLUME, (index, 1 if muted else 0))

    def hold_done(self):
        self.hold = 0
        self.end_hold()
        return False

    def end_hold(self):
        if self.hold:
            GLib.source_remove(self.hold)
            self.hold = 0
        held, self.held = self.held, None
        if self.host_state() != held or self.muted_moved():
            self.push()
            return
        self.step()


class Cache:
    def __init__(self, bridge, name, path):
        self.bridge = bridge
        self.name = name
        self.path = path
        self.manager = None
        self.owner = None

    def start(self):
        Gio.DBusObjectManagerClient.new(self.bridge.bus, Gio.DBusObjectManagerClientFlags.DO_NOT_AUTO_START, self.name,
                                        self.path, None, None, None, self.built)

    def built(self, _source, result):
        try:
            self.manager = Gio.DBusObjectManagerClient.new_finish(result)
        except GLib.Error as error:
            log(f"no {self.name} objects: {error.message}")
            return
        for name in ("object-added", "object-removed", "interface-added", "interface-removed",
                     "interface-proxy-properties-changed"):
            self.manager.connect(name, self.moved)
        self.manager.connect("notify::name-owner", self.owner_changed)
        self.owner_changed()

    def moved(self, *_args):
        self.bridge.changed()

    def owner_changed(self, *_args):
        owner = self.manager.get_name_owner()
        if owner == self.owner:
            return
        if self.owner is not None:
            log(f"{self.name} left the bus")
            self.owner = None
            self.lost()
        self.owner = owner
        if owner is not None:
            log(f"{self.name} is on the bus")
            self.appeared()
        self.bridge.changed()

    def ready(self):
        return self.owner is not None

    def proxy(self, path, iface):
        return None if self.owner is None else self.manager.get_interface(path, iface)

    def objects(self, iface):
        if self.owner is None:
            return []
        found = [(obj.get_object_path(), obj.get_interface(iface)) for obj in self.manager.get_objects()]
        return sorted(((path, proxy) for path, proxy in found if proxy is not None), key=lambda item: item[0])


