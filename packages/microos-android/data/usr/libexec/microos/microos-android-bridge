#!/usr/bin/python3
import configparser
import os
import re
import signal
import struct
import sys
import time
import traceback

import gbinder
import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

ME = "microos-android-bridge"
WAYDROID_CFG = os.environ.get("MICROOS_WAYDROID_CFG") or "/var/lib/waydroid/waydroid.cfg"
BINDER_DIR = os.environ.get("MICROOS_BINDER_DIR") or "/dev"
WPCTL = os.environ.get("MICROOS_WPCTL") or "/usr/bin/wpctl"
PW_DUMP = os.environ.get("MICROOS_PW_DUMP") or "/usr/bin/pw-dump"
HOLD_MS = int(os.environ.get("MICROOS_BRIDGE_HOLD_MS") or 2000)
POWER_S = float(os.environ.get("MICROOS_BRIDGE_POWER_S") or 90)
WPCTL_S = float(os.environ.get("MICROOS_BRIDGE_WPCTL_S") or 2)
SERVICE = "microosbridge"
INTERFACE = "net.seilent.microos.IBridge"
CALLBACK = "net.seilent.microos.IBridgeCallback"
PACKAGE = "net.seilent.microos.helper"
PACKAGES = "packages.list"
LOGIND = ("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager")
POWER = {"0userrequested": "PowerOff", "1userrequested": "Reboot"}
SINK = "@DEFAULT_AUDIO_SINK@"
VOLUME = re.compile(r"Volume: ([0-9]+)\.([0-9]{2})( \[MUTED\])?")
UID = re.compile(r"1[0-9]{4}")
ADDRESS = re.compile(r"[0-9A-F]{2}(:[0-9A-F]{2}){5}")
HEX = re.compile(r"[0-9A-Fa-f]{64}")
ONEWAY = 1
EX_SECURITY = -1
EX_ILLEGAL_ARGUMENT = -3
UNKNOWN_TRANSACTION = -74
OK, NOT_READY, UNAVAILABLE, UNKNOWN, BUSY, UNSUPPORTED, VERSION = range(7)
SET_VOLUME, RADIOS, WIFI_LIST, BT_LIST, RESULT, PROMPT = range(1, 7)
SETTLE_MS = 100
STAT_S = 0.1
ARM_MS = 1000
REFUSALS = 10
MINUTE_MS = 60000
STOP_CALL_MS = 2000


def log(message):
    print(f"{ME}: {message}", file=sys.stderr, flush=True)


def home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def u32(value):
    return value & 0xFFFFFFFF


def guest_index(hundredths, top):
    return (min(hundredths, 100) * top + 50) // 100


def report_state(report):
    index, _top, muted = report
    return 0 if muted else index


def helper_uid(text):
    found = [fields for fields in (line.split() for line in text.splitlines()) if fields and fields[0] == PACKAGE]
    if len(found) != 1:
        return None
    fields = found[0]
    if len(fields) < 5 or not UID.fullmatch(fields[1]) or fields[2] != "0" or ":privapp:" not in fields[4]:
        return None
    return int(fields[1])


class BadArgument(Exception):
    pass


def read_int(reader):
    ok, value = reader.read_int32()
    if not ok:
        raise BadArgument()
    return value


def read_choice(reader, count):
    value = read_int(reader)
    if not 0 <= value < count:
        raise BadArgument()
    return value


def read_text(reader, longest):
    size = read_int(reader)
    if not 0 <= size <= longest:
        raise BadArgument()
    words = [read_int(reader) for _ in range((size + 2) // 2)]
    try:
        return struct.pack(f"<{len(words)}i", *words)[:2 * size].decode("utf-16-le")
    except UnicodeDecodeError:
        raise BadArgument() from None


def read_binder(reader):
    ok, remote = reader.read_nullable_object()
    if not ok or remote is None or remote.is_dead():
        raise BadArgument()
    return remote


def read_address(reader):
    address = read_text(reader, 17)
    if not ADDRESS.fullmatch(address):
        raise BadArgument()
    return address


class Packages:
    def __init__(self):
        self.directory = os.path.join(home(), ".local/share/microos-waydroid/waydroid/data/system")
        self.path = os.path.join(self.directory, PACKAGES)
        self.uid = None
        self.seen = None
        self.checked = None
        self.monitor = None
        self.unwatchable = None

    def start(self):
        self.read()
        if self.arm(True):
            GLib.timeout_add(ARM_MS, self.arm)

    def arm(self, first=False):
        if not os.path.isdir(self.directory):
            return True
        try:
            monitor = Gio.File.new_for_path(self.directory).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        except GLib.Error as error:
            if error.message != self.unwatchable:
                log(f"cannot watch {self.directory}: {error.message}")
            self.unwatchable = error.message
            return True
        self.unwatchable = None
        self.monitor = monitor
        monitor.connect("changed", self.event)
        if not first:
            self.read()
        return False

    def event(self, monitor, one, other, kind):
        if kind == Gio.FileMonitorEvent.DELETED and one.get_path() == self.directory:
            monitor.cancel()
            self.monitor = None
            self.read()
            GLib.timeout_add(ARM_MS, self.arm)
            return
        if one.get_basename() == PACKAGES or (other is not None and other.get_basename() == PACKAGES):
            self.read()

    def signature(self):
        try:
            info = os.stat(self.path)
        except OSError:
            return None
        return info.st_ino, info.st_size, info.st_mtime_ns

    def read(self):
        self.seen = self.signature()
        uid = None
        if self.seen is not None:
            try:
                with open(self.path, "rb") as handle:
                    uid = helper_uid(handle.read().decode(errors="replace"))
            except OSError:
                uid = None
        if uid != self.uid:
            log(f"helper uid {uid}" if uid is not None else f"no helper uid in {self.path}")
        self.uid = uid

    def check(self):
        now = time.monotonic()
        if self.checked is not None and now - self.checked < STAT_S:
            return
        self.checked = now
        if self.signature() != self.seen:
            self.read()


class Volume:
    def __init__(self, bridge):
        self.bridge = bridge
        self.dump = None
        self.settle = 0
        self.running = None
        self.timer = 0
        self.writes = []
        self.asked = None
        self.own = False
        self.read_due = False
        self.decide_due = False
        self.host = None
        self.report = None
        self.fresh = False
        self.held = None
        self.hold = 0
        self.level = None

    def start(self):
        try:
            self.dump = Gio.Subprocess.new([PW_DUMP, "-m", "-N"], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as error:
            log(f"{PW_DUMP} did not run: {error.message}: host volume changes do not reach the guest")
        else:
            self.dump.wait_async(None, self.dump_exited)
            self.dump.get_stdout_pipe().read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, self.dumped)
        self.read_due = True
        self.step()

    def stop(self):
        if self.dump is not None:
            self.dump.force_exit()
        if self.running is not None:
            self.running.force_exit()

    def dumped(self, stream, result):
        try:
            data = stream.read_bytes_finish(result)
        except GLib.Error as error:
            log(f"reading {PW_DUMP} failed: {error.message}")
            return
        if not data.get_size():
            return
        if not self.settle:
            self.settle = GLib.timeout_add(SETTLE_MS, self.settled)
        stream.read_bytes_async(65536, GLib.PRIORITY_DEFAULT, None, self.dumped)

    def dump_exited(self, process, result):
        try:
            process.wait_finish(result)
        except GLib.Error as error:
            log(f"waiting for {PW_DUMP} failed: {error.message}")
            return
        rc = process.get_exit_status() if process.get_if_exited() else -process.get_term_sig()
        log(f"pw-dump exited {rc}: host volume changes no longer reach the guest")

    def settled(self):
        self.settle = 0
        self.read_due = True
        self.step()
        return False

    def step(self):
        if self.running is not None:
            return
        if self.writes:
            verb, value = self.writes.pop(0)
            self.run([WPCTL, verb, SINK, value], self.wrote)
        elif self.read_due:
            self.read_due = False
            self.run([WPCTL, "get-volume", SINK], self.got)
        elif self.decide_due and self.held is None:
            self.decide_due = False
            self.decide()

    def run(self, argv, done):
        command = " ".join(argv[1:])
        try:
            process = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        except GLib.Error as error:
            log(f"wpctl {command} did not run: {error.message}")
            self.finish(done, None)
            return

        def communicated(proc, result):
            if self.running is not process:
                return
            GLib.source_remove(self.timer)
            self.timer = 0
            try:
                _ok, out, _err = proc.communicate_utf8_finish(result)
            except GLib.Error as error:
                log(f"wpctl {command} failed: {error.message}")
                self.finish(done, None)
                return
            rc = proc.get_exit_status() if proc.get_if_exited() else -proc.get_term_sig()
            out = (out or "").strip()
            if rc:
                log(f"wpctl {command} exited {rc}: {out}")
            self.finish(done, None if rc else out)

        def expire():
            self.timer = 0
            process.force_exit()
            log(f"wpctl {command} killed after {WPCTL_S:g} s")
            self.finish(done, None)
            return False

        self.running = process
        self.timer = GLib.timeout_add(int(WPCTL_S * 1000), expire)
        process.communicate_utf8_async(None, None, communicated)

    def finish(self, done, out):
        self.running = None
        done(out)
        self.step()

    def wrote(self, _out):
        if not self.writes:
            self.own = True
            self.read_due = True

    def got(self, out):
        own, self.own = self.own, False
        if out is None:
            return
        found = VOLUME.fullmatch(out)
        if found is None:
            log(f"wpctl get-volume printed {out!r}")
            return
        self.host = (int(found.group(1)) * 100 + int(found.group(2)), found.group(3) is not None)
        if self.report is None:
            return
        state = self.host_state()
        if own and state == self.asked:
            if self.held is None and state != report_state(self.report):
                self.decide_due = True
            return
        if self.held is None and not self.decide_due and (state != report_state(self.report) or self.muted_moved()):
            self.push()

    def host_state(self):
        hundredths, muted = self.host
        return 0 if muted else guest_index(hundredths, self.report[1])

    def muted_moved(self):
        hundredths, muted = self.host
        return muted and guest_index(hundredths, self.report[1]) != self.level

    def reset(self, fresh):
        if self.hold:
            GLib.source_remove(self.hold)
            self.hold = 0
        self.held = None
        self.report = None
        self.writes = []
        self.decide_due = False
        self.fresh = fresh
        self.level = None

    def reported(self, index, top, muted):
        self.report = (index, top, muted)
        if index and not muted:
            self.level = index
        state = report_state(self.report)
        if self.fresh:
            self.fresh = False
            if self.host is not None and self.host_state() != state:
                self.push()
            return
        self.decide_due = True
        if self.held is None:
            self.step()
        elif state == self.held:
            self.end_hold()

    def decide(self):
        if self.host is None or self.report is None:
            return
        index, top, muted = self.report
        want = report_state(self.report)
        if want == self.host_state():
            return
        hundredths, host_muted = self.host
        level = [] if guest_index(hundredths, top) == want else [("set-volume", f"{want / top:.4f}")]
        if want == 0:
            writes = [("set-mute", "1")]
        elif host_muted:
            writes = level + [("set-mute", "0")]
        else:
            writes = level
        log(f"guest volume {index} of {top}{' muted' if muted else ''}: "
            f"{', '.join(' '.join(write) for write in writes)}")
        self.writes = writes
        self.asked = want
        self.step()

    def push(self):
        hundredths, muted = self.host
        top = self.report[1]
        index = guest_index(hundredths, top)
        self.decide_due = False
        self.held = 0 if muted or index == 0 else index
        self.level = index
        if self.hold:
            GLib.source_remove(self.hold)
        self.hold = GLib.timeout_add(HOLD_MS, self.hold_done)
        log(f"host volume {hundredths / 100:.2f}{' muted' if muted else ''} pushed as {index} of {top}")
        self.bridge.send(SET_VOLUME, (index, 1 if muted else 0))

    def hold_done(self):
        self.hold = 0
        self.end_hold()
        return False

    def end_hold(self):
        if self.hold:
            GLib.source_remove(self.hold)
            self.hold = 0
        held, self.held = self.held, None
        if self.host_state() != held or self.muted_moved():
            self.push()
            return
        self.step()


class ServiceManager(gbinder.ServiceManager):
    pass


class Link:
    def __init__(self, remote):
        self.remote = remote
        self.client = gbinder.Client(remote, CALLBACK)
        self.death = 0


class Bridge:
    def __init__(self, loop, bus):
        self.loop = loop
        self.bus = bus
        self.packages = Packages()
        self.volume = Volume(self)
        self.manager = None
        self.local = None
        self.present = False
        self.callback = None
        self.euid = None
        self.armed = None
        self.deadline = 0
        self.refusals = 0
        self.refusing = 0
        self.unknown = set()
        self.calls = {
            1: (False, self.hello),
            2: (True, self.report_volume),
            3: (False, self.set_radio),
            4: (False, self.set_airplane),
            5: (False, self.watch_wifi),
            6: (False, self.connect_wifi),
            7: (False, self.watch_bluetooth),
            8: (False, self.connect_bluetooth),
            9: (False, self.pair_bluetooth),
            10: (False, self.answer_pairing),
            11: (False, self.power),
        }

    def start(self):
        self.packages.start()
        self.volume.start()
        config = configparser.ConfigParser()
        config.read(WAYDROID_CFG)
        if not config.has_option("waydroid", "binder"):
            log(f"no binder in {WAYDROID_CFG}")
            return False
        section = config["waydroid"]
        device = os.path.join(BINDER_DIR, section["binder"])
        if not os.path.exists(device):
            log(f"no {device}")
            return False
        self.manager = ServiceManager(device, section.get("service_manager_protocol"), section.get("binder_protocol"))
        self.local = self.manager.new_local_object(INTERFACE, self.transact)
        self.manager.add_presence_handler(self.presence_changed)
        self.present = self.manager.is_present()
        if self.present:
            self.register()
        return True

    def stop(self):
        self.volume.stop()

    def register(self):
        def added(status):
            if status:
                log(f"adding {SERVICE} returned {status}")
            else:
                log(f"{SERVICE} added")

        if not self.manager.add_service(SERVICE, self.local, added):
            log(f"adding {SERVICE} did not start")

    def presence_changed(self):
        present = self.manager.is_present()
        if present == self.present:
            return
        self.present = present
        if present:
            log("the guest service manager is back")
            self.packages.read()
            self.register()
            return
        log("the guest service manager is gone")
        self.unlink()
        self.fire(False)

    def transact(self, request, code, flags):
        oneway = bool(flags & ONEWAY)
        try:
            return self.dispatch(request, code, oneway)
        except Exception as error:
            line = traceback.extract_tb(error.__traceback__)[-1].lineno
            log(f"call {code} raised {type(error).__name__} at line {line}")
            return self.answer(oneway, EX_ILLEGAL_ARGUMENT)

    def dispatch(self, request, code, oneway):
        euid = request.sender_euid()
        if not self.trusted(euid):
            self.refuse(code, euid)
            return self.answer(oneway, EX_SECURITY)
        if code not in self.calls:
            if code not in self.unknown:
                self.unknown.add(code)
                log(f"unknown call {code} from uid {euid}")
            return None, UNKNOWN_TRANSACTION
        kind, handler = self.calls[code]
        self.euid = euid
        try:
            if request.interface() != INTERFACE.encode() or kind != oneway:
                raise BadArgument()
            values = handler(request.init_reader())
        except BadArgument:
            log(f"call {code} from uid {euid}: bad argument")
            return self.answer(oneway, EX_ILLEGAL_ARGUMENT)
        return self.answer(oneway, 0, values)

    def answer(self, oneway, exception, values=None):
        if oneway:
            return None, 0
        reply = self.local.new_reply()
        reply.append_int32(u32(exception))
        if exception:
            reply.append_string16("refused" if exception == EX_SECURITY else "bad argument")
            reply.append_int32(0)
        for value in values or ():
            reply.append_int32(u32(value))
        return reply, 0

    def trusted(self, euid):
        if euid != self.packages.uid:
            self.packages.check()
        return self.packages.uid is not None and euid == self.packages.uid

    def refuse(self, code, euid):
        if not self.refusing:
            self.refusals = 0
            self.refusing = GLib.timeout_add(MINUTE_MS, self.refused_minute)
        self.refusals += 1
        if self.refusals <= REFUSALS:
            log(f"refused {code} from uid {euid}")

    def refused_minute(self):
        self.refusing = 0
        if self.refusals > REFUSALS:
            log(f"refused {self.refusals - REFUSALS} more calls in the last minute")
        return False

    def link(self, remote):
        self.unlink()
        link = Link(remote)
        link.death = remote.add_death_handler(lambda: self.died(link))
        self.callback = link
        self.volume.reset(True)
        log(f"hello from uid {self.euid}")
        GLib.idle_add(self.linked, link)

    def linked(self, link):
        if link is self.callback:
            self.send(RADIOS, (-1, -1, "", ""))
        return False

    def died(self, link):
        if link is not self.callback:
            return
        log("the helper callback died")
        self.unlink()

    def unlink(self):
        link, self.callback = self.callback, None
        if link is None:
            return
        link.remote.remove_handler(link.death)
        self.volume.reset(False)

    def send(self, code, values):
        link = self.callback
        if link is None:
            return
        request = link.client.new_request()
        for value in values:
            if isinstance(value, str):
                request.append_string16(value)
            else:
                request.append_int32(u32(value))
        status = link.client.transact_sync_oneway(code, request)
        if status:
            log(f"callback {code} returned {status}")

    def hello(self, reader):
        version = read_int(reader)
        remote = read_binder(reader)
        if version != 1:
            return (VERSION,)
        self.link(remote)
        return (OK,)

    def report_volume(self, reader):
        index = read_int(reader)
        top = read_int(reader)
        muted = read_choice(reader, 2)
        if not 1 <= top <= 100 or not 0 <= index <= top:
            raise BadArgument()
        if self.callback is None:
            log("reportVolume dropped: no helper callback")
            return None
        self.volume.reported(index, top, muted)
        return None

    def set_radio(self, reader):
        read_choice(reader, 2)
        read_choice(reader, 2)
        return (NOT_READY,)

    def set_airplane(self, reader):
        read_choice(reader, 2)
        return (NOT_READY,)

    def watch_wifi(self, reader):
        read_choice(reader, 2)
        return (NOT_READY,)

    def connect_wifi(self, reader):
        ident = read_text(reader, 128)
        password = read_text(reader, 64)
        if not ident or not (len(password) in (0, 64) or 8 <= len(password) <= 63):
            raise BadArgument()
        if len(password) == 64 and not HEX.fullmatch(password):
            raise BadArgument()
        return (NOT_READY, 0)

    def watch_bluetooth(self, reader):
        read_choice(reader, 2)
        return (NOT_READY,)

    def connect_bluetooth(self, reader):
        read_address(reader)
        read_choice(reader, 2)
        return (NOT_READY, 0)

    def pair_bluetooth(self, reader):
        read_address(reader)
        return (NOT_READY, 0)

    def answer_pairing(self, reader):
        read_int(reader)
        read_choice(reader, 2)
        return (NOT_READY,)

    def power(self, reader):
        reason = read_text(reader, 64)
        if not reason or not all(" " <= char <= "~" for char in reason):
            raise BadArgument()
        if self.callback is None:
            return (NOT_READY,)
        if reason not in POWER:
            log(f"power {reason} not acted on")
            return (UNSUPPORTED,)
        if self.armed is not None:
            return (BUSY,)
        self.armed = reason
        self.deadline = GLib.timeout_add(int(POWER_S * 1000), self.power_expired)
        log(f"power {reason} armed")
        return (OK,)

    def power_expired(self):
        self.deadline = 0
        log(f"power {self.armed} armed, the guest is still up after {POWER_S:g} s")
        self.armed = None
        return False

    def fire(self, stopping):
        reason, self.armed = self.armed, None
        if reason is None:
            return
        GLib.source_remove(self.deadline)
        self.deadline = 0
        method = POWER[reason]
        log(f"power {reason}: {method}")
        args = GLib.Variant("(b)", (False,))
        if stopping:
            try:
                self.bus.call_sync(*LOGIND, method, args, None, Gio.DBusCallFlags.NONE, STOP_CALL_MS, None)
            except GLib.Error as error:
                log(f"{method} failed: {Gio.DBusError.get_remote_error(error) or error.message}")
            return

        def done(bus, result):
            try:
                bus.call_finish(result)
            except GLib.Error as error:
                log(f"{method} failed: {Gio.DBusError.get_remote_error(error) or error.message}")

        self.bus.call(*LOGIND, method, args, None, Gio.DBusCallFlags.NONE, -1, None, done)

    def quit(self):
        self.fire(True)
        self.loop.quit()
        return GLib.SOURCE_REMOVE


def main():
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except GLib.Error as error:
        log(f"no system bus: {error.message}")
        return 1
    loop = GLib.MainLoop()
    bridge = Bridge(loop, bus)
    for number in (signal.SIGTERM, signal.SIGINT):
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, number, bridge.quit)
    if not bridge.start():
        bridge.stop()
        return 1
    loop.run()
    bridge.stop()
    return 0


if __name__ == "__main__":
    sys.exit(main())
