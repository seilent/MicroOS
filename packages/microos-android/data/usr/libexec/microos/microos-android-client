#!/usr/bin/python3
import fcntl
import json
import os
import re
import signal
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

ME = "microos-android-client"
UNIT = "microos-android.service"
SESSION = "gamescope-session-plus@android.service"
WRITERS = ("microos-android-battery.service", "microos-android-brightness.service", "microos-android-lsfg.service",
           "microos-android-perf.service")
LAYER_UNIT = "microos-android-layer.service"
GSF_UNIT = "microos-android-gsf.service"
WAYDROID_NAME = "id.waydro.Session"
TRACK = os.environ.get("MICROOS_TRACK") or "/usr/libexec/microos/microos-session-track"
CHECK = os.environ.get("MICROOS_ANDROID_CHECK") or "/usr/libexec/microos/microos-android-check"
GUEST = os.environ.get("MICROOS_ANDROID_GUEST") or "/usr/libexec/microos/microos-android-guest"
WAYDROID = os.environ.get("MICROOS_WAYDROID") or "/usr/bin/waydroid"
GSF_ID = os.environ.get("MICROOS_ANDROID_GSF_ID") or "/var/lib/microos-android/gsf-id"
MANGOHUD_CONFIG = re.compile(r"/tmp/mangohud\.[A-Za-z0-9]{8}")
MANAGER = ("org.freedesktop.systemd1", "/org/freedesktop/systemd1", "org.freedesktop.systemd1.Manager")
PROPS = "org.freedesktop.DBus.Properties"
REFUSE_WAIT = float(os.environ.get("MICROOS_REFUSE_WAIT") or 30)
CHECK_TIMEOUT = float(os.environ.get("MICROOS_CHECK_TIMEOUT") or 5)
LAYER_TIMEOUT = float(os.environ.get("MICROOS_LAYER_TIMEOUT") or 30)
BOOT_TIMEOUT = float(os.environ.get("MICROOS_BOOT_TIMEOUT") or 120)
GSF_EVERY_MS = int(os.environ.get("MICROOS_GSF_EVERY_MS") or 60000)
LOCK_WAIT = float(os.environ.get("MICROOS_STATE_LOCK_WAIT") or 10)
TICK_MS = 250
BOOT_POLL_S = 1.0
MARKERS = ("ready", "start-done", "end-reason")
WORD = re.compile(r"[a-z][a-z0-9-]{0,31}")
DISPLAY_FILE = os.environ.get("MICROOS_DISPLAY_FILE") or "/usr/share/microos-android/display"
TOUCH_MODES = ("0", "1", "2", "3", "4")


def log(message):
    print(f"{ME}: {message}", file=sys.stderr, flush=True)


def env(name, fallback=""):
    return os.environ.get(name) or fallback


def home():
    return env("HOME", os.path.expanduser("~"))


def runtime_dir():
    return env("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")


def run_dir():
    return env("MICROOS_RUNTIME_DIR", os.path.join(runtime_dir(), "microos-android"))


def waydroid_data():
    return env("MICROOS_WAYDROID_DATA", os.path.join(home(), ".local/share/microos-waydroid"))


def state_dir():
    return env("MICROOS_ANDROID_STATE", os.path.join(home(), ".local/state/microos-android"))


def write_atomic(path, text, mode=0o644):
    directory = os.path.dirname(path)
    os.makedirs(directory, exist_ok=True)
    temp = f"{path}.{os.getpid()}.new"
    with open(temp, "w") as handle:
        handle.write(text)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temp, mode)
    os.replace(temp, path)


def read_text(path):
    try:
        with open(path) as handle:
            return handle.read().strip()
    except OSError:
        return ""


def word_ok(word):
    return bool(WORD.fullmatch(word))


def boottime_ms():
    try:
        with open("/proc/uptime") as handle:
            return int(float(handle.read().split()[0]) * 1000)
    except (OSError, ValueError, IndexError):
        return 0


def lock_state():
    path = os.path.join(state_dir(), "state.json.lock")
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    except OSError as error:
        log(f"cannot open {path}: {error}")
        return None
    deadline = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return fd
        except OSError:
            if time.monotonic() >= deadline:
                log(f"{path} is held, writing anyway")
                return fd
            time.sleep(0.05)


def unlock_state(fd):
    if fd is None:
        return
    try:
        fcntl.flock(fd, fcntl.LOCK_UN)
    except OSError:
        pass
    os.close(fd)


def update_state(fields):
    path = os.path.join(state_dir(), "state.json")
    fd = lock_state()
    try:
        data = {}
        try:
            with open(path) as handle:
                loaded = json.load(handle)
            if isinstance(loaded, dict):
                data = loaded
        except (OSError, ValueError):
            data = {}
        for key, value in fields.items():
            parts = key.split(".")
            node = data
            for part in parts[:-1]:
                child = node.get(part)
                if not isinstance(child, dict):
                    child = {}
                    node[part] = child
                node = child
            node[parts[-1]] = value
        try:
            write_atomic(path, json.dumps(data, sort_keys=True) + "\n", 0o600)
        except OSError as error:
            log(f"cannot write {path}: {error}")
    finally:
        unlock_state(fd)


def unit_path(unit):
    return "/org/freedesktop/systemd1/unit/" + unit.replace("-", "_2d").replace("@", "_40").replace(".", "_2e")


def unit_state(bus, unit):
    try:
        reply = bus.call_sync(MANAGER[0], unit_path(unit), PROPS, "Get",
                              GLib.Variant("(ss)", ("org.freedesktop.systemd1.Unit", "ActiveState")),
                              None, Gio.DBusCallFlags.NONE, 2000, None)
    except GLib.Error:
        return ""
    return reply.unpack()[0]


def session_serial():
    fields = read_text(os.path.join(env("MICROOS_RUNDIR", "/run/microos"), "session-current")).split()
    return fields[2] if len(fields) >= 3 and fields[2].isdigit() else ""


def start_check():
    try:
        result = subprocess.run([CHECK], stdout=subprocess.PIPE, stderr=subprocess.PIPE, stdin=subprocess.DEVNULL,
                                timeout=CHECK_TIMEOUT)
    except subprocess.TimeoutExpired:
        log(f"{CHECK} is past {CHECK_TIMEOUT:g} s, taking it as can run")
        return 0, ""
    except OSError as error:
        log(f"{CHECK} did not run: {error}")
        return 0, ""
    for line in result.stderr.decode(errors="replace").splitlines():
        if line:
            log(line)
    lines = [line for line in result.stdout.decode(errors="replace").splitlines() if line]
    return result.returncode, (lines[-1] if lines and word_ok(lines[-1]) else "")


def place_layer():
    try:
        result = subprocess.run(["systemctl", "start", LAYER_UNIT], stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                                stdin=subprocess.DEVNULL, timeout=LAYER_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as error:
        log(f"{LAYER_UNIT} did not run: {error}, no frame generation layer")
        return False
    if result.returncode:
        log(f"{LAYER_UNIT} failed: {result.stderr.decode(errors='replace').strip()}, no frame generation layer")
        return False
    return True


def touch_mode():
    try:
        with open(DISPLAY_FILE) as handle:
            values = [line.strip()[len("touch_mode="):] for line in handle if line.startswith("touch_mode=")]
    except OSError as error:
        return None, f"cannot read {DISPLAY_FILE}: {error.strerror}"
    if not values:
        return None, ""
    if values[0] not in TOUCH_MODES:
        return None, f"touch_mode={values[0]} in {DISPLAY_FILE} is not a gamescope touch mode"
    return values[0], ""


def set_touch_mode():
    mode, error = touch_mode()
    if mode is None and not error:
        return
    if not error:
        command = ["xprop", "-root", "-f", "STEAM_TOUCH_CLICK_MODE", "32c", "-set", "STEAM_TOUCH_CLICK_MODE", mode]
        try:
            result = subprocess.run(command, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, timeout=5)
        except (OSError, subprocess.SubprocessError) as failure:
            error = f"xprop failed: {failure}"
        else:
            if result.returncode:
                error = f"xprop exited {result.returncode}: {result.stderr.decode(errors='replace').strip()}"
    if error:
        log(f"touch mode not set on {env('DISPLAY')}: {error}")
        update_state({"touch.result": "failed", "touch.reason": error})
        return
    log(f"touch mode {mode} set on {env('DISPLAY')}")
    update_state({"touch.result": "set", "touch.reason": ""})


def gapps_fields(listing):
    names = {line[len("package:"):].strip() for line in listing.splitlines() if line.startswith("package:")}
    return {"gapps.play": "on" if "com.android.vending" in names else "off",
            "gapps.gms": "on" if "com.google.android.gms" in names else "off"}, "com.google.android.gsf" in names


class Window:
    def __init__(self):
        import gi as _gi

        _gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk

        self.gtk = Gtk
        self.window = None

    def show(self):
        gtk = self.gtk
        if not gtk.init_check([])[0]:
            raise RuntimeError("no display")
        self.window = gtk.Window(type=gtk.WindowType.TOPLEVEL)
        self.window.set_decorated(False)
        self.window.set_skip_taskbar_hint(True)
        self.window.set_skip_pager_hint(True)
        self.window.fullscreen()
        self.window.connect("delete-event", lambda *args: True)
        self.window.show_all()

    def hide(self):
        if self.window is not None:
            self.window.hide()


class Client:
    def __init__(self, bus=None, loop=None):
        self.bus = bus or Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.loop = loop or GLib.MainLoop()
        self.job = None
        self.started = False
        self.named = False
        self.booting = False
        self.ready = False
        self.refused = False
        self.deadline = 0.0
        self.next_poll = 0.0
        self.exit_code = 0
        self.subscriptions = []
        self.watch = 0
        self.window = None

    def subscribe(self):
        self.subscriptions.append(self.bus.signal_subscribe(
            MANAGER[0], MANAGER[2], "JobRemoved", MANAGER[1], None, Gio.DBusSignalFlags.NONE, self.job_removed))
        self.watch = Gio.bus_watch_name_on_connection(self.bus, WAYDROID_NAME, Gio.BusNameWatcherFlags.NONE,
                                                      self.name_appeared, None)

    def unsubscribe(self):
        for subscription in self.subscriptions:
            self.bus.signal_unsubscribe(subscription)
        self.subscriptions = []
        if self.watch:
            Gio.bus_unwatch_name(self.watch)
            self.watch = 0

    def name_appeared(self, conn, name, owner):
        if not self.named:
            log(f"{WAYDROID_NAME} is on the bus")
        self.named = True

    def job_removed(self, conn, sender, path, interface, signal, params):
        job_id, job_path, unit, result = params.unpack()[:4]
        if self.job is None or str(job_path) != self.job or unit != UNIT:
            return
        self.job = None
        if result == "done":
            self.started = True
            return
        self.refuse(self.end_reason() or (result if word_ok(result) else "start-failed"))

    def end_reason(self):
        reason = read_text(os.path.join(run_dir(), "end-reason"))
        return reason if word_ok(reason) else ""

    def start_unit(self):
        try:
            reply = self.bus.call_sync(MANAGER[0], MANAGER[1], MANAGER[2], "StartUnit",
                                       GLib.Variant("(ss)", (UNIT, "replace")), None, Gio.DBusCallFlags.NONE,
                                       -1, None)
        except GLib.Error as error:
            log(f"StartUnit failed: {error.message}")
            self.refuse("start-failed")
            return
        path = reply.unpack()[0]
        self.job = str(path) if path else None
        self.deadline = time.monotonic() + BOOT_TIMEOUT

    def refuse(self, reason):
        if self.refused:
            return
        self.refused = True
        log(f"refusing: {reason}")
        update_state({"last.result": "refused", "last.reason": reason, "last.boottime": boottime_ms()})
        self.record_refusal(reason)
        deadline = time.monotonic() + REFUSE_WAIT
        while unit_state(self.bus, SESSION) in ("active", "activating", "reloading"):
            if time.monotonic() >= deadline:
                log("the session is still active after the refusal")
                break
            time.sleep(0.25)
        self.exit_code = 1
        self.loop.quit()

    def record_refusal(self, reason):
        serial = session_serial()
        if not serial:
            log("no session serial, the refusal is not recorded")
            return
        try:
            result = subprocess.run([TRACK, "refuse", "android", serial, reason], stdout=subprocess.DEVNULL,
                                    stderr=subprocess.PIPE, timeout=10)
        except (OSError, subprocess.SubprocessError) as error:
            log(f"{TRACK} refuse failed: {error}")
            return
        for line in result.stderr.decode(errors="replace").splitlines():
            if line:
                log(line)

    def clear_markers(self):
        directory = run_dir()
        for name in MARKERS:
            try:
                os.unlink(os.path.join(directory, name))
            except OSError:
                pass

    def write_session_env(self, layer):
        wayland = env("GAMESCOPE_WAYLAND_DISPLAY")
        text = (f"DISPLAY={env('DISPLAY')}\nGAMESCOPE_WAYLAND_DISPLAY={wayland}\nWAYLAND_DISPLAY={wayland}\n"
                f"XDG_DATA_HOME={waydroid_data()}\nPULSE_RUNTIME_PATH={os.path.join(runtime_dir(), 'pulse')}\n"
                f"MICROOS_ANDROID_LSFG_LAYER={1 if layer else 0}\n")
        if MANGOHUD_CONFIG.fullmatch(env("MANGOHUD_CONFIGFILE")):
            text += f"MANGOHUD_CONFIGFILE={env('MANGOHUD_CONFIGFILE')}\n"
        write_atomic(os.path.join(run_dir(), "session.env"), text)

    def spawn(self, argv, done, extra=None):
        launcher = Gio.SubprocessLauncher.new(Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
        for key, value in (extra or {}).items():
            launcher.setenv(key, value, True)
        try:
            process = launcher.spawnv(argv)
        except GLib.Error as error:
            log(f"cannot run {argv[0]}: {error.message}")

            def failed():
                done(-1, "")
                return False

            GLib.idle_add(failed)
            return

        def finished(proc, result):
            try:
                _ok, out, err = proc.communicate_utf8_finish(result)
            except GLib.Error as error:
                log(f"{argv[0]} {argv[1] if len(argv) > 1 else ''}: {error.message}")
                done(-1, "")
                return
            for line in (err or "").splitlines():
                if line:
                    log(line)
            done(proc.get_exit_status() if proc.get_if_exited() else -1, out or "")

        process.communicate_utf8_async(None, None, finished)

    def poll_boot(self):
        self.booting = True

        def done(code, _out):
            self.booting = False
            self.next_poll = time.monotonic() + BOOT_POLL_S
            if code == 0 and not self.ready and not self.refused:
                self.mark_ready()

        self.spawn([GUEST, "boot"], done)

    def mark_ready(self):
        self.ready = True
        self.spawn([WAYDROID, "show-full-ui"], self.shown,
                   {"XDG_DATA_HOME": waydroid_data(), "WAYLAND_DISPLAY": env("GAMESCOPE_WAYLAND_DISPLAY")})
        write_atomic(os.path.join(run_dir(), "ready"), "\n")
        update_state({"last.result": "ready", "last.reason": "", "last.boottime": boottime_ms()})
        self.hide_boot_screen()
        log("android ready")
        for unit in WRITERS:
            self.start_unit_named(unit, "fail")
        self.spawn([GUEST, "opts"], self.opts_done)

    def shown(self, code, _out):
        if code:
            log(f"show-full-ui exited {code}")

    def opts_done(self, code, _out):
        if code:
            log(f"the guest settings exited {code}")
        self.spawn([GUEST, "sh", "pm list packages"], self.packages_done)

    def packages_done(self, code, out):
        gsf = False
        if code == 0:
            fields, gsf = gapps_fields(out)
            update_state(fields)
        else:
            log(f"the guest package list exited {code}, the Google apps state is not read")
        write_atomic(os.path.join(run_dir(), "start-done"), "\n")
        log("start tasks done")
        if gsf:
            self.read_gsf()

    def read_gsf(self):
        if read_text(GSF_ID):
            return False
        self.start_unit_named(GSF_UNIT, "replace", system=True)
        GLib.timeout_add(GSF_EVERY_MS, self.read_gsf)
        return False

    def start_unit_named(self, unit, mode, system=False):
        bus = self.bus
        if system:
            try:
                bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            except GLib.Error as error:
                log(f"no system bus for {unit}: {error.message}")
                return
        try:
            bus.call_sync(MANAGER[0], MANAGER[1], MANAGER[2], "StartUnit",
                          GLib.Variant("(ss)", (unit, mode)), None, Gio.DBusCallFlags.NONE, 5000, None)
        except GLib.Error as error:
            log(f"StartUnit {unit} failed: {error.message}")

    def show_boot_screen(self):
        if env("MICROOS_ANDROID_NO_UI") == "1":
            return
        try:
            self.window = Window()
            self.window.show()
        except (ImportError, RuntimeError, ValueError) as error:
            log(f"no boot screen: {error}")
            self.window = None

    def hide_boot_screen(self):
        if self.window is not None:
            self.window.hide()

    def tick(self):
        if self.ready or self.refused:
            return False
        if self.started and unit_state(self.bus, UNIT) in ("inactive", "failed", ""):
            self.refuse(self.end_reason() or "start-failed")
            return False
        if time.monotonic() >= self.deadline:
            self.refuse("boot-timeout")
            return False
        if self.started and self.named and not self.booting and time.monotonic() >= self.next_poll:
            self.poll_boot()
        return True

    def finish(self):
        self.unsubscribe()
        return self.exit_code

    def run(self):
        self.clear_markers()
        self.write_session_env(False)
        set_touch_mode()
        self.show_boot_screen()
        code, word = start_check()
        if code == 2:
            self.refuse(word or "check-refused")
            return self.finish()
        if code == 1:
            self.refuse("not-installed")
            return self.finish()
        if code != 0:
            log(f"the start check exited {code}, taking it as can run")
        self.write_session_env(place_layer())
        self.subscribe()
        signal.signal(signal.SIGTERM, lambda *args: self.loop.quit())
        signal.signal(signal.SIGINT, lambda *args: self.loop.quit())
        self.start_unit()
        GLib.timeout_add(TICK_MS, self.tick)
        self.loop.run()
        return self.finish()


def main():
    return Client().run()


if __name__ == "__main__":
    sys.exit(main())
