#!/usr/bin/bash
set -uo pipefail

SERVICE=microos-android-images.service
SYSTEMCTL="${MICROOS_SYSTEMCTL:-systemctl}"

"${SYSTEMCTL}" start --no-block "${SERVICE}" || {
    echo "microos-android-install: cannot start ${SERVICE}" >&2
    exit 1
}
echo "microos-android-install: ${SERVICE} fetches the Android images"
