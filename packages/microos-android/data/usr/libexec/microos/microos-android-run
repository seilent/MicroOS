#!/usr/bin/bash
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export MICROOS_RUNTIME_DIR="${MICROOS_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/microos-android}"
microos_me=microos-android-run
. "${MICROOS_LEPTON_LIB:-${here}/microos-lepton-lib.sh}"

LEPTON="${MICROOS_LEPTON:-/usr/libexec/microos/microos-lepton}"
PAD_NODES="${MICROOS_PAD_NODES:-/usr/libexec/microos/microos-android-pad-nodes}"
SESSION_WATCH="${MICROOS_SESSION_WATCH:-/usr/libexec/microos/microos-android-session-watch}"
RUN="${MICROOS_RUNTIME_DIR}"
POLL_S="${MICROOS_POLL_S:-0.5}"
STEAM_PIPE="${MICROOS_STEAM_PIPE:-${DATA}/home/.steam/steam.pipe}"
GAPPS="${MICROOS_GAPPS:-${DATA}/gapps}"
STUB_DIR="${MICROOS_STUB_DIR:-/usr/share/microos-android}"
DISPLAY_FILE="${MICROOS_DISPLAY_FILE:-/usr/share/microos-android/display}"
OPTS="${MICROOS_OPTS:-/usr/share/microos-android/opts}"
OPTS_TIMEOUT_S="${MICROOS_OPTS_TIMEOUT_S:-30}"
EXTEND_USEC="${MICROOS_EXTEND_USEC:-120000000}"
GMS_GRANTS="android.permission.ACCESS_FINE_LOCATION android.permission.ACCESS_COARSE_LOCATION android.permission.ACCESS_BACKGROUND_LOCATION android.permission.READ_CONTACTS android.permission.WRITE_CONTACTS"
LEPTON_NOT_INSTALLED="Lepton is not installed. Install it in Steam."
NAME=android
CONTEXT="${MICROOS_ANDROID_CONTEXT:-${DATA}/home/.local/share/lepton/contexts/${NAME}}"
[[ "${CONTEXT%/}" == "${CONTEXT}" ]] || CONTEXT=${CONTEXT%/}
[[ "${CONTEXT##*/}" == "${NAME}" ]] || { echo "microos-android-run: ${CONTEXT} is not a ${NAME} context, refusing" >&2; exit 1; }
CONTAINER="lepton-${NAME}"

say() { printf '%s: %s\n' "${microos_me}" "$*" >&2; }

fail() {
    say "$*"
    mkdir -p "${RUN}" && printf 'microos-android-run: %s\n' "$*" > "${RUN}/start-failed"
    exit 1
}

check_fail() {
    say "$*"
    exit 1
}

check_reason() {
    word_ok "${1:-}" || check_fail "$2"
    printf '%s\n' "$1"
    exit 2
}

legacy_context() {
    local old=play path
    for path in "$(home)/.local/share/lepton/contexts/microemu-${old}" \
        "$(home)/.local/share/microemu/android/home/.local/share/lepton/contexts/microemu-${old}"; do
        [[ -d "${path}" ]] || continue
        printf '%s\n' "${path}"
        return 0
    done
    return 1
}

stamp_word() {
    local file="${CONTEXT}/microos-android-stamp" key=$1
    [[ -f "${file}" ]] || return 1
    sed -n "s/^${key}=//p" "${file}" 2>/dev/null | head -n 1
}

check() {
    local runtime="" identity="" stamp="" storage_word storage_folder
    if [[ ! -d "${CONTEXT}" ]] && legacy_context > /dev/null; then
        check_reason old-path "the context is at an older path, refusing"
    fi
    runtime=$(MICROOS_LEPTON_READ_ONLY=1 "${LEPTON}" runtime 2>/dev/null) || check_fail "no Lepton runtime, refusing"
    identity=$(rootfs_identity "${runtime}" 2>/dev/null) || identity=
    stamp=$(stamp_word rootfs 2>/dev/null) || stamp=
    if [[ -n "${identity}" && -n "${stamp}" ]] && identity_older "${stamp}" "${identity}"; then
        check_reason downgrade "the runtime is older than the context last booted, refusing"
    fi
    storage_read || :
    case "${storage_word}" in
        card|on-os-card) ;;
        *) check_reason "${storage_word}" "shared storage reads ${storage_word}" ;;
    esac
    exit 0
}

storage_lock_run() {
    mkdir -p "${STATE_DIR}" || fail "cannot make ${STATE_DIR}"
    [[ ! -L "${STORAGE_LOCK}" ]] || fail "${STORAGE_LOCK} is a link, refusing"
    exec {storage_fd}>>"${STORAGE_LOCK}" || return 1
    flock -n -s "${storage_fd}" || return 1
    return 0
}

private_home_dirs() {
    local dir
    for dir in Documents Downloads Videos; do
        [[ ! -d "${VALVE_HOME}/${dir}" ]] || { printf '%s\n' "${dir}"; return 0; }
    done
    return 0
}

storage_external() {
    local word folder dir file
    storage_read --locked || return 1
    word=${storage_word}
    folder=${storage_folder}
    case "${word}" in
        card|on-os-card) ;;
        *) reason "${word}" "shared storage reads ${word}" ;;
    esac
    for dir in $(private_home_dirs); do
        reason folder-unusable "${dir} is in the private HOME and Valve would link it into the shared storage, refusing"
    done
    if [[ -z "${folder}" ]]; then
        folder="${CONTEXT}/external"
        if [[ ! -d "${folder}" || -L "${folder}" ]]; then
            reason folder-unusable "${folder} is not a directory, refusing"
        fi
    fi
    find "${folder}" -maxdepth 1 -name '.microos-write.*' -delete 2>/dev/null || :
    file=$(LC_ALL=C mktemp -p "${folder}" .microos-write.XXXXXX 2>&1) || {
        case "${file}" in
            *"Read-only file system"*) reason read-only "${folder} is read only, refusing" ;;
            *) reason folder-unusable "cannot write in ${folder}: ${file}" ;;
        esac
    }
    rm -f "${file}" || reason folder-unusable "cannot remove ${file}, refusing"
    [[ "${word}" != on-os-card ]] || [[ "${folder}" == "${CONTEXT}/external" ]] \
        || reason folder-unusable "${folder} is not ${CONTEXT}/external on an SD install, refusing"
    printf '%s\n' "${folder}"
}

check_stub() {
    local ext="${CONTEXT}/external" entries mode
    [[ -d "${ext}" && ! -L "${ext}" ]] || fail "${ext} is not a directory, refusing"
    entries=$(ls -A -- "${ext}" 2>/dev/null) || fail "cannot read ${ext}, refusing"
    [[ -z "${entries}" ]] || fail "${ext} is not empty, refusing"
    mode=$(stat -c %a "${ext}") || fail "cannot read ${ext}, refusing"
    [[ "${mode}" == 555 ]] || emptying_step || fail "${ext} is ${mode}, not 0555, refusing"
}

emptying_step() {
    [[ "$(storage_step_get verb)" == move-card && "$(storage_step_get step)" == emptying \
        && "$(storage_step_get id)" == "$(storage_tie storage)" ]]
}

context_create() {
    local tmp="${CONTEXT}.tmp" card="" id="" kind content="" row="" stale_row="" stale_uuid=""
    local stale="" stale_card="" stale_id="" storage_word storage_folder
    if [[ -e "${tmp}" || -L "${tmp}" ]]; then
        stale_card=$(sed -n 's/^card=//p' "${tmp}/microos-android-storage" 2>/dev/null | head -n 1) || stale_card=
        stale_id=$(sed -n 's/^storage=//p' "${tmp}/microos-android-storage" 2>/dev/null | head -n 1) || stale_id=
        stale=$(storage_content) || stale=
        stale_row=$(storage_mount_row "${stale}" 2>/dev/null) || stale_row=
        IFS='|' read -r _ stale_uuid _ <<< "${stale_row}"
        if [[ -n "${stale_card}" && -n "${stale_id}" && "${stale_uuid}" == "${stale_card}" ]]; then
            rmdir "${stale}/MicroOS/Android/${stale_id}" 2>/dev/null || :
        fi
        rm -rf "${tmp:?}" || fail "cannot remove the stale ${tmp}, refusing"
    fi
    storage_read --locked || reason moving "cannot read the shared storage, refusing"
    kind=${storage_word}
    case "${kind}" in
        card)
            content=$(storage_content) || reason no-card "no content card, refusing"
            row=$(storage_mount_row "${content}") || reason no-card "cannot read the mount table of ${content}, refusing"
            IFS='|' read -r _ card _ <<< "${row}"
            ;;
        on-os-card) ;;
        *)
            reason "${kind}" "shared storage reads ${kind}, refusing"
            ;;
    esac
    id=$(storage_new_id)
    mkdir -p "$(dirname "${CONTEXT}")" || fail "cannot make $(dirname "${CONTEXT}"), refusing"
    mkdir "${tmp}" || fail "cannot make ${tmp}, refusing"
    {
        [[ -z "${card}" ]] || printf 'card=%s\n' "${card}"
        printf 'storage=%s\n' "${id}"
    } | storage_write "${tmp}/microos-android-storage" || { rm -rf "${tmp:?}"; fail "cannot write the tie, refusing"; }
    if [[ "${kind}" == card ]]; then
        if ! mkdir "${tmp}/external" || ! chmod 0555 "${tmp}/external"; then
            rm -rf "${tmp:?}"
            fail "cannot make ${tmp}/external, refusing"
        fi
        if ! storage_make_folder "${content}" "${id}"; then
            rmdir "${content}/MicroOS/Android/${id}" 2>/dev/null || :
            rm -rf "${tmp:?}"
            fail "cannot make ${content}/MicroOS/Android/${id}, refusing"
        fi
    elif ! mkdir "${tmp}/external" || ! chmod 0770 "${tmp}/external"; then
        rm -rf "${tmp:?}"
        fail "cannot make ${tmp}/external, refusing"
    fi
    sync "${tmp}" || { rm -rf "${tmp:?}"; fail "cannot sync ${tmp}, refusing"; }
    mv -T "${tmp}" "${CONTEXT}" || { rm -rf "${tmp:?}"; fail "cannot move ${tmp} into ${CONTEXT}, refusing"; }
    sync "$(dirname "${CONTEXT}")" || say "cannot sync ${CONTEXT}'s parent"
    say "made the context ${CONTEXT}"
    return 0
}
reason() {
    word_ok "${1:-}" || fail "${2:-refusal}"
    write_reason "${RUN}" "$1" || fail "$2"
    fail "$2"
}

request_install() {
    mkdir -p "${XDG_STATE_HOME}/microos-lepton" && : > "${XDG_STATE_HOME}/microos-lepton/lepton-install-requested"
}

container_running() {
    [[ "$(podman container inspect -f '{{.State.Running}}' "${CONTAINER}" 2>/dev/null)" == true ]]
}

boot_completed() {
    [[ "$(podman exec "${CONTAINER}" /system/bin/getprop sys.boot_completed 2>/dev/null)" == 1 ]]
}

boot_log() {
    until container_running && podman exec "${CONTAINER}" /system/bin/pidof logd >/dev/null 2>&1; do
        sleep "${POLL_S}"
    done
    podman exec "${CONTAINER}" /system/bin/logcat -b main -b system -b crash -v threadtime 2>/dev/null \
        | while IFS= read -r line; do
            printf '%s\n' "${line}"
            if [[ "${line}" == *"privapp-permissions whitelist"* && ! -e "${DATA}/privapp-log" ]]; then
                printf '%s\n' "${line}" > "${DATA}/privapp-log"
            fi
        done >> "${DATA}/boot.log"
}

steam_pipe() {
    while :; do
        if [[ -p "${STEAM_PIPE}" ]] && ! pgrep -x steam >/dev/null 2>&1; then
            python3 - "${STEAM_PIPE}" <<'PY'
import os
import select
import stat
import subprocess
import sys

path = sys.argv[1]


def steam_running():
    return subprocess.run(["pgrep", "-x", "steam"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


try:
    fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
except OSError:
    sys.exit(0)
if not stat.S_ISFIFO(os.fstat(fd).st_mode):
    sys.exit(0)
pending = b""
while not steam_running():
    try:
        if not stat.S_ISFIFO(os.stat(path).st_mode) or os.stat(path).st_ino != os.fstat(fd).st_ino:
            break
    except OSError:
        break
    ready, _, _ = select.select([fd], [], [], 1)
    if not ready:
        continue
    pending += os.read(fd, 65536)
    while b"\n" in pending:
        line, pending = pending.split(b"\n", 1)
        if line:
            print("microos-android-run: android asked to open " + line.decode(errors="replace"), file=sys.stderr, flush=True)
os.close(fd)
PY
        fi
        sleep 1
    done
}

derive_rc() {
    local runtime=$1 source rootfs overlay keycodes=0 line stripped=0 number=0 rc_rc rc_hash
    local -a trees
    source="${runtime}/images/rootfs/system/etc/init/lineage-system.rc"
    rootfs="${runtime}/images/rootfs"
    overlay="${runtime}/images/rootfs_overlay"
    if [[ -e "${overlay}/system/etc/init/lineage-system.rc" || -L "${overlay}/system/etc/init/lineage-system.rc" ]]; then
        reason rc-keycodes "Lepton in ${runtime} ships system/etc/init/lineage-system.rc in images/rootfs_overlay, refusing"
    fi
    [[ -d "${rootfs}" && ! -L "${rootfs}" ]] || reason rc-keycodes "${rootfs} missing, refusing"
    [[ -f "${source}" && ! -L "${source}" ]] || reason rc-keycodes "${source} missing, refusing"
    rc_hash=$(sha256sum < "${source}" | cut -d' ' -f1) || reason rc-keycodes "cannot read ${source}, refusing"
    trees=("${rootfs}")
    [[ ! -d "${overlay}" ]] || trees+=("${overlay}")
    if ! find "${trees[@]}" \( -type f -o -type l \) -name '*.rc' -print0 > "${RUN}/rc-list"; then
        rm -f "${RUN}/rc-list"
        reason rc-keycodes "cannot list the rc files under ${trees[*]}, refusing"
    fi
    while IFS= read -r -d '' line; do
        [[ "${line}" != "${source}" ]] || continue
        [[ ! -L "${line}" ]] || { rm -f "${RUN}/rc-list"; reason rc-keycodes "${line} is a link, refusing"; }
        rc_rc=0
        grep -qE '^[[:space:]]*keycodes([[:space:]]|$)' "${line}" || rc_rc=$?
        case "${rc_rc}" in
            0) rm -f "${RUN}/rc-list"; reason rc-keycodes "a keycodes line outside ${source}: ${line}, refusing" ;;
            1) ;;
            *) rm -f "${RUN}/rc-list"; reason rc-keycodes "cannot read ${line}, refusing" ;;
        esac
    done < "${RUN}/rc-list"
    rm -f "${RUN}/rc-list"
    while IFS= read -r line || [[ -n "${line}" ]]; do
        number=$((number + 1))
        if [[ "${line}" =~ ^[[:space:]]*keycodes([[:space:]]|$) ]]; then
            keycodes=$((keycodes + 1))
            if [[ "${line}" =~ ^[[:space:]]*keycodes[[:space:]]+114[[:space:]]+115[[:space:]]+116[[:space:]]*$ ]]; then
                stripped=${number}
                continue
            fi
        fi
        printf '%s\n' "${line}"
    done < "${source}" > "${RUN}/lineage-system.rc.new" || reason rc-keycodes "cannot write ${RUN}/lineage-system.rc, refusing"
    if (( stripped == 0 )); then
        rm -f "${RUN}/lineage-system.rc.new"
        reason rc-keycodes "${source} has no keycodes 114 115 116 line, refusing"
    fi
    if (( keycodes != 1 )); then
        rm -f "${RUN}/lineage-system.rc.new"
        reason rc-keycodes "${source} has ${keycodes} keycodes lines, not one, refusing"
    fi
    chmod 0644 "${RUN}/lineage-system.rc.new" || { rm -f "${RUN}/lineage-system.rc.new"; reason rc-keycodes "cannot write ${RUN}/lineage-system.rc, refusing"; }
    if ! cmp -s "${RUN}/lineage-system.rc.new" <(sed "${stripped}d" "${source}"); then
        rm -f "${RUN}/lineage-system.rc.new"
        reason rc-keycodes "${RUN}/lineage-system.rc has more or less than ${source} minus line ${stripped}, refusing"
    fi
    mv -T "${RUN}/lineage-system.rc.new" "${RUN}/lineage-system.rc" || reason rc-keycodes "cannot write ${RUN}/lineage-system.rc, refusing"
    say "stripped keycodes from line ${stripped} of ${source} (${rc_hash})"
}

gapps_check() {
    local dir path sha size
    dir=$(readlink -f "${GAPPS}/current" 2>/dev/null) || return 1
    [[ -d "${dir}" && -f "${dir}/STAMP" ]] || return 1
    [[ -f "${STUB_DIR}/restrictions-stub.jar" && -f "${STUB_DIR}/restrictions-stub.rc" ]] || return 1
    while read -r sha size path; do
        [[ "${sha}" == set=* ]] && continue
        [[ -n "${path}" && "${path}" == system/* && "${path}" != *..* ]] || return 1
        [[ -f "${dir}/${path}" && "$(stat -c %s "${dir}/${path}")" == "${size}" ]] || return 1
        printf '%s\n' "${path}"
    done < "${dir}/STAMP"
}

guest_gms() {
    local packages="${CONTEXT}/baked/data_overlay/system/packages.xml"
    [[ -f "${packages}" ]] || return 1
    awk '/<package /{ if ($0 ~ /name="com\.google\.android\.gms"/ \
        && $0 ~ /codePath="\/system\/priv-app\//) found = 1 } END { exit !found }' "${packages}"
}

write_stamp() {
    printf '%s\n' "${stamp}" > "${CONTEXT}/microos-android-stamp.new" \
        && mv -T "${CONTEXT}/microos-android-stamp.new" "${CONTEXT}/microos-android-stamp"
}

first_gapps_boot() {
    local perm ok=1
    for perm in ${GMS_GRANTS}; do
        if ! podman exec "${CONTAINER}" /system/bin/pm grant com.google.android.gms "${perm}" >/dev/null 2>&1; then
            say "pm grant com.google.android.gms ${perm} failed"
            ok=0
        fi
    done
    if (( ! ok )); then
        say "first boot with ${gapps_set}: a grant failed, the stamp stays unchanged and the next start retries"
        return 0
    fi
    write_stamp
    say "first boot with ${gapps_set}: grants done"
}

quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

apply_opts() {
    local kind id rest arg line script='' stamp_file="${CONTEXT}/microos-android-opts" result applied=0 failed=0
    local -a args
    [[ -f "${OPTS}" ]] || { say "${OPTS} missing, no guest settings applied"; return 0; }
    touch "${stamp_file}"
    while read -r kind id rest; do
        [[ -n "${kind}" ]] || continue
        [[ "${id}" =~ ^[a-z0-9-]+$ ]] || { say "${OPTS}: bad id ${id}"; continue; }
        case "${kind}" in
            set|pkg) grep -qxF -- "${id}" "${stamp_file}" && continue ;;
            unset) grep -qxF -- "${id}" "${stamp_file}" || continue ;;
            *) say "${OPTS}: unknown kind ${kind}"; continue ;;
        esac
        read -ra args <<<"${rest}"
        line="${kind:0:1} $(quote "${id}")"
        for arg in "${args[@]}"; do
            line+=" $(quote "${arg}")"
        done
        script+="${line}"$'\n'
    done < "${OPTS}"
    [[ -n "${script}" ]] || return 0
    script='s() { i=$1; shift; if /system/bin/cmd "$@" >/dev/null 2>&1; then echo "ok $i"; else echo "fail $i"; fi; }
u() { i=$1; shift; if /system/bin/cmd "$@" >/dev/null 2>&1; then echo "undone $i"; else echo "fail $i"; fi; }
p() { if /system/bin/cmd package list packages "$2" 2>/dev/null | /system/bin/grep -qx "package:$2"; then s "$1" package disable-user --user 0 "$2"; else echo "absent $1"; fi; }
'"${script}"
    while read -r result id; do
        [[ "${id}" =~ ^[a-z0-9-]+$ ]] || continue
        case "${result}" in
            exit)
                [[ "${id}" == 124 ]] && say "guest settings timed out after ${OPTS_TIMEOUT_S} s, the next start retries the rest"
                ;;
            ok|absent)
                printf '%s\n' "${id}" >> "${stamp_file}"
                applied=$((applied + 1))
                ;;
            undone)
                grep -vxF -- "${id}" "${stamp_file}" > "${stamp_file}.new"
                mv "${stamp_file}.new" "${stamp_file}"
                applied=$((applied + 1))
                ;;
            fail)
                say "guest setting ${id} failed, the next start retries it"
                failed=$((failed + 1))
                ;;
        esac
    done < <(timeout "${OPTS_TIMEOUT_S}" podman exec "${CONTAINER}" /system/bin/sh -c "${script}" 2>/dev/null; echo "exit $?")
    say "guest settings: ${applied} applied, ${failed} failed"
}

boot_log_pid=
steam_pipe_pid=
session_watch_pid=

stop_child() {
    local pid=$1 i
    [[ -n "${pid}" ]] || return 0
    pkill -TERM -P "${pid}" 2>/dev/null
    kill "${pid}" 2>/dev/null
    for (( i = 0; i < 20; i++ )); do
        kill -0 "${pid}" 2>/dev/null || return 0
        sleep 0.05
    done
    kill -KILL "${pid}" 2>/dev/null
}

stop_session_watch() {
    stop_child "${session_watch_pid}"
    session_watch_pid=
}

if [[ "${1:-}" == --check ]]; then
    check
fi

rm -f "${RUN}/start-failed"
storage_lock_run || reason moving "a storage verb holds ${STORAGE_LOCK}, refusing"
podman() {
    command podman "$@" {storage_fd}>&-
}
rc=0
podman container exists "${CONTAINER}" 2>/dev/null || rc=$?
case "${rc}" in
    1) ;;
    0) fail "container ${CONTAINER} exists, refusing" ;;
    *) fail "podman container exists failed (rc=${rc}), refusing" ;;
esac
display=${GAMESCOPE_WAYLAND_DISPLAY:-}
if [[ -z "${display}" || "${display}" == /* || "${display}" == *..* || ! -S "${XDG_RUNTIME_DIR}/${display}" ]]; then
    fail "no gamescope display at ${display:-unset}"
fi
density=$(sed -n 's/^density=//p' "${DISPLAY_FILE}" 2>/dev/null | head -n 1)
[[ "${density}" =~ ^[0-9]+$ ]] || fail "no density in ${DISPLAY_FILE}"
[[ -x "${LEPTON}" ]] || fail "${LEPTON} missing"
lepton_err=$(mktemp) || fail "cannot make a temp file"
rc=0
lepton_runtime=$("${LEPTON}" runtime 2> "${lepton_err}") || rc=$?
if (( rc )); then
    reason_text=$(grep -v '^$' "${lepton_err}" | sed -n '$p' | sed 's/^microos-lepton: //')
    rm -f "${lepton_err}"
    [[ "${reason_text}" != "${LEPTON_NOT_INSTALLED}" ]] || request_install
    fail "${reason_text}"
fi
rm -f "${lepton_err}"
odm_source="${lepton_runtime}/images/rootfs/vendor/odm/etc/build.prop"
[[ -f "${odm_source}" ]] || fail "${odm_source} missing"

mkdir -p "${RUN}" "${DATA}"
if [[ ! -e "${CONTEXT}" && ! -L "${CONTEXT}" ]]; then
    legacy_context > /dev/null && reason old-path "the context is at an older path, refusing"
    context_create
fi
mkdir -p "${CONTEXT}/internal" || fail "cannot make ${CONTEXT}/internal"
storage_kind=$(storage_state --locked | head -n 1)
[[ "${storage_kind}" != card ]] || check_stub
MICROOS_ANDROID_EXTERNAL=$(storage_external) || fail "cannot read the shared storage, refusing"
[[ -n "${MICROOS_ANDROID_EXTERNAL}" ]] || fail "no shared storage folder, refusing"
export MICROOS_ANDROID_EXTERNAL
{
    cat "${odm_source}"
    echo "ro.sf.lcd_density=${density}"
    echo qemu.hw.mainkeys=1
    echo pm.dexopt.install=speed
    echo ro.adb.secure=1
    if [[ -e "${DATA}/privapp-log" ]]; then
        echo ro.control_privapp_permissions=log
    fi
} > "${RUN}/odm-build.prop"
[[ ! -e "${DATA}/privapp-log" ]] || say "privapp log mode"

derive_rc "${lepton_runtime}"

mounts=()
while IFS= read -r node; do
    [[ -n "${node}" ]] || continue
    mounts+=("\"type=bind,source=${node},destination=${node},rw\"")
done < <("${PAD_NODES}")
mounts+=("\"type=bind,source=${RUN}/lineage-system.rc,destination=/system/etc/init/lineage-system.rc,ro\"")
mounts+=("\"type=bind,source=${RUN}/odm-build.prop,destination=/vendor/odm/etc/build.prop,ro\"")
mounts+=("\"type=bind,source=/dev/net/tun,destination=/dev/tun,rw\"")

gapps_set=
old_stamp=$(cat "${CONTEXT}/microos-android-stamp" 2>/dev/null)
old_gapps=$(sed -n 's/^.* gapps=//p' <<< "${old_stamp}" | head -n 1)
gapps_list=$(gapps_check 2>/dev/null) || gapps_list=
if [[ -z "${gapps_list}" ]] && { [[ ! -f "${CONTEXT}/microos-android-stamp" ]] \
    || { [[ -n "${old_gapps}" && "${old_gapps}" != none ]]; }; } && guest_gms; then
    reason gapps-missing "the context was booted with Google apps and no set is installed, run microos-android gapps install"
fi
if [[ -e "${GAPPS}/current" || ( -n "${old_gapps}" && "${old_gapps}" != none ) ]]; then
    [[ -n "${gapps_list}" ]] || fail "gapps tree incomplete, run microos-android gapps install"
    mapfile -t gapps_files <<<"${gapps_list}"
    gapps_dir=$(readlink -f "${GAPPS}/current")
    gapps_set=${gapps_dir##*/}
    for path in "${gapps_files[@]}"; do
        mounts+=("\"type=bind,source=${gapps_dir}/${path},destination=/${path},ro\"")
    done
    mounts+=("\"type=bind,source=${STUB_DIR}/restrictions-stub.jar,destination=/system/framework/restrictions-stub.jar,ro\"")
    mounts+=("\"type=bind,source=${STUB_DIR}/restrictions-stub.rc,destination=/system/etc/init/restrictions-stub.rc,ro\"")
    say "gapps ${gapps_set} on"
fi
{
    echo "[containers]"
    echo "annotations = [\"run.oci.systemd.subgroup=app-steam-app1-1.scope\"]"
    echo "mounts = [$(IFS=,; echo "${mounts[*]}")]"
} > "${RUN}/containers.conf"

stamp="$(cat "${lepton_runtime}/version.txt" 2>/dev/null) $(cat "${lepton_runtime}/images/version.txt" 2>/dev/null) gapps=${gapps_set:-none}"
identity=$(rootfs_identity "${lepton_runtime}" 2>/dev/null) || identity=
if [[ -n "${identity}" ]]; then
    stamp+=$'\n'"rootfs=${identity}"
fi
stamp_changed=0
if [[ "${old_stamp}" != "${stamp}" ]]; then
    stamp_changed=1
    say "context stamp missing or changed, boot bound extended"
    systemd-notify "EXTEND_TIMEOUT_USEC=${EXTEND_USEC}"
fi

unset SteamAppId LD_LIBRARY_PATH
export TERM=dumb APP_WANTS_FLATSCREEN=true GAMESCOPE_WAYLAND_DISPLAY="${display}"
export STEAM_COMPAT_DATA_PATH="${CONTEXT}" LEPTON_NO_CLEANUP=true LEPTON_KEEP_CONTEXT=1 MICROOS_LEPTON_RUNTIME="${lepton_runtime}"
export CONTAINERS_CONF_OVERRIDE="${RUN}/containers.conf"

rm -f "${RUN}/lepton.out"
mkfifo "${RUN}/lepton.out"
: > "${DATA}/boot.log"
boot_log {storage_fd}>&- &
boot_log_pid=$!
if [[ -z "${MICROOS_STEAM_PIPE:-}" ]]; then
    mkdir -p "${STEAM_PIPE%/*}" && { [[ -e "${STEAM_PIPE}" || -L "${STEAM_PIPE}" ]] || mkfifo "${STEAM_PIPE}"; }
fi
if [[ -p "${STEAM_PIPE}" ]]; then
    steam_pipe {storage_fd}>&- &
    steam_pipe_pid=$!
else
    say "no ${STEAM_PIPE}, Steam links from Android are not read"
fi
if [[ -x "${SESSION_WATCH}" ]]; then
    "${SESSION_WATCH}" {storage_fd}>&- &
    session_watch_pid=$!
else
    say "${SESSION_WATCH} missing, no session watch"
fi

handle() {
    local line=$1
    if (( ready )); then
        printf '%s\n' "${line}" >> "${DATA}/lepton.log"
        return 0
    fi
    printf '%s\n' "${line}" >&2
    [[ "${line}" == "Boot complete!" ]] || return 0
    if container_running && boot_completed; then
        ready=1
        apply_opts
        if (( stamp_changed )) && [[ -n "${gapps_set}" ]]; then
            printf 'gapps\n' > "${RUN}/first-boot.new" || say "cannot write ${RUN}/first-boot"
            mv -T "${RUN}/first-boot.new" "${RUN}/first-boot" 2>/dev/null || say "cannot write ${RUN}/first-boot"
            first_gapps_boot {storage_fd}>&- &
        else
            write_stamp
        fi
        systemd-notify --ready
        stop_child "${boot_log_pid}"
        say "android ready"
    else
        say "lepton printed Boot complete! but the container is not running or not booted"
    fi
}

ready=0
partial=
: > "${DATA}/lepton.log"
stopping=0
trap 'stopping=1; say "stop requested, waiting for lepton start"' TERM
trap 'stopping=1; say "stop requested, waiting for lepton start"' INT
"${LEPTON}" start "${NAME}" {storage_fd}>&- > "${RUN}/lepton.out" 2>&1 &
lepton_pid=$!
exec 3< "${RUN}/lepton.out"
rm -f "${RUN}/lepton.out"

while :; do
    read_rc=0
    IFS= read -r -t 1 line <&3 || read_rc=$?
    if (( read_rc == 0 )); then
        handle "${partial}${line}"
        partial=
        continue
    fi
    if (( read_rc <= 128 )); then
        [[ -z "${partial}${line}" ]] || handle "${partial}${line}"
        break
    fi
    partial+=${line}
    if ! kill -0 "${lepton_pid}" 2>/dev/null; then
        while IFS= read -r -t 0.2 line <&3; do
            handle "${partial}${line}"
            partial=
        done
        [[ -z "${partial}${line}" ]] || handle "${partial}${line}"
        break
    fi
done
exec 3<&-

rc=0
while :; do
    rc=0
    wait "${lepton_pid}" || rc=$?
    kill -0 "${lepton_pid}" 2>/dev/null || break
done
stop_child "${boot_log_pid}"
stop_child "${steam_pipe_pid}"
stop_session_watch
say "lepton start exited with ${rc}"
printf 'microos-android-run: lepton start exited with %s\n' "${rc}" >> "${DATA}/lepton.log"
if (( stopping )); then
    exit 143
fi
if (( ! ready )); then
    fail "android exited during boot, see ${DATA}/boot.log"
fi
exit "${rc}"
