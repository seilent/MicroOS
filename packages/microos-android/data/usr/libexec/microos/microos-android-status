#!/usr/bin/python3
import json
import os
import re
import signal
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

ME = "microos-android-status"
NAME = "net.seilent.MicroOs.Android1"
ROOT = "/net/seilent/MicroOs/Android"
XML = f"""
<node>
  <interface name="{NAME}">
    <property name="Lepton" type="s" access="read"/>
    <property name="LeptonBuild" type="s" access="read"/>
    <property name="GooglePlay" type="s" access="read"/>
    <property name="GsfId" type="s" access="read"/>
    <property name="LastResult" type="s" access="read"/>
    <property name="LastReason" type="s" access="read"/>
    <property name="Storage" type="s" access="read"/>
    <property name="StorageCard" type="s" access="read"/>
    <method name="Foreground">
      <arg name="package" type="s" direction="out"/>
    </method>
  </interface>
</node>
"""
GUEST = os.environ.get("MICROOS_ANDROID_GUEST") or "/usr/libexec/microos/microos-android-guest"
IMAGES = os.environ.get("MICROOS_ANDROID_IMAGES") or "/var/lib/microos-android/images"
IMAGES_STATE = os.environ.get("MICROOS_ANDROID_IMAGES_STATE") or "/var/lib/microos-android/images.state"
VAR = os.environ.get("MICROOS_ANDROID_VAR") or "/var/lib/microos-android"
SYSTEM_CARD = os.environ.get("MICROOS_SYSTEM_CARD") or "/run/microos/system-card"
POLL_MS = int(os.environ.get("MICROOS_STATUS_POLL_MS") or 1000)
SETTLE_MS = int(os.environ.get("MICROOS_STATUS_SETTLE_MS") or 50)
FOREGROUND_MS = int(os.environ.get("MICROOS_STATUS_FOREGROUND_MS") or 2000)
LAUNCHER = "com.android.launcher3"
RESUMED = re.compile(r"ResumedActivity: ActivityRecord\{\S+ u[0-9]+ ([A-Za-z0-9_.]+)/[A-Za-z0-9_.$]+")
FIELDS = ("Lepton", "LeptonBuild", "GooglePlay", "GsfId", "LastResult", "LastReason", "Storage", "StorageCard")


def log(message):
    print(f"{ME}: {message}", file=sys.stderr, flush=True)


def home():
    return os.environ.get("HOME") or os.path.expanduser("~")


def state_dir():
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(home(), ".local/state")
    return os.environ.get("MICROOS_ANDROID_STATE") or os.path.join(base, "microos-android")


def run_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    return os.environ.get("MICROOS_RUNTIME_DIR") or os.path.join(base, "microos-android")


def install_mark():
    try:
        with open(os.path.join(run_dir(), "gapps-install")) as handle:
            return handle.read().strip()
    except OSError:
        return ""


def read_state():
    try:
        with open(os.path.join(state_dir(), "state.json")) as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def text(data, *path):
    node = data
    for part in path:
        if not isinstance(node, dict):
            return ""
        node = node.get(part)
    if node is None or isinstance(node, bool):
        return ""
    return str(node)


def first_line(path):
    try:
        with open(path) as handle:
            return handle.readline().strip()
    except (OSError, UnicodeDecodeError):
        return ""


def image_state():
    try:
        with open(IMAGES_STATE) as handle:
            for line in handle:
                if line.startswith("state="):
                    return line.strip()[len("state="):]
    except (OSError, UnicodeDecodeError):
        pass
    return ""


def image_values():
    current = os.path.join(IMAGES, "current")
    state = image_state()
    try:
        build = os.path.basename(os.readlink(current)) if os.path.isdir(current) else ""
    except OSError:
        build = ""
    if state == "fetching":
        return "downloading", build
    if build:
        return "ready", build
    return ("failed" if state == "failed" else "not-installed"), ""


def google_play(data, install):
    if install == "running":
        return "updating"
    if install == "failed":
        return "failed"
    installed = os.path.isfile(os.path.join(VAR, "gapps.manifest"))
    booted = text(data, "gapps", "play") == "on"
    if installed != booted:
        return "updating"
    return "on" if booted else "off"


def gsf_id():
    value = first_line(os.path.join(VAR, "gsf-id"))
    return value if re.fullmatch(r"[1-9][0-9]*", value) else ""


def storage_word():
    if os.path.islink(SYSTEM_CARD):
        return ""
    flag = first_line(SYSTEM_CARD)
    if flag == "none":
        return "on-internal"
    if flag == "internal" or re.fullmatch(r"mmcblk[0-9]+", flag):
        return "on-os-card"
    return ""


def resumed_package(output):
    found = RESUMED.search(output)
    if not found or found.group(1) == LAUNCHER:
        return ""
    return found.group(1)


def directory_stamp(directory):
    try:
        status = os.stat(directory)
    except OSError:
        return (0, 0)
    return (status.st_mtime_ns, status.st_ino)


def link_stamp(path):
    try:
        status = os.lstat(path)
    except OSError:
        return (0, 0, "")
    try:
        target = os.readlink(path)
    except OSError:
        target = ""
    return (status.st_mtime_ns, status.st_ino, target)


class Status:
    def __init__(self, bus):
        self.bus = bus
        self.node = Gio.DBusNodeInfo.new_for_xml(XML)
        self.registration = bus.register_object(ROOT, self.node.interfaces[0], self.method, self.property, None)
        self.monitors = []
        self.armed = set()
        self.last = {}
        self.stamp = None
        self.pending = 0

    def values(self):
        data = read_state()
        word, build = image_values()
        return {
            "Lepton": word,
            "LeptonBuild": build,
            "GooglePlay": google_play(data, install_mark()),
            "GsfId": gsf_id(),
            "LastResult": text(data, "last", "result"),
            "LastReason": text(data, "last", "reason"),
            "Storage": storage_word(),
            "StorageCard": "",
        }

    def method(self, conn, sender, path, interface, name, params, invocation):
        if name == "Foreground":
            self.foreground(invocation)
            return
        invocation.return_dbus_error(NAME + ".UnknownMethod", f"{name} is not a method")

    def foreground(self, invocation):
        def answer(package):
            invocation.return_value(GLib.Variant("(s)", (package,)))

        try:
            process = Gio.Subprocess.new(
                [GUEST, "sh", "dumpsys activity activities"],
                Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            answer("")
            return
        cancellable = Gio.Cancellable()
        timer = {"id": 0}

        def expire():
            timer["id"] = 0
            cancellable.cancel()
            process.force_exit()
            return False

        def done(proc, result):
            if timer["id"]:
                GLib.source_remove(timer["id"])
            package = ""
            try:
                data = proc.communicate_finish(result)[1]
                if proc.get_if_exited() and proc.get_exit_status() == 0:
                    package = resumed_package(bytes(data.get_data() if data else b"").decode(errors="replace"))
            except Exception:
                package = ""
            answer(package)

        timer["id"] = GLib.timeout_add(FOREGROUND_MS, expire)
        process.communicate_async(None, cancellable, done)

    def property(self, conn, sender, path, interface, name):
        return GLib.Variant("s", self.values().get(name, ""))

    def sample(self):
        return (directory_stamp(state_dir()), link_stamp(os.path.join(IMAGES, "current")), link_stamp(IMAGES_STATE),
                link_stamp(os.path.join(VAR, "gsf-id")), link_stamp(os.path.join(VAR, "gapps.manifest")),
                link_stamp(SYSTEM_CARD), link_stamp(os.path.join(run_dir(), "gapps-install")))

    def emit(self):
        values = self.values()
        if values == self.last:
            return
        self.last = values
        self.bus.emit_signal(
            None, ROOT, "org.freedesktop.DBus.Properties", "PropertiesChanged",
            GLib.Variant("(sa{sv}as)", (NAME, {key: GLib.Variant("s", values[key]) for key in FIELDS}, [])))

    def flush(self):
        self.pending = 0
        self.emit()
        return False

    def arm(self):
        for directory in (state_dir(), run_dir(), VAR, IMAGES, os.path.dirname(IMAGES_STATE)):
            if directory in self.armed:
                continue
            if self.watch(directory):
                self.armed.add(directory)

    def poll(self):
        self.arm()
        sample = self.sample()
        if sample != self.stamp:
            self.stamp = sample
            if not self.pending:
                self.pending = GLib.timeout_add(SETTLE_MS, self.flush)
        return True

    def watch(self, directory):
        if not os.path.isdir(directory):
            return False
        try:
            monitor = Gio.File.new_for_path(directory).monitor_directory(Gio.FileMonitorFlags.WATCH_MOVES, None)
        except GLib.Error as error:
            log(f"cannot watch {directory}: {error.message}")
            return False
        monitor.connect("changed", self.notify)
        self.monitors.append(monitor)
        return True

    def notify(self, monitor, one, two, event):
        if event not in (Gio.FileMonitorEvent.CHANGED, Gio.FileMonitorEvent.CREATED,
                         Gio.FileMonitorEvent.MOVED, Gio.FileMonitorEvent.DELETED,
                         Gio.FileMonitorEvent.RENAMED, Gio.FileMonitorEvent.MOVED_IN,
                         Gio.FileMonitorEvent.MOVED_OUT):
            return
        if one is not None and os.path.basename(one.get_path() or "").startswith(".state."):
            return
        if not self.pending:
            self.pending = GLib.timeout_add(SETTLE_MS, self.flush)


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    status = Status(bus)
    loop = GLib.MainLoop()
    owned = {"name": False}

    def acquired(conn, name):
        owned["name"] = True
        log(f"owns {NAME}")
        status.last = {}
        status.stamp = status.sample()
        status.emit()

    def lost(conn, name):
        if owned["name"]:
            log(f"lost {NAME}")
            loop.quit()
        else:
            log(f"{NAME} is taken by another process, exiting")
            loop.quit()

    Gio.bus_own_name_on_connection(bus, NAME, Gio.BusNameOwnerFlags.DO_NOT_QUEUE, acquired, lost)

    signal.signal(signal.SIGTERM, lambda *args: loop.quit())
    signal.signal(signal.SIGINT, lambda *args: loop.quit())
    status.arm()
    status.stamp = status.sample()
    GLib.timeout_add(POLL_MS, status.poll)
    loop.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
