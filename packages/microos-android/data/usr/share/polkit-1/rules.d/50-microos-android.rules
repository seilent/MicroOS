polkit.addRule(function(action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units" || subject.user != "micro") {
    return;
  }
  var unit = action.lookup("unit");
  var units = /^microos-android-(images|gsf|reset|layer|gapps@(fetch|install|remove))\.service$/;
  if (action.lookup("verb") == "start" && unit && units.test(unit)) {
    return polkit.Result.YES;
  }
});

polkit.addRule(function(action, subject) {
  var network = ["org.freedesktop.NetworkManager.enable-disable-wifi", "org.freedesktop.NetworkManager.network-control",
                 "org.freedesktop.NetworkManager.wifi.scan", "org.freedesktop.NetworkManager.settings.modify.own"];
  if (subject.user == "micro" && network.indexOf(action.id) >= 0) {
    return polkit.Result.YES;
  }
});
