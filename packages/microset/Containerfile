FROM localhost/microos-pkg-builder

RUN dnf -y --setopt=install_weak_deps=False install \
      cmake gcc-c++ qt6-qtbase-devel qt6-qtbase-private-devel qt6-qtdeclarative-devel qt6-qtwayland-devel \
      layer-shell-qt-devel glib2-devel wayland-protocols-devel wayland-devel libxcb-devel alsa-lib-devel dbus-daemon \
      util-linux unzip xorg-x11-server-Xvfb xorg-x11-xauth \
 && dnf clean all
