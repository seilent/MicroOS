From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: seilent <github@seilent.net>
Date: Sun, 8 Nov 2026 06:26:31 +0900
Subject: [PATCH] inputplumber: let the device config skip DeckService

The root DeckService rewrites every composite device that is not a deck,
so microos-input cannot own the targets. A device config with
`[inputplumber] enabled = false` now keeps DeckService out, the field
absent still starts it, and a config read error is logged and starts it.
---
 steamos-manager/src/daemon/root.rs  |  8 +++--
 steamos-manager/src/hardware.rs     |  1 +
 steamos-manager/src/inputplumber.rs | 46 ++++++++++++++++++++++++++++-
 3 files changed, 51 insertions(+), 4 deletions(-)

diff --git a/steamos-manager/src/daemon/root.rs b/steamos-manager/src/daemon/root.rs
index 7a71215..1e46c46 100644
--- a/steamos-manager/src/daemon/root.rs
+++ b/steamos-manager/src/daemon/root.rs
@@ -19,7 +19,7 @@ use zbus::connection::Connection;
 
 use crate::daemon::{Daemon, DaemonCommand, DaemonContext, channel};
 use crate::ds_inhibit::Inhibitor;
-use crate::inputplumber::DeckService;
+use crate::inputplumber::{DeckService, deck_service_enabled};
 use crate::manager::root::SteamOSManager;
 use crate::path;
 use crate::sls::ftrace::Ftrace;
@@ -127,8 +127,10 @@ impl DaemonContext for RootContext {
         let ftrace = Ftrace::init(&connection).await?;
         daemon.add_service(ftrace);
 
-        let ip = DeckService::init(connection);
-        daemon.add_service(ip);
+        if deck_service_enabled().await {
+            let ip = DeckService::init(connection);
+            daemon.add_service(ip);
+        }
 
         let sysfs = SysfsWriterService::init()?;
         daemon.add_service(sysfs);
diff --git a/steamos-manager/src/hardware.rs b/steamos-manager/src/hardware.rs
index d33f70f..b245a95 100644
--- a/steamos-manager/src/hardware.rs
+++ b/steamos-manager/src/hardware.rs
@@ -177,6 +177,7 @@ pub(crate) struct HdmiCecConfig {
 #[derive(Clone, Deserialize, Debug, Default)]
 #[serde(default)]
 pub(crate) struct InputPlumberConfig {
+    pub enabled: Option<bool>,
     pub target_devices: Vec<InputPlumberTargetDevice>,
 }
 
diff --git a/steamos-manager/src/inputplumber.rs b/steamos-manager/src/inputplumber.rs
index 0da1ea7..c7c659d 100644
--- a/steamos-manager/src/inputplumber.rs
+++ b/steamos-manager/src/inputplumber.rs
@@ -8,7 +8,7 @@
 use anyhow::Result;
 use tokio::spawn;
 use tokio_stream::StreamExt;
-use tracing::{debug, info};
+use tracing::{debug, error, info};
 use zbus::Connection;
 use zbus::fdo::{InterfacesAdded, ObjectManagerProxy};
 use zbus::names::OwnedInterfaceName;
@@ -44,6 +44,19 @@ pub struct DeckService {
     composite_device_iface_name: OwnedInterfaceName,
 }
 
+pub(crate) async fn deck_service_enabled() -> bool {
+    match device_config().await {
+        Ok(config) => config
+            .as_ref()
+            .and_then(|config| config.inputplumber.as_ref())
+            .is_none_or(|ip| ip.enabled.unwrap_or(true)),
+        Err(e) => {
+            error!("Failed to read the device config, starting DeckService: {e}");
+            true
+        }
+    }
+}
+
 impl DeckService {
     pub fn init(connection: Connection) -> DeckService {
         DeckService {
@@ -157,3 +170,34 @@ impl Service for DeckService {
         }
     }
 }
+
+#[cfg(test)]
+mod test {
+    use super::*;
+    use crate::hardware::DeviceConfig;
+    use crate::testing;
+
+    const SHIPPED_CONFIG: &str = include_str!("../microos-pm2.toml");
+
+    async fn enabled(config_toml: &str) -> bool {
+        let config: DeviceConfig = toml::from_str(config_toml).expect("device config");
+        let h = testing::start();
+        h.test.set_device_config(config).await;
+        deck_service_enabled().await
+    }
+
+    #[tokio::test]
+    async fn deck_service_enabled_without_the_field() {
+        assert!(enabled("[inputplumber]\ntarget_devices = [\"deck-uhid\", \"keyboard\"]\n").await);
+    }
+
+    #[tokio::test]
+    async fn deck_service_disabled_with_the_field() {
+        assert!(!enabled("[inputplumber]\nenabled = false\n").await);
+    }
+
+    #[tokio::test]
+    async fn deck_service_enabled_with_the_shipped_config() {
+        assert!(enabled(SHIPPED_CONFIG).await);
+    }
+}
