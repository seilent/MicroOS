[Unit]
Description=Clear the GPU undervolt boot marker on a clean shutdown
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target display-manager.service user@1000.service systemd-user-sessions.service
After=systemd-tmpfiles-setup.service microos-powerd.service
RequiresMountsFor=/var/lib/microos

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/true
ExecStop=/usr/libexec/microos/microos-gpu-undervolt-clean
ProtectSystem=strict
ReadWritePaths=-/var/lib/microos/gpu-undervolt
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
RestrictSUIDSGID=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
