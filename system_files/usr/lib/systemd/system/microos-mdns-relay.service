[Unit]
Description=mDNS relay between Wi-Fi and the Waydroid bridge
BindsTo=sys-subsystem-net-devices-waydroid0.device
After=sys-subsystem-net-devices-waydroid0.device microos-waydroid-forward.service

[Service]
Type=exec
ExecStart=/usr/libexec/microos/microos-mdns-relay wlp1s0 waydroid0
DynamicUser=yes
CapabilityBoundingSet=
ProtectHome=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=sys-subsystem-net-devices-waydroid0.device
