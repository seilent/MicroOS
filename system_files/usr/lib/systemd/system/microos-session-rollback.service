[Unit]
Description=Boot the previous image from recovery
ConditionPathExists=/run/ostree-booted
RequiresMountsFor=/sysroot /boot /boot/efi /var/lib/microos

[Service]
Type=oneshot
PrivateMounts=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
RestrictSUIDSGID=yes
ExecStart=/usr/libexec/microos/microos-session-giveup rollback
