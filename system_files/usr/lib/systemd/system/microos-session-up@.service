[Unit]
Description=Mark the %i session up
After=microos-session-boot.service
CollectMode=inactive-or-failed

[Service]
Type=oneshot
ExecStart=/usr/bin/microos-session up %i
ProtectSystem=strict
ReadWritePaths=/run/microos /var/lib/microos/session
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
