[Unit]
Description=Hand Steam the Lepton install request from MicroEMU
BindsTo=gamescope-session-plus@steam.service
After=gamescope-session-plus@steam.service
ConditionPathExists=%S/microemu/lepton-install-requested

[Service]
Type=oneshot
TimeoutStartSec=330
ExecStart=/usr/libexec/microos/microos-steam-compat lepton-install
