[Unit]
Description=Steam license cache of account %i for Lossless Scaling detection
DefaultDependencies=no
Requisite=gamescope-session-plus@steam.service
After=gamescope-session-plus@steam.service
StopPropagatedFrom=gamescope-session-plus@steam.service

[Path]
PathChanged=%h/.local/share/Steam/userdata/%i/config/licensecache
Unit=microos-lsfg.service
