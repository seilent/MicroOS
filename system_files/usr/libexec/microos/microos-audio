def describe(hw, sink):
    desc = sink.get("description")
    return desc if desc and desc != "(null)" else hw


def write_conf(instance, text):
    os.makedirs(EQ_DIR, mode=0o700, exist_ok=True)
    path = os.path.join(EQ_DIR, f"{instance}.conf")
    with open(path + ".new", "w") as f:
        f.write(text)
    os.replace(path + ".new", path)


def read_conf(instance):
    try:
        with open(os.path.join(EQ_DIR, f"{instance}.conf")) as f:
            return f.read()
    except OSError:
        return None


def remove_conf(instance):
    try:
        os.unlink(os.path.join(EQ_DIR, f"{instance}.conf"))
    except FileNotFoundError:
        pass


def channels(sink):
    return [int(c["value"]) for c in (sink.get("volume") or {}).values()]


def chain_target(sink, sinks):
    m = EQ_TARGET.search(str((sink.get("properties") or {}).get("filter.smart.target", "")))
    try:
        return sinks.get(json.loads(f'"{m.group(1)}"')) if m else None
    except ValueError:
        return None


def card_side(card):
    return "headphones" if any(REMOTE_SINK.match(name) for name in card.get("profiles") or {}) else "receiver"


def codec_profile(card, codec):
    profiles = card.get("profiles") or {}
    suffix = f"codec {CODECS[codec]})"
    for name, info in profiles.items():
        if info.get("available") is False:
            continue
        base = "a2dp-duplex" if name.startswith("a2dp-duplex") else "a2dp-sink"
        if name == f"{base}-{codec}" or (name == base and str(info.get("description", "")).endswith(suffix)):
            return name
    return None


def monotonic_us():
    return time.clock_gettime_ns(time.CLOCK_MONOTONIC) // 1000


def offer_on_disk():
    try:
        with open(OFFER_CONF) as f:
            m = OFFER_CODEC.search(f.read())
    except FileNotFoundError:
        return "auto"
    except OSError:
        return None
    return m.group(1) if m else None


def read_offer():
    offer = {"applied": "auto"}
    try:
        with open(BT_CODECS) as f:
            for line in f:
                key, _, value = line.strip().partition(" ")
                if key in ("wanted", "applied") and value:
                    offer[key] = value
                elif key == "written" and value.isdigit():
                    offer[key] = int(value)
    except OSError:
        pass
    offer.setdefault("written", monotonic_us())
    return offer


def configured_name(value):
    try:
        name = json.loads(value).get("name")
    except (ValueError, AttributeError):
        return None
    return name if isinstance(name, str) and name else None


class Audio:
    def __init__(self, bus, loop):
        self.bus = bus
        self.loop = loop
        self.output = None
        self.configured = None
        self.sent = []
        self.settling = True
        self.pending = None
        self.retry = None
        self.cycles = {}
        self.dirty = set()
        self.eq = None
        self.units = None
        self.skip_logged = set()
        self.codec = {"receiver": None, "headphones": None}
        self.codec_done = {}
        self.codec_fail = {}
        self.cards_dirty = True
        self.reset_pending = {}
        self.fold_logged = set()
        self.max_volume = None
        self.power_on = None
        self.power_on_done = False
        self.power_on_waits = 0
        self.session = None
        self.engine = None
        self.engine_seen = False
        self.offer = read_offer()
        self.role = None
        self.role_next = None
        self.role_timer = None
        self.guard = None
        self.show_failed = False
        self.hold = None
        self.hold_timer = None
        self.restarted = None
        self.deferred = None

    def watch(self, argv, handler):
        proc = Gio.Subprocess.new(argv, Gio.SubprocessFlags.STDOUT_PIPE)
        stream = Gio.DataInputStream.new(proc.get_stdout_pipe())
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.line, (argv[0], stream, handler))
        return proc

    def line(self, stream, result, data):
        name, _, handler = data
        try:
            text, _ = stream.read_line_finish_utf8(result)
        except GLib.Error as err:
            text = None
            log(f"reading {name} failed: {err.message}")
        if text is None:
            log(f"{name} exited")
            self.loop.quit()
            return
        handler(text)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.line, data)

    def metadata(self, text):
        m = UPDATE.fullmatch(text)
        if m:
            name = configured_name(m.group(1))
        elif REMOVE.fullmatch(text):
            name = None
        else:
            return
        now = time.monotonic()
        self.sent = [(n, t) for n, t in self.sent if now - t < ECHO_S]
        names = [n for n, _ in self.sent]
        if name in names:
            del self.sent[:names.index(name) + 1]
            if self.sent:
                return
        elif name is not None and not self.settling:
            self.foreign(name)
        self.configured = name
        if not self.settling:
            self.schedule()

    def foreign(self, name):
        output = classify(name) or eq_slot(name) or "auto"
        log(f"configured default {name} set elsewhere, storing audio.output {output}")
        self.output = output
        self.bus.call(
            *MICROSET, "Set", GLib.Variant("(sv)", ("audio.output", GLib.Variant("s", output))),
            None, Gio.DBusCallFlags.NONE, 5000, None, self.stored, output,
        )

    def stored(self, bus, result, output):
        try:
            bus.call_finish(result)
        except GLib.Error as err:
            log(f"storing audio.output {output} failed: {err.message}")

    def sinks(self, text):
        if " on card " in text and text.startswith(("Event 'new'", "Event 'change'")):
            self.cards_dirty = True
        if any(f" on {kind} " in text for kind in ("sink", "source", "sink-input", "source-output", "card")):
            self.schedule()

    def schedule(self):
        if self.pending is None:
            self.pending = GLib.timeout_add(DEBOUNCE_MS, self.refresh)

    def settled(self):
        self.settling = False
        self.schedule()
        return GLib.SOURCE_REMOVE

    def refresh(self):
        self.pending = None
        sinks = None
        if self.cycles or (not self.settling and (self.max_volume is not None or self.output not in (None, "auto")
                                                  or self.eq_wanted() or eq_slot(self.configured))):
            try:
                sinks = list_sinks()
            except ERRORS as err:
                log(f"listing sinks failed: {err}")
                self.again()
                return GLib.SOURCE_REMOVE
        if sinks is not None:
            self.cap(sinks)
            self.fold(sinks)
        self.reconcile(sinks)
        self.power_on_volume(sinks)
        self.equalize(sinks)
        self.codecs()
        self.offer_pass()
        self.step(sinks)
        return GLib.SOURCE_REMOVE

    def again(self):
        if self.retry is None:
            self.retry = GLib.timeout_add(RETRY_MS, self.retried)

    def retried(self):
        self.retry = None
        self.schedule()
        return GLib.SOURCE_REMOVE

    def reconcile(self, sinks):
        if self.settling or self.output is None:
            return
        current = self.configured
        slot = eq_slot(current)
        if slot is not None and self.output != slot:
            self.foreign(current)
            self.schedule()
            return
        if self.output == "auto":
            if current is None or classify(current) is None:
                return
            want = None
        else:
            usable = [s for n, s in sorted(sinks.items()) if classify(n) == self.output and available(s)]
            if current in sinks and sinks[current] in usable:
                return
            want = max(usable, key=priority)["name"] if usable else None
        if want == current:
            return
        if want is None and self.output in ("speaker", "headphones") and card_off():
            return
        self.sent = self.sent[-7:] + [(want, time.monotonic())]
        try:
            if want is None:
                run("pw-metadata", "-n", "default", "-d", "0", KEY)
                log(f"audio.output {self.output}: configured default removed")
            else:
                run("pactl", "set-default-sink", want)
                log(f"audio.output {self.output}: configured default {want}")
            self.configured = want
        except ERRORS as err:
            self.sent.pop()
            log(f"setting the configured default failed: {err}")

    def cap(self, sinks):
        if self.max_volume is None:
            return
        top = self.max_volume * FULL // 100
        fresh = None
        for name, sink in sinks.items():
            chain = channels(sink)
            if eq_slot(name) is not None or not chain or max(chain) <= top:
                continue
            try:
                if fresh is None:
                    fresh = list_sinks()
                now = channels(fresh[name]) if name in fresh else []
                if len(now) != len(chain):
                    continue
                chain = [min(a, b) for a, b in zip(chain, now)]
                if max(chain) <= top:
                    continue
                levels = [c * top // max(chain) for c in chain]
                run("pactl", "set-sink-volume", name, *map(str, levels))
                log(f"{name} volume {chain} above audio.max_volume {self.max_volume}, folded to {levels}")
            except ERRORS as err:
                log(f"folding {name} to audio.max_volume failed: {err}")
                self.again()

    def power_on_volume(self, sinks):
        if self.settling or self.power_on_done or self.max_volume is None or self.power_on is None or sinks is None:
            return
        try:
            with open(BOOT_ID) as f:
                boot = f.read().strip()
        except OSError as err:
            log(f"reading the boot id failed: {err}")
            return
        try:
            with open(POWER_ON) as f:
                if f.readline().strip() == boot:
                    self.power_on_done = True
                    return
        except OSError:
            pass
        target = ""
        if self.power_on:
            try:
                default = run("pactl", "get-default-sink").strip()
            except ERRORS as err:
                log(f"reading the default sink failed: {err}")
                self.again()
                return
            sink = sinks.get(default)
            if sink is not None and eq_slot(default) is not None:
                sink = chain_target(sink, sinks)
            if (sink is None or classify(sink["name"]) is None) and self.power_on_waits < POWER_ON_WAITS:
                if self.power_on_waits == 0:
                    log(f"audio.power_on_volume {self.power_on}: default sink {default} is not a listed output, waiting")
                self.power_on_waits += 1
                self.again()
                return
            if sink is None or classify(sink["name"]) is None:
                log(f"audio.power_on_volume {self.power_on}: default sink {default} is still not a listed output, "
                    "skipped for this boot")
            else:
                percent = min(self.power_on, self.max_volume)
                try:
                    run("pactl", "set-sink-volume", sink["name"], str(percent * FULL // 100))
                except ERRORS as err:
                    log(f"setting the power on volume failed: {err}")
                    self.again()
                    return
                log(f"audio.power_on_volume {self.power_on}: {sink['name']} set to {percent} %")
                target = sink["name"]
        self.power_on_done = True
        try:
            os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
            with open(POWER_ON + ".new", "w") as f:
                f.write(boot + "\n" + target + "\n")
            os.replace(POWER_ON + ".new", POWER_ON)
        except OSError as err:
            log(f"writing the power on marker failed: {err}")

    def eq_wanted(self):
        return self.eq is not None and (bool(self.units) or any(
            v["on"] or v["balance"] or v["crossfeed"] != "off" for v in self.eq.values()))

    def chain_spec(self, slot, sink):
        eq = self.eq[slot]
        filters = eq["filters"] if eq["on"] else None
        stereo = len(channels(sink)) == 2
        balance = eq["balance"] if stereo else 0
        crossfeed = eq["crossfeed"] if stereo and slot in WIRED else "off"
        if not stereo and (eq["balance"] or (slot in WIRED and eq["crossfeed"] != "off")):
            skipped = (sink["name"], eq["balance"], eq["crossfeed"])
            if skipped not in self.skip_logged:
                self.skip_logged.add(skipped)
                log(f"{sink['name']} has {len(channels(sink))} channels, balance and crossfeed skipped")
        if filters is None and balance == 0 and crossfeed == "off":
            return None
        preamp, bands = filters or (0.0, ())
        return preamp, bands, crossfeed, balance

    def fold(self, sinks):
        present = set()
        for name, sink in sinks.items():
            if eq_slot(name) is None:
                continue
            key = (name, (sink.get("properties") or {}).get("object.id"))
            present.add(key)
            chain = channels(sink)
            muted = bool(sink.get("mute"))
            if chain and all(c == FULL for c in chain) and not muted:
                self.reset_pending.pop(key, None)
                self.fold_logged.discard(key)
                continue
            try:
                if key not in self.reset_pending:
                    self.fold_hw(name, sink, sinks, chain, key)
                hw = self.reset_pending.get(key)
                if hw is None:
                    continue
                if muted:
                    run("pactl", "set-sink-mute", hw, "1")
                run("pactl", "set-sink-volume", name, str(FULL))
                if muted:
                    run("pactl", "set-sink-mute", name, "0")
                del self.reset_pending[key]
                log(f"{name} volume {chain} mute {muted} folded into {hw}")
            except ERRORS as err:
                log(f"folding the volume of {name} failed: {err}")
                self.again()
        self.reset_pending = {k: v for k, v in self.reset_pending.items() if k in present}
        self.fold_logged &= present

    def fold_hw(self, name, sink, sinks, chain, key):
        hw = chain_target(sink, sinks)
        if hw is None:
            if key not in self.fold_logged:
                log(f"{name} is not at 100 % and its hardware sink is gone or unknown, left as is")
                self.fold_logged.add(key)
            return
        factor = min(min(chain) / FULL, 1.0) if chain else 1.0
        if factor < 1.0:
            fresh = list_sinks().get(hw["name"])
            if fresh is None:
                raise ValueError(f"{hw['name']} is gone")
            levels = [int(min(a, b) * factor) for a, b in zip(channels(hw), channels(fresh))]
            if levels:
                run("pactl", "set-sink-volume", hw["name"], *map(str, levels))
        self.reset_pending[key] = hw["name"]

    def equalize(self, sinks):
        if self.settling or self.eq is None:
            return
        if self.units is None:
            try:
                listed = run("systemctl", "--user", "list-units", "--all", "--plain", "--no-legend", "--full",
                             "microos-eq@*.service")
            except ERRORS as err:
                log(f"listing EQ units failed: {err}")
                self.again()
                return
            self.units = {}
            for line in listed.splitlines():
                cols = line.split()
                m = EQ_UNIT.fullmatch(cols[0]) if len(cols) >= 3 else None
                if m and cols[2] in ("active", "activating", "reloading"):
                    self.units[m.group(1)] = {"hw": None, "conf": None, "live": None,
                                              "out": {"checks": 0, "stuck": 0, "kicks": 0, "timer": None}}
            if self.units:
                log(f"running EQ chains: {' '.join(sorted(self.units))}")
        want = {}
        for name, sink in sorted((sinks or {}).items()):
            slot = classify(name)
            if slot is None or (slot in ("headphones", "speaker") and not available(sink)):
                continue
            spec = self.chain_spec(slot, sink)
            if spec is not None:
                want[eq_instance(slot, name, spec)] = (name, sink, spec)
        up = {i for i in want if eq_node(i) in sinks}
        dump = None
        for instance, (hw, sink, spec) in want.items():
            unit = self.units.get(instance)
            if unit is None:
                if not self.start(instance, hw, sink, spec):
                    continue
                unit = self.units[instance]
            unit["hw"] = hw
            node = sinks.get(eq_node(instance))
            if unit["conf"] != spec:
                text = eq_conf(instance, hw, describe(hw, sink), spec)
                if unit["conf"] is None and read_conf(instance) == text:
                    unit["conf"] = unit["live"] = spec
                else:
                    try:
                        write_conf(instance, text)
                        unit["conf"] = spec
                        if node is None:
                            unit["live"] = None
                    except OSError as err:
                        log(f"writing the EQ conf of {instance} failed: {err}")
            if node is None:
                unit["waits"] = unit.get("waits", 0) + 1
                if unit["waits"] >= EQ_WAITS:
                    log(f"EQ chain {instance} has no node after {unit['waits']} refreshes, starting it again")
                    del self.units[instance]
                self.again()
                continue
            unit["waits"] = 0
            if unit["live"] != spec:
                self.props(instance, unit, spec)
            if "out" in unit and unit["out"]["timer"] is None:
                if dump is None:
                    dump = pw_dump()
                self.check_out(instance, unit, hw, dump)
        busy = {want[i][0] for i in want if i not in up}
        for instance, unit in list(self.units.items()):
            if instance in want or (unit["hw"] in busy and eq_node(instance) in (sinks or {})):
                continue
            self.stop(instance)

    def start(self, instance, hw, sink, spec):
        try:
            write_conf(instance, eq_conf(instance, hw, describe(hw, sink), spec))
            try:
                run("systemctl", "--user", "reset-failed", f"microos-eq@{instance}.service")
            except ERRORS:
                pass
            run("systemctl", "--user", "start", "--no-block", f"microos-eq@{instance}.service")
        except ERRORS as err:
            log(f"starting the EQ chain {instance} for {hw} failed: {err}")
            self.again()
            return False
        log(f"EQ chain {instance} started for {hw}")
        self.units[instance] = {"hw": hw, "conf": spec, "live": spec}
        return True

    def props(self, instance, unit, spec):
        try:
            proc = subprocess.run(["pw-cli", "s", eq_node(instance), "Props", eq_params(spec)],
                                  capture_output=True, text=True, timeout=PACTL_TIMEOUT)
            if proc.returncode != 0 or "Error" in proc.stderr or "Error" in proc.stdout:
                raise ValueError((proc.stderr or proc.stdout).strip())
        except ERRORS as err:
            log(f"sending EQ values to {instance} failed: {err}")
            self.again()
            return
        unit["live"] = spec
        log(f"EQ values sent to {instance}")

    def check_out(self, instance, unit, hw, dump):
        out = unit["out"]
        nodes = {o.get("id"): o["info"] for o in dump if o.get("type") == "PipeWire:Interface:Node" and o.get("info")}
        ids = {(info.get("props") or {}).get("node.name"): n for n, info in nodes.items()}
        oid = ids.get(eq_node(instance) + ".out")
        info = nodes.get(oid) or {}
        fmt = (info.get("params") or {}).get("Format")
        if fmt:
            del unit["out"]
            return
        linked = oid is not None and any(
            o.get("type") == "PipeWire:Interface:Link" and (o.get("info") or {}).get("output-node-id") == oid
            and o["info"].get("input-node-id") == ids.get(hw) and o["info"].get("state") == "active" for o in dump)
        out["checks"] += 1
        out["stuck"] = out["stuck"] + 1 if fmt == [] and linked and info.get("state") == "running" else 0
        if out["stuck"] == 0 and out["checks"] >= EQ_WAITS:
            del unit["out"]
            return
        if out["stuck"] >= 2:
            if out["kicks"] >= EQ_KICKS:
                log(f"EQ chain {instance} output has no format after {out['kicks']} suspends, left as is")
                del unit["out"]
                return
            self.kick(instance, out)
            return
        self.again()

    def kick(self, instance, out):
        sink = eq_node(instance)
        out["stuck"] = 0
        out["kicks"] += 1
        log(f"EQ chain {instance} output has no format, suspending its sink")
        try:
            run("pactl", "suspend-sink", sink, "1")
        except ERRORS as err:
            log(f"suspending {sink} failed: {err}")
            self.again()
            return
        out["timer"] = GLib.timeout_add(EQ_RESUME_MS, self.resume, sink, out)

    def resume(self, sink, out):
        out["timer"] = None
        try:
            run("pactl", "suspend-sink", sink, "0")
        except ERRORS as err:
            log(f"resuming {sink} failed: {err}")
        self.again()
        return GLib.SOURCE_REMOVE

    def stop(self, instance):
        try:
            run("systemctl", "--user", "stop", "--no-block", f"microos-eq@{instance}.service")
        except ERRORS as err:
            log(f"stopping the EQ chain {instance} failed: {err}")
            self.again()
            return
        log(f"EQ chain {instance} stopped")
        del self.units[instance]
        remove_conf(instance)

    def codecs(self):
        wanted = self.codec.values()
        if self.settling or all(v is None for v in wanted) or not self.cards_dirty:
            return
        self.cards_dirty = False
        if all(v in (None, "auto") for v in wanted):
            self.codec_done = {}
            for ident in list(self.codec_fail):
                self.drop_fail(ident)
            return
        try:
            cards = json.loads(run("pactl", "--format=json", "list", "cards"))
        except ERRORS as err:
            log(f"listing cards failed: {err}")
            self.cards_dirty = True
            self.again()
            return
        done = {}
        seen = set()
        for card in cards:
            name = card.get("name") or ""
            if not name.startswith("bluez_card."):
                continue
            side = card_side(card)
            key, codec = CODEC_KEYS[side], self.codec[side]
            if codec in (None, "auto"):
                continue
            gateway = "audio-gateway" in (card.get("profiles") or {})
            if side == "headphones" and gateway and not REMOTE_SINK.match(card.get("active_profile") or ""):
                continue
            ident = (name, (card.get("properties") or {}).get("object.serial", card.get("index")))
            seen.add(ident)
            previous = self.codec_done.get(ident)
            if previous == (side, codec):
                done[ident] = previous
                continue
            if side == "receiver":
                continue
            profile = codec_profile(card, codec)
            if profile is None:
                self.drop_fail(ident)
                done[ident] = (side, codec, None)
                if previous != done[ident]:
                    log(f"{key} {codec}: {name} offers no profile for it, left as is")
                continue
            fail = self.codec_fail.get(ident)
            snap = (card.get("active_profile"), json.dumps(card.get("profiles"), sort_keys=True))
            if fail and fail["snap"] != snap:
                self.drop_fail(ident)
                fail = None
            if fail and fail["codec"] == codec and (fail["wait"] or fail["tries"] > CODEC_RETRIES):
                continue
            if card.get("active_profile") != profile:
                try:
                    run("pactl", "set-card-profile", name, profile)
                    log(f"{key} {codec}: {name} profile {profile}")
                except ERRORS as err:
                    if not fail or fail["codec"] != codec:
                        self.drop_fail(ident)
                        fail = {"codec": codec, "tries": 0, "snap": snap, "wait": None}
                        self.codec_fail[ident] = fail
                        log(f"{key} {codec}: setting {name} profile {profile} failed: {err}")
                    fail["tries"] += 1
                    if fail["tries"] <= CODEC_RETRIES:
                        fail["wait"] = GLib.timeout_add(CODEC_RETRY_MS << (fail["tries"] - 1), self.codec_retry, ident)
                    continue
            self.drop_fail(ident)
            done[ident] = (side, codec)
        for ident in [i for i in self.codec_fail if i not in seen]:
            self.drop_fail(ident)
        self.codec_done = done

    def wanted(self, role):
        if role is None:
            return self.offer.get("wanted")
        if role != "receiver":
            return "auto"
        codec = self.codec["receiver"]
        if codec is None:
            return None
        return codec if codec in OFFERS else "auto"

    def guarded(self, wanted):
        if wanted == "auto":
            return wanted
        if self.guard is None:
            try:
                env = shlex.split(run("systemctl", "--user", "show", "-p", "Environment", "--value",
                                      "wireplumber.service"))
            except ERRORS as err:
                self.show_failure(f"reading the wireplumber environment failed: {err}")
                return None
            self.show_failed = False
            dirs = [e.partition("=")[2].split(":") for e in env if e.startswith("WIREPLUMBER_CONFIG_DIR=")]
            self.guard = bool(dirs) and dirs[-1][0] == WP_DIR
            if not self.guard:
                log(f"wireplumber.service does not read {WP_DIR} first, the phone codec offer stays auto")
        return wanted if self.guard else "auto"

    def place(self, target):
        disk = offer_on_disk()
        if disk == target:
            return disk
        try:
            if target == "auto":
                os.unlink(OFFER_CONF)
            else:
                os.makedirs(os.path.dirname(OFFER_CONF), mode=0o700, exist_ok=True)
                with open(OFFER_CONF + ".new", "w") as f:
                    f.write(f"monitor.bluez.properties = {{ override.bluez5.codecs = [ {target} msbc lc3_swb ] }}\n")
                    f.flush()
                    os.fsync(f.fileno())
                os.replace(OFFER_CONF + ".new", OFFER_CONF)
        except OSError as err:
            log(f"writing the bluetooth offer {target} failed: {err}")
            self.again()
            return disk
        self.offer["written"] = monotonic_us()
        log(f"bluetooth offer {target}: " + ("fragment removed" if target == "auto" else "fragment written"))
        return target

    def show_failure(self, msg):
        if not self.show_failed:
            log(msg)
        self.show_failed = True
        self.again()

    def derive(self, disk):
        if disk == self.offer["applied"]:
            return True
        try:
            start = int(run("systemctl", "--user", "show", "-p", "ActiveEnterTimestampMonotonic", "--value",
                            "wireplumber.service").strip())
        except ERRORS as err:
            self.show_failure(f"reading the wireplumber start time failed: {err}")
            return False
        self.show_failed = False
        if start > self.offer.get("written", 0):
            self.offer["applied"] = disk
            log(f"bluetooth offer {disk} in effect")
        return True

    def publish(self, wanted):
        lines = f"wanted {wanted}\napplied {self.offer['applied']}\n"
        if self.offer.get("written") is not None:
            lines += f"written {self.offer['written']}\n"
        self.offer["wanted"] = wanted
        try:
            with open(BT_CODECS) as f:
                if f.read() == lines:
                    return
        except OSError:
            pass
        try:
            os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
            with open(BT_CODECS + ".new", "w") as f:
                f.write(lines)
            os.replace(BT_CODECS + ".new", BT_CODECS)
        except OSError as err:
            log(f"writing the bluetooth offer status failed: {err}")

    def offer_pass(self):
        if self.settling:
            return None
        wanted = self.wanted(self.role)
        if wanted is None:
            return None
        target = self.guarded(wanted)
        if target is None:
            return None
        disk = self.place(target)
        if disk is None:
            return None
        known = self.derive(disk)
        self.publish(wanted)
        if known:
            self.restart(disk)

    def restart(self, disk):
        if disk is None or self.role_timer is not None:
            return
        if disk == self.offer["applied"]:
            self.deferred = None
            self.release("the offer is in effect")
            return
        if self.restarted == self.offer.get("written", 0):
            return
        if self.held_back(disk, self.blocked):
            return
        if self.engine is not None and self.hold is None:
            self.take_hold()
            return
        if self.hold == "asking" or self.held_back(disk, self.carded):
            return
        try:
            run("systemctl", "--user", "restart", "--no-block", "wireplumber.service")
        except ERRORS as err:
            log(f"restarting wireplumber for the bluetooth offer {disk} failed: {err}")
            self.release("the restart failed")
            return
        self.restarted = self.offer.get("written", 0)
        log(f"bluetooth offer {disk}: no audio stream and no bluetooth card, wireplumber restarted")

    def held_back(self, disk, check):
        try:
            reason = check()
        except ERRORS as err:
            log(f"listing nodes for the bluetooth offer failed: {err}")
            self.again()
            return True
        if reason is None:
            self.deferred = None
            return False
        if reason != self.deferred:
            log(f"bluetooth offer {disk} pending: {reason}")
            self.deferred = reason
        self.release(reason)
        return True

    def blocked(self):
        nodes = [n for kind in ("sinks", "sources") for n in json.loads(run("pactl", "--format=json", "list", kind))]
        busy = sorted(str(n.get("name")) for n in nodes if n.get("state") == "RUNNING")
        if busy:
            return f"{' '.join(busy)} running"
        streams = []
        for kind in ("sink-inputs", "source-outputs"):
            for stream in json.loads(run("pactl", "--format=json", "list", kind)):
                name = str((stream.get("properties") or {}).get("node.name") or stream.get("index"))
                if not name.startswith(EQ_PREFIX):
                    streams.append(name)
        if streams:
            return f"{' '.join(sorted(streams))} open"
        return self.carded()

    def carded(self):
        cards = json.loads(run("pactl", "--format=json", "list", "cards"))
        connected = sorted(c["name"] for c in cards if str(c.get("name", "")).startswith("bluez_card."))
        return f"{' '.join(connected)} connected" if connected else None

    def hold_for(self, role):
        if self.engine is None or self.hold is not None:
            return
        wanted = self.wanted(role)
        target = None if wanted is None else self.guarded(wanted)
        if target is not None and target != self.offer["applied"]:
            self.take_hold()

    def take_hold(self):
        self.hold = "asking"
        self.hold_timer = GLib.timeout_add(HOLD_MAX_MS, self.hold_expired)
        log("holding the reconnect engine for the bluetooth offer")
        self.session.call(*RECONNECT, "Hold", GLib.Variant("(b)", (True,)), None, Gio.DBusCallFlags.NONE, 5000, None,
                          self.hold_reply, None)

    def hold_reply(self, conn, result, _data):
        try:
            conn.call_finish(result)
            got = "held"
        except GLib.Error as err:
            log(f"holding the reconnect engine failed: {err.message}")
            got = "failed"
        if self.hold == "asking":
            self.hold = got
        self.schedule()

    def unhold(self):
        if self.hold in ("asking", "held") and self.engine is not None:
            self.session.call(*RECONNECT, "Hold", GLib.Variant("(b)", (False,)), None, Gio.DBusCallFlags.NONE, 5000,
                              None, self.unhold_reply, None)
            return True
        return False

    def unhold_reply(self, conn, result, _data):
        try:
            conn.call_finish(result)
        except GLib.Error as err:
            log(f"releasing the reconnect engine failed: {err.message}")

    def release(self, reason):
        if self.hold_timer is not None:
            GLib.source_remove(self.hold_timer)
            self.hold_timer = None
        if self.unhold():
            log(f"reconnect engine released: {reason}")
        self.hold = None

    def hold_expired(self):
        self.hold_timer = None
        if self.unhold():
            log(f"reconnect engine released after {HOLD_MAX_MS} ms")
        self.hold = "expired"
        self.schedule()
        return GLib.SOURCE_REMOVE

    def connect_engine(self):
        try:
            self.session = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except GLib.Error as err:
            log(f"no session bus, bluetooth role headphones: {err.message}")
            self.engine_gone()
            return
        self.session.signal_subscribe(RECONNECT[0], PROPS, "PropertiesChanged", RECONNECT[1], RECONNECT[2],
                                      Gio.DBusSignalFlags.NONE, self.engine_props)
        Gio.bus_watch_name_on_connection(self.session, RECONNECT[0], Gio.BusNameWatcherFlags.NONE,
                                         self.engine_up, self.engine_down)

    def engine_up(self, conn, _name, owner):
        self.engine = owner
        self.engine_seen = True
        conn.call(RECONNECT[0], RECONNECT[1], PROPS, "Get", GLib.Variant("(ss)", (RECONNECT[2], "Role")),
                  GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 5000, None, self.role_read, owner)

    def role_read(self, conn, result, owner):
        try:
            role = conn.call_finish(result).unpack()[0]
        except GLib.Error as err:
            log(f"reading the reconnect engine role failed: {err.message}")
            return
        if owner == self.engine:
            self.role_changed(role)

    def engine_props(self, _conn, _sender, _path, _iface, _signal, params):
        _iface_name, changed, _invalid = params.unpack()
        if "Role" in changed:
            self.role_changed(changed["Role"])
        self.schedule()

    def engine_down(self, _conn, _name):
        self.engine = None
        if self.hold_timer is not None:
            GLib.source_remove(self.hold_timer)
            self.hold_timer = None
        self.hold = None
        self.engine_gone()

    def engine_gone(self):
        if self.engine_seen:
            self.role_changed("headphones")
        elif self.role is None and "wanted" not in self.offer:
            self.role = "headphones"
            self.schedule()

    def role_changed(self, role):
        if not isinstance(role, str) or not role:
            return
        if self.role is None and self.role_timer is None:
            self.role = role
            log(f"bluetooth role {role}")
            self.schedule()
            return
        if self.role_timer is not None:
            GLib.source_remove(self.role_timer)
        self.role_next = role
        self.role_timer = GLib.timeout_add(int(ROLE_SETTLE_S * 1000), self.role_settled)
        self.hold_for(role)

    def role_settled(self):
        self.role_timer = None
        if self.role != self.role_next:
            log(f"bluetooth role {self.role_next}")
        self.role = self.role_next
        self.schedule()
        return GLib.SOURCE_REMOVE

    def codec_retry(self, ident):
        self.codec_fail[ident]["wait"] = None
        self.cards_dirty = True
        self.schedule()
        return GLib.SOURCE_REMOVE

    def drop_fail(self, ident):
        fail = self.codec_fail.pop(ident, None)
        if fail and fail["wait"]:
            GLib.source_remove(fail["wait"])

    def load(self):
        self.bus.call(
            *MICROSET, "List", GLib.Variant("(s)", ("audio.",)),
            GLib.VariantType("(a{sv})"), Gio.DBusCallFlags.NONE, 5000, None, self.loaded, None,
        )

    def loaded(self, bus, result, _data):
        try:
            values = bus.call_finish(result).unpack()[0]
        except GLib.Error as err:
            log(f"reading the audio keys failed: {err.message}")
            return
        self.eq = {slot: {"on": False, "filters": None, "balance": 0, "crossfeed": "off"} for slot in SLOTS}
        self.set_key("audio.max_volume", values.get("audio.max_volume", 100))
        self.set_key("audio.power_on_volume", values.get("audio.power_on_volume", 0))
        for key, value in values.items():
            if key.startswith(CHAIN_KEYS) or key in CODEC_KEYS.values():
                self.set_key(key, value)
        self.set_output(values.get("audio.output"))

    def set_key(self, key, value):
        for side, name in CODEC_KEYS.items():
            if key == name:
                self.codec[side] = value
                self.cards_dirty = True
                return
        if key in ("audio.max_volume", "audio.power_on_volume"):
            try:
                number = max(0, min(100, int(value)))
            except (TypeError, ValueError):
                number = 100 if key == "audio.max_volume" else 0
                log(f"{key} {value!r} not valid, using {number}")
            if key == "audio.max_volume":
                self.max_volume = max(50, number)
            else:
                self.power_on = number
            return
        parts = key.split(".")
        if self.eq is None or len(parts) < 3 or parts[2] not in SLOTS:
            return
        if len(parts) == 3 and parts[1] == "balance":
            try:
                self.eq[parts[2]]["balance"] = max(-20, min(20, int(value)))
            except (TypeError, ValueError):
                log(f"{key} {value!r} not valid, balance 0 for {parts[2]}")
                self.eq[parts[2]]["balance"] = 0
        elif len(parts) == 3 and parts[1] == "crossfeed":
            if value != "off" and value not in XFEED:
                log(f"{key} {value!r} unknown, crossfeed off for {parts[2]}")
            self.eq[parts[2]]["crossfeed"] = value if value in XFEED else "off"
        elif len(parts) == 4 and parts[3] == "on":
            self.eq[parts[2]]["on"] = bool(value)
        elif len(parts) == 4 and parts[3] == "filters":
            filters = parse_filters(value)
            if filters is None:
                log(f"{key} {value!r} not valid, EQ off for {parts[2]}")
            self.eq[parts[2]]["filters"] = filters

    def set_output(self, value):
        if value not in OUTPUTS:
            log(f"audio.output {value!r} unknown, using auto")
            value = "auto"
        self.output = value
        self.schedule()

    def changed(self, _conn, _sender, _path, _iface, _signal, params):
        key, value = params.unpack()
        if key == "audio.output":
            self.set_output(value)
        elif key.startswith(CHAIN_KEYS) or key in (*CODEC_KEYS.values(), "audio.max_volume", "audio.power_on_volume"):
            self.set_key(key, value)
            if key == CODEC_KEYS["receiver"] and self.role_timer is None:
                self.hold_for(self.role)
            self.schedule()
        elif key in APPLY:
            self.dirty.add(APPLY[key])
            self.cycles.setdefault(APPLY[key], ["wait", None])
            self.schedule()

    def appeared(self, _conn, _name, _owner):
        self.load()

    def step(self, sinks):
        for sink, (stage, timer) in list(self.cycles.items()):
            state = sinks.get(sink, {}).get("state")
            if state is None:
                log(f"apply cycle: {sink} is gone, dropped")
                self.drop(sink)
            elif stage == "hold" and timer is None and state == "SUSPENDED":
                log(f"apply cycle: {sink} closed for its pmdown_time, it opens on the next stream")
                if sink in self.dirty:
                    self.cycles[sink] = ["wait", None]
                    self.suspend(sink)
                else:
                    del self.cycles[sink]
            elif stage == "hold" and state != "SUSPENDED":
                log(f"apply cycle: {sink} opened during the hold, waiting again")
                if timer is not None:
                    GLib.source_remove(timer)
                self.cycles[sink] = ["wait", None]
                if state != "RUNNING":
                    self.suspend(sink)
            elif stage == "wait" and state != "RUNNING":
                self.suspend(sink)

    def suspend(self, sink):
        self.dirty.discard(sink)
        wait = pmdown_ms() + 1000
        try:
            run("pactl", "suspend-sink", sink, "1")
        except ERRORS as err:
            log(f"apply cycle: suspending {sink} failed: {err}")
            del self.cycles[sink]
            return
        log(f"apply cycle: {sink} suspended, holding {wait} ms")
        self.cycles[sink] = ["hold", GLib.timeout_add(wait, self.held, sink)]

    def held(self, sink):
        if sink in self.cycles:
            self.cycles[sink][1] = None
            self.schedule()
        return GLib.SOURCE_REMOVE

    def drop(self, sink):
        timer = self.cycles.pop(sink)[1]
        if timer is not None:
            GLib.source_remove(timer)
        self.dirty.discard(sink)


def main():
    os.environ["LC_ALL"] = "C"
    loop = GLib.MainLoop()
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    audio = Audio(bus, loop)
    bus.signal_subscribe(
        MICROSET[0], MICROSET[2], "Changed", MICROSET[1], None, Gio.DBusSignalFlags.NONE, audio.changed,
    )
    Gio.bus_watch_name_on_connection(bus, MICROSET[0], Gio.BusNameWatcherFlags.NONE, audio.appeared, None)
    procs = [
        audio.watch(["pw-metadata", "-n", "default", "-m", "0", KEY], audio.metadata),
        audio.watch(["pactl", "subscribe"], audio.sinks),
    ]
    GLib.timeout_add(int(SETTLE_S * 1000), audio.settled)
    audio.connect_engine()
    loop.run()
    for proc in procs:
        proc.force_exit()
    return 1


if __name__ == "__main__":
    sys.exit(main())
