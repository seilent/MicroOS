#!/usr/bin/env python3
import json
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

CARD = "alsa_card.platform-sound"
LOGIN1 = ("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager")
PACTL_TIMEOUT = 3
PACTL_ERRORS = (subprocess.SubprocessError, OSError, ValueError)


def pactl(*args, timeout=PACTL_TIMEOUT):
    return subprocess.run(
        ["pactl", *args], capture_output=True, text=True, check=True, timeout=max(timeout, 0)
    ).stdout


def active_profile(card):
    for entry in json.loads(pactl("--format=json", "list", "cards")):
        if entry.get("name") == card:
            return entry.get("active_profile")
    return None


class AudioSleep:
    def __init__(self, bus, card):
        self.bus = bus
        self.card = card
        self.fd = None
        self.saved = None

    def inhibit(self):
        if self.fd is not None:
            return
        result, fds = self.bus.call_with_unix_fd_list_sync(
            *LOGIN1,
            "Inhibit",
            GLib.Variant(
                "(ssss)",
                ("sleep", "MicroOS", "Turn the internal audio card off before suspend", "delay"),
            ),
            GLib.VariantType("(h)"),
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            None,
        )
        self.fd = fds.get(result.unpack()[0])

    def release(self):
        if self.fd is not None:
            os.close(self.fd)
            self.fd = None

    def wake_card(self):
        try:
            if active_profile(self.card) == "off":
                pactl("set-card-profile", self.card, "HiFi")
        except PACTL_ERRORS as err:
            print(f"microos-audio-sleep: setting {self.card} to HiFi failed: {err}", file=sys.stderr)

    def suspend_card(self):
        end = time.monotonic() + PACTL_TIMEOUT
        try:
            profile = active_profile(self.card)
            if profile and profile != "off":
                self.saved = profile
                pactl("set-card-profile", self.card, "off", timeout=end - time.monotonic())
        except PACTL_ERRORS as err:
            print(f"microos-audio-sleep: turning {self.card} off failed: {err}", file=sys.stderr)

    def resume_card(self):
        if not self.saved:
            return
        try:
            pactl("set-card-profile", self.card, self.saved)
        except PACTL_ERRORS as err:
            print(f"microos-audio-sleep: restoring {self.card} to {self.saved} failed: {err}", file=sys.stderr)
        self.saved = None

    def prepare_for_sleep(self, _conn, _sender, _path, _iface, _signal, params):
        if params.unpack()[0]:
            self.suspend_card()
            self.release()
        else:
            try:
                self.inhibit()
            except GLib.Error as err:
                print(f"microos-audio-sleep: sleep inhibitor failed: {err.message}", file=sys.stderr)
            self.resume_card()


def main():
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    sleeper = AudioSleep(bus, CARD)
    bus.signal_subscribe(
        LOGIN1[0], LOGIN1[2], "PrepareForSleep", LOGIN1[1], None,
        Gio.DBusSignalFlags.NONE, sleeper.prepare_for_sleep,
    )
    sleeper.wake_card()
    sleeper.inhibit()
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
