#!/usr/bin/env bash
set -euo pipefail

me=microos-boot-ok
die() { echo "$me: $*" >&2; exit 1; }

rundir=${MICROOS_RUNDIR:-/run/microos}
statedir=${MICROOS_STATEDIR:-/var/lib/microos}
esp=${MICROOS_ESP:-/boot/efi}
conf=${MICROOS_BOOT_OK_CONF:-/usr/lib/microos/boot-ok.conf}
bootimg=${MICROOS_BOOTIMG_UPDATE:-/usr/libexec/microos/microos-bootimg-update}
lockwait=${MICROOS_BOOT_OK_LOCK_WAIT:-1800}
pins=$statedir/boot-ok-pins
skip=$statedir/boot-ok-skip

[[ -r $conf ]] || die "missing $conf"
. "$conf"

declare -A inv=() refused=()
user_unit() {
  local out uid gid frag drop p
  us="" uinv=""
  uid=$(id -u "$MICROOS_BOOT_OK_USER" 2> /dev/null) || return 0
  gid=$(id -g "$MICROOS_BOOT_OK_USER" 2> /dev/null) || return 0
  out=$(setpriv --reuid="$uid" --regid="$gid" --init-groups --no-new-privs env -i XDG_RUNTIME_DIR="/run/user/$uid" \
    systemctl --user show -p ActiveState,InvocationID,FragmentPath,DropInPaths "$1" < /dev/null 2> /dev/null) || return 0
  frag=$(sed -n 's/^FragmentPath=//p' <<< "$out")
  drop=$(sed -n 's/^DropInPaths=//p' <<< "$out")
  us=$(sed -n 's/^ActiveState=//p' <<< "$out")
  uinv=$(sed -n 's/^InvocationID=//p' <<< "$out")
  [[ $frag == /usr/lib/systemd/user/* ]] || us=refused
  for p in $drop; do
    [[ $p == /usr/lib/* || $p == /etc/* ]] || us=refused
  done
  if [[ $us == refused && -z ${refused[$1]:-} ]]; then
    refused[$1]=1
    echo "$me: $1 refused: FragmentPath '$frag', DropInPaths '$drop' not under /usr/lib or /etc" >&2
  fi
}

unit_why() {
  if [[ $us == refused ]]; then
    why="$1 refused, unit not from /usr/lib or /etc"
  else
    why="$1 not active"
  fi
}

users_up() {
  local u
  for u in ${MICROOS_BOOT_OK_USER_ACTIVE:-}; do
    user_unit "$u"
    if [[ $us != active || -z $uinv ]]; then
      unit_why "$u"
      return 1
    fi
    inv[$u]=$uinv
  done
}

units_ok() {
  local u
  for u in $MICROOS_BOOT_OK_FAILED; do
    if systemctl is-failed --quiet "$u"; then
      echo "$me: not confirmed: $u failed" >&2
      return 1
    fi
  done
  for u in $MICROOS_BOOT_OK_ACTIVE; do
    if [[ $(systemctl show -p ConditionResult --value "$u") == yes ]] && ! systemctl is-active --quiet "$u"; then
      echo "$me: not confirmed: $u is not active" >&2
      return 1
    fi
  done
  for u in ${MICROOS_BOOT_OK_USER_ACTIVE:-}; do
    user_unit "$u"
    if [[ $us != active ]]; then
      echo "$me: not confirmed: $u is not active" >&2
      return 1
    fi
    if [[ $uinv != "${inv[$u]}" ]]; then
      echo "$me: not confirmed: $u restarted" >&2
      return 1
    fi
  done
}

write() {
  local f=$1 t
  shift
  t=$(mktemp "$f.XXXXXX")
  if (( $# )); then
    printf '%s\n' "$@" > "$t"
  fi
  chmod 0644 "$t"
  sync "$t"
  mv -fT "$t" "$f"
  sync -f "$f"
}

read_status() {
  status=$(ostree admin status --json) || die "ostree admin status failed"
}

id_of() {
  jq -r "[.deployments[] | select($1) | \"\(.checksum).\(.serial)\"] | first // empty" <<< "$status"
}

pinned() {
  jq -e --arg id "$1" 'any(.deployments[]; .pinned and "\(.checksum).\(.serial)" == $id)' <<< "$status" > /dev/null
}

index_of() {
  jq -r --arg id "$1" '.deployments[] | select("\(.checksum).\(.serial)" == $id) | .index' <<< "$status"
}

if [[ -e $skip ]]; then
  want=$(tr -d '[:space:]' < "$skip")
  rm -f "$skip"
  sync -f "$statedir"
  read_status
  booted=$(id_of .booted)
  if [[ -n $booted && $booted == "$want" ]]; then
    echo "$me: skipped once"
    exit 3
  fi
  echo "$me: boot-ok-skip names '$want', booted $booted, not skipped" >&2
fi

read_current() {
  local line
  [[ -f $rundir/session-current ]] || return 1
  line=$(dd if="$rundir/session-current" iflag=nofollow bs=4096 count=1 status=none 2> /dev/null) || return 1
  [[ $line =~ ^[a-z0-9-]+\ [A-Za-z0-9@._-]+\.service\ [0-9]+(\ [0-9]+)?$ ]] || return 1
  session=$line
}

session_up() {
  why="display-manager.service not active"
  systemctl is-active --quiet display-manager.service || return 1
  why="no session-current"
  read_current || return 1
  read -r name unit _ <<< "$session"
  why="recovery is the current session"
  [[ $name != recovery ]] || return 1
  user_unit "$unit"
  id=$uinv
  unit_why "$unit"
  [[ $us == active && -n $id ]]
}

session_held() {
  [[ -z ${MICROOS_BOOT_OK_USER_ACTIVE:-} ]] || return 0
  session_up || return 1
  why="current session changed to $name"
  [[ $session == "$held_session" ]] || return 1
  why="$unit restarted"
  [[ $id == "$held_id" ]]
}

ready() {
  why="$MICROOS_BOOT_OK_TARGET not active"
  systemctl is-active --quiet "$MICROOS_BOOT_OK_TARGET" || return 1
  if [[ -n ${MICROOS_BOOT_OK_USER_ACTIVE:-} ]]; then
    users_up
    return
  fi
  session_up || return 1
  held_session=$session held_id=$id
}

waited=0
wait_ready() {
  until ready; do
    (( waited < MICROOS_BOOT_OK_WAIT )) || die "not confirmed: $why after $MICROOS_BOOT_OK_WAIT s"
    sleep "$MICROOS_BOOT_OK_STEP"
    waited=$(( waited + MICROOS_BOOT_OK_STEP ))
  done
}

wait_ready
held=0
while :; do
  units_ok || exit 1
  if ! session_held; then
    echo "$me: hold restarted: $why" >&2
    wait_ready
    held=0
    continue
  fi
  (( held < MICROOS_BOOT_OK_HOLD )) || break
  sleep "$MICROOS_BOOT_OK_STEP"
  held=$(( held + MICROOS_BOOT_OK_STEP ))
done

read_status
booted=$(id_of .booted)
[[ $booted =~ ^[0-9a-f]{64}\.[0-9]+$ ]] || die "no booted deployment in ostree admin status"
b=$(bootc status --json | jq -r '.status.booted.ostree | "\(.checksum).\(.deploySerial)"') || die "bootc status failed"
[[ $b == "$booted" ]] || die "ostree booted $booted, bootc booted $b"

install -d -m 0755 "$rundir" "$statedir"
exec 8> "$rundir/update.lock"
if ! flock -w "$lockwait" 8; then
  echo "$me: not confirmed: update.lock busy" >&2
  exit 3
fi

listed=()
if [[ -f $pins ]]; then
  while read -r id; do
    [[ -n $id ]] && listed+=("$id")
  done < "$pins"
fi
was_listed=0
for id in "${listed[@]}"; do
  [[ $id != "$booted" ]] || was_listed=1
done

read_status
if ! pinned "$booted"; then
  if (( ! was_listed )); then
    listed+=("$booted")
    write "$pins" "${listed[@]}"
    was_listed=1
  fi
  ostree admin pin booted > /dev/null
fi

read_status
[[ $(id_of .booted) == "$booted" ]] || die "the booted deployment changed to $(id_of .booted)"
pinned "$booted" || die "$booted is not pinned"

write "$statedir/confirmed" "$booted"
rollback=no
! jq -e 'any(.deployments[]; (.booted or .staged) | not)' <<< "$status" > /dev/null || rollback=yes
write "$rundir/deployments" "booted=$booted" confirmed=yes "rollback=$rollback"

out=$("$bootimg" --bak "$booted") || die "KERNEL.BAK not baked from $booted, pins kept"
read -r word deploy bake <<< "$(tail -n 1 <<< "$out")"
stamp=""
if [[ -f $esp/.microos-bootimg-bak.id ]]; then
  stamp=$(< "$esp/.microos-bootimg-bak.id")
fi
[[ $word == bak && $deploy == "$booted" && -n $bake && $bake == "$stamp" ]] ||
  die "KERNEL.BAK does not hold $booted, pins kept"

pinset() {
  jq -r '.deployments[] | select(.pinned) | "\(.checksum).\(.serial)"' <<< "$status" | LC_ALL=C sort | paste -sd' '
}
ids() {
  jq -r '.deployments[] | "\(.checksum).\(.serial)"' <<< "$status"
}

read_status
target=" "
for id in $(pinset) "$booted"; do
  [[ $target == *" $id "* ]] && continue
  if [[ $id == "$booted" || " ${listed[*]} " != *" $id "* ]]; then
    target+="$id "
  fi
done

fails=0
while :; do
  read_status
  cur=" $(pinset) "
  op="" id=""
  for x in $(ids); do
    if [[ $target == *" $x "* && $cur != *" $x "* ]]; then
      op=pin id=$x
      break
    fi
  done
  if [[ -z $op ]]; then
    for x in $cur; do
      if [[ $target != *" $x "* ]]; then
        op=unpin id=$x
        break
      fi
    done
  fi
  [[ -n $op ]] || break
  if [[ $op == pin ]]; then
    want=$({ tr ' ' '\n' <<< "$cur"; echo "$id"; } | grep . | LC_ALL=C sort | paste -sd' ')
    if [[ $id == "$booted" ]]; then
      ostree admin pin booted > /dev/null
    else
      ostree admin pin "$(index_of "$id")" > /dev/null
    fi
  else
    want=$(tr ' ' '\n' <<< "$cur" | grep . | grep -Fvx "$id" | LC_ALL=C sort | paste -sd' ' || true)
    ostree admin pin --unpin "$(index_of "$id")" > /dev/null
  fi
  read_status
  if [[ $(pinset) != "$want" ]]; then
    fails=$(( fails + 1 ))
    (( fails < 3 )) || die "deployment indexes kept moving, $pins unchanged"
  fi
done

if (( was_listed )); then
  write "$pins" "$booted"
else
  write "$pins"
fi
echo "$me: confirmed $booted"
