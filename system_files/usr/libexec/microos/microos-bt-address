#!/usr/bin/env bash
set -euo pipefail

me=microos-bt-address
root=${MICROOS_BT_ROOT:-}
wait=${MICROOS_BT_WAIT:-30}
poll=${MICROOS_BT_POLL:-0.5}
serial=$root/sys/devices/soc0/serial_number
uptime=$root/proc/uptime

log() { echo "$me: $*"; }

uptime_cs() {
  local up
  read -r up _ < "$uptime" || return 1
  [[ $up =~ ^[0-9]+\.[0-9]{2}$ ]] || return 1
  echo $((10#${up/./}))
}

mgmt() { timeout 3 btmgmt "$@" < /dev/null || true; }

unconfigured() {
  mgmt config | awk -F'\t' '
    /^hci[0-9]+:\t/ { cur = $1; if (cur == "hci0:") seen = 1 }
    cur == "hci0:" && $1 == "" && $2 ~ /^missing options:/ {
      n = split(substr($2, 17), o, " ")
      for (i = 1; i <= n; i++) if (o[i] == "public-address") miss = 1
    }
    END { if (seen) print miss ? "missing" : "unconfigured" }'
}

configured() { mgmt info | grep -qxF $'hci0:\tPrimary controller'; }

derive() {
  local s last
  if [[ ! -r $serial ]]; then
    log "no $serial"
    return 1
  fi
  s=$(< "$serial")
  s=${s//[[:space:]]/}
  if ((${#s} < 6)); then
    log "serial '$s' is shorter than 6 characters"
    return 1
  fi
  last=${s: -6}
  if [[ ! $last =~ ^[0-9A-Fa-f]{6}$ ]]; then
    log "serial '$s' ends in non hex characters"
    return 1
  fi
  addr=00:03:7F:${last:4:2}:${last:2:2}:${last:0:2}
  addr=${addr^^}
  if ((16#${addr:0:2} & 1)) || [[ -z ${addr//[0:]/} ]]; then
    log "$addr is not a unicast address"
    return 1
  fi
}

if ! start=$(uptime_cs); then
  log "cannot read $uptime"
  exit 1
fi
while :; do
  state=$(unconfigured)
  [[ -n $state ]] && break
  if configured; then
    log "hci0 is configured"
    exit 0
  fi
  if ! now=$(uptime_cs) || ((now - start > wait * 100)); then
    log "hci0 not listed after $wait s"
    exit 1
  fi
  sleep "$poll"
done

if [[ $state != missing ]]; then
  log "hci0 is unconfigured but has a public address"
  exit 0
fi
derive || exit 0
if ! out=$(timeout 3 btmgmt --index 0 public-addr "$addr" < /dev/null 2>&1); then
  log "setting $addr on hci0 failed: $out"
  exit 1
fi
log "hci0 public address $addr"
