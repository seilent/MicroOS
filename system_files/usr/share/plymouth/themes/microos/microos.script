Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

wordmark = Image("wordmark.png");
starting = Image("starting.png");
updating = Image("updating.png");
microdap = Image("micro-dap.png");
microemu = Image("micro-emu.png");
steamos = Image("steam-os.png");
sprite = Sprite();
shown = 0;
ticks = 0;

fun show(image)
{
  sprite.SetImage(image);
  sprite.SetX(Window.GetX() + Math.Int((Window.GetWidth() - image.GetWidth()) / 2));
  sprite.SetY(Window.GetY() + Math.Int((Window.GetHeight() - image.GetHeight()) / 2));
  sprite.SetOpacity(1);
  global.shown = 1;
}

fun refresh()
{
  if (!shown)
    {
      global.ticks += 1;
      if (ticks >= 2)
        show(wordmark);
    }
}

fun message(text)
{
  if (text == "microos-starting")
    show(starting);
  else if (text == "microos-updating")
    show(updating);
  else if (text == "microos-session-microdap")
    show(microdap);
  else if (text == "microos-session-microemu")
    show(microemu);
  else if (text == "microos-session-steam")
    show(steamos);
  else if (text.SubString(0, 16) == "microos-session-")
    show(wordmark);
}

if (Plymouth.GetMode() == "boot")
  show(wordmark);
else
  sprite.SetOpacity(0);

Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayMessageFunction(message);
