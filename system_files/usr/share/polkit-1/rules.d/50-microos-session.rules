polkit.addRule(function(action, subject) {
  if (action.id != "org.freedesktop.systemd1.manage-units" || subject.user != "micro") {
    return;
  }
  var unit = action.lookup("unit");
  var units = /^(microos-session-(switch|fallback|up)@[a-z0-9][a-z0-9-]*|microos-session-rollback)\.service$/;
  if (action.lookup("verb") == "start" && unit && units.test(unit)) {
    return polkit.Result.YES;
  }
});
