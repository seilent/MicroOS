#!/usr/bin/env bash
conf=$XDG_RUNTIME_DIR/microos-audio/eq/$1.conf
while :; do
  PIPEWIRE_DEBUG=I pipewire -c "$conf" &
  echo $! > "$EQ_SHIM_DIR/$1.pid"
  wait $!
  rc=$?
  [[ -e $EQ_SHIM_DIR/$1.stop ]] && exit 0
  ((rc == 0)) && exit 0
  sleep 0.1
  echo "restart $1 $rc" >> "$EQ_SHIM_DIR/log"
done
