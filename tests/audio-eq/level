#!/usr/bin/env python3
import sys

import numpy as np


def main():
    cmd, rate = sys.argv[1], int(sys.argv[2])
    if cmd == "gen":
        seconds, amp = float(sys.argv[3]), float(sys.argv[4])
        t = np.arange(int(rate * seconds)) / rate
        signal = sum(amp * np.sin(2 * np.pi * float(f) * t) for f in sys.argv[5:])
        sys.stdout.buffer.write(signal.astype("<f4").tobytes())
    elif cmd == "gen2":
        seconds, left, right = float(sys.argv[3]), float(sys.argv[4]), float(sys.argv[5])
        t = np.arange(int(rate * seconds)) / rate
        signal = sum(np.sin(2 * np.pi * float(f) * t) for f in sys.argv[6:])
        sys.stdout.buffer.write(np.stack([left * signal, right * signal], axis=1).astype("<f4").tobytes())
    elif cmd == "mag":
        data = np.fromfile(sys.argv[3], dtype="<f4")
        if len(data) < rate:
            sys.exit(f"level: {len(data)} samples, need {rate}")
        spectrum = np.abs(np.fft.rfft(data[-rate:])) * 2 / rate
        for f in sys.argv[4:]:
            print(f"{f} {20 * np.log10(max(spectrum[int(f)], 1e-12)):.4f}")
    else:
        sys.exit(f"level: unknown command {cmd}")


main()
