#!/usr/bin/env bash
units=$STUB_DIR/units
mkdir -p "$units"
[[ -e $STUB_DIR/systemctl-fails ]] && { echo "systemctl stub: fails" >&2; exit 1; }
case "$*" in
  "--user list-units --all --plain --no-legend --full microos-eq@*.service")
    for u in "$units"/*; do
      if [[ -e $u ]]; then echo "${u##*/} loaded $(cat "$u") running EQ chain"; fi
    done
    ;;
  "--user start --no-block $4")
    echo "start $4" >> "$STUB_DIR/log"
    echo active > "$units/$4"
    ;;
  "--user reset-failed $3")
    echo "reset $3" >> "$STUB_DIR/log"
    ;;
  "--user stop --no-block $4")
    echo "stop $4" >> "$STUB_DIR/log"
    rm -f "$units/$4"
    ;;
  "--user restart --no-block wireplumber.service")
    echo "restart wireplumber.service" >> "$STUB_DIR/log"
    [[ -e $STUB_DIR/restart-fails ]] && { echo "systemctl stub: restart fails" >&2; exit 1; }
    python3 -c 'import time; print(time.clock_gettime_ns(time.CLOCK_MONOTONIC) // 1000)' > "$STUB_DIR/wp-start"
    if [[ -e $STUB_DIR/bindsto ]]; then
      read -r -a stat < "/proc/$PPID/stat"
      setsid bash -c 'sleep 0.2; kill -- "-$1"; exec bash "$2"' _ "${stat[4]}" "$STUB_DIR/bindsto" < /dev/null > /dev/null 2>&1 &
    fi
    ;;
  "--user show -p "*)
    [[ -e $STUB_DIR/show-fails ]] && { echo "systemctl stub: show fails" >&2; exit 1; }
    ;;&
  "--user show -p Environment --value wireplumber.service")
    cat "$STUB_DIR/wp-env" 2> /dev/null || true
    ;;
  "--user show -p ActiveEnterTimestampMonotonic --value wireplumber.service")
    cat "$STUB_DIR/wp-start" 2> /dev/null || echo 0
    ;;
  *)
    echo "systemctl stub: $*" >&2
    exit 1
    ;;
esac
