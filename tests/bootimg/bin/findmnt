#!/usr/bin/env bash
mp="" v=0
while (( $# )); do
  case $1 in
    -M) mp=$2; shift 2; continue ;;
    -*v*) v=1 ;;
  esac
  shift
done
if [[ $mp == "$MICROOS_ESP" ]]; then
  [[ ${FAKE_ESP_MOUNTED:-1} == 1 ]] || exit 1
  echo "${FAKE_ESP_FSTYPE:-vfat} ${FAKE_ESP_OPTS:-rw,relatime,fmask=0077,dmask=0077} ${FAKE_ESP_SOURCE:-/dev/sdX1}"
elif [[ $mp == "$MICROOS_SYSROOT" ]]; then
  if (( v )) && [[ ${FAKE_SYS_BRACKET:-0} == 0 ]]; then
    echo "${FAKE_SYS_SOURCE:-/dev/sdX3}"
  else
    echo "${FAKE_SYS_SOURCE:-/dev/sdX3}[/root]"
  fi
else
  exit 1
fi
