#!/usr/bin/env python3
import sys

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

NAME = "net.seilent.MicroOs.DesktopHome"
PATH = "/net/seilent/MicroOs/DesktopHome"
IFACE = "net.seilent.MicroOs.DesktopHome1"
PROPS = "org.freedesktop.DBus.Properties"


def bus():
    return Gio.bus_get_sync(Gio.BusType.SESSION, None)


def wait(conn, name):
    for _ in range(200):
        reply = conn.call_sync(
            "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
            GLib.Variant("(s)", (name,)), GLib.VariantType("(b)"), Gio.DBusCallFlags.NONE, 1000, None,
        )
        if reply.unpack()[0]:
            return 0
        GLib.usleep(50000)
    return 1


def unwrap(variant):
    value = variant
    while hasattr(value, "unpack"):
        value = value.unpack()
    return value


def show(value):
    if isinstance(value, list):
        return "|".join(",".join(row) for row in value)
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def watched(path):
    log = open(path, "a", buffering=1)

    def changed(_conn, _sender, _path, _iface, _signal, params):
        iface, values, _invalid = params.unpack()
        if iface != IFACE:
            return
        for key in sorted(values):
            log.write(f"{key} {show(unwrap(values[key]))}\n")

    return changed


def main(argv):
    conn = bus()
    cmd = argv[0]
    if cmd == "wait":
        return wait(conn, argv[1])
    if cmd == "get":
        reply = conn.call_sync(NAME, PATH, PROPS, "Get", GLib.Variant("(ss)", (IFACE, argv[1])),
                               GLib.VariantType("(v)"), Gio.DBusCallFlags.NONE, 2000, None)
        print(show(unwrap(reply.unpack()[0])))
        return 0
    if cmd == "call":
        args = GLib.Variant("(s)", (argv[2],)) if len(argv) > 2 else None
        try:
            conn.call_sync(NAME, PATH, IFACE, argv[1], args, None, Gio.DBusCallFlags.NONE, 10000, None)
        except GLib.Error as err:
            print(Gio.dbus_error_get_remote_error(err) or "local")
            return 0
        print("ok")
        return 0
    if cmd == "watch":
        conn.signal_subscribe(NAME, PROPS, "PropertiesChanged", PATH, IFACE, Gio.DBusSignalFlags.NONE,
                              watched(argv[1]))
        GLib.MainLoop().run()
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
