#!/usr/bin/env bash
n=$(($(cat "$STUB_DIR/aplay.n" 2> /dev/null || echo 0) + 1))
echo "$n" > "$STUB_DIR/aplay.n"
printf 'aplay %s\n' "$*" >> "$STUB_LOG"
[[ -f $STUB_DIR/on-$n ]] && bash "$STUB_DIR/on-$n"
if [[ -e $STUB_DIR/hang ]]; then
  echo $$ > "$STUB_DIR/aplay.pid"
  exec sleep 30
fi
ready=$(cat "$STUB_DIR/ready" 2> /dev/null || echo 1)
[[ $ready != never ]] && ((n >= ready)) && exit 0
echo "aplay: main:850: audio open error: Invalid argument" >&2
exit 1
