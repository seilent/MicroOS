#!/usr/bin/env python3
import os
import signal
import sys

import gi

gi.require_version("Gio", "2.0")
gi.require_version("GLibUnix", "2.0")
from gi.repository import Gio, GLib, GLibUnix

INTERCEPT = ("net.seilent.MicroOs.Intercept", "/net/seilent/MicroOs/Intercept", "net.seilent.MicroOs.Intercept1")
XML = """
<node>
  <interface name="test.Hotkeyd">
    <method name="Poke"/>
  </interface>
</node>
"""
OVERLAY = ("net.seilent.MicroSet.Overlay", "/net/seilent/MicroSet/Overlay", "net.seilent.MicroSet.Overlay1")
OVERLAY_XML = f"""
<node>
  <interface name="{OVERLAY[2]}">
    <method name="Toggle"/>
  </interface>
</node>
"""
MENU = ("net.seilent.MicroOs.SessionMenu", "/net/seilent/MicroOs/SessionMenu", "net.seilent.MicroOs.SessionMenu1")
MENU_XML = f"""
<node>
  <interface name="{MENU[2]}">
    <method name="Show">
      <arg type="a(ssa{{sv}})" direction="in"/>
      <arg type="s" direction="in"/>
      <arg type="a{{sv}}" direction="in"/>
    </method>
  </interface>
</node>
"""
LOG = sys.argv[1]


def record(line):
    with open(LOG, "a") as f:
        f.write(line + "\n")


def poke(_conn, _sender, _path, _iface, _name, _params, invocation):
    record("poke")
    invocation.return_value(None)


def toggle(_conn, _sender, _path, _iface, _name, _params, invocation):
    record("toggle")
    invocation.return_value(None)


def show(_conn, _sender, _path, _iface, _name, params, invocation):
    record(f"show {params.print_(False)}")
    try:
        with open(LOG + ".mode") as f:
            mode = f.read().split()
    except FileNotFoundError:
        mode = ["ok"]
    if mode[0] == "error":
        invocation.return_dbus_error(mode[1], "stub")
    elif mode[0] == "delay":
        GLib.timeout_add(int(mode[1]), lambda: invocation.return_value(None) or False)
    elif mode[0] == "die":
        os._exit(0)
    else:
        invocation.return_value(None)


def consume(bus, key):
    try:
        bus.call_sync(*INTERCEPT, "Consume", GLib.Variant("(s)", (key,)), None, Gio.DBusCallFlags.NONE, 5000, None)
        record(f"consumed {key}")
    except GLib.Error as err:
        record(f"consume {key} failed {Gio.DBusError.get_remote_error(err)}")
    return True


def changed(_conn, _sender, _path, _iface, _signal, params):
    _iface, props, _gone = params.unpack()
    if "Holder" in props:
        record(f"holder {props['Holder']}")


def again(bus):
    bus.call_sync(*INTERCEPT, "Acquire", None, None, Gio.DBusCallFlags.NONE, 5000, None)
    record("acquired")
    return True


def main(cmds):
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    for cmd in cmds:
        if cmd in ("acquire", "release"):
            bus.call_sync(*INTERCEPT, cmd.capitalize(), None, None, Gio.DBusCallFlags.NONE, 5000, None)
        elif cmd == "get":
            print(bus.call_sync(
                INTERCEPT[0], INTERCEPT[1], "org.freedesktop.DBus.Properties", "Get",
                GLib.Variant("(ss)", (INTERCEPT[2], "Holder")), None, Gio.DBusCallFlags.NONE, 5000, None,
            ).unpack()[0])
            return 0
        elif cmd == "gone":
            msg = Gio.DBusMessage.new_method_call(*INTERCEPT, "Acquire")
            msg.set_flags(Gio.DBusMessageFlags.NO_REPLY_EXPECTED)
            bus.send_message(msg, Gio.DBusSendMessageFlags.NONE)
            bus.flush_sync(None)
            record(f"gone {bus.get_unique_name()}")
            return 0
        elif cmd == "overlay":
            bus.register_object_with_closures2(
                OVERLAY[1], Gio.DBusNodeInfo.new_for_xml(OVERLAY_XML).interfaces[0], toggle, None, None
            )
            bus.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "RequestName",
                GLib.Variant("(su)", (OVERLAY[0], 4)), None, Gio.DBusCallFlags.NONE, 5000, None,
            )
        elif cmd == "usr1":
            GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, again, bus)
        elif cmd == "menu":
            bus.register_object_with_closures2(
                MENU[1], Gio.DBusNodeInfo.new_for_xml(MENU_XML).interfaces[0], show, None, None
            )
            bus.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "RequestName",
                GLib.Variant("(su)", (MENU[0], 4)), None, Gio.DBusCallFlags.NONE, 5000, None,
            )
        elif cmd.startswith("consume:"):
            GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR2, consume, bus, cmd[8:])
        elif cmd == "watch":
            bus.signal_subscribe(
                INTERCEPT[0], "org.freedesktop.DBus.Properties", "PropertiesChanged", INTERCEPT[1], None,
                Gio.DBusSignalFlags.NONE, changed,
            )
        elif cmd == "serve":
            bus.register_object_with_closures2(
                "/test", Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0], poke, None, None
            )
            bus.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "RequestName",
                GLib.Variant("(su)", ("test.Hotkeyd", 4)), None, Gio.DBusCallFlags.NONE, 5000, None,
            )
    record(f"ready {bus.get_unique_name()}")
    GLib.MainLoop().run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[2:]))
