#!/usr/bin/env python3
import os
import struct
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

EVENT = struct.Struct("llHHi")
VALUES = {"up": 0, "down": 1, "repeat": 2}


def key(fd, value):
    t = time.clock_gettime(time.CLOCK_MONOTONIC)
    s, u = int(t), int((t % 1) * 1e6)
    os.write(fd, EVENT.pack(s, u, 1, 116, value) + EVENT.pack(s, u, 0, 0, 0))


def main(path):
    fd = os.open(path, os.O_WRONLY)
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    for line in sys.stdin:
        for word in line.split():
            cmd, _, arg = word.partition(":")
            if cmd in VALUES:
                key(fd, VALUES[cmd])
            elif cmd == "wait":
                time.sleep(float(arg))
            elif cmd == "sleep":
                bus.call_sync(
                    "org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager",
                    "EmitPrepareForSleep", GLib.Variant("(b)", (arg == "true",)), None,
                    Gio.DBusCallFlags.NONE, -1, None,
                )
            else:
                print(f"unknown command {word}", flush=True)
                return 1
        print("ok", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
