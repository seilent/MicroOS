#!/usr/bin/env python3
import os
import struct
import sys
import time

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

EVENT = struct.Struct("llHHi")
VALUES = {"up": 0, "down": 1, "repeat": 2}
KEYS = {
    "power": ("event0", 116),
    "guide": ("event1", 183),
    "lc": ("event1", 184),
    "rc": ("event1", 185),
    "guide2": ("event2", 183),
    "volup": ("event3", 115),
    "voldown": ("event4", 114),
}
LOGIN1 = ("org.freedesktop.login1", "/org/freedesktop/login1", "org.freedesktop.login1.Manager")
STUB = ("org.shadowblip.InputPlumber", "/test", "test.Stub")
fds = {}


def key(d, name, value):
    node, code = KEYS[name]
    if node not in fds:
        fds[node] = os.open(os.path.join(d, node, "node"), os.O_RDWR)
    t = time.clock_gettime(time.CLOCK_MONOTONIC)
    s, u = int(t), int((t % 1) * 1e6)
    os.write(fds[node], EVENT.pack(s, u, 1, code, value) + EVENT.pack(s, u, 0, 0, 0))


def call(bus, dest, method, params):
    bus.call_sync(*dest, method, params, None, Gio.DBusCallFlags.NONE, -1, None)


def main(d):
    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    for line in sys.stdin:
        for word in line.split():
            cmd, _, arg = word.partition(":")
            name, _, value = cmd.rpartition(".")
            if value in VALUES:
                key(d, name or "power", VALUES[value])
            elif cmd == "wait":
                time.sleep(float(arg))
            elif cmd == "sleep":
                call(bus, LOGIN1, "EmitPrepareForSleep", GLib.Variant("(b)", (arg == "true",)))
            elif cmd == "deny":
                call(bus, LOGIN1, "SetDeny", GLib.Variant("(s)", (arg,)))
            elif cmd == "close":
                os.close(fds.pop(KEYS[arg][0]))
            elif cmd == "add":
                call(bus, STUB, "AddDevice", None)
            elif cmd == "remove":
                call(bus, STUB, "RemoveDevice", None)
            elif cmd == "delay":
                call(bus, STUB, "SetDelay", GLib.Variant("(u)", (int(arg),)))
            elif cmd == "step":
                call(bus, STUB, "SetStep", GLib.Variant("(u)", (int(arg),)))
            else:
                print(f"unknown command {word}", flush=True)
                return 1
        print("ok", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
