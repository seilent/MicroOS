#!/usr/bin/env bash
echo "journalctl $*" >> "$FAKE/calls"
pid="" boot=""
for a; do
  [[ $a != _PID=* ]] || pid=${a#_PID=}
  [[ $a != _BOOT_ID=* ]] || boot=${a#_BOOT_ID=}
done
[[ -f $FAKE/journal ]] || exit 0
while read -r b line; do
  [[ -z $boot || $b == "$boot" ]] || continue
  [[ -z $pid || $line == *" systemd[$pid]: "* ]] || continue
  printf '%s\n' "$line"
done < "$FAKE/journal"
exit 0
