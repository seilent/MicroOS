#!/usr/bin/env bash
printf 'plymouth %s\n' "$*" >> "$STUB_LOG"
case $1 in
  --ping) [[ ! -e $STUB_DIR/down ]] ;;
  quit)
    if [[ ${2:-} == --retain-splash ]]; then
      n=$(cat "$STUB_DIR/retain-fails" 2> /dev/null || echo 0)
      if ((n > 0)); then
        echo $((n - 1)) > "$STUB_DIR/retain-fails"
        if ((n == 1)) && [[ -e $STUB_DIR/switch-at-retain ]]; then
          echo active > "$STUB_DIR/switch-state"
        fi
        exit 1
      fi
    else
      [[ ! -e $STUB_DIR/switch-at-quit ]] || echo activating > "$STUB_DIR/switch-state"
      [[ ! -e $STUB_DIR/quit-fails ]]
    fi
    ;;
  display-message) [[ ! -e $STUB_DIR/send-fails ]] ;;
  *) exit 1 ;;
esac
