        beats.append(time.monotonic())
    gaps = [b - a for a, b in zip(beats, beats[1:])]
    check("session stalled mid FRAME: heartbeats on time", len(beats) >= 5 and max(gaps) < 0.6, gaps)
    S.s.sendall(JPEG[10:])
    check("session stalled mid FRAME: the frame completes", t.frame()[1] == JPEG)
