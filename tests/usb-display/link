class Link:
    def __init__(self, fmt=None):
        global links
        links += 1
        tcp = socket.socket()
        tcp.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        tcp.bind(("0.0.0.0", 0))
        tcp.listen(16)
        self.port = tcp.getsockname()[1]
        self.path = f"\0microos-usb-display-link-test-{os.getpid()}-{links}"
        unix = socket.socket(socket.AF_UNIX)
        unix.bind(self.path)
        unix.listen(16)
        env = dict(os.environ)
        env.pop("MICROOS_USB_DISPLAY_FORMAT", None)
        if fmt is not None:
            env["MICROOS_USB_DISPLAY_FORMAT"] = fmt
        self.proc = subprocess.Popen([sys.executable, __file__, "serve", link_path, str(tcp.fileno()), str(unix.fileno()),
                                      creds, proc_dir, current_file], pass_fds=(tcp.fileno(), unix.fileno()), env=env,
                                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        tcp.close()
        unix.close()
        self.lines = []
        self.cond = threading.Condition()
        threading.Thread(target=self.collect, daemon=True).start()
        check("link starts", self.wait_log("listening") is not None, self.text())

    def collect(self):
        for line in self.proc.stderr:
            with self.cond:
                self.lines.append(line.decode(errors="replace"))
                self.cond.notify_all()
        with self.cond:
            self.lines.append("")
            self.cond.notify_all()

    def mark(self):
        with self.cond:
            return len(self.lines)

    def wait_log(self, text, timeout=5, start=0):
        texts = (text,) if isinstance(text, str) else text
        deadline = time.monotonic() + timeout
        with self.cond:
            while True:
                for i in range(start, len(self.lines)):
                    if any(t in self.lines[i] for t in texts):
                        return i
                left = deadline - time.monotonic()
                if left <= 0:
                    return None
                self.cond.wait(left)

    def count(self, text, start=0):
        with self.cond:
            return sum(text in line for line in self.lines[start:])

    def text(self, start=0):
        with self.cond:
            return "".join(self.lines[start:])

    def stop(self):
        if self.proc.poll() is None:
            self.proc.send_signal(signal.SIGTERM)
        try:
            return self.proc.wait(5)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            return self.proc.wait()


class Peer:
    def read(self, timeout):
        deadline = time.monotonic() + timeout
        while True:
            msg = self.parse()
            if msg is not None:
                return msg
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError
            self.s.settimeout(left)
            try:
                data = self.s.recv(1 << 20)
            except (ConnectionResetError, BrokenPipeError):
                return None
            if not data:
                return None
            self.buf += data

    def parse(self):
        if len(self.buf) < d.HEADER.size:
            return None
        _, _, kind, length = d.HEADER.unpack(self.buf[:d.HEADER.size])
        if len(self.buf) < d.HEADER.size + length:
            return None
        msg = kind, self.buf[d.HEADER.size:d.HEADER.size + length]
        self.buf = self.buf[d.HEADER.size + length:]
        return msg

    def close(self):
        self.s.close()


class Session(Peer):
    def __init__(self, link, name="steam", cgroup=None):
        self.link = link
        self.name = name
        self.buf = b""
        with open(cgroup_file, "w") as f:
            f.write(cgroup or f"0::/user.slice/user-{UID}.slice/user@{UID}.service/app.slice/microos-usb-display@{name}.service\n")
        mark = link.mark()
        self.s = socket.socket(socket.AF_UNIX)
        self.s.connect(link.path)
        i = link.wait_log((f"session {name} connected", "closing a session connection"), 5, mark)
        self.ok = i is not None and f"session {name} connected" in link.lines[i]

    def send(self, kind, payload=b""):
        self.s.sendall(d.sl_pack(kind, payload))

    def expect(self, kind, timeout=5):
        try:
            msg = self.read(timeout)
        except TimeoutError:
            return None
        return msg[1] if msg and msg[0] == kind else None

    def quiet(self, timeout):
        try:
            self.read(timeout)
        except TimeoutError:
            return True
        return False

    def closed(self, timeout=5):
        try:
            while self.read(timeout) is not None:
                pass
            return True
        except TimeoutError:
            return False


class Tablet(Peer):
    def __init__(self, link, source="127.0.0.1", rcvbuf=None):
        self.s = socket.socket()
        if rcvbuf is not None:
            self.s.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, rcvbuf)
        self.s.settimeout(5)
        self.s.bind((source, 0))
        self.s.connect(("127.0.0.1", link.port))
        self.s.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.buf = b""
        self.beat = 0.0
        self.sn = None

    def send(self, data):
        self.s.sendall(data)

    def until(self, kinds, timeout=5, beat=True):
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if beat and time.monotonic() >= self.beat:
                try:
                    self.send(d.heartbeat(time.monotonic_ns()))
                except OSError:
                    return None
                self.beat = time.monotonic() + 0.25
            try:
                msg = self.read(min(0.05, max(0.0, deadline - time.monotonic())))
            except TimeoutError:
                continue
            if msg is None or msg[0] in kinds:
                return msg
        raise TimeoutError

    def hello(self, key=KEY, mode=MODE, formats=3):
        kind, self.sn = self.read(5)
        if kind != d.NONCE:
            raise RuntimeError(f"first message {kind}")
        self.tn = os.urandom(32)
        self.send(d.hello(key, self.sn, self.tn, *mode, formats))

    def accepted(self):
        msg = self.until({d.ACCEPT, d.BYE})
        if msg is None or msg[0] != d.ACCEPT:
            return None
        return d.parse_accept(KEY, self.tn, self.sn, msg[1])

    def frame(self, timeout=5, beat=True):
        msg = self.until({d.FRAME}, timeout, beat)
        return d.parse_frame(msg[1]) if msg else (None, None)

    def bye(self, timeout=5, beat=True):
        msg = self.until({d.BYE}, timeout, beat)
        return d.parse_fixed(d.BYE, msg[1]) if msg else None

    def rest(self, timeout=5, beat=False):
        kinds = []
        deadline = time.monotonic() + timeout
        try:
            while True:
                msg = self.until(set(range(1, 9)), deadline - time.monotonic(), beat)
                if msg is None:
                    return kinds
                kinds.append(msg[0])
        except TimeoutError:
            kinds.append("open")
            return kinds

    def closed(self, timeout=5, beat=True):
        try:
            return self.until(set(), timeout, beat) is None
        except TimeoutError:
            return False


def scenario(what, fn):
    try:
        fn()
    except (OSError, RuntimeError, TimeoutError, d.WireError) as err:
        fail(f"{what}: {type(err).__name__} {err}")


def start_stream(link, session, fmt=d.FMT_JPEG, rcvbuf=None):
    t = Tablet(link, rcvbuf=rcvbuf)
    t.hello()
    check("ACCEPT", t.accepted() == fmt)
    start = session.expect(d.START)
    check("START with the format and the v1 mode", start == d.START_BODY.pack(fmt, *MODE), start)
    session.send(d.READY)
    return t


def end_stream(t, session):
    t.send(d.bye(d.BYE_USER))
    check("STOP after the tablet's BYE", session.expect(d.STOP) == b"")
    session.send(d.STOPPED)
    t.close()


