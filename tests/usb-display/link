def other_uid():
    mark = L.mark()
    code = ("import os, socket, sys\n"
            "print(os.getpid(), flush=True)\n"
            "sys.stdin.readline()\n"
            "s = socket.socket(socket.AF_UNIX)\n"
            "s.connect('\\0' + sys.argv[1])\n"
            "s.settimeout(3)\n"
            "try:\n"
            "    print('closed' if s.recv(64) == b'' else 'data', flush=True)\n"
            "except TimeoutError:\n"
            "    print('open', flush=True)\n")
    child = subprocess.Popen(["setpriv", "--reuid=65534", "--regid=65534", "--clear-groups", sys.executable, "-c", code,
                              L.path[1:]], stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
    pid = int(child.stdout.readline())
    os.makedirs(os.path.join(proc_dir, str(pid)), exist_ok=True)
    with open(os.path.join(proc_dir, str(pid), "cgroup"), "w") as f:
        f.write(f"0::/user.slice/user-{UID}.slice/user@{UID}.service/app.slice/microos-usb-display@steam.service\n")
    out, _ = child.communicate("go\n", timeout=10)
    check("session peer with another uid and a valid cgroup: closed", out.strip() == "closed", out)
    check("session peer with another uid: refused", L.wait_log("closing a session connection", 5, mark) is not None)


