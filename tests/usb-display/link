def bucket_flood():
    t = start_stream(L, S)
    S.send(d.SL_FRAME, b"\x02" + JPEG)
    head, _ = t.frame()
    check("TOUCH flood: streaming before the flood", head is not None)
    t.send(d.frame_ack(head["seq"] if head else 0, 1, 2))
    t.send(d.touch(0, 0, d.TOUCH_DOWN, 0.5, 0.5) + d.touch(0, 0, d.TOUCH_MOVE, 0.5, 0.5) * 5000 +
           d.touch(0, 0, d.TOUCH_UP, 0.5, 0.5) + d.touch(0, 0, d.TOUCH_FRAME, 0.0, 0.0))
    kinds = []
    while not kinds or kinds[-1] != d.TOUCH_FRAME:
        body = S.expect(d.SL_TOUCH)
        if body is None:
            break
        kinds.append(d.TOUCH_BODY.unpack(body)[2])
    moves = kinds.count(d.TOUCH_MOVE)
    check("TOUCH flood: down, up and frame pass", [k for k in kinds if k != d.TOUCH_MOVE] ==
          [d.TOUCH_DOWN, d.TOUCH_UP, d.TOUCH_FRAME], kinds[:3])
    check("TOUCH flood: moves dropped past the bucket", 199 <= moves < 5000, moves)
    end_stream(t, S)


