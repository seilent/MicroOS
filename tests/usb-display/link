N = Link("nv12")
S = Session(N)


def nv12():
    t = start_stream(N, S, d.FMT_NV12)
    data = os.urandom(1536000)
    S.send(d.SL_FRAME, b"\x01" + data)
    head, got = t.frame()
    check("NV12 frame header", head is not None and (head["fmt"], head["stride0"], head["stride1"]) == (1, 1280, 1280), head)
    check("NV12 frame data", got == data)
    t.send(d.frame_ack(0, 1, 2))
    S.send(d.SL_FRAME, b"\x01" + data[:-1])
    check("NV12 short frame: session closed", S.closed())
    check("NV12 short frame: BYE(session)", t.bye() == (d.BYE_SESSION, 0))
    t.close()


scenario("NV12", nv12)
