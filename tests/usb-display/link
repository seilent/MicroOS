def stream():
    t = Tablet(L)
    t.hello()
    check("ACCEPT", t.accepted() == d.FMT_JPEG)
    check("HEARTBEAT right after ACCEPT", t.read(1)[0] == d.HEARTBEAT)
    check("START", S.expect(d.START) == d.START_BODY.pack(d.FMT_JPEG, *MODE))
    S.send(d.READY)
    before = time.monotonic_ns()
    S.send(d.SL_FRAME, b"\x02" + JPEG)
    head, data = t.frame()
    after = time.monotonic_ns()
    check("FRAME header written by the link", head is not None and {k: head[k] for k in head if k != "pts_ns"} ==
          dict(seq=0, fmt=2, width=1280, height=800, stride0=1280, stride1=1280, colorimetry=1), head)
    check("FRAME pts from the link's CLOCK_MONOTONIC at arrival", head is not None and before <= head["pts_ns"] <= after)
    check("FRAME data", data == JPEG)
    t.send(d.frame_ack(0, 1, 2))
    t.send(d.touch(0, 3, d.TOUCH_DOWN, 0.25, 0.75))
    t.send(d.touch(1, 9, d.TOUCH_MOVE, 1.0, 0.0))
    check("TOUCH after READY relayed", S.expect(d.SL_TOUCH) == d.TOUCH_BODY.pack(0, 3, 1, 0.25, 0.75))
    check("TOUCH on slot 9 relayed", S.expect(d.SL_TOUCH) == d.TOUCH_BODY.pack(1, 9, 2, 1.0, 0.0))
    end_stream(t, S)


def pacing():
    t = start_stream(L, S)
    frames = [b"\xff\xd8" + bytes([i]) * 64 + b"\xff\xd9" for i in range(6)]
    S.s.sendall(b"".join(d.sl_pack(d.SL_FRAME, b"\x02" + f) for f in frames[:5]))
    got = [t.frame() for _ in range(2)]
    check("two frames in flight", [(h and h["seq"], x) for h, x in got] == [(0, frames[0]), (1, frames[1])],
          [h for h, _ in got])
    try:
        extra = t.until({d.FRAME}, 0.5)
    except TimeoutError:
        extra = None
    check("no third frame before an ack", extra is None, extra)
    t.send(d.frame_ack(1, 1, 2))
    head, data = t.frame()
    check("the newest waiting frame wins after the ack", head is not None and head["seq"] == 2 and data == frames[4],
          head)
    t.send(d.frame_ack(2, 1, 2))
    S.send(d.SL_FRAME, b"\x02" + frames[5])
    head, data = t.frame()
    check("frames continue after the acks", head is not None and head["seq"] == 3 and data == frames[5], head)
    end_stream(t, S)


