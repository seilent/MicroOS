def load(path):
    loader = importlib.machinery.SourceFileLoader("usbdisplaylink", path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("usbdisplaylink", loader))
    loader.exec_module(mod)
    return mod


def serve(path, tcp, unix, creds, proc, current):
    high = [fcntl.fcntl(int(fd), fcntl.F_DUPFD, 10) for fd in (tcp, unix)]
    for want, fd in zip((3, 4), high):
        os.dup2(fd, want)
        os.close(fd)
    os.environ.update(LISTEN_PID=str(os.getpid()), LISTEN_FDS="2", CREDENTIALS_DIRECTORY=creds)
    d = load(path)
    d.PEER, d.PROC, d.USER, d.CURRENT = "127.0.0.1", proc, pwd.getpwuid(os.getuid()).pw_name, current
    return d.main()


