    deadline = time.monotonic() + 15
    frames = 0
    while "chatty" not in stub_log() and time.monotonic() < deadline:
        if conn.until({k.SL_FRAME}, deadline - time.monotonic()) is not None:
            frames += 1
    check("chatty: both pipes drained", "chatty" in stub_log(), stub_log())
    check("chatty: frames flow while it writes", frames > 0 and conn.until({k.SL_FRAME}) is not None)
    conn.send(k.STOP)
    check("chatty: STOPPED", conn.until({k.STOPPED}) == (k.STOPPED, b""))


