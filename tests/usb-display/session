def load(path, name):
    loader = importlib.machinery.SourceFileLoader(name, path)
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(mod)
    return mod


def serve(path, sock, client, events, cap=None):
    d = load(path, "usbdisplay")
    if cap is not None:
        d.FRAME_DATA_MAX = int(cap)

    def out(line):
        with open(events, "a") as f:
            f.write(line + "\n")

    class UInput:
        def __init__(self, caps=None, name="", input_props=None):
            self.name = name
            out(f"{name}: create")

        def write(self, etype, code, value):
            out(f"{self.name}: {etype} {code} {value}")

        def syn(self):
            out(f"{self.name}: syn")

        def close(self):
            out(f"{self.name}: close")

    class Stdin:
        def __init__(self, pipe):
            self.pipe = pipe

        def close(self):
            out("stdin closed")
            self.pipe.close()

    class Popen(subprocess.Popen):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, **kwargs)
            self.stdin = Stdin(self.stdin)

    def source():
        src = d.Gst.ElementFactory.make("videotestsrc")
        src.set_property("is-live", True)
        return src

    d.evdev.UInput = UInput
    d.subprocess.Popen = Popen
    d.source = source
    d.SOCK, d.CLIENT = sock, client
    sys.argv = [path, "steam"]
    return d.main()


