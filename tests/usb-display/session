def reconnect():
    global conn
    stub_mode("node")
    conn.send(k.START, START_JPEG)
    check("lost link: READY", conn.until({k.READY, k.FAILED}) == (k.READY, b""))
    mark = len(lines())
    conn.s.close()
    lost = time.monotonic()
    conn = link.accept(5)
    took = time.monotonic() - lost
    check("lost link: reconnects after 1 s while the socket exists", conn is not None and 0.9 <= took <= 3, took)
    check("lost link: the run is torn down", "eof" in stub_log() and "microos-usb-display touch: close" in lines()[mark:],
          stub_log())
    conn.send(k.STOP)
    check("kept idle: STOPPED", conn.until({k.STOPPED}) == (k.STOPPED, b""))
    check("kept idle: no reconnect", link.accept(2.5) is None)
    check("kept idle: the connection stays open", not conn.closed(0.1))
    conn.s.close()
    link.gone()
    check("socket gone: exit 0", exit_code(part.proc, 5) == 0, part.log()[-500:])


