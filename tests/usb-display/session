class Conn:
    def __init__(self, s):
        self.s = s
        self.buf = b""

    def send(self, kind, payload=b""):
        self.s.sendall(k.sl_pack(kind, payload))

    def read(self, timeout):
        deadline = time.monotonic() + timeout
        while True:
            if len(self.buf) >= k.HEADER.size:
                kind, length = k.sl_unpack_header(self.buf[:k.HEADER.size], k.FROM_SESSION)
                if len(self.buf) >= k.HEADER.size + length:
                    msg = kind, self.buf[k.HEADER.size:k.HEADER.size + length]
                    self.buf = self.buf[k.HEADER.size + length:]
                    return msg
            left = deadline - time.monotonic()
            if left <= 0:
                raise TimeoutError
            self.s.settimeout(left)
            data = self.s.recv(1 << 20)
            if not data:
                return None
            self.buf += data

    def until(self, kinds, timeout=10):
        deadline = time.monotonic() + timeout
        while True:
            msg = self.read(max(0.0, deadline - time.monotonic()))
            if msg is None or msg[0] in kinds:
                return msg

    def closed(self, timeout):
        try:
            return self.until(set(), timeout) is None
        except TimeoutError:
            return False


class FakeLink:
    def __init__(self):
        self.srv = socket.socket(socket.AF_UNIX)
        self.srv.bind(sock_path)
        self.srv.listen(4)

    def accept(self, timeout):
        self.srv.settimeout(timeout)
        try:
            return Conn(self.srv.accept()[0])
        except TimeoutError:
            return None

    def gone(self):
        self.srv.close()
        os.unlink(sock_path)


class Part:
    def __init__(self, *cap):
        self.err = os.path.join(tmp, "part.err")
        env = dict(os.environ, STUB_DIR=stub, NOTIFY_SOCKET=notify_path, XDG_RUNTIME_DIR=run_dir,
                   GAMESCOPE_WAYLAND_DISPLAY="gamescope-3")
        with open(self.err, "a") as err:
            self.proc = subprocess.Popen([sys.executable, __file__, "serve", part_path, sock_path,
                                          os.path.join(here, "gamescopevirtual"), events, *cap], env=env,
                                         stdin=subprocess.DEVNULL, stdout=err, stderr=err)

    def log(self):
        return read(self.err)

    def stop(self):
        if self.proc.poll() is None:
            self.proc.send_signal(signal.SIGTERM)
        try:
            return self.proc.wait(10)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            return self.proc.wait()


