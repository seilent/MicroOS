def padded(y_stride, uv_stride, gap, cut=0):
    y, uv = os.urandom(y_stride * 800), os.urandom(uv_stride * 400)
    data = y + bytes(gap) + uv
    buf = Gst.Buffer.new_wrapped(data[:len(data) - cut])
    GstVideo.buffer_add_video_meta_full(buf, GstVideo.VideoFrameFlags.NONE, GstVideo.VideoFormat.NV12, 1280, 800, 2,
                                        [0, len(y) + gap, 0, 0], [y_stride, uv_stride, 0, 0])
    tight = b"".join(y[r * y_stride:r * y_stride + 1280] for r in range(800)) + \
        b"".join(uv[r * uv_stride:r * uv_stride + 1280] for r in range(400))
    return Gst.Sample.new(buf, caps, None, None), tight


