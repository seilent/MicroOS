def teardown_order(what, stopped_at):
    got = lines()
    try:
        stdin = got.index("stdin closed", stopped_at)
        close = got.index("microos-usb-display touch: close", stopped_at)
        stopped = got.index("STOPPED", stopped_at)
    except ValueError:
        fail(f"{what}: teardown lines missing: {got[stopped_at:]}")
        return
    lift = [i for i in range(stdin, close) if got[i].endswith(f"{A} {E.ABS_MT_TRACKING_ID} -1")]
    check(f"{what}: stdin closed first, slots lifted, uinput closed, STOPPED last", stdin < close < stopped and lift,
          got[stopped_at:])
    check(f"{what}: gamescopevirtual got EOF before STOPPED", "eof" in stub_log(), stub_log())


def mark_stopped(conn):
    msg = conn.until({k.STOPPED})
    with open(events, "a") as f:
        f.write("STOPPED\n")
    return msg


